                    self.send_header("Cache-Control", "no-store")
                    self.send_header("Content-Length", str(len(body)))
                    self.end_headers()
                    self.wfile.write(body)
                    return
                if u.path in ("/", "/ui"):
                    return self.send_file(os.path.join(here, "web", "ui.html"), "text/html; charset=utf-8")
                if u.path == "/seamside":
