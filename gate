#!/bin/sh
# gate: the tool is one binary, and this is the shim that finds it.
#
# Every executable line in this repository stays text, so the binary is never
# committed: it is built here, carried in by a team, or downloaded from a
# release. This file is the one place that knows where to look, and it looks in
# the order a person would want:
#
#   GATE_CLI            an explicit path, for anybody holding one
#   bin/gate-cli        built from this clone by bin/build-cli.sh
#   .gate/bin/gate-cli  carried into a repository by `gate init --vendor`
#   gate-cli on PATH    installed once, used everywhere
#
# and if none of them is here it says so in one sentence with the two ways out,
# rather than failing in a way somebody has to guess at.
set -e
HERE="$(cd "$(dirname "$0")" && pwd)"

# a windows binary wears its extension; every other platform names it plain
for CANDIDATE in \
    "${GATE_CLI:-}" \
    "$HERE/bin/gate-cli" \
    "$HERE/bin/gate-cli.exe" \
    "$HERE/.gate/bin/gate-cli" \
    "$HERE/.gate/bin/gate-cli.exe" \
    "$(command -v gate-cli 2>/dev/null || true)"
do
    [ -n "$CANDIDATE" ] || continue
    [ "$CANDIDATE" = "off" ] && continue
    [ -x "$CANDIDATE" ] || continue
    exec "$CANDIDATE" "$@"
done

echo "gate: no binary here, and this tool is one binary." >&2
echo "  build it: bin/build-cli.sh, which needs swiftc and takes about a minute" >&2
echo "  or take one: the releases at github.com/DanielSwift1992/gate carry one per" >&2
echo "  platform, each with the corpus revision its court was built from and a sha256" >&2
exit 1
