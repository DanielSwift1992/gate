VIEWS = ("full", "bare", "table")


def opens_as(path):
    # ── AND HOW A FILE IS FIRST MET, SAID BY THE FILE. The same act as `// role:`
    # one line above it: sorting files by the shape of their names was a guess
    # dressed as a category, and the rule that replaced it was that each file
    # states what it is in its own words. A letter opened in Full reads as code
    # — every line wearing `//`, the greeting dressed as a source file — and a
    # ratio of prose to records would be that same guess again, wearing a
    # threshold. So the author says it, once, in their own file.
    #
    # A word that is not a view is refused by name rather than ignored, because
    # a preference silently dropped is a preference the writer thinks they have.
    # the manifest row speaks first: how a file is met is a column, not a
    # comment, the same way Written became one. The head stays as the word of
    # pages that live outside any manifest (the shelf sources themselves).
    base = os.path.dirname(os.path.abspath(FACTS)) if FACTS else os.getcwd()
    for r in (MANIFEST.get("rows") if MANIFEST else None) or []:
        if os.path.abspath(os.path.join(base, r["path"])) == os.path.abspath(path) \
                and r.get("opens"):
            said = r["opens"].lower()
            return (said if said in VIEWS else None), said
    try:
        head = open(path, encoding="utf-8", errors="replace").read(2000)
    except OSError:
        return None, None
    for line in head.split("\n")[:6]:
        m = re.match(r"//\s*opens:\s*(\S+)", line.strip())
        if m:
            said = m.group(1).strip().lower()
            return (said if said in VIEWS else None), said
    return None, None


def opens_guards():
    bad = []
    for name, path in bench_files():
        if not os.path.exists(path):
            continue
        view, said = opens_as(path)
        if said and not view:
            bad.append({"address": name,
                        "claim": f"`{said}` is not a view: this file says how it should first be "
                                 "met and names something the bench cannot open. It is one of "
                                 + " · ".join(VIEWS)})
    return bad


def stdlib_role(name):
    # WHICH IT IS, THE FILE SAYS ITSELF — the same rule a seam side already
    # lives by. Sorting these by the shape of their names was a guess dressed
    # as a category, and it put the tool's own furniture in front of an
    # operator who has no use for it. `forms` is what YOUR world and policy are
    # written in; `gate's own` is how this page looks and spaces itself, which
    # is gate's business and is judged in gate's own battery.
    for line in STDLIB.get(name, "").split("\n")[:4]:
        m = re.match(r"// role: (.+)", line.strip())
        if m:
            return m.group(1).strip()
    return None


# the sorts of the shelf, and the list is closed on purpose: a fifth word is a
# category somebody invented in a hurry, and the point of the column is that
# what taking this tool imposes on a repository can be read off a short list
SPEAKS = ("a-domain", "the-tool", "the-bench", "the-reader")


def stdlib_speaks(name):
    # AND WHOSE VOICE THE PAGE SPEAKS IN, WHICH THE ROLE DOES NOT SAY. The role
    # says which court reads a file and whether it is this tool's own furniture,
    # and under `forms` two unlike things go on standing together: the words a
    # world of YOURS is written in, and the words this tool's own verbs and
    # courts are written in. An operator opening the shelf asks which of these
    # is about their repository, and the role column answers a question they did
    # not ask. Said in the file's third line, beside the role, for the reason the
    # role is said there: a category read off the shape of a name is a guess.
    for line in STDLIB.get(name, "").split("\n")[:4]:
        m = re.match(r"// speaks-for: (.+)", line.strip())
        if m:
            return m.group(1).strip()
    return None


def stdlib_guards():
    # A PRINTOUT THAT NO LONGER MATCHES WHAT IT PRINTS. The copy claims, in its
    # own header, to be the words this judge carries; once edited it says
    # something the judge will not answer for, and a reader has no way to tell.
    # It is not a source — editing it adds no word to the language — so the only
    # honest ends are to print it again or to stop claiming it is the printout.
    if not FACTS:
        return []
    d = os.path.dirname(os.path.abspath(FACTS))
    bad = []
    # AND EVERY PAGE ON THE SHELF SAYS WHICH IT IS. Sorting these by the shape
    # of their names was a guess dressed as a category; the rule that replaced
    # it — each file states its own role in its own second line — is only worth
    # anything if a file that forgets is caught rather than quietly filed under
    # nothing. A shelf page with no role is not a small omission: it decides
    # whether an operator is shown the page at all.
    for name in STDLIB:
        if stdlib_role(name) is None:
            bad.append({"address": f"stdlib/{name}.swift:2",
                        "claim": "this page does not say what it is. A shelf file states its own "
                                 "role in its second line: `// role: forms` for what an operator "
                                 "speaks, `// role: gate's own` for this tool's furniture, and "
                                 "one that says nothing cannot be placed"})
    # AND WHOSE VOICE IT SPEAKS IN, WHICH IS THE QUESTION THE ROLE LEAVES OPEN.
    # Under one role stand the words a domain of yours is written in and the
    # words this tool's own verbs are written in, and the difference is the
    # whole of what an operator wants from this shelf: which of it is about my
    # repository, and which of it came with the tool. A page that says nothing
    # is filed by whoever reads it, differently each time.
    for name in STDLIB:
        said = stdlib_speaks(name)
        if said is None:
            bad.append({"address": f"stdlib/{name}.swift:3",
                        "claim": "this page does not say whose voice it speaks in. A shelf file "
                                 "states its sort in its third line, beside its role: "
                                 "`// speaks-for: a-domain` for the words a world of yours is "
                                 "written in, `the-tool` for what this tool's own verbs and "
                                 "courts are written in, `the-bench` for the page you read them "
                                 "on, `the-reader` for what a repository is met with"})
        elif said not in SPEAKS:
            bad.append({"address": f"stdlib/{name}.swift:3",
                        "claim": f"`{said}` is not a sort of the shelf: this page names a group "
                                 "nobody declared, and the reader it was written for would look "
                                 "for it and find nothing. It is one of "
                                 + " · ".join(SPEAKS) + ", and the list is closed so that what "
                                 "taking this tool puts on a repository stays a list somebody "
                                 "can read to the end"})
    for name, body in STDLIB.items():
        p = os.path.join(d, f"{name}.swift")
        if os.path.exists(p):
            text = open(p).read()
            if text.startswith(MATERIALIZED_MARK) and text != body:
                bad.append({"address": f"{name}.swift", "claim": "this printout no longer matches the words the judge carries, and still says it does. Editing it adds no word to the language: print it again, or drop the header so it stops claiming to be the printout"})
    return bad


def one_stream(named):
    # ONE NAMESPACE IS ONE STREAM, AND THIS IS THE ONE PLACE THAT SAYS WHICH.
    # The duplicate guard asks whether two files declare one name, and that
    # question only means anything inside a stream judged together. A forms file
    # is its own stream — each spells its own ladder from Unit, the way the
    # corpus tells every world to — so metrics and palette both saying `W2` is
    # two worlds each counting for itself, not one world saying a thing twice.
    # The layout is not a fragment of the world either; its court is the guards.
    #
    # This rule lived here and the bench built its own list beside it, without
    # it. The result was this repository's own bench showing twenty-one
    # refusals, in red, at the front door, while `gate status` on the same files
    # at the same moment said `holds` — every one of them two worlds counting.
    # Nobody saw it because we always opened a sandbox, never gate itself.
    forms = {r["path"] for r in ((MANIFEST.get("rows") if MANIFEST else None) or [])
             if r["role"] == "forms"}
    layout = MANIFEST["manifest"] if MANIFEST else None
    apart = {os.path.abspath(x) for x in (layout, policy_path()) if x}
    return [(n, p) for n, p in named
            if n not in forms and os.path.abspath(p) not in apart]


def disk_sources():
    return [(n, open(p).read()) for n, p in one_stream(bench_files())
            if os.path.exists(p)]


def duplicate_guards():
    # One name, one declaration. Two declarations of a name are two truths
    # about it, which is the thing this tool exists to make impossible — and
    # the judge does not catch them: it keeps one and says nothing. Swift
    # refuses the same file outright ("invalid redeclaration"), so this is the
    # fast tier saying at a keystroke what the compiler would say at a build.
    # Only names at the top of a file: a typealias INSIDE a declaration is an
    # axis, and every person in a roster states the same ones.
    return duplicate_guards_over(disk_sources())


def top_names(text):
    # THE NAMES A FILE GIVES, AT THE TOP OF IT AND NOWHERE ELSE. A typealias inside
    # a declaration is an AXIS — what that record says about itself — and every
    # record of a kind states the same ones. One reading of that rule, used by the
    # guard that refuses two declarations of a name and by the one that asks whether
    # a law's carrier is inside the encoding that carries it.
    out, depth = [], 0
    for i, line in enumerate(text.split("\n"), 1):
        code = line.split("//")[0]
        m = re.match(r"\s*(?:public\s+)?(enum|protocol|struct|typealias)\s+(\w+)", code)
        if m and depth == 0:
            # a LIST, not a map: a name declared twice in one file is the very thing
            # the duplicate guard is for, and a map would have swallowed it
            out.append((m.group(2), i))
        depth += code.count("{") - code.count("}")
    return out


def laws_of(text):
    # every top-level certificate and the names it leans on: `X = Form<A, B>` and a
    # gated conformance's premise are the two shapes a law is written in here.
    #
    # TWO KINDS OF WORD ARE NOT REFERENCES, and reading them as such makes this
    # accuse a file of leaning on a world it never named. A NAME INSIDE ANGLES IS A
    # NAME, NOT A HOLE — `Legible<Bright, Dark, Slack>` binds `Dark`, and another
    # world's atom happening to be spelled `Dark` has nothing to do with it (a law
    # this project wrote down once already, and I walked into it again). AND AN AXIS
    # IS NOT A TOP-LEVEL NAME — `Who.Site` says what that record states about
    # itself; `Site` is read off `Who`, never out of the document.
    def refs(expr, bound):
        return set(re.findall(r"\b([A-Z]\w*)", re.sub(r"\.\w+", "", expr))) - bound

    def params(name):
        m = re.search(r"(?:public )?enum " + name + r"\s*<([^>]*)>", text)
        if not m:
            return set()
        return {p.split(":")[0].strip() for p in m.group(1).split(",") if p.strip()}

    for m in re.finditer(r"^public typealias (\w+)\s*=\s*(.+)$", text, re.M):
        yield m.group(1), refs(m.group(2), set()), text[:m.start()].count("\n") + 1
    for m in re.finditer(r"^(?:public )?extension (\w+): (\w+)\n\s*where (.+?)\{", text, re.M | re.S):
        yield (m.group(1), refs(m.group(3), params(m.group(1))),
               text[:m.start()].count("\n") + 1)


def duplicate_guards_over(sources):
    seen, bad = {}, []
    for name, text in sources:
        for who, i in top_names(text):
            here = f"{name}:{i}"
            if who in seen:
                bad.append({"address": here,
                            "claim": f"`{who}` is declared twice: once at {seen[who]} and again "
                                     "here. One name, one declaration: two of them are two truths "
                                     "about it, and only one can be read"})
            else:
                seen[who] = here
    return bad


def entry_guards():
    # THE BODY IS TOTAL, the way the top of a file is.
    #
    # The judge refuses anything at the top of a file that is not in its
    # grammar ("outside the fragment"), and inside a body it refuses an
    # unknown form and an argument that resolves to nothing. One thing it
    # does not refuse: an entry that never closes. It swallows the entries
    # after it and drops the run without a word — comment out one `>.self`
    # and six claims stop being checked while the verdict still holds.
    #
    # So every line inside a body must belong to a whole entry: a form, its
    # arguments, and the `>.self` that ends it. Anything else is named by
    # its line, which is what "no line may be written that is not allowed"
    # means once it is applied to the inside of a body as well.
    return entry_guards_over(disk_sources())


def entry_guards_over(sources):
    bad = []
    for name, text in sources:
        lines = text.split("\n")
        in_body, depth, open_at, saw_arg = False, 0, None, False
        for i, raw in enumerate(lines, 1):
            code = raw.split("//")[0]
            if not in_body:
                if re.search(r"var\s+body\s*:\s*some\s+Structure\s*\{", code):
                    in_body, depth, open_at, saw_arg = True, 1, None, False
                continue
            depth += code.count("{") - code.count("}")
            if depth <= 0:                      # the body ends here
                if open_at:
                    bad.append({"address": f"{name}:{open_at}",
                                "claim": "an entry opens here and never closes: everything after it "
                                         "stops being read as a claim, and the judge says nothing"})
                in_body = False
                continue
            bare = code.strip()
            if not bare:
                continue
            closes = re.search(r">\s*\.self\s*;?", bare) is not None
            opens = re.match(r"^[A-Z]\w*\s*<", bare)
            if opens:
                if open_at:
                    bad.append({"address": f"{name}:{open_at}",
                                "claim": "an entry opens here and never closes: the next one begins "
                                         "before it ends, so neither is read as a claim"})
                open_at, saw_arg = i, False
                if closes:                       # a whole entry on one line
                    open_at = None
                continue
            if closes:
                if open_at is None:
                    bad.append({"address": f"{name}:{i}",
                                "claim": "an entry closes here that nothing opens: its form is "
                                         "commented out or missing, so the claim it made is gone "
                                         "and what is left is not Swift"})
                open_at, saw_arg = None, False
                continue
            if open_at is None:                  # neither a form, nor an argument of one
                bad.append({"address": f"{name}:{i}",
                            "claim": f"`{bare[:40]}` stands inside a body and belongs to no entry: "
                                     "a body holds claims, and every claim is a form, its arguments "
                                     "and the `>.self` that ends it"})
            else:
                saw_arg = True
    return bad


def taken_judge_guard():
    # ── THE ONE ROW THIS WHOLE DOCUMENT EXISTS TO KEEP HONEST. The manifest says
    # which revision of the corpus the judge was taken at; the binary says which
    # revision it was BUILT from, written down beside it by `build-judge.sh`.
    # Two statements of one fact, from two places, and nothing compared them —
    # so rebuilding the judge and forgetting the row would have left the panel
    # showing one revision and the table another, both calmly, forever.
    #
    # This is not the judge judging itself: it is arithmetic over two strings
    # somebody else wrote down, which is exactly the kind of check that may
    # stand here. Self-application is not self-certification, and a row that
    # accounts for the court is worth nothing if nobody holds it to the court.
    rows = (MANIFEST.get("rows") if MANIFEST else None) or []
    claimed = next((r.get("from") for r in rows if r["role"] == "judge"), None)
    if not claimed:
        return []
    built = judge_from()
    if not built:
        return [{"address": os.path.basename(MANIFEST["manifest"]),
                 "claim": f"this world says it took the judge at `{claimed}`, and the judge "
                          "beside it records no revision at all. `bin/build-judge.sh` writes "
                          "one down, and until it does the row answers for nothing"}]
    said = claimed.split("@")[-1]
    if not (built.startswith(said) or said.startswith(built)):
        return [{"address": os.path.basename(MANIFEST["manifest"]),
                 "claim": f"this world says it took the judge at `{said}`, and the judge beside "
                          f"it was built from `{built[:12]}` — one of the two is out of date, "
                          "and a row that names the court may not disagree with the court"}]
    return []


def vendored_guards():
    # .gate/ is a materialized shelf like any other: the judge it carries must
    # be the judge it says it carries. An edited copy of the tool is a second
    # truth about what judged this repository — named, not tolerated.
    if not FACTS:
        return []
    d = os.path.dirname(os.path.abspath(FACTS))
    readme = os.path.join(d, ".gate", "README.md")
    binp = os.path.join(d, ".gate", "bin", "gate-judge")
    if not (os.path.exists(readme) and os.path.exists(binp)):
        return []
    stated = re.search(r"judge sha256: ([0-9a-f]{64})", open(readme).read())
    if not stated:
        return []
    import hashlib
    with open(binp, "rb") as f:
        actual = hashlib.sha256(f.read()).hexdigest()
    if actual != stated.group(1):
        return [{"address": ".gate/README.md",
                 "claim": "the carried judge is not the judge this repository states: "
                          f"sha256 {actual[:12]} against {stated.group(1)[:12]}. "
                          "Re-run `gate init . --vendor`, or state the one you mean"}]
    # ── AND A DIGEST SAYS WHAT A FILE IS, NEVER WHETHER IT RUNS. The judge is built
    # for one platform, so a repository vendored on one machine and cloned on another
    # carries a court that matches its recorded digest to the letter and cannot
    # execute. Identity checked, runnability not, which is the same green over
    # nothing this tool exists against, one floor down.
    if not _binary_runs(binp):
        return [{"address": ".gate/bin/gate-judge",
                 "claim": "the carried judge matches its recorded digest and does not run on "
                          "this machine: it was built for another platform. The port serves "
                          "the plain court where node is installed, and `bin/build-judge.sh` "
                          "builds a judge that runs here"}]
    return []


RBAC_FORMS_HEADER = """// printed by gate import rbac: the K8s access world in the domain forms
// (the exemplar: theory corpus Sources/Examples/Grants.swift @ 0fd0b38).
// Realms are namespaces plus the cluster scope. A role is a room stating its
// realm, a binding is a keeper stating its post, and the gate's equality is the
// K8s invariant itself: a RoleBinding and its Role live in one namespace.
// The forms below are the stdlib module forms-grants, printed from the shelf.

"""

READS, WRITES = {"get", "list", "watch"}, {"create", "update", "patch", "delete", "deletecollection"}


def rbac_key(rules):
    verbs = {v for r in rules or [] for v in r.get("verbs", [])}
    if "*" in verbs or verbs & {"escalate", "bind", "impersonate"}:
        return "WardenKey"
    if verbs & WRITES:
        return "WriterKey"
    return "ReaderKey"


def sanitize(s):
    return re.sub(r"[^A-Za-z0-9]", "_", s)


def cmd_import_rbac(a):
    # import rbac rbac.json [-o gate.swift] — kubectl get roles,clusterroles,
    # rolebindings -A -o json | is the input. Three judged outcomes per
    # binding: ok / the Role lives in a foreign namespace (an equality refusal
    # with both names) / no such Role anywhere (dangling).
    src = a[0]
    out_path = a[a.index("-o") + 1] if "-o" in a else "rbac-gate.swift"
    items = theirs_json(src, "a kubectl dump of roles and bindings").get("items", [])
    roles, cluster_roles, bindings = {}, {}, []
    namespaces = set()
    for it in items:
        kind, meta = it.get("kind"), it.get("metadata", {})
        ns, name = meta.get("namespace", ""), meta.get("name", "")
        if kind == "Role":
            roles[(ns, name)] = it
            namespaces.add(ns)
        elif kind == "ClusterRole":
            cluster_roles[name] = it
        elif kind == "RoleBinding":
            bindings.append(it)
            namespaces.add(ns)
    lines = [RBAC_FORMS_HEADER + STDLIB["forms-grants"]]
    # ── the read gate, this world's own. The grants vocabulary above carries
    # one gate, entry to WORK a room, and its key must write. A read binding
    # is not that entry: its key honestly reads, and pushing it through the
    # writing gate was a lie the court could not see while it dropped the
    # conjunct. The membership court walks the ladder now, so a warden and a
    # writer pass Writes, everybody passes Reads at the read gate, and a
    # reader at the writing gate is refused by class, at its certificate.
    lines.append("")
    lines.append("public protocol Viewed {}")
    lines.append("public enum View<Who: Keeper, Into: Room> {}")
    lines.append("extension View: Viewed")
    lines.append("where Who.Key: Reads, Who.Post == Into.Place {}")
    srcmap = {}
    for ns in sorted(namespaces):
        lines.append(f"public enum Ns_{sanitize(ns)}: Realm {{}}")
    lines.append("public enum ClusterScope: Realm {}")
    lines.append("")
    for (ns, name) in sorted(roles):
        lines.append(f"public enum Role_{sanitize(ns)}_{sanitize(name)}: Room {{")
        lines.append(f"    public typealias Place = Ns_{sanitize(ns)}")
        lines.append("}")
    for name in sorted(cluster_roles):
        lines.append(f"public enum CR_{sanitize(name)}: Room {{")
        lines.append("    public typealias Place = ClusterScope")
        lines.append("}")
    lines.append("")
    checked = 0
    for b in bindings:
        meta = b.get("metadata", {})
        bns, bname = meta.get("namespace", ""), meta.get("name", "")
        ref = b.get("roleRef", {})
        rkind, rname = ref.get("kind"), ref.get("name", "")
        keeper = f"B_{sanitize(bns)}_{sanitize(bname)}"
        cert = f"Bind_{sanitize(bns)}_{sanitize(bname)}"
        if rkind == "ClusterRole":
            post, room = "ClusterScope", f"CR_{sanitize(rname)}"
            key = rbac_key(cluster_roles.get(rname, {}).get("rules"))
            what = f"rolebinding {bns}/{bname} -> clusterrole {rname}"
        else:
            post = f"Ns_{sanitize(bns)}"
            key = rbac_key(roles.get((bns, rname), {}).get("rules"))
            if (bns, rname) in roles:
                room = f"Role_{sanitize(bns)}_{sanitize(rname)}"
            else:
                foreign = sorted(ns for (ns, n) in roles if n == rname)
                room = f"Role_{sanitize(foreign[0])}_{sanitize(rname)}" if foreign else f"Role_{sanitize(bns)}_{sanitize(rname)}"
            what = f"rolebinding {bns}/{bname} -> role {rname}"
        lines.append(f"public enum {keeper}: Keeper {{")
        lines.append(f"    public typealias Post = {post}")
        lines.append(f"    public typealias Key = {key}")
        lines.append("}")
        head = "View" if key == "ReaderKey" else "Enter"
        lines.append(f"public typealias {cert} = {head}<{keeper}, {room}>")
        srcmap[cert] = what
        checked += 1
    world = "\n".join(lines) + "\n"
    with open(out_path, "w") as f:
        f.write(world)
    t0 = time.time()
    outp = judge_call(["judge", "where", out_path]).stdout
    ms = round((time.time() - t0) * 1000, 1)
    refusals = []
    for m in re.finditer(r"^✗ '(\w+)[^']*' requires the types '[^']*' \(aka '([^']+)'\) and '[^']*' \(aka '([^']+)'\) be equivalent", outp, re.M):
        cert, left, right = m.groups()
        if cert not in srcmap:
            continue
        dangling = re.match(r"(\w+)\.Place$", right)
        claim = (f"roleRef names a Role that exists nowhere ({right} undeclared)"
                 if dangling else f"the binding lives in {left}, its Role lives in {right}: a RoleBinding and its Role must share one namespace")
        refusals.append({"certificate": cert, "source": srcmap[cert], "claim": claim})
    canon = "canon v2" in outp
    return {
        "command": "import rbac",
        "world": out_path,
        "namespaces": len(namespaces),
        "roles": len(roles),
        "cluster_roles": len(cluster_roles),
        "bindings_judged": checked,
        "verdict": "refused" if refusals else "holds",
        "refusals": refusals,
        "judge_ms": ms,
        "canon_handshake": canon,
        "note": "both tiers of the gate are judged by this run: the posting equalities against one canon, and the key's class through the ladder the world presents (the membership court)",
    }


BADGE_SVG = ('<svg xmlns="http://www.w3.org/2000/svg" width="{w}" height="20" role="img" '
             'aria-label="{alt}"><rect width="{lw}" height="20" rx="3" fill="#2F3131"/>'
             '<rect x="{lw}" width="{rw}" height="20" rx="3" fill="{fill}"/>'
             '<g font-family="ui-monospace,Menlo,monospace" font-size="11">'
