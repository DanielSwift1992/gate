def cmd_survey(a):
    # survey [N] — the t0 gesture: a read-only map of the repo with NO
    # translation. Unwritten links from its own history (co-change — exact
    # statistics), identity, object candidates, fabric coverage.
    import itertools, collections

    n = int(a[0]) if a else 500
    fmt = subprocess.run(["git", "log", f"-{n}", "--format=%x40%ae %G?", "--name-only"],
                         capture_output=True, text=True).stdout
    commits, authors, signed, cur = [], collections.Counter(), 0, []
    for line in fmt.splitlines():
        if line.startswith("@"):
            if cur:
                commits.append(cur); cur = []
            email, g = (line[1:].split() + ["N"])[:2]
            authors[email] += 1
            signed += 1 if g in ("G", "U", "X", "Y") else 0
        elif line.strip():
            cur.append(line.strip())
    if cur:
        commits.append(cur)
    pair_n, file_n = collections.Counter(), collections.Counter()
    for files in commits:
        fs = list(set(files))
        for f in fs:
            file_n[f] += 1
        for x, y in itertools.combinations(sorted(fs), 2):
            pair_n[(x, y)] += 1
    links = [
        {"a": x, "b": y, "together": c, "confidence": round(c / min(file_n[x], file_n[y]), 2)}
        for (x, y), c in pair_n.most_common(30)
        if c >= 5
    ][:10]
    subjects = subprocess.run(["git", "log", f"-{n}", "--format=%s %b"], capture_output=True, text=True).stdout
    keys = collections.Counter(re.findall(r"\b[A-Z][A-Z0-9]+-\d+\b", subjects))
    world = None
    if FACTS and os.path.exists(FACTS):
        r = judge(FACTS)
        world = {"facts": FACTS, "verdict": r["verdict"], "refusals": len(r["refusals"])}
    return {
        "command": "survey",
        "commits": len(commits),
        "unwritten_links": links,
        "identity": {
            "authors": len(authors),
            "top": [f"{e} ({c})" for e, c in authors.most_common(5)],
            "signed_commits": signed,
        },
        "object_candidates": {k: c for k, c in keys.most_common(10)},
        "fabric": world or {"facts": None, "note": "no world yet: coverage 0% — the links above say where to start"},
    }


# ── the stdlib: definitions baked into the binary, fully extractable ──
# Hidden is not secret (the git model: packed away, but cat-file shows all).
# `gate stdlib` lists, `gate show <name>` prints, `gate materialize <name>`
# lands the file in the repo — from then on it is the client's, versioned by
# his git; editing it means removing the header (it becomes his file).

MATERIALIZED_MARK = "// gate stdlib"

def load_stdlib():
    # the shelf's single source: stdlib/*.swift next to the CLI. Readable,
    # editable, judged by our own judge in our own battery (self-hosted);
    # baking them into the one release binary is the Swift packaging step.
    d = os.path.join(os.path.dirname(os.path.abspath(__file__)), "stdlib")
    out = {}
    if os.path.isdir(d):
        for f in sorted(os.listdir(d)):
            if f.endswith(".swift"):
                out[f[:-6]] = open(os.path.join(d, f)).read()
    return out


STDLIB = load_stdlib()


def cmd_stdlib(a):
    if a and a[0] == "show":
        name = a[1]
        if name not in STDLIB:
            raise SystemExit(json.dumps({"error": f"no such stdlib module: {name} (gate stdlib lists them)"}))
        print(STDLIB[name])
        sys.exit(0)
    if a and a[0] == "materialize":
        name = a[1]
        if name not in STDLIB:
            raise SystemExit(json.dumps({"error": f"no such stdlib module: {name}"}))
        path = f"{name}.swift"
        with open(path, "w") as f:
            f.write(STDLIB[name])
        return {"command": "stdlib materialize", "wrote": path,
                "note": "now yours to version and import; edit it = remove the stdlib header (drift of an unedited copy is guarded by status)"}
    return {"command": "stdlib", "modules": {k: v.split("\n")[0].replace("// ", "") for k, v in STDLIB.items()},
            "note": "hidden is not secret: show prints, materialize lands the file in your repo"}


def stdlib_guards():
    # a materialized copy still carrying the stdlib header must match the
    # binary's: drifted — re-materialize, or drop the header to own the file
    if not FACTS:
        return []
    d = os.path.dirname(os.path.abspath(FACTS))
    bad = []
    for name, body in STDLIB.items():
        p = os.path.join(d, f"{name}.swift")
        if os.path.exists(p):
            text = open(p).read()
            if text.startswith(MATERIALIZED_MARK) and text != body:
                bad.append({"address": f"{name}.swift", "claim": "a materialized stdlib copy drifted from the binary's: re-materialize, or remove the header to own the file"})
    return bad


def vendored_guards():
    # .gate/ is a materialized shelf like any other: the judge it carries must
    # be the judge it says it carries. An edited copy of the tool is a second
    # truth about what judged this repository — named, not tolerated.
    if not FACTS:
        return []
    d = os.path.dirname(os.path.abspath(FACTS))
    readme = os.path.join(d, ".gate", "README.md")
    binp = os.path.join(d, ".gate", "bin", "gate-judge")
    if not (os.path.exists(readme) and os.path.exists(binp)):
        return []
    stated = re.search(r"judge sha256: ([0-9a-f]{64})", open(readme).read())
    if not stated:
        return []
    import hashlib
    with open(binp, "rb") as f:
        actual = hashlib.sha256(f.read()).hexdigest()
    if actual == stated.group(1):
        return []
    return [{"address": ".gate/README.md",
             "claim": "the carried judge is not the judge this repository states: "
                      f"sha256 {actual[:12]} against {stated.group(1)[:12]} — "
                      "re-run `gate init . --vendor`, or state the one you mean"}]


RBAC_GENRE_HEADER = """// printed by gate import rbac — the K8s access world in the domain genre
// (the exemplar: theory corpus Sources/Examples/Grants.swift @ 0fd0b38).
// Realms are namespaces plus the cluster scope. A role is a room stating its
// realm; a binding is a keeper stating its post; the gate's equality is the
// K8s invariant itself: a RoleBinding and its Role live in one namespace.
// The genre below is the stdlib module genre-grants, printed from the shelf.

"""

READS, WRITES = {"get", "list", "watch"}, {"create", "update", "patch", "delete", "deletecollection"}


def rbac_key(rules):
    verbs = {v for r in rules or [] for v in r.get("verbs", [])}
    if "*" in verbs or verbs & {"escalate", "bind", "impersonate"}:
        return "WardenKey"
    if verbs & WRITES:
        return "WriterKey"
    return "ReaderKey"


def sanitize(s):
    return re.sub(r"[^A-Za-z0-9]", "_", s)


def cmd_import_rbac(a):
    # import rbac rbac.json [-o gate.swift] — kubectl get roles,clusterroles,
    # rolebindings -A -o json | is the input. Three judged outcomes per
    # binding: ok / the Role lives in a foreign namespace (an equality refusal
    # with both names) / no such Role anywhere (dangling).
    src = a[0]
    out_path = a[a.index("-o") + 1] if "-o" in a else "rbac-gate.swift"
    items = json.load(open(src)).get("items", [])
    roles, cluster_roles, bindings = {}, {}, []
    namespaces = set()
    for it in items:
        kind, meta = it.get("kind"), it.get("metadata", {})
        ns, name = meta.get("namespace", ""), meta.get("name", "")
        if kind == "Role":
            roles[(ns, name)] = it
            namespaces.add(ns)
        elif kind == "ClusterRole":
            cluster_roles[name] = it
        elif kind == "RoleBinding":
            bindings.append(it)
            namespaces.add(ns)
    lines = [RBAC_GENRE_HEADER + STDLIB["genre-grants"]]
    srcmap = {}
    for ns in sorted(namespaces):
        lines.append(f"public enum Ns_{sanitize(ns)}: Realm {{}}")
    lines.append("public enum ClusterScope: Realm {}")
    lines.append("")
    for (ns, name) in sorted(roles):
        lines.append(f"public enum Role_{sanitize(ns)}_{sanitize(name)}: Room {{")
        lines.append(f"    public typealias Place = Ns_{sanitize(ns)}")
        lines.append("}")
    for name in sorted(cluster_roles):
        lines.append(f"public enum CR_{sanitize(name)}: Room {{")
        lines.append("    public typealias Place = ClusterScope")
        lines.append("}")
    lines.append("")
    checked = 0
    for b in bindings:
        meta = b.get("metadata", {})
        bns, bname = meta.get("namespace", ""), meta.get("name", "")
        ref = b.get("roleRef", {})
        rkind, rname = ref.get("kind"), ref.get("name", "")
        keeper = f"B_{sanitize(bns)}_{sanitize(bname)}"
        cert = f"Bind_{sanitize(bns)}_{sanitize(bname)}"
        if rkind == "ClusterRole":
            post, room = "ClusterScope", f"CR_{sanitize(rname)}"
            key = rbac_key(cluster_roles.get(rname, {}).get("rules"))
            what = f"rolebinding {bns}/{bname} -> clusterrole {rname}"
        else:
            post = f"Ns_{sanitize(bns)}"
            key = rbac_key(roles.get((bns, rname), {}).get("rules"))
            if (bns, rname) in roles:
                room = f"Role_{sanitize(bns)}_{sanitize(rname)}"
            else:
                foreign = sorted(ns for (ns, n) in roles if n == rname)
                room = f"Role_{sanitize(foreign[0])}_{sanitize(rname)}" if foreign else f"Role_{sanitize(bns)}_{sanitize(rname)}"
            what = f"rolebinding {bns}/{bname} -> role {rname}"
        lines.append(f"public enum {keeper}: Keeper {{")
        lines.append(f"    public typealias Post = {post}")
        lines.append(f"    public typealias Key = {key}")
        lines.append("}")
        lines.append(f"public typealias {cert} = Enter<{keeper}, {room}>")
        srcmap[cert] = what
        checked += 1
    world = "\n".join(lines) + "\n"
    with open(out_path, "w") as f:
        f.write(world)
    t0 = time.time()
    outp = subprocess.run([JUDGE, "judge", "where", out_path], capture_output=True, text=True).stdout
    ms = round((time.time() - t0) * 1000, 1)
    refusals = []
    for m in re.finditer(r"^✗ '(\w+)[^']*' requires the types '[^']*' \(aka '([^']+)'\) and '[^']*' \(aka '([^']+)'\) be equivalent", outp, re.M):
        cert, left, right = m.groups()
        if cert not in srcmap:
            continue
        dangling = re.match(r"(\w+)\.Place$", right)
        claim = (f"roleRef names a Role that exists nowhere ({right} undeclared)"
                 if dangling else f"the binding lives in {left}, its Role lives in {right}: a RoleBinding and its Role must share one namespace")
        refusals.append({"certificate": cert, "source": srcmap[cert], "claim": claim})
    canon = "canon v2" in outp
    return {
        "command": "import rbac",
        "world": out_path,
        "namespaces": len(namespaces),
        "roles": len(roles),
        "cluster_roles": len(cluster_roles),
        "bindings_judged": checked,
        "verdict": "refused" if refusals else "holds",
        "refusals": refusals,
        "judge_ms": ms,
        "canon_handshake": canon,
        "note": "tier one (verb class, Who.Key: Writes) is the compiler's: judged when the world is built as Swift; this run holds the posting equalities (agnostic where-judge)",
    }


CODEOWNERS_HEADER = """// printed by gate import codeowners — who owns what in this repository,
// written in the access crystal (`gate stdlib show genre-grants`). A zone is
// a top of the tree, a room is a pattern, and an owner keeps a zone: owning
// is entry at the warden's threshold, judged like any other claim.
//
"""


def codeowners_zone(pattern):
    # the zone a pattern belongs to: its first real segment, or the root
    p = pattern.strip().lstrip("/")
    if not p or p.startswith("*"):
        return "Root"
    return sanitize(p.split("/")[0]) or "Root"


def read_codeowners(path):
    # every rule, with the line it stands on: an address in THEIR file
    rules = []
    for n, raw in enumerate(open(path), 1):
        line = raw.split("#")[0].strip()
        if not line:
            continue
        parts = line.split()
        owners = [p for p in parts[1:] if p.startswith("@") or "@" in p]
        if owners:
            rules.append({"line": n, "pattern": parts[0], "owners": owners})
    return rules


def cmd_import_codeowners(a):
    # import codeowners CODEOWNERS [--tree DIR] [-o out.swift] — a repository's
    # own ownership, as a judged world. What CODEOWNERS cannot say, this can:
    # an owner nobody declares is refused, and a pattern matching no file in
    # the tree is named by the line it sits on.
    src = a[0]
    out_path = a[a.index("-o") + 1] if "-o" in a else "codeowners-gate.swift"
    tree = a[a.index("--tree") + 1] if "--tree" in a else None
    # WHO MAY OWN WHAT is the thing CODEOWNERS cannot say: without it, every
    # rule is its own authority and the gate has nothing to hold. A policy —
    # owner,zone — makes each rule a claim against a stated zone, and a rule
    # reaching outside it is refused by the line it sits on.
    import csv as _csv
    policy = {}
    if "--policy" in a:
        for row in _csv.DictReader(open(a[a.index("--policy") + 1])):
            policy.setdefault(row["owner"].lstrip("@"), row["zone"])
    rules = read_codeowners(src)
    zones = sorted({codeowners_zone(r["pattern"]) for r in rules})
    lines = [CODEOWNERS_HEADER + STDLIB["genre-grants"], ""]
    for z in sorted(set(zones) | {sanitize(v) for v in policy.values()}):
        lines.append(f"public enum Zone_{z}: Realm {{}}")
    lines.append("")
    keepers, srcmap = {}, {}
    for i, r in enumerate(rules):
        zone = codeowners_zone(r["pattern"])
        room = f"Path_{i}_{sanitize(r['pattern'])[:40]}"
        lines.append(f"public enum {room}: Room {{")
        lines.append(f"    public typealias Place = Zone_{zone}")
        lines.append("}")
        for owner in r["owners"]:
            plain = owner.lstrip("@")
            kept = policy.get(plain)          # the zone this owner may keep
            keeper = (f"Owner_{sanitize(plain)}" if kept
                      else f"Owner_{sanitize(plain)}_in_{zone}")
            if keeper not in keepers:
                keepers[keeper] = (owner, kept or zone)
                lines.append(f"public enum {keeper}: Keeper {{")
                lines.append(f"    public typealias Post = Zone_{sanitize(kept) if kept else zone}")
                lines.append("    public typealias Key = WardenKey")
                lines.append("}")
            cert = f"Owns_{i}_{sanitize(owner.lstrip('@'))}"
            lines.append(f"public typealias {cert} = Owns<{keeper}, {room}>")
            srcmap[cert] = f"{os.path.basename(src)}:{r['line']} · {r['pattern']} {owner}"
    world = "\n".join(lines) + "\n"
    with open(out_path, "w") as f:
        f.write(world)
    t0 = time.time()
    outp = subprocess.run([JUDGE, "judge", "where", out_path], capture_output=True, text=True).stdout
    ms = round((time.time() - t0) * 1000, 1)
    refusals = []
    for m in re.finditer(r"^✗ '(\w+)[^']*' requires the types '[^']*' \(aka '([^']+)'\) and '[^']*' \(aka '([^']+)'\) be equivalent", outp, re.M):
        cert, left, right = m.groups()
        if cert in srcmap:
            refusals.append({"certificate": cert, "source": srcmap[cert],
                             "claim": f"the owner keeps {left}, the path lives in {right}: an owner and the path they own must share one zone"})
    # a pattern matching no file in the tree: CODEOWNERS says it, the tree does not
    ghosts = []
    if tree:
        import fnmatch
        paths = []
        for root, dirs, files in os.walk(tree):
            dirs[:] = [d for d in dirs if d != ".git"]
            for f in files:
                paths.append(os.path.relpath(os.path.join(root, f), tree))
        for r in rules:
            pat = r["pattern"].strip("/")
            hit = any(fnmatch.fnmatch(p, pat) or fnmatch.fnmatch(p, pat + "/*")
                      or p.startswith(pat + "/") or fnmatch.fnmatch(os.path.basename(p), pat)
                      for p in paths)
            if not hit:
                ghosts.append({"address": f"{os.path.basename(src)}:{r['line']}",
                               "claim": f"a ghost path: CODEOWNERS names `{r['pattern']}`, and the tree has no such file"})
    return {
        "command": "import codeowners",
        "world": out_path,
        "zones": len(zones),
        "paths": len(rules),
        "owners": len(keepers),
        "policy": (f"{len(policy)} owners have a stated zone" if policy else None),
        "verdict": "refused" if (refusals or ghosts) else "holds",
        "refusals": refusals + ghosts,
        "judge_ms": ms,
        "canon_handshake": "canon v2" in outp,
        "note": ("ownership is the warden's threshold: the compiler holds the key's class "
                 "when the world is built as Swift, and this run holds the zone equalities"
                 if policy else
                 "no ownership policy given (--policy owner,zone): every rule is its own "
                 "authority, so the equalities hold trivially. The ghost paths above are "
                 "read from the tree, not judged."),
    }


def repo_findings(n=400):
    # What is true of THIS repository, said in sentences a person can act on.
    # This is the one producer behind `gate findings`, the survey, the audit
    # page and the text of an issue: read the clone, name what is worth
    # naming, and mark plainly which of it the judge checked and which was
    # only read. Nothing here needs a translated world — a repository that
    # has never heard of gate still has findings.
    out = []
    j = repo_journal(n)
    commits = j["commits"]
    base = os.path.dirname(os.path.abspath(FACTS)) if FACTS else "."

    if not commits:
        return out
    authors = {}
    for c in commits:
        authors.setdefault(c["email"], []).append(c)

    # what the world says, if there is one: refusals are findings of the first order
    if FACTS and os.path.exists(FACTS):
        r = dispatch("status", [])
        for ref in r.get("refusals", []):
            out.append({"kind": "judged", "subject": ref["address"],
                        "sentence": f"{ref['address']} — {ref['claim']}",
                        "evidence": "the judge, on this working copy"})

    # who touches the facts, and whether anything checked those edits
    world = set(j.get("world_files") or [])
    if world:
        touchers = {c["email"] for c in commits if c["touches_world"]}
        edits = sum(1 for c in commits if c["touches_world"])
        ci = os.path.isdir(os.path.join(base, ".github", "workflows"))
        hooked = subprocess.run(["git", "config", "--get", "core.hooksPath"], cwd=base,
                                capture_output=True, text=True).stdout.strip()
        if edits and not (ci or hooked):
            out.append({"kind": "observed", "subject": "unchecked edits",
                        "sentence": f"{len(touchers)} people changed these facts across "
                                    f"{edits} commits, and nothing checked those edits: "
                                    "there is no hook and no workflow in this repository.",
                        "evidence": f"git log over {', '.join(sorted(world))}"})
        unnamed = sorted({c["email"] for c in commits if c["touches_world"] and not c["person"]})
        if unnamed:
            out.append({"kind": "observed", "subject": "unnamed authors",
                        "sentence": f"{len(unnamed)} of the people who changed these facts are "
                                    "not tied to anyone in the world: an email is not a person "
                                    "until something says it is.",
                        "evidence": ", ".join(unnamed[:4])})

    # ownership, if this repository states any: a stale owner is worth a sentence
    co = os.path.join(base, "CODEOWNERS")
    for cand in (co, os.path.join(base, ".github", "CODEOWNERS"),
                 os.path.join(base, "docs", "CODEOWNERS")):
        if os.path.exists(cand):
            rules = read_codeowners(cand)
            owners = {o.lstrip("@") for r_ in rules for o in r_["owners"]}
            seen = {c["email"].split("@")[0] for c in commits} | {
                (c["person"] or "").lower() for c in commits}
            quiet = sorted(o for o in owners if "/" not in o and o.lower() not in seen)
            # a history too short to be evidence proves nothing about anyone
            if quiet and len(commits) >= 50:
                out.append({"kind": "observed", "subject": "quiet owners",
                            "sentence": f"{len(quiet)} of the {len(owners)} owners named in "
                                        f"CODEOWNERS have not appeared in the last "
                                        f"{len(commits)} commits: ownership outlives people, "
                                        "and nothing here notices.",
                            "evidence": ", ".join("@" + q for q in quiet[:4])})
            out.append({"kind": "offer", "subject": "CODEOWNERS",
                        "sentence": f"CODEOWNERS states {len(rules)} rules over "
                                    f"{len(owners)} owners, and no tool checks them. "
                                    "`gate import codeowners` reads them as a world: a path "
                                    "no file matches, or an owner outside their zone, is "
                                    "named by the line it sits on.",
                        "evidence": os.path.relpath(cand, base)})
            break

    # the shape of the work, from the history itself
    top = sorted(authors.items(), key=lambda kv: -len(kv[1]))[:1]
    if top and len(commits) >= 20:
        who, cs = top[0]
        share = round(100 * len(cs) / len(commits))
        if share >= 50:
            out.append({"kind": "observed", "subject": "concentration",
                        "sentence": f"{share}% of the last {len(commits)} commits are one "
                                    f"person's ({who}): what they know is not written down "
                                    "anywhere this repository can check.",
                        "evidence": f"{len(cs)} of {len(commits)} commits"})
    return out


def cmd_findings(a):
    # findings [--md] [N] — what is true of this repository, in sentences.
    nums = [x for x in a if x.isdigit()]
    found = repo_findings(int(nums[0]) if nums else 400)
    return {"command": "findings", "findings": found,
            "judged": sum(1 for f in found if f["kind"] == "judged"),
            "observed": sum(1 for f in found if f["kind"] != "judged"),
            "markdown": findings_markdown(found) if "--md" in a else None,
            "mutates": False}


def findings_markdown(found):
    # the same findings as a note somebody could read in an issue: what was
    # checked, what was only read, and how to see it for yourself.
    if not found:
        return "Nothing to report: this repository states no facts gate can read yet.\n"
    lines = ["### What this repository says about itself", ""]
    for f in found:
        mark = "**checked**" if f["kind"] == "judged" else ("**offer**" if f["kind"] == "offer" else "read")
        lines.append(f"- {f['sentence']}  \n  <sub>{mark} · {f['evidence']}</sub>")
    lines += ["", "Everything marked *read* comes from the git history and is not a verdict.",
              "To see it yourself: `gate findings` in a clone — nothing leaves the machine.", ""]
    return "\n".join(lines)


def cmd_init(a):
    vendor = "--vendor" in a
    a = [x for x in a if x != "--vendor"]
    root = a[0] if a else "world"
    made = []
    for rel, content in INIT_FILES.items():
        p = os.path.join(root, rel)
        os.makedirs(os.path.dirname(p), exist_ok=True)
        if not os.path.exists(p):
            with open(p, "w") as f:
                f.write(content)
            made.append(rel)
    hook = os.path.join(root, ".githooks", "pre-commit")
    if os.path.exists(hook):
        os.chmod(hook, 0o755)
    vendored = cmd_vendor(root) if vendor else None
    hooks_note, undo, prior = None, None, None
    if os.path.isdir(os.path.join(root, ".git")):  # seamless: the hook wires itself
        prior = subprocess.run(["git", "config", "--local", "core.hooksPath"], cwd=root,
                               capture_output=True, text=True).stdout.strip() or None
        subprocess.run(["git", "config", "core.hooksPath", ".githooks"], cwd=root, capture_output=True)
        hooks_note = "pre-commit hook wired (core.hooksPath = .githooks)"
        # this is somebody else's repository: say what moved and how to put it back
        undo = (f"git config core.hooksPath {prior}" if prior
                else "git config --unset core.hooksPath")
        if prior:
            hooks_note += f" — it was {prior}"
    return {"command": "init", "root": root, "created": made, "hooks": hooks_note,
            "undo_hooks": undo, "changed_git_config": bool(hooks_note), "vendored": vendored}


def world_rows(text):
    people = []
    for m in re.finditer(r"public enum (\w+): Employee, Person \{(.*?)\n\}", text, re.S):
        f = dict(re.findall(r"public typealias (\w+) = ([\w.]+)", m.group(2)))
        people.append({"id": m.group(1), **{k.lower(): v for k, v in f.items() if k != "Sex"}})
    grants = [{"who": w, "doc": d} for w, d in re.findall(r"VerifiedView<\s*(\w+),\s*(\w+)\s*>\.self;", text)]
    return people, grants


def cmd_report(a):
    # report [-o report.html] — the printable audit page: the world's tables
    # + the verdict. No server: one self-contained html, mailable to an audit.
    out_path = a[a.index("-o") + 1] if "-o" in a else "report.html"
    text = open(FACTS).read()
    people, grants = world_rows(text)
    r = judge(FACTS)
    bad_lines = {ref["claim"] for ref in r["refusals"]}

    def table(rows, cols):
        head = "".join(f"<th>{c}</th>" for c in cols)
        body = "".join(
            "<tr>" + "".join(f"<td>{row.get(c, '')}</td>" for c in cols) + "</tr>"
            for row in rows
        )
        return f"<table><tr>{head}</tr>{body}</table>"

    verdict_html = (
        "<p class='ok'>holds: every claim checked</p>"
        if r["verdict"] == "holds"
        else "<ul class='bad'>"
        + "".join(f"<li><code>{ref['address']}</code> · {ref['claim']}</li>" for ref in r["refusals"])
        + "</ul>"
    )
    # who may do what, and when that last changed: an audit asks for both, and
    # git already answers the second — the policy's own history, from the journal
    ids, rules, where = read_policy()
    policy_html = ""
    if ids or rules:
        rows = ([{"what": f"{action} requires", "who": rank} for action, rank in sorted(rules.items())]
                + [{"what": mail, "who": person} for mail, person in sorted(ids.items())])
        j = repo_journal(50)
        pf = os.path.basename(policy_path() or "")
        changes = [c for c in j["commits"] if pf and pf in c["files"]]
        hist = "".join(
            f"<li><code>{c['short']}</code> {c['when'][:10]} · {c['person'] or c['email']} · {c['subject']}</li>"
            for c in changes[:10])
        policy_html = ("<h2>Policy</h2>" + table(rows, ["what", "who"])
                       + ("<p>Last changed:</p><ul>" + hist + "</ul>" if hist
                          else "<p>Stated, and unchanged in the last 50 commits.</p>"))

    found = repo_findings(200)
    findings_html = ""
    if found:
        items = "".join(
            f"<li>{f['sentence']}<br><small>{'checked by the judge' if f['kind'] == 'judged' else 'read from git history, not a verdict'} · {f['evidence']}</small></li>"
            for f in found)
        findings_html = f"<h2>Findings</h2><ul class='findings'>{items}</ul>"

    html = f"""<!-- printed by gate report; the table is read from the world, never stored -->
<meta charset="utf-8"><title>gate report</title>
<style>
body{{font:14px/1.5 -apple-system,sans-serif;max-width:60em;margin:2em auto;padding:0 1em;color:#1d1d1f}}
table{{border-collapse:collapse;margin:1em 0}}td,th{{border:1px solid #d2d2d7;padding:.3em .8em;text-align:left}}
th{{background:#f5f5f7}}.ok{{color:#248a3d}}.bad li{{color:#c4453b;margin:.3em 0}}code{{background:#f5f5f7;padding:0 .3em}}
.findings li{{margin:.6em 0}}.findings small{{color:#8e8e93}}
</style>
<h1>gate report</h1>
<p>{len(people)} people · {len(grants)} grants · judged in {r['judge_ms']} ms</p>
<h2>Verdict</h2>{verdict_html}
<h2>People</h2>{table(people, ["id", "rank", "home", "site", "given", "family", "born"])}
<h2>Grants</h2>{table(grants, ["who", "doc"])}
{policy_html}
{findings_html}
"""
    with open(out_path, "w") as f:
        f.write(html)
    return {"command": "report", "wrote": out_path, "people": len(people), "grants": len(grants), **{k: r[k] for k in ("verdict", "judge_ms")}, "refusals": r["refusals"]}


def cmd_serve(a):
    # serve [port] [--no-open] — the bench, and the local JSON surface it reads.
    # THE CONTRACT (the bench depends on exactly this, and nothing else):
    #   GET  /  and /ui              the bench itself
    #   GET  /files                  {files: [name], personal: name|null}
    #   GET  /world?f=name           the text of one file from that list
    #   GET  /gitstatus?f=name       {git: committed|modified|untracked}
    #   GET  /log?n=&scope=          the journal (scope: world|all) — observed
    #   GET  /show?hash=&f=          one commit, read as the facts it changed
    #   GET  /status                 the verdict, as the CLI gives it
    #   GET  /check/view?who=&doc=   a question, answered by a verdict
    #   GET  /diff/transfer?who=&to= what would break (changes nothing)
    #   POST /verdict?f=name         judge the whole list with this file's
    #                                unsaved text in place of its own
    #   PUT  /world?f=name           write one file (the bench writes only
    #                                when the judge holds)
    # Loopback only, no caching, and no route reaches outside the repository.
    from http.server import BaseHTTPRequestHandler, HTTPServer
    from urllib.parse import urlparse, parse_qs

    nums = [x for x in a if x.isdigit()]
    port = int(nums[0]) if nums else 4744
    if FACTS:
        personal_file(create=True)  # first run: your own world, in your own git
    open_it = "--no-open" not in a

    here = os.path.dirname(os.path.abspath(__file__))
    playground = os.path.dirname(os.path.dirname(here))  # typed-playground root

    class H(BaseHTTPRequestHandler):
        def send_file(self, path, ctype):
            with open(path, "rb") as f:
                body = f.read()
            self.send_response(200)
            self.send_header("Content-Type", ctype)
            # never cached: an updated gate must not be hidden behind a bench
            # (or a judge) the browser kept from the last version
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

        def do_GET(self):
            u = urlparse(self.path)
            q = {k: v[0] for k, v in parse_qs(u.query).items()}
            try:
                if u.path in ("/", "/ui"):
                    return self.send_file(os.path.join(here, "ui.html"), "text/html; charset=utf-8")
                if u.path == "/judge.js":
                    return self.send_file(os.path.join(here, "judge.js"), "text/javascript")
                if u.path == "/codemirror.js":
                    return self.send_file(os.path.join(here, "codemirror.js"), "text/javascript")
                if u.path == "/codemirror.css":
                    return self.send_file(os.path.join(here, "codemirror.css"), "text/css")
                if u.path == "/files":
                    names = [n for n, _ in bench_files()]
                    pf = personal_file()
                    body = json.dumps({"files": names,
                                       "personal": names[-1] if pf else None}).encode()
                    self.send_response(200)
                    self.send_header("Content-Type", "application/json")
                    self.send_header("Cache-Control", "no-store")
                    self.end_headers()
                    self.wfile.write(body)
                    return
                if u.path == "/world":
                    # the UI obeys the declared layout: ?f= names a file FROM the list
                    p = self.pick(q)
                    if not p:
                        return self.no_world()
                    return self.send_file(p, "text/plain; charset=utf-8")
                if u.path == "/gitstatus" and not FACTS:
                    return self.no_world()
                if u.path == "/gitstatus":
                    # the honest state: a write lands in the working copy; git
                    # carries the history. This says whether the file is
                    # committed or has uncommitted changes — never our own save.
                    base = os.path.dirname(os.path.abspath(FACTS))
                    p = self.pick(q)
                    st = subprocess.run(["git", "status", "--porcelain", "--", p], cwd=base, capture_output=True, text=True)
                    tracked = subprocess.run(["git", "ls-files", "--error-unmatch", p], cwd=base, capture_output=True)
                    state = ("untracked" if tracked.returncode else
                             ("modified" if st.stdout.strip() else "committed"))
                    body = json.dumps({"file": os.path.relpath(p, base), "git": state}).encode()
                    self.send_response(200)
                    self.send_header("Content-Type", "application/json")
                    self.send_header("Cache-Control", "no-store")
                    self.end_headers()
                    self.wfile.write(body)
                    return
                if u.path == "/log":
                    out = repo_journal(int(q.get("n", 200)), q.get("scope", "world"))
                elif u.path == "/show":
                    out = commit_change(q.get("hash", ""), q.get("f") or None)
                elif u.path == "/status":
                    out = dispatch("status", [])
                elif u.path == "/check/view":
                    out = cmd_ask([q["who"], q["doc"]])
                elif u.path == "/diff/transfer":
                    out = cmd_change(["transfer", q["who"], q["to"]])
                else:
                    self.send_response(404); self.end_headers(); return
            except SystemExit as e:
                out = {"error": str(e)}
            body = json.dumps(out, ensure_ascii=False).encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

        def pick(self, q):
            # only the judged list is servable or writable: the manifest's files
            # plus your personal world
            return dict(bench_files()).get(q.get("f", ""), FACTS)

        def no_world(self):
            self.send_response(404)
            self.send_header("Cache-Control", "no-store")
            self.end_headers()

        def do_PUT(self):
            # the single writing handle: world files — they ARE the source
            # (plumbing stays open, judgement stays inevitable)
            u = urlparse(self.path)
            q = {k: v[0] for k, v in parse_qs(u.query).items()}
            if u.path != "/world":
                self.send_response(404); self.end_headers(); return
            n = int(self.headers.get("Content-Length", 0))
            with open(self.pick(q), "wb") as f:
                f.write(self.rfile.read(n))
            self.send_response(200); self.end_headers()

        def do_POST(self):
            # /verdict?f=rel — judge the WHOLE declared list with the active
            # file replaced by the editor's unsaved text (cross-file, server-side)
            u = urlparse(self.path)
            q = {k: v[0] for k, v in parse_qs(u.query).items()}
            if u.path != "/verdict":
                self.send_response(404); self.end_headers(); return
            n = int(self.headers.get("Content-Length", 0))
            text = self.rfile.read(n).decode()
            base = os.path.dirname(os.path.abspath(FACTS))
            active = self.pick(q)
            d = tempfile.mkdtemp(prefix="gate-bench-")
            paths = []
            for name, p in bench_files():
                tp = os.path.join(d, name.replace(os.sep, "__"))
                with open(tp, "w") as f:
                    f.write(text if p == active else open(p).read())
                paths.append(tp)
            raw = subprocess.run([JUDGE, "judge", *paths], capture_output=True, text=True).stdout
            refusals = [{"address": m.group(1).replace("__", "/"), "claim": m.group(2).strip()}
                        for m in re.finditer(r"^\s+(\S+\.swift:\d+)\s+(.+)$", raw, re.M)]
            # refine each address to the line of its subject, per file (the same
            # move the CLI makes — the judge pins to the previous drain's line)
            by_file = {}
            for ref in refusals:
                fname = ref["address"].split(":")[0]
                by_file.setdefault(fname, []).append(ref)
            byname = dict(bench_files())
            sources = [(n, text if p == active else (open(p).read() if os.path.exists(p) else ""))
                       for n, p in bench_files()]
            if len(sources) > 1:
                refusals = attribute_refusals(refusals, sources)
            else:
                for fname, group in by_file.items():
                    real = byname.get(fname, os.path.join(base, fname))
                    src = text if real == active else (open(real).read() if os.path.exists(real) else "")
                    refine_addresses(src, group, fname)
            times = re.findall(r"([\d.]+) ms", raw)
            body = json.dumps({"verdict": "holds" if not refusals else "refused",
                               "refusals": refusals,
                               "judge_ms": float(times[-1]) if times else None}).encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

        def log_message(self, *args):
            pass

    print(json.dumps({"command": "serve", "url": f"http://127.0.0.1:{port}", "routes": ["/status", "/log", "/show?hash=&f=", "/check/view?who=&doc=", "/diff/transfer?who=&to="], "mutating_routes": "none, by design"}))
    sys.stdout.flush()
    if open_it:   # the bench is the point of serve; the loopback, never a network
        try:
            import webbrowser, threading
            threading.Timer(0.4, webbrowser.open, [f"http://127.0.0.1:{port}/ui"]).start()
        except Exception:
            pass
    HTTPServer(("127.0.0.1", port), H).serve_forever()


USAGE = """usage (the git-shaped porcelain):
  gate init [dir]                     · gate status | fsck
  gate check view WHO DOC             · gate check administer|delete WHO DOC
  gate diff  transfer WHO DEPT        · gate diff  grant|revoke WHO DOC
  gate diff  hire ID RANK HOME GIVEN FAMILY BORN SITE
  gate apply transfer|grant|revoke|hire ...   (writes only on holds, like a commit)
  gate import people.csv grants.csv [-o gate.swift]
  gate export gate.swift -o people.csv grants.csv
  gate verify people.csv grants.csv --against CMD
  gate serve [port]                   (local read-only JSON surface)
  gate report [-o report.html]        (printable audit page)
  gate guard [merge]                  (repo policy by the same gates: HEAD author
                                       via tables/identities.csv must hold the
                                       rank stated in tables/guard.csv)
  gate library [-o lib.json]          (the domain crystal: forms, axes, seed coverage)
  gate library diff a.json b.json     (set operations between crystals; forms, never facts)
  gate survey [N]                     (t0, read-only: unwritten links from your own
                                       history, identity, object candidates, fabric)
(ask = check, change = diff/apply: old names stay as aliases)"""


def dispatch(cmd, rest):
    if cmd in ("check", "ask", "diff", "apply", "change", "status", "fsck", "report"):
        ensure_world()
    if cmd in ("check", "ask") and rest[0] == "view":
        return cmd_ask(rest[1:])
    if cmd in ("check", "ask") and rest[0] in ("administer", "delete"):
        return cmd_ask_build(rest[0], rest[1:])
    if cmd == "diff":
        return cmd_change([x for x in rest if x != "--apply"])
    if cmd == "apply":
        return cmd_change(rest + ["--apply"])
    if cmd == "change":
        return cmd_change(rest)
    if cmd == "import" and rest and rest[0] == "codeowners":
        return cmd_import_codeowners(rest[1:])
    if cmd == "import" and rest and rest[0] == "rbac":
        return cmd_import_rbac(rest[1:])
    if cmd == "import":
        return cmd_import(rest)
    if cmd == "export":
        return cmd_export(rest)
    if cmd == "verify":
        return cmd_verify(rest)
    if cmd == "init":
        return cmd_init(rest)
    if cmd in ("status", "fsck"):
        files = world_files()
        if not files:
            # no world here — but this IS a git repository, and the journal
            # reads one of those with no translation at all. Offer the rung
            # the reader is standing on, not the whole ladder.
            inside = subprocess.run(["git", "rev-parse", "--is-inside-work-tree"],
                                    capture_output=True, text=True).stdout.strip() == "true"
            return {"command": "status", "verdict": "no world here", "refusals": [],
                    "next": ("gate log — read this repository's own history, nothing to translate"
                             if inside else "gate init . — start a world in this folder"),
                    "then": "drop your CSVs into tables/ and run gate status again, or gate demo to see one",
                    "mutates": False}
        # what disagrees right now: judgement over the declared file list +
        # layout guards + world metrics (counted, never remembered)
        t0 = time.time()
        raw = subprocess.run([JUDGE, "judge", *files], capture_output=True, text=True).stdout
        wall_ms = round((time.time() - t0) * 1000, 1)
        refusals = [{"address": m.group(1), "claim": m.group(2).strip()}
                    for m in re.finditer(r"^\s+(\S+\.swift:\d+)\s+(.+)$", raw, re.M)]
        if len(files) > 1:  # one claim, one file: the one that makes it
            refusals = attribute_refusals(refusals, [(os.path.basename(p), open(p).read()) for p in files])
        refusals += manifest_guards()
        refusals += policy_guards()
        refusals += stdlib_guards()
        refusals += vendored_guards()
        times = re.findall(r"([\d.]+) ms", raw)
        out = {"command": "status", "facts": files if len(files) > 1 else FACTS,
               "verdict": "holds" if not refusals else "refused", "refusals": refusals,
               "judge_ms": float(times[-1]) if times else None, "wall_ms": wall_ms, "mutates": False}
        m = re.search(r"(\d+) declarations · (\d+) lookups · (\d+) premises", raw)
        if m:
            out["world"] = {"declarations": int(m.group(1)), "lookups": int(m.group(2)), "premises": int(m.group(3))}
        out["next"] = next_rung(bool(refusals))
        return out
    if cmd == "guard" and rest and rest[0] == "deps":
        return cmd_guard_deps(rest[1:])
    if cmd == "guard":
        ensure_world()
        return cmd_guard(rest)
    if cmd == "library":
        ensure_world()
        return cmd_library(rest)
    if cmd == "survey":
        return cmd_survey(rest)
    if cmd == "demo":
        return cmd_demo(rest)
    if cmd == "my":
        # my — your personal world: where it is, and its verdict WITH the shared
        # world (the claims you keep, judged against facts other people own)
        p = personal_file(create=True)
        if not p:
            raise SystemExit(json.dumps({"error": "no world here: cd into a repo with gate.swift"}))
        named = bench_files()
        raw = subprocess.run([JUDGE, "judge", *[q for _, q in named]], capture_output=True, text=True).stdout
        refusals = [{"address": m.group(1), "claim": m.group(2).strip()}
                    for m in re.finditer(r"^\s+(\S+\.swift:\d+)\s+(.+)$", raw, re.M)]
        refusals = attribute_refusals(refusals, [(n, open(p).read()) for n, p in named])
        return {"command": "my", "personal": p, "repo_key": repo_key(),
                "shared_repo_untouched": True,
                "verdict": "holds" if not refusals else "refused", "refusals": refusals}
    if cmd == "findings":
        return cmd_findings(rest)
    if cmd == "log":
        # gate log [N] — the world's history; gate log all [N] — the repository's
        scope = "all" if rest and rest[0] in ("all", "--all") else "world"
        nums = [x for x in rest if x.isdigit()]
        return repo_journal(int(nums[0]) if nums else 200, scope)
    if cmd == "stdlib":
        return cmd_stdlib(rest)
    raise SystemExit(USAGE)


def is_red(out):
    return out.get("verdict") == "refused" or bool(out.get("translation_holes")) or out.get("base", "").startswith("dirty")


def humanize(out):
    # humans get lines, machines get --json (git's porcelain pattern)
    lines = []
    cmd = out.get("command", "")
    if out.get("verdict") == "no world here":
        lines.append("status: no world here")
        lines.append(f"  next: {out['next']}")
        lines.append(f"  then: {out['then']}")
        return "\n".join(lines)
    if "verdict" in out:
        head = "holds" if out["verdict"] == "holds" else f"refused {len(out.get('refusals', []))}"
        tail = []
        if isinstance(out.get("world"), dict):
            w = out["world"]
            tail.append(f"{w['declarations']} declarations · {w['lookups']} lookups · {w['premises']} premises")
        if out.get("judge_ms") is not None:
            tail.append(f"{out['judge_ms']} ms")
        if out.get("build_s") is not None:
            tail.append(f"build {out['build_s']} s")
        if cmd.startswith("change") and not out.get("dry_run", True):
            tail.append("applied" if out.get("applied") else "NOT applied")
        elif cmd.startswith("change"):
            tail.append("dry-run")
        lines.append(f"{cmd or 'verdict'}: {head}" + (" · " + " · ".join(tail) if tail else ""))
        for r in out.get("refusals", []):
            src = f"  ({r['source']})" if r.get("source") else ""
            # an address, or the certificate that carries one: an importer names
            # the claim, the source line names where it came from
            where = r.get("address") or r.get("certificate") or "?"
            lines.append(f"  {where} · {r['claim']}{src}")
        for s in out.get("compiler_says", []):
            lines.append(f"  compiler: {s}")
        if out.get("note"):
            lines.append(f"  note: {out['note']}")
        if out.get("next"):
            lines.append(f"  next: {out['next']}")
    elif "seeds" in out:
        lines.append(f"verify: {out['translation_holes']} hole(s)")
        for s in out["seeds"]:
            lines.append(f"  {s['seed']:22} world={s['world']:8} legacy={s['legacy']:8} → {s['reading']}")
    elif out.get("base", "").startswith("dirty"):
        lines.append("verify: base dirty — fix these before seeding")
        for w in out.get("world_says", []):
            lines.append(f"  world:  {w}")
        for l in out.get("legacy_says", []):
            lines.append(f"  legacy: {l}")
    elif cmd == "demo":
        lines.append(f"demo: a world in {out['root']}")
        lines.append(f"  next: {out['next']}")
        for t in out["try"]:
            lines.append(f"    {t}")
    elif cmd == "init":
        lines.append(f"init: {out['root']}" + (f" · created {len(out['created'])} files" if out["created"] else " · already there"))
        if out.get("hooks"):
            lines.append(f"  {out['hooks']}")
        if out.get("undo_hooks"):
            lines.append(f"  to undo that one git setting: {out['undo_hooks']}")
        if out.get("vendored"):
            v = out["vendored"]
            lines.append(f"  gate now travels with this repository: .gate/ + {v['shim']}")
            lines.append("  commit it, and every clone has the tool — nothing to install")
            if v.get("judge_sha256"):
                lines.append(f"  judge sha256: {v['judge_sha256'][:16]}…")
    elif cmd == "export":
        lines.append(f"export: {out['people']} people, {out['grants']} grants → {', '.join(out['wrote'])}")
    elif cmd == "log":
        d = out.get("default_branch") or "?"
        what = ("the world's history" if out.get("scope") == "world" and out.get("world_files")
                else "the repository")
        lines.append(f"log: {len(out['commits'])} commits · {what} · observed, not judged · closed = reachable from {d}")
        for c in out["commits"]:
            st = "?" if c["closed"] is None else ("closed" if c["closed"] else "open")
            who = c["person"] or c["email"]
            star = " *" if c["touches_world"] else ""
            lines.append(f"  {c['short']} {st:6} {c['when'][:10]} {who:20} {c['subject']}{star}")
    elif cmd == "findings":
        f = out["findings"]
        if not f:
            lines.append("findings: nothing to report yet")
        else:
            lines.append(f"findings: {len(f)} · {out['judged']} checked by the judge, "
                         f"{out['observed']} read from git")
            for x in f:
                tag = "checked" if x["kind"] == "judged" else ("offer  " if x["kind"] == "offer" else "read   ")
                lines.append(f"  [{tag}] {x['sentence']}")
                lines.append(f"           {x['evidence']}")
        if out.get("markdown"):
            lines.append("")
            lines.append(out["markdown"])
    elif cmd == "survey":
        lines.append(f"survey: {out['commits']} commits, read-only")
        lines.append("  unwritten links (co-change from your own history):")
        for l in out["unwritten_links"]:
            lines.append(f"    {l['together']:3d}x {l['confidence']:4.0%}  {l['a']} <-> {l['b']}")
        i = out["identity"]
        lines.append(f"  identity: {i['authors']} author(s), {i['signed_commits']} signed commits")
        for t in i["top"]:
            lines.append(f"    {t}")
        if out["object_candidates"]:
            lines.append("  object candidates in commit messages: " + ", ".join(f"{k}({c})" for k, c in out["object_candidates"].items()))
        f = out["fabric"]
        lines.append(f"  fabric: {f.get('facts') or 'no world yet'} · " + (f"{f['verdict']}, {f['refusals']} refusal(s)" if f.get("verdict") else f.get("note", "")))
    else:
        return json.dumps(out, ensure_ascii=False, indent=2)
    return "\n".join(lines)


VERSION = "0.1.0"


def judge_version():
    # the judge has no version flag; its identity is its bytes, which is also
    # what the README asks a reviewer to reproduce from the public corpus
    import hashlib
    try:
        with open(JUDGE, "rb") as f:
            return "sha256:" + hashlib.sha256(f.read()).hexdigest()[:12]
    except OSError:
        return "missing"


def main():
    if len(sys.argv) < 2:
        raise SystemExit(USAGE)
    args = sys.argv[1:]
    if args[0] in ("--version", "-v", "version"):
        print(json.dumps({"command": "version", "gate": VERSION, "judge": judge_version(),
                          "python": sys.version.split()[0]}) if "--json" in args
              else f"gate {VERSION} · judge {judge_version()} (canon v2) · python {sys.version.split()[0]}")
        return
    as_json = "--json" in args
    args = [a for a in args if a != "--json"]
    cmd, rest = args[0], args[1:]
    if cmd == "serve":
        return cmd_serve(rest)
    if cmd == "report":
        ensure_world()
        out = cmd_report(rest)
    else:
        out = dispatch(cmd, rest)
    print(json.dumps(out, ensure_ascii=False, indent=2) if as_json else humanize(out))
    sys.exit(1 if is_red(out) else 0)


if __name__ == "__main__":
    main()
