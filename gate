def is_red(out):
    # a threshold the operator declared is not a verdict, but it is theirs to act
    # on, so it reaches the exit code the same way a refusal does
    return out.get("over_threshold") or out.get("verdict") == "refused" or bool(out.get("translation_holes")) or out.get("base", "").startswith("dirty")


def humanize(out):
    # humans get lines, machines get --json (git's porcelain pattern)
    lines = []
    cmd = out.get("command", "")
    # ── A REFUSAL PRINTS, WHOEVER MADE IT. Every command formatted its own, so a
    # refusal from one that had never had one before printed nothing at all — or
    # a traceback, when the formatter reached for a field a refusal does not
    # carry. That is the same silence this tool sells against, standing in its
    # own reading of its own arguments. One branch, before any of them.
    if out.get("asks") and out.get("note") and "verdict" not in out:
        lines.append("usage: " + out["note"])
        if out.get("next"):
            lines.append(f"  next: {out['next']}")
        return "\n".join(lines)
    if cmd == "badge" and out.get("verdict") != "no world here":
        lines.append("badge: " + out["text"] + (f" · wrote {out['wrote']}" if out.get("wrote") else ""))
        lines.append(f"  note: {out['note']}")
        lines.append(f"  next: {out['next']}")
        return "\n".join(lines)
    if out.get("verdict") == "no world here":
        # and the line names the verb that was asked: `gate badge` in a bare
        # folder printed `status: no world here`, which is a different verb
        # answering, and a person reading it looks for a status they never ran
        lines.append(f"{cmd or 'status'}: no world here")
        lines.append(f"  next: {out['next']}")
        lines.append(f"  then: {out['then']}")
        return "\n".join(lines)
    if "verdict" in out:
        # a verdict is one of three words, and only one of them is counted:
        # `refused N` names how many, `holds` and `observed` name none — and
        # `observed 0` would be a count of the refusals a court that never sat
        # did not make
        head = (out["verdict"] if out["verdict"] in ("holds", "observed")
                else f"refused {len(out.get('refusals', []))}")
        tail = []
        if isinstance(out.get("world"), dict):
            w = out["world"]
            tail.append(f"{w['declarations']} declarations · {w['lookups']} lookups · {w['premises']} premises")
        if isinstance(out.get("forms"), dict):
            # NOUGHT IS THREE DIFFERENT FACTS AND ONLY ONE OF THEM IS WORDS. Beside
            # a judged world it is a number. Beside a refusal it is nothing at all:
            # a stream that refuses is not counted, and printing «nothing was
            # checked» next to a named refusal says the opposite of what happened.
            # Alone it is the whole verdict, and then it is said in words. Walking
            # the README's own first recipe printed the first of these wrongly, and
            # breaking the letter on a fresh entry printed the second.
            n = out["forms"]["equalities"]
            if n:
                tail.append(f"{n} equalities")
            elif not out.get("refusals") and not out.get("world"):
                tail.append("nothing claimed here yet, so nothing was checked")
        if out.get("judge_ms") is not None:
            tail.append(f"{out['judge_ms']} ms")
        if out.get("build_s") is not None:
            tail.append(f"build {out['build_s']} s")
        if cmd.startswith("change") and not out.get("dry_run", True):
            tail.append("applied" if out.get("applied") else
                        "nothing to change: it already says this"
                        if out.get("changed") is False and out.get("verdict") == "holds"
                        else "NOT applied")
        elif cmd.startswith("change"):
            tail.append("dry-run")
        lines.append(f"{cmd or 'verdict'}: {head}" + (" · " + " · ".join(tail) if tail else ""))
        if out.get("court") and out["court"] != "the judge":
            lines[-1] += f" · judged by {out['court']}"
        if out.get("unjudged"):
            n = len(out["unjudged"])
            lines.append(f"  not judged here: {n} forms "
                         + ("row" if n == 1 else "rows")
                         + " (" + ", ".join(out["unjudged"][:3])
                         + (", …" if n > 3 else "") + "). The certificate court is the "
                         "binary's, and this machine has none that runs")
        for r in out.get("refusals", []):
            src = f"  ({r['source']})" if r.get("source") else ""
            # an address, or the certificate that carries one: an importer names
            # the claim, the source line names where it came from
            where = r.get("address") or r.get("certificate") or "?"
            lines.append(f"  {where} · {r['claim']}{src}")
        for s in out.get("compiler_says", []):
            lines.append(f"  compiler: {s}")
        if out.get("note"):
            lines.append(f"  note: {out['note']}")
        if out.get("next"):
            lines.append(f"  next: {out['next']}")
    elif "seeds" in out:
        lines.append(f"verify: {out['translation_holes']} hole(s)")
        for s in out["seeds"]:
            lines.append(f"  {s['seed']:22} world={s['world']:8} legacy={s['legacy']:8} → {s['reading']}")
    elif out.get("base", "").startswith("dirty"):
        lines.append("verify: base dirty. Fix these before seeding")
        for w in out.get("world_says", []):
            lines.append(f"  world:  {w}")
        for l in out.get("legacy_says", []):
            lines.append(f"  legacy: {l}")
    elif cmd == "attention" and "seams" in out:
        # the morning cut: counted first, because the count is the answer and
        # the addresses are what you read once the count is not zero
        n = out.get("waiting_on_you", 0)
        lines.append("attention: " + (
            f"{n} await your word" if n else "nothing awaits your word")
            + f" · {out.get('you_wait_on', 0)} awaiting theirs"
            + (f" · parted at {out['parted']}" if out.get("parted") else "")
            + (f" · {out['came_back']} came back" if out.get("came_back") else ""))
        for s in out["seams"]:
            who = s.get("against") or s.get("carrier") or "a pair"
            for x in (s.get("expired") or []):
                lines.append(f"  came back · {x['address']} · {x.get('because', '')}")
            for x in (s.get("parted") or []):
                lines.append(f"  parted · {x['address']} · {who}")
            for x in (s.get("waits_on_you") or []):
                lines.append(f"  your word · {x['address']} · {who}")
        if out.get("next"):
            lines.append(f"  next: {out['next']}")
    elif cmd == "demo seam":
        lines.append(f"demo seam: two sides in {out['root']} — the contract states "
                     f"{out['declared']['contract']}, the library claims {out['declared']['carrier']}")
        for x in out["waiting_on_you"]:
            lines.append(f"  waits on the library · {x}")
        for x in out["you_wait_on"]:
            lines.append(f"  waits on the contract · {x}")
        for x in out["parted"]:
            lines.append(f"  parted · {x}")
        lines.append(f"  next: {out['next']}")
        lines.append(f"  more: {len(out['try'])} other things to try; `--json` lists them")
    elif cmd == "demo":
        # ── ONE RUNG, WHICH IS THIS TOOL'S OWN LAW ABOUT ITSELF: "a reader is on
        # a rung, and a product that lists the whole ladder teaches nothing."
        # Both demos printed five doors at once — the one act, then four more —
        # to somebody who had run their first command thirty seconds earlier.
        # The list is still there for whoever asked for all of it; `--json` is
        # where an agent reads, and a person gets a step.
        lines.append(f"demo: a world in {out['root']}")
        for r in out.get("refused", []):
            lines.append(f"  asked `{out['asked']}` for you, and it answers:")
            lines.append(f"    {r}")
        lines.append(f"  next: {out['next']}")
        if out.get("back"):
            lines.append(f"  back: {out['back']}")
        lines.append(f"  more: {len(out['try'])} other things to try; `--json` lists them")
    elif cmd == "init":
        lines.append(f"init: {out['root']}" + (f" · created {len(out['created'])} files" if out["created"] else " · already there"))
        if out.get("next"):
            lines.append(f"  next: {out['next']}")
        if out.get("hooks"):
            lines.append(f"  {out['hooks']}")
        if out.get("undo_hooks"):
            lines.append(f"  to undo that one git setting: {out['undo_hooks']}")
        if out.get("observed"):
            lines.append(f"  {out['observed']}")
        if out.get("vendored"):
            v = out["vendored"]
            lines.append(f"  gate now travels with this repository: .gate/ + {v['shim']}")
            lines.append("  commit it, and every clone has the tool. Nothing to install")
            if v.get("judge_sha256"):
                lines.append(f"  judge sha256: {v['judge_sha256'][:16]}…")
    elif cmd in ("mine", "theirs") and out.get("made_mine"):
        lines.append(f"{cmd}: {out['made_mine']} is yours · wrote {out['wrote']}"
                     # nothing lands unmentioned: a page that names the forms it is
                     # written in arrives with them, and both are said out loud
                     + (" and " + " and ".join(out["with"]) if out.get("with") else "")
                     + (f" · from the judge at {out['from'][:7]}" if out.get("from") else ""))
        lines.append(f"  note: {out['note']}")
        lines.append(f"  next: {out['next']}")
    elif cmd in ("mine", "theirs"):
        # SAID IN ONE LINE, THE SAME LINE BOTH WAYS. The whole difference is the
        # verb: one I write, one I only read — and the operator should be able to
        # see which a file is without opening it.
        if out.get("asks"):
            lines.append("usage: " + out["note"])
        elif out.get("held") is not None:
            # THE ACCOUNT, in the shape somebody reads down a column: what, what
            # for, and how fresh. An owner who cannot see this cannot own it.
            lines.append(f"{cmd}: {len(out['held'])}")
            for h in out["held"]:
                at = f" · at {h['at']}" if h.get("at") else ""
                lines.append(f"  {h['file']:<28} {h['role'] or 'unsaid':<7}{at}")
            lines.append(f"  next: `gate {cmd} FILE --forget` takes one out of the list, "
                         "and leaves the file alone")
        elif out.get("forgot"):
            lines.append(f"{cmd}: {out['forgot']} · out of {out['declared_in']}")
            lines.append("  the file is still on disk: that is a separate act, and yours")
        else:
            # what was taken, and at what — the whole account in the line that
            # takes it, because a pin stated nowhere pins nothing
            took = f" · took it at {out['at']}" if out.get("at") else ""
            lines.append(f"{cmd}: {out['file']}{took} · written down in {out['declared_in']}")
            lines.append(f"  role `{out['role']}` — {out['role_means']}")
    elif cmd == "aside":
        if out.get("asks"):
            lines.append("usage: " + out["note"]); lines.append(f"  next: {out['next']}")
        else:
            lines.append(f"aside: {out['address']} · while {out['because']} is open "
                         f"· said by {out['declared_by']} · {out['standing']} standing")
            lines.append(f"  note: {out['note']}")
            lines.append(f"  next: {out['next']}")
    elif cmd == "attention":
        if out.get("asks"):
            lines.append("usage: " + out["note"]); lines.append(f"  next: {out['next']}")
        else:
            lines.append(f"attention: as {out['as']} · {len(out['waits_on_you'])} waiting on you · "
                         f"{len(out['you_wait_on'])} you are waiting for · {len(out['parted'])} parted"
                         + (f" · {len(out['expired'])} came back" if out["expired"] else ""))
            for x in out["expired"]:
                lines.append(f"  came back · {x['address']} · it was set aside for {x['because']}, "
                             f"and {x['because']} is closed")
            for x in out["waits_on_you"]:
                lines.append(f"  waits on you · {x['address']} · "
                             + (x.get("why") or "stated by the contract, and you have not said whether you carry it"))
            for x in out["you_wait_on"]:
                lines.append(f"  you are waiting · {x['address']} · "
                             + (x.get("why") or "you carry it, and the contract has not stated it"))
            for x in out["parted"]:
                lines.append(f"  parted · {x['address']} · {x['why']}")
            for x in out["known"]:
                lines.append(f"  known · {x['address']} · set aside by {x['declared_by']} "
                             f"for {x['because']} ({x['state'].lower()})")
            lines.append(f"  note: {out['note']}")
            lines.append(f"  next: {out['next']}")
    elif cmd.startswith("declare"):
        if out.get("asks"):
            lines.append("usage: " + out["note"])
            lines.append(f"  next: {out['next']}")
        else:
            lines.append(f"{cmd}: {out['declares']} declared"
                         + (f" · wrote {out['wrote']}" if out.get("wrote") else ""))
            lines.append(f"  note: {out['note']}")
            lines.append(f"  next: {out['next']}")
    elif cmd == "seam" and out.get("asks"):
        lines.append("usage: " + out["note"])
        lines.append(f"  next: {out['next']}")
    elif cmd == "drift" and out.get("asks"):
        lines.append("usage: " + out["note"])
        lines.append(f"  next: {out['next']}")
    elif cmd == "drift":
        # every line here names its CATEGORY, because the two kinds of fact
        # below are not equally certified: a date is an object, an absence is a
        # walk. The word `refused` appears nowhere — no world entered, so no
        # court sat.
        head = f"drift: observation of {out['carrier']} against {out['contract']}"
        if out.get("thin"):
            head += " · no history here, so nothing is dated"
        elif out["late"]:
            head += (f" · behind on {out['late']} names · median {out['median_days']} days"
                     f" · worst {out['worst_days']}")
        else:
            head += " · nothing arrived late"
        lines.append(head)
        for w in out.get("worst", []):
            lines.append(f"  in history · {w['field']} · the contract's earliest revision saying it is "
                         f"{w['contract']}, the library's earliest commit writing it {w['carrier']}: "
                         f"{w['days']} days")
        for n in out.get("unwritten", [])[:5]:
            lines.append(f"  in this walk · {n} · the contract declares it; no file walked writes it")
        if len(out.get("unwritten", [])) > 5:
            lines.append(f"  … and {len(out['unwritten']) - 5} more names no file walked writes")
        for r in out.get("silent_routes", [])[:3]:
            lines.append(f"  in this walk · {r} · the contract declares this route; no file walked "
                         "spells its segments")
        if out.get("over_threshold"):
            lines.append(f"  threshold: you set --fail-over {out['threshold']}, and the median is "
                         f"{out['median_days']} — this exits non-zero by your rule, not by a verdict")
        lines.append(f"  note: {out['note']}")
        lines.append(f"  next: {out['next']}")
    elif cmd == "stdlib" and out.get("modules"):
        # WHAT MAY BE SAID HERE, in a sentence rather than a blob. An operator
        # who cannot see the vocabulary cannot know it is theirs to read: the
        # shelf was reachable only by already knowing a name on it.
        #
        # AND IT IS NOT A SHELF OF FILES. Splitting it into speech and gate's
        # own furniture drew a line that does not matter to anybody using this,
        # and hid the line that does: none of it is yours. Every word here is
        # carried by the judge we ship — a world speaks `Department` with no file
        # of that name anywhere near it, and a copy declared as a world file is
        # refused outright. So a printout is exactly that, and the dependency is
        # the judge, named by revision.
        roles = out.get("roles") or {}
        speak = [k for k in out["modules"] if roles.get(k) == "forms"]
        lines.append(f"stdlib: {len(speak)} you can speak, "
                     f"{len(out['modules']) - len(speak)} gate's own, all of it theirs")
        for name, note in out["modules"].items():
            own = "" if roles.get(name) == "forms" else "   (gate's own furniture)"
            lines.append(f"  {name:<20} {note.split(':')[-1].strip()[:52]}{own}")
        lines.append("  these are theirs: read them, quote them, learn them, but they are not "
                     "files your world is made of, and editing one adds no word to the language. "
                     "`gate --version` names the revision they were compiled from")
        lines.append("  next: `gate stdlib show <name>` reads one as plain Swift · "
                     "`gate mine FILE` / `gate theirs FILE` is how a file joins your world")
    elif cmd == "library":
        f = out.get("forms") or out.get("crystal") or {}
        lines.append(f"library: {len(f)} forms" + (f" · wrote {out['wrote']}" if out.get("wrote") else ""))
    elif cmd == "export" and out.get("verdict") == "refused":
        lines.append(f"export: refused {len(out['refusals'])}")
        for r in out["refusals"]:
            lines.append(f"  {r['address']} · {r['claim']}")
        lines.append(f"  next: {out['next']}")
    elif cmd == "export":
        lines.append(f"export: {out['people']} people, {out['grants']} grants → {', '.join(out['wrote'])}")
    elif cmd == "log":
        d = out.get("default_branch") or "?"
        what = ("the world's history" if out.get("scope") == "world" and out.get("world_files")
                else "the repository")
        # and when the word could not be honoured, the line says which word and why
        if out.get("narrowed") is False:
            what += ": no file here is declared a world file, so there is nothing narrower"
        lines.append(f"log: {len(out['commits'])} commits · {what} · observed, not judged · closed = reachable from {d}")
        for c in out["commits"]:
            st = "?" if c["closed"] is None else ("closed" if c["closed"] else "open")
            who = c["person"] or c["email"]
            star = " *" if c["touches_world"] else ""
            lines.append(f"  {c['short']} {st:6} {c['when'][:10]} {who:20} {c['subject']}{star}")
    elif cmd == "findings history":
        rows = out["history"]
        lines.append(f"findings history: {out['commits']} commits carry the pair, read from git")
        # the fold first, because it is the finding and the rows are its evidence
        if out.get("parted"):
            lines.append(f"  {out['parted']['said']}")
        lines.append(f"  {out['measure']}")
        for r in rows:
            n = r["divergences"]
            said = ("not read: no verdict in the reply" if n is None else
                    "in agreement" if n == 0 else
                    f"{n} divergence" + ("" if n == 1 else "s"))
            lines.append(f"  {r['at']} {r['when']}  {said:22}"
                         f" {r['rules']} rules"
                         + ("" if r["judged"] else ", no policy: only unmatched rules can show"))
        # and where the pair was read, said once rather than on every row, plus
        # every move: a file that changed place is the same pair, and a reader
        # who sees only the last path cannot tell that from a pair that was born
        # there. The moves are the interesting line, so they are named.
        seen = []
        for r in rows:
            if not seen or seen[-1][0] != r.get("file"):
                seen.append((r.get("file"), r["at"], r["when"]))
        if seen:
            lines.append("  read from " + seen[0][0]
                         + "".join(f", moved to {f} at {a} {w}" for f, a, w in seen[1:]))
        if out.get("shape"):
            lines.append(f"  {out['shape']}")
        if out.get("markdown"):
            lines.append("")
            lines.append(out["markdown"])
    elif cmd == "findings":
        f = out["findings"]
        if not f:
            lines.append("findings: nothing to report yet")
        else:
            lines.append(f"findings: {len(f)} · {out['judged']} checked by the judge, "
                         f"{out['observed']} read from git")
            for x in f:
                tag = "checked" if x["kind"] == "judged" else ("offer  " if x["kind"] == "offer" else "read   ")
                lines.append(f"  [{tag}] {x['sentence']}")
                lines.append(f"           {x['evidence']}")
        if out.get("markdown"):
            lines.append("")
            lines.append(out["markdown"])
    elif cmd == "survey":
        lines.append(f"survey: {out['commits']} commits, read-only")
        lines.append("  unwritten links (co-change from your own history):")
        for l in out["unwritten_links"]:
            lines.append(f"    {l['together']:3d}x {l['confidence']:4.0%}  {l['a']} <-> {l['b']}")
        i = out["identity"]
        lines.append(f"  identity: {i['authors']} author(s), {i['signed_commits']} signed commits")
        for t in i["top"]:
            lines.append(f"    {t}")
        if out["object_candidates"]:
            lines.append("  object candidates in commit messages: " + ", ".join(f"{k}({c})" for k, c in out["object_candidates"].items()))
        f = out["fabric"]
        lines.append(f"  fabric: {f.get('facts') or 'no world yet'} · " + (f"{f['verdict']}, {f['refusals']} refusal(s)" if f.get("verdict") else f.get("note", "")))
    else:
        return json.dumps(out, ensure_ascii=False, indent=2)
    # EVERY OUTPUT ENDS WITH THE STEP THAT COMES NEXT. It is the oldest rule
    # here and it was kept by hand, branch by branch, which meant five commands
    # quietly did not: `log`, `library`, `survey`, `findings`, and — worst —
    # `init`, where somebody has just set everything up and is looking for what
    # to do. A reader who has to plan their own next move is a reader carrying
    # the map, and carrying the map is exactly what this is supposed to take off
    # them. The rule lives in one place now, so a new verb cannot forget it.
    if out.get("next") and not any(l.startswith("  next:") for l in lines):
        lines.append(f"  next: {out['next']}")
    return "\n".join(lines)


VERSION = "0.1.0"


def judge_from():
    # WHICH REVISION OF THE CORPUS THIS JUDGE CAME FROM. Bytes say what a thing
    # is; they do not say what it was made from, and a dependency stated as an
    # opaque hash cannot be checked by anybody who does not already know the
    # answer. The build records the commit beside the binary. Where it is
    # missing, that is said rather than glossed.
    try:
        return open(JUDGE + ".from", encoding="utf-8").read().strip() or None
    except OSError:
        return None


def judge_version():
    # the judge has no version flag. Its identity is its bytes, which is also what the
    # README asks a reviewer to reproduce from the public corpus.
    #
    # ── AND IT IS THE IDENTITY OF WHATEVER ANSWERS HERE. This printed the binary's
    # digest on a machine where the binary cannot run and the port was doing the
    # judging: the one command whose whole job is to say what judges this repository,
    # naming a file that judged nothing. Bytes of the court that sat, or nothing.
    import hashlib
    if JUDGE_KIND != "binary":
        # both courts sit in the port now, so the identity is both files:
        # a drift in the certificate court may not hide behind an unchanged
        # plain one
        try:
            digest = hashlib.sha256()
            for piece in (os.path.join("bin", "judge.js"), os.path.join("bin", "judge-where.js")):
                with open(os.path.join(_HERE, piece), "rb") as f:
                    digest.update(f.read())
            return "port sha256:" + digest.hexdigest()[:12]
        except OSError:
            return "port"
    try:
        with open(JUDGE, "rb") as f:
            return "sha256:" + hashlib.sha256(f.read()).hexdigest()[:12]
    except OSError:
        return "missing"


def command_in(out):
    # ── THE LAST MILE. Every answer here ends with a step, and the step names a
    # command in backticks — which is a sentence to read, not a thing to run.
    # Somebody then retypes it, with their own path, and gets it slightly wrong.
    # The command is lifted out beside the sentence: ready as it stands, with
    # whatever this run already knew filled in, for a person to copy and for an
    # agent to read without parsing prose.
    #
    # What is NOT here, and on purpose: running it. The bench reads and judges;
    # the Enter is the operator's, in their own terminal, with their own tools.
    # A page that executes in a repository holding somebody else's files is an
    # attack surface we would have built ourselves, and the one thing this bench
    # can promise today is that it cannot break anything.
    for field in ("next", "then", "try"):
        said = out.get(field)
        if not isinstance(said, str):
            continue
        m = re.search(r"`([^`]+)`", said)
        if m and re.match(r"(gate|git|bin/|yq|swift)\b", m.group(1).strip()):
            return m.group(1).strip()
    return None



def main():
    if len(sys.argv) < 2:
        raise SystemExit(USAGE)
    args = sys.argv[1:]
    if args[0] in ("--version", "-v", "version"):
        came = judge_from()
        print(json.dumps({"command": "version", "gate": VERSION, "judge": judge_version(),
                          "judge_from": came, "python": sys.version.split()[0]}) if "--json" in args
              else f"gate {VERSION} · judge {judge_version()} (canon v2) · python {sys.version.split()[0]}"
              + ("\n  the court is " + str(court_shape()["lines"]) + " lines in "
                 + " and ".join(os.path.basename(f) for f in court_shape()["files"])
                 + " and the rest of that repository is worlds it shows itself on, and the "
                   "theory it comes from"
                 if court_shape() else "")
              + ("\n  judge built from verification-is-identification " + came[:12]
                 + ". `bin/build-judge.sh " + came[:12] + "` builds the same judge: check "
                   "yours by running the battery with GATE_JUDGE pointing at it. The linker "
                   "is not byte-stable, so the hash names what is here and is not the check"
                 if came and JUDGE_KIND == "binary" else
                 "\n  the revision this judge was built from is not recorded: "
                 "`bin/build-judge.sh` writes it down" if JUDGE_KIND == "binary" else "")
              + ("\n  both courts are served by the port under node "
                 + (subprocess.run([shutil.which("node"), "--version"], capture_output=True,
                                   text=True).stdout.strip() or "")
                 + ": the plain court runs in bin/judge.js and the certificate court in "
                   "bin/judge-where.js, line-for-line ports of the same judge, held to "
                   "its lines by the battery's parity checks. "
                 + ("The binary here was built for another platform"
                    if os.path.exists(JUDGE) else "There is no binary here")
                 if JUDGE_KIND == "port" else ""))
        return
    # ── THE STRANGLER'S DOOR: one place that hands an argv to the Swift CLI.
    # The binary states what it carries (`--carries`, one argv prefix per
    # line); this side asks once and forwards a carried argv whole, by exec.
    # No list of moved verbs lives here: a second copy of the binary's own
    # answer would drift the day a vein lands. No binary, or GATE_CLI=off,
    # and every vein runs its python side, unchanged: the same door the
    # judge's port walks, from the other side.
    _cli = os.environ.get("GATE_CLI") or os.path.join(_HERE, "bin", "gate-cli")
    if os.environ.get("GATE_CLI") != "off" and os.path.isfile(_cli) and os.access(_cli, os.X_OK):
        try:
            _said = subprocess.run([_cli, "--carries"], capture_output=True,
                                   text=True, timeout=5).stdout
            _veins = [tuple(l.split()) for l in _said.splitlines() if l.strip()]
            if any(tuple(args[:len(v)]) == v for v in _veins if v):
                os.execv(_cli, [_cli, *args])
        except OSError:
            pass
    as_json = "--json" in args
    args = [a for a in args if a != "--json"]
    cmd, rest = args[0], args[1:]
    if cmd == "serve":
        return cmd_serve(rest)
    if cmd == "report":
        ensure_world()
        out = cmd_report(rest)
    else:
        out = dispatch(cmd, rest)
    # ── AND A VERB GIVEN HALF OF WHAT IT NEEDS DOES NOT EXIT NOUGHT. Typing a
    # verb bare is a question, and a usage line with a nought exit is the right
    # answer to it. Naming some of what a verb takes and not the rest is a
    # mistake: `gate theirs their.swift` with no revision, `gate seam one.swift`
    # with no second side, `gate mine f.swift --role nosuchcourt`. Five verbs
    # answered those with the same nought exit, so a script reading only the
    # code was told a world had taken a file it never took. The verbs mark it
    # where they read their arguments; the canon is written once, here.
    # (popped, not read: the mark is how a verb says which of its two answers
    # this is, and a mark that survives into `--json` is a field the Swift vein
    # carrying the same verb does not print. Byte parity between the carriers is
    # the battery's own check, and it caught this the run it was written)
    if isinstance(out, dict) and out.pop("misread", False):
        cannot(out["note"], out.get("next"))
    if isinstance(out, dict) and "command_to_run" not in out:
        ready = command_in(out)
        if ready:
            out["command_to_run"] = ready
    print(json.dumps(out, ensure_ascii=False, indent=2) if as_json else humanize(out))
    sys.exit(1 if is_red(out) else 0)


if __name__ == "__main__":
    try:
        try:
            main()
        except Cannot as _no:
            # the terminal's half of the canon: the sentence and the step on
            # stderr, the object for whoever asked for one, and a code either way
            sys.stderr.write((json.dumps(_no.said(), ensure_ascii=False)
                              if "--json" in sys.argv else
                              "gate: " + _no.note
                              + (f"\n  next: {_no.then}" if _no.then else "")) + "\n")
            raise SystemExit(1)
    finally:
        # whatever a verb made to probe with does not outlive the verb. `main`
        # leaves through sys.exit, so this is the one place that always runs.
        sweep_scratch()
