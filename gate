            paths = []
            layout = MANIFEST["manifest"] if MANIFEST else None
            forms_here = {r["path"] for r in ((MANIFEST.get("rows") if MANIFEST else None) or [])
                          if r["role"] == "forms"}
            for name, p in bench_files():
                if p != active and not os.path.exists(p):
                    continue                      # a personal world nobody wrote
                tp = os.path.join(d, name.replace(os.sep, "__"))
                with open(tp, "w") as f:
                    f.write(text if p == active else open(p).read())
                # THE LAYOUT IS OPENABLE, NOT PLAIN-JUDGED. It is the operator's
                # own document and belongs in the bench — a dependency is written
                # by whoever depends, and this was the one file of theirs the
                # bench would not open. But it is not a fragment of the world:
                # it declares protocols, which the plain court refuses on sight,
                # so putting it in this stream turned every row into a refusal.
                # Its court is the guards, and they answer below.
                # AND THE POLICY IS NOT A FRAGMENT OF THE PLAIN WORLD EITHER.
                # It declares an extension carrying a typeName, which the plain
                # court refuses on sight — that is precisely why it has a guard
                # of its own. Listing it in the bench (so it can be opened) is a
                # fact about the panel; sending it to this court is a fact about
                # judgement, and confusing the two made the bench refuse what
                # the command line held, one day after that disagreement was
                # fenced. The fence only compared this repository, which has no
                # policy at all.
                if p != layout and name not in forms_here \
                        and os.path.abspath(p) != os.path.abspath(policy_path() or ""):
