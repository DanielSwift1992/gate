def cmd_guard_deps(a):
    # guard deps [manifest lock] — git's own soil: manifest ↔ lockfile.
    # The adapter prints a world: the lock declares "package@version" atoms,
    # a manifest requirement REFERENCES its pin's atom through an axis — a
    # drift "resolves to nothing" with an address. Not one new form.
    manifest_p = a[0] if a else "package.json"
    lock_p = a[1] if len(a) > 1 else "package-lock.json"
    manifest = json.load(open(manifest_p))
    lock = json.load(open(lock_p))
    deps = manifest.get("dependencies", {})
    pins = {
        name.replace("node_modules/", ""): info.get("version")
        for name, info in lock.get("packages", {}).items()
        if name.startswith("node_modules/")
    }
    atom = lambda n, v: (n + "_" + v).replace("-", "_").replace(".", "_").replace("@", "").replace("/", "_")
    lines = ["// printed by gate guard deps: the lockfile declares the atoms,",
             "// the manifest's requirements REFERENCE them — a drift fails to resolve.", ""]
    srcmap = {}
    for n, v in sorted(pins.items()):
        lines.append(f"public enum {atom(n, v)}: Close {{}}")
    lines.append("")
    for n, want in sorted(deps.items()):
        pinned = pins.get(n)
        target = atom(n, want.lstrip("=v")) if want[0].isdigit() or want.startswith("=") else (atom(n, pinned) if pinned else atom(n, "unpinned"))
        lines.append(f"public enum Req_{atom(n, '')[:-1]}: Close {{")
        srcmap[len(lines)] = f"{os.path.basename(manifest_p)} · \"{n}\": \"{want}\""
        lines.append(f"    public typealias Pin = {target}")
        lines.append("}")
    orphans = sorted(set(pins) - set(deps))
    world = "\n".join(lines) + "\n"
    d = tempfile.mkdtemp(prefix="gate-deps-")
    p = os.path.join(d, "deps-gate.swift")
    open(p, "w").write(world)
    r = judge(p)
    for ref in r["refusals"]:
        n = int(ref["address"].split(":")[1])
        for k in range(max(0, n - 2), n + 2):
            if k in srcmap:
                ref["source"] = srcmap[k]
    out = {"command": "guard deps", "requirements": len(deps), "pins": len(pins), **r}
    if orphans:
        out["orphan_pins"] = orphans
        out["verdict"] = "refused"
        out["refusals"] = out["refusals"] + [
            {"address": os.path.basename(lock_p), "claim": f"pin {o}@{pins[o]} is required by nothing: a leftover after removal"}
            for o in orphans
        ]
    out["note"] = ("SKETCH, not a product path: only orphan pins are detected; a missing pin "
                   "currently yields a FALSE holds (the judge resolves no axis without a reading "
                   "premise) — native ecosystem lockfile checkers already cover this class")
    return out


def cmd_survey(a):
    # survey [N] — the t0 gesture: a read-only map of the repo with NO
    # translation. Unwritten links from its own history (co-change — exact
    # statistics), identity, object candidates, fabric coverage.
    import itertools, collections

    n = int(a[0]) if a else 500
    fmt = subprocess.run(["git", "log", f"-{n}", "--format=%x40%ae %G?", "--name-only"],
                         capture_output=True, text=True).stdout
    commits, authors, signed, cur = [], collections.Counter(), 0, []
    for line in fmt.splitlines():
        if line.startswith("@"):
            if cur:
                commits.append(cur); cur = []
            email, g = (line[1:].split() + ["N"])[:2]
            authors[email] += 1
            signed += 1 if g in ("G", "U", "X", "Y") else 0
        elif line.strip():
            cur.append(line.strip())
    if cur:
        commits.append(cur)
    pair_n, file_n = collections.Counter(), collections.Counter()
    for files in commits:
        fs = list(set(files))
        for f in fs:
            file_n[f] += 1
        for x, y in itertools.combinations(sorted(fs), 2):
            pair_n[(x, y)] += 1
    links = [
        {"a": x, "b": y, "together": c, "confidence": round(c / min(file_n[x], file_n[y]), 2)}
        for (x, y), c in pair_n.most_common(30)
        if c >= 5
    ][:10]
    subjects = subprocess.run(["git", "log", f"-{n}", "--format=%s %b"], capture_output=True, text=True).stdout
    keys = collections.Counter(re.findall(r"\b[A-Z][A-Z0-9]+-\d+\b", subjects))
    world = None
    if FACTS and os.path.exists(FACTS):
        r = judge(FACTS)
        world = {"facts": FACTS, "verdict": r["verdict"], "refusals": len(r["refusals"])}
    return {
        "command": "survey",
        "commits": len(commits),
        "unwritten_links": links,
        "identity": {
            "authors": len(authors),
            "top": [f"{e} ({c})" for e, c in authors.most_common(5)],
            "signed_commits": signed,
        },
        "object_candidates": {k: c for k, c in keys.most_common(10)},
        "fabric": world or {"facts": None, "note": "no world yet: coverage 0% — the links above say where to start"},
    }


# ── the stdlib: definitions baked into the binary, fully extractable ──
# Hidden is not secret (the git model: packed away, but cat-file shows all).
# `gate stdlib` lists, `gate show <name>` prints, `gate materialize <name>`
# lands the file in the repo — from then on it is the client's, versioned by
# his git; editing it means removing the header (it becomes his file).

MATERIALIZED_MARK = "// gate stdlib"

def load_stdlib():
    # the shelf's single source: stdlib/*.swift next to the CLI. Readable,
    # editable, judged by our own judge in our own battery (self-hosted);
    # baking them into the one release binary is the Swift packaging step.
    d = os.path.join(os.path.dirname(os.path.abspath(__file__)), "stdlib")
    out = {}
    if os.path.isdir(d):
        for f in sorted(os.listdir(d)):
            if f.endswith(".swift"):
                out[f[:-6]] = open(os.path.join(d, f)).read()
    return out


STDLIB = load_stdlib()


def cmd_stdlib(a):
    if a and a[0] == "show":
        name = a[1]
        if name not in STDLIB:
            raise SystemExit(json.dumps({"error": f"no such stdlib module: {name} (gate stdlib lists them)"}))
        print(STDLIB[name])
        sys.exit(0)
    if a and a[0] == "materialize":
        name = a[1]
        if name not in STDLIB:
            raise SystemExit(json.dumps({"error": f"no such stdlib module: {name}"}))
        path = f"{name}.swift"
        with open(path, "w") as f:
            f.write(STDLIB[name])
        return {"command": "stdlib materialize", "wrote": path,
                "note": "now yours to version and import; edit it = remove the stdlib header (drift of an unedited copy is guarded by status)"}
    return {"command": "stdlib", "modules": {k: v.split("\n")[0].replace("// ", "") for k, v in STDLIB.items()},
            "note": "hidden is not secret: show prints, materialize lands the file in your repo"}


def stdlib_guards():
    # a materialized copy still carrying the stdlib header must match the
    # binary's: drifted — re-materialize, or drop the header to own the file
    if not FACTS:
        return []
    d = os.path.dirname(os.path.abspath(FACTS))
    bad = []
    for name, body in STDLIB.items():
        p = os.path.join(d, f"{name}.swift")
        if os.path.exists(p):
            text = open(p).read()
            if text.startswith(MATERIALIZED_MARK) and text != body:
                bad.append({"address": f"{name}.swift", "claim": "a materialized stdlib copy drifted from the binary's: re-materialize, or remove the header to own the file"})
    return bad


RBAC_GENRE_HEADER = """// printed by gate import rbac — the K8s access world in the domain genre
// (the exemplar: theory corpus Sources/Examples/Grants.swift @ 0fd0b38).
// Realms are namespaces plus the cluster scope. A role is a room stating its
// realm; a binding is a keeper stating its post; the gate's equality is the
// K8s invariant itself: a RoleBinding and its Role live in one namespace.
// The genre below is the stdlib module genre-grants, printed from the shelf.

"""

READS, WRITES = {"get", "list", "watch"}, {"create", "update", "patch", "delete", "deletecollection"}


def rbac_key(rules):
    verbs = {v for r in rules or [] for v in r.get("verbs", [])}
    if "*" in verbs or verbs & {"escalate", "bind", "impersonate"}:
        return "WardenKey"
    if verbs & WRITES:
        return "WriterKey"
    return "ReaderKey"


def sanitize(s):
    return re.sub(r"[^A-Za-z0-9]", "_", s)


def cmd_import_rbac(a):
    # import rbac rbac.json [-o gate.swift] — kubectl get roles,clusterroles,
    # rolebindings -A -o json | is the input. Three judged outcomes per
    # binding: ok / the Role lives in a foreign namespace (an equality refusal
    # with both names) / no such Role anywhere (dangling).
    src = a[0]
    out_path = a[a.index("-o") + 1] if "-o" in a else "rbac-gate.swift"
    items = json.load(open(src)).get("items", [])
    roles, cluster_roles, bindings = {}, {}, []
    namespaces = set()
    for it in items:
        kind, meta = it.get("kind"), it.get("metadata", {})
        ns, name = meta.get("namespace", ""), meta.get("name", "")
        if kind == "Role":
            roles[(ns, name)] = it
            namespaces.add(ns)
        elif kind == "ClusterRole":
            cluster_roles[name] = it
        elif kind == "RoleBinding":
            bindings.append(it)
            namespaces.add(ns)
    lines = [RBAC_GENRE_HEADER + STDLIB["genre-grants"]]
    srcmap = {}
    for ns in sorted(namespaces):
        lines.append(f"public enum Ns_{sanitize(ns)}: Realm {{}}")
    lines.append("public enum ClusterScope: Realm {}")
    lines.append("")
    for (ns, name) in sorted(roles):
        lines.append(f"public enum Role_{sanitize(ns)}_{sanitize(name)}: Room {{")
        lines.append(f"    public typealias Place = Ns_{sanitize(ns)}")
        lines.append("}")
    for name in sorted(cluster_roles):
        lines.append(f"public enum CR_{sanitize(name)}: Room {{")
        lines.append("    public typealias Place = ClusterScope")
        lines.append("}")
    lines.append("")
    checked = 0
    for b in bindings:
        meta = b.get("metadata", {})
        bns, bname = meta.get("namespace", ""), meta.get("name", "")
        ref = b.get("roleRef", {})
        rkind, rname = ref.get("kind"), ref.get("name", "")
        keeper = f"B_{sanitize(bns)}_{sanitize(bname)}"
        cert = f"Bind_{sanitize(bns)}_{sanitize(bname)}"
        if rkind == "ClusterRole":
            post, room = "ClusterScope", f"CR_{sanitize(rname)}"
            key = rbac_key(cluster_roles.get(rname, {}).get("rules"))
            what = f"rolebinding {bns}/{bname} -> clusterrole {rname}"
        else:
            post = f"Ns_{sanitize(bns)}"
            key = rbac_key(roles.get((bns, rname), {}).get("rules"))
            if (bns, rname) in roles:
                room = f"Role_{sanitize(bns)}_{sanitize(rname)}"
            else:
                foreign = sorted(ns for (ns, n) in roles if n == rname)
                room = f"Role_{sanitize(foreign[0])}_{sanitize(rname)}" if foreign else f"Role_{sanitize(bns)}_{sanitize(rname)}"
            what = f"rolebinding {bns}/{bname} -> role {rname}"
        lines.append(f"public enum {keeper}: Keeper {{")
        lines.append(f"    public typealias Post = {post}")
        lines.append(f"    public typealias Key = {key}")
        lines.append("}")
        lines.append(f"public typealias {cert} = Enter<{keeper}, {room}>")
        srcmap[cert] = what
        checked += 1
    world = "\n".join(lines) + "\n"
    with open(out_path, "w") as f:
        f.write(world)
    t0 = time.time()
    outp = subprocess.run([JUDGE, "judge", "where", out_path], capture_output=True, text=True).stdout
    ms = round((time.time() - t0) * 1000, 1)
    refusals = []
    for m in re.finditer(r"^✗ '(\w+)[^']*' requires the types '[^']*' \(aka '([^']+)'\) and '[^']*' \(aka '([^']+)'\) be equivalent", outp, re.M):
        cert, left, right = m.groups()
        if cert not in srcmap:
            continue
        dangling = re.match(r"(\w+)\.Place$", right)
        claim = (f"roleRef names a Role that exists nowhere ({right} undeclared)"
                 if dangling else f"the binding lives in {left}, its Role lives in {right}: a RoleBinding and its Role must share one namespace")
        refusals.append({"certificate": cert, "source": srcmap[cert], "claim": claim})
    canon = "canon v2" in outp
    return {
        "command": "import rbac",
        "world": out_path,
        "namespaces": len(namespaces),
        "roles": len(roles),
        "cluster_roles": len(cluster_roles),
        "bindings_judged": checked,
        "verdict": "refused" if refusals else "holds",
        "refusals": refusals,
        "judge_ms": ms,
        "canon_handshake": canon,
        "note": "tier one (verb class, Who.Key: Writes) is the compiler's: judged when the world is built as Swift; this run holds the posting equalities (agnostic where-judge)",
    }


