def policy_path():
    # the policy file sits BESIDE the world, the way the manifest does
    if not FACTS:
        return None
    p = os.path.join(os.path.dirname(os.path.abspath(FACTS)), "gate.policy.swift")
    return p if os.path.exists(p) else None


def read_policy():
    # Who somebody is, and what an action demands, are FACTS — declared in
    # gate.policy.swift and travelling through git like every other fact: one
    # truth, a history, a pull request. The CSVs seeded them once, and are read
    # only while no policy file states them yet.
    #   public enum MailBoss: Identity { public typealias Person = Emp9001 }
    #   extension MailBoss { public static var typeName: String { "boss@corp" } }
    #   public enum MergePolicy { public typealias Requires = Manager }
    # The file stays out of the judged list — the reference judge does not read
    # a typeName extension inside a world (a recorded gap) — so status guards
    # it instead: an identity naming nobody is refused by line there.
    # The SHARED repo only, never the personal world: guard is a team gate, and
    # its verdict must be the same on this machine and on CI, where no personal
    # world exists. A personal file rebinding an email must change nothing.
    ids, rules, where = {}, {}, {}
    pp = policy_path()
    for name, path in ([(os.path.basename(pp), pp)] if pp else []):
        text = open(path).read()
        for m in re.finditer(r"(?:public\s+)?enum\s+(\w+)\s*:[^{\n]*\bIdentity\b[^{\n]*\{(.*?)\n\}", text, re.S):
            who = re.search(r"typealias\s+Person\s*=\s*(\w+)", m.group(2))
            mail = re.search(rf"extension\s+{m.group(1)}\b.*?typeName.*?\"([^\"]+)\"", text, re.S)
            if who and mail:
                ids[mail.group(1)] = who.group(1)
                where[mail.group(1)] = (name, text[:m.start()].count("\n") + 1)
        for m in re.finditer(r"(?:public\s+)?enum\s+(\w+)Policy\s*\{(.*?)\n\}", text, re.S):
            req = re.search(r"typealias\s+Requires\s*=\s*(\w+)", m.group(2))
            if req:
                rules[m.group(1).lower()] = req.group(1)
                where["policy:" + m.group(1).lower()] = (name, text[:m.start()].count("\n") + 1)
    return ids, rules, where


def policy_guards():
    # the policy file is not in the judged list (the judge does not read its
    # extension form), so status guards it: every Person an identity names
    # must be declared by the world, and every Requires must be a real name.
    pp = policy_path()
    if not pp:
        return []
    ids, rules, where = read_policy()
    # ── WHAT THE WORLD DECLARES, AND ITS FORMS WITH IT. A person is declared in
    # the world; a rank is declared in the forms the world is written in, which
    # `world_files()` does not return. The guard below therefore could not see a
    # single rank, and fell back to asking whether the word merely LOOKED like a
    # name — so `Requires = NoSuchRank` passed, capitalised and meaningless, and
    # this tool said the world holds. The comment over it had promised for weeks
    # that every Requires must be a real name.
    #
    # The set is gathered without this mechanism learning any world's vocabulary:
    # it asks what is declared anywhere the world reads, never what a rank is.
    #
    # ── AND THE TWO QUESTIONS ARE NOT ONE QUESTION. A rank is a word of a form,
    # and the wide set below is right for it. A person is a RECORD, and a record
    # lives in the judged files: `world_people()` is that narrower set, asked here
    # and by `guard merge`, which had been asking its own.
    people = world_people()
    declared = set(people)
    texts = []
    base = os.path.dirname(MANIFEST["manifest"]) if MANIFEST else "."
    for r in ((MANIFEST.get("rows") if MANIFEST else None) or []):
        if r["role"] == "forms" and os.path.exists(os.path.join(base, r["path"])):
            texts.append(open(os.path.join(base, r["path"]), encoding="utf-8",
                              errors="replace").read())
    texts += list(STDLIB.values())
    for text in texts:
        declared |= set(re.findall(r"(?:public\s+)?enum\s+(\w+)\s*:", text))
    bad = []
    for mail, who in ids.items():
        if who not in people:
            f, ln = where.get(mail, (os.path.basename(pp), 1))
            bad.append({"address": f"{f}:{ln}",
                        "claim": f"an identity names `{who}`, and the world declares no such person"})
    for action, rank in rules.items():
        f, ln = where.get("policy:" + action, (os.path.basename(pp), 1))
        if not re.match(r"^[A-Z]\w*$", rank):
            bad.append({"address": f"{f}:{ln}",
                        "claim": f"the {action} policy requires `{rank}`, which is not a name"})
        elif declared and rank not in declared:
            bad.append({"address": f"{f}:{ln}",
                        "claim": f"the {action} policy requires `{rank}`, and nothing this world "
                                 "reads declares it. A policy naming a rank nobody has is a "
                                 "policy that can never be met"})
    return bad


def next_rung(refused, serving=False):
    # ONE next step, chosen by what the repository already has: a reader is on
    # a rung, and a product that lists the whole ladder teaches nothing.
    #
    # ── AND A STEP IS A STEP FROM WHERE THE READER IS STANDING. This ladder is
    # written for a terminal, and the bench printed it word for word, so a
    # person who had just opened `gate serve` was told, at the foot of that very
    # page, to run `gate serve`. A rung that names the room you are already in
    # is not a step, and it says the tool does not know where you are. The
    # ladder is the same ladder either way: what `serving` changes is that the
    # bench counts as taken, which is the same rule the rest of this function
    # follows, that a rung already taken is not offered.
    #
    # ── AND EACH RUNG SAYS WHAT YOU GET, NOT WHAT YOU WILL BE STOPPED FROM.
    # `so what does not hold cannot be committed` is the same act said as a
    # prohibition: true, and it leaves a person hearing that they will be
    # refused rather than that their word will start standing. Every line here
    # names the thing that becomes yours once the step is taken.
    if refused:
        return ("the refusal names its line: click it and the file opens there" if serving else
                "open the address above, or run `gate serve` and watch the verdict move as you type")
    root = os.path.dirname(os.path.abspath(FACTS)) if FACTS else "."
    hooked = subprocess.run(["git", "config", "--get", "core.hooksPath"], cwd=root,
                            capture_output=True, text=True).stdout.strip()
    if not hooked:
        return "run `gate init .` to wire the hook: from here on, what you commit is what holds"
    # ── AND THE RUNG AFTER ENTRY IS THE LETTER THAT JUST ARRIVED. Straight from
    # the hook to `who may merge` skips the only thing standing in the repository
    # at that moment: a page of ours, now theirs, with the lesson in it. A ladder
    # is only useful while it names the step the reader is actually on.
    rows = [r for r in ((MANIFEST.get("rows") if MANIFEST else None) or []) if r.get("path")]
    said_something = FACTS and os.path.exists(FACTS)

    def arrived_by_taking(rel):
        # a taken page says so in its own first line, which is where the revision
        # it came from is written: so «has this person said anything of their own
        # yet» is read from the files rather than from a list of names in here
        p = os.path.join(root, rel)
        try:
            return "Origin: gate's shelf" in open(p, errors="replace").read()
        except OSError:
            return False

    if rows and not said_something and all(arrived_by_taking(r["path"]) for r in rows) \
            and any(os.path.basename(r["path"]) == "readme.swift" for r in rows):
        # ── AND THE RUNG STOPS ANNOUNCING WHAT THE NEXT SCREEN ALREADY SAYS. The
        # bench opens on the letter, so a rung describing the letter spends a line on
        # a thing the reader is about to be looking at. Two words is the whole step.
        if not serving:
            return "gate serve"
    if not policy_path():
        return "say who may merge: gate.policy.swift"
    ci = os.path.join(root, ".github", "workflows")
    if not os.path.isdir(ci):
        return ("put `gate status` in the CI you already run: from then on nobody reads a diff "
                "to know the claims still hold")
    # and on the bench that last rung is the room itself: a ladder whose steps
    # are all taken says nothing rather than inventing a step
    return ("" if serving else
            "run `gate serve` for the bench: your world on the left, the verdict on the right, "
            "and a page of your own beside them")


def cmd_guard(a):
    # guard [merge] — the repository's OWN action policy by the same gates:
    # a git object (the HEAD author) → an identity declared in the world → a
    # probe entry of an existing form (VerifiedAtRank) → judgement. CI and
    # hooks only transport the verdict.
    import csv

    action = a[0] if a else "merge"
    if not FACTS or not os.path.exists(FACTS):
        cannot("guard reads who may act from a world, and there is no world here",
               "run `gate init .` to start one, or `gate demo` for a repository to look at")
    world_dir = os.path.dirname(os.path.abspath(FACTS)) or "."
    email = subprocess.run(
        ["git", "log", "-1", "--format=%ae"], cwd=world_dir, capture_output=True, text=True
    ).stdout.strip()
    identities, rules, where = read_policy()
    stated_in = "gate.policy.swift"
    if not identities and not rules and TABLES:   # a world that has not stated them yet
        stated_in = "tables (a seed): declare them in the world to put them under review"
        idp, gp = os.path.join(TABLES, "identities.csv"), os.path.join(TABLES, "guard.csv")
        if os.path.exists(idp):
            identities = {r["email"]: r["id"] for r in csv.DictReader(theirs_text(idp))}
        if os.path.exists(gp):
            rules = {r["action"]: r["requires_rank"] for r in csv.DictReader(theirs_text(gp))}
    if action not in rules:
        cannot(f"no policy states who may {action}",
               f"declare `public enum {action.capitalize()}Policy {{{{ public typealias Requires = <rank> }}}}` in gate.policy.swift")
    required = rules[action]
    who = identities.get(email)
    if not who:
        return {"command": f"guard {action}", "author": email, "policy_from": stated_in, "verdict": "refused",
                "refusals": [{"address": os.path.basename(FACTS), "claim": f"author {email} is not mapped to any person: an unknown identity performs no guarded action"}]}
    # the shared world alone, and now literally the same reading `status` makes:
    # this line had gathered its own set under a comment saying it was the same
    if who not in world_people():   # a policy naming nobody is not a policy
        f, ln = where.get(email, (os.path.basename(FACTS), 1))
        return {"command": f"guard {action}", "author": f"{email} = {who}", "policy_from": stated_in,
                "verdict": "refused",
                "refusals": [{"address": f"{f}:{ln}",
                              "claim": f"an identity names `{who}`, and the world declares no such person"}]}
    text = open(FACTS).read()
    probe = last_entry_insert(text, "VerifiedAtRank", {"first": who, "args_second": required}, 8)
    r = judge(with_temp(probe))
    return {"command": f"guard {action}", "author": f"{email} = {who}", "requires": required,
            "policy_from": stated_in, **r, "mutates": False}


def cmd_library(a):
    # library [-o lib.json] | library diff a.json b.json — the domain vocabulary:
    # forms (entry heads + gates), axes, seed coverage. Forms carry no facts:
    # a library is shareable, client data never is (SAT5: a domain has one
    # canonical vocabulary; two worlds are subsets of it).
    # a vocabulary is read out of a world, and this verb read FACTS without
    # asking whether there is one: in a repository with no world it opened None
    # and raised. It is the verb `check` sends people to for the names they may
    # use, so a stranger following that sentence met a stack trace.
    if not a and not (FACTS and os.path.exists(FACTS)):
        cannot("library reads the vocabulary a world is written in, and there is no "
               "world here",
               "run `gate init .` to start one, or `gate demo` for a repository to look "
               "at. `gate library diff a.json b.json` needs no world")
    if a and a[0] == "diff":
        la = theirs_json(a[1], "a library printed by `gate library -o`")
        lb = theirs_json(a[2], "a library printed by `gate library -o`")
        A, B = set(la["forms"]), set(lb["forms"])
        return {
            "command": "library diff",
            "shared": sorted(A & B),
            "only_first": sorted(A - B),
            "only_second": sorted(B - A),
            "note": "the union is safe by construction: one domain has one canonical vocabulary (SAT5), so a difference is teachable form, never client data",
        }
    out_path = a[a.index("-o") + 1] if "-o" in a else None
    text = open(FACTS).read()
    heads = sorted(set(re.findall(r"(\w+)<\s*\w+,\s*\w+\s*>\.self;?", text)))
    axes = sorted(set(re.findall(r"public typealias (\w+) = ", text)))
    lib = {"forms": heads, "axes": axes}
    if TABLES:  # coverage: which catalogue seeds the world holds (verify --self)
        v = cmd_verify([os.path.join(TABLES, "people.csv"), os.path.join(TABLES, "grants.csv")])
        if "seeds" in v:
            lib["coverage"] = {s["seed"]: ("held" if s["world"] == "refused" else "no gate") for s in v["seeds"]}
    result = {"command": "library", "facts": FACTS, **lib,
              "next": "run `gate status` to judge what this vocabulary is used to say"}
    if out_path:
        with open(out_path, "w") as f:
            json.dump(lib, f, indent=2, sort_keys=True)
        result["wrote"] = out_path
    return result


def cmd_guard_deps(a):
    # guard deps [manifest lock] — git's own soil: manifest ↔ lockfile.
    # The adapter prints a world: the lock declares "package@version" atoms,
    # a manifest requirement REFERENCES its pin's atom through an axis — a
    # drift "resolves to nothing" with an address. Not one new form.
    manifest_p = a[0] if a else "package.json"
    lock_p = a[1] if len(a) > 1 else "package-lock.json"
    manifest = theirs_json(manifest_p, "a package manifest")
    lock = theirs_json(lock_p, "the lockfile your resolver wrote")
    deps = manifest.get("dependencies", {})
    pins = {
        name.replace("node_modules/", ""): info.get("version")
        for name, info in lock.get("packages", {}).items()
        if name.startswith("node_modules/")
    }
    atom = lambda n, v: (n + "_" + v).replace("-", "_").replace(".", "_").replace("@", "").replace("/", "_")
    lines = ["// printed by gate guard deps: the lockfile declares the atoms,",
             "// the manifest's requirements reference them, so a drift fails to resolve.", ""]
    srcmap = {}
    for n, v in sorted(pins.items()):
        lines.append(f"public enum {atom(n, v)}: Close {{}}")
    lines.append("")
    for n, want in sorted(deps.items()):
        pinned = pins.get(n)
        target = atom(n, want.lstrip("=v")) if want[0].isdigit() or want.startswith("=") else (atom(n, pinned) if pinned else atom(n, "unpinned"))
        lines.append(f"public enum Req_{atom(n, '')[:-1]}: Close {{")
        srcmap[len(lines)] = f"{os.path.basename(manifest_p)} · \"{n}\": \"{want}\""
        lines.append(f"    public typealias Pin = {target}")
        lines.append("}")
    orphans = sorted(set(pins) - set(deps))
    world = "\n".join(lines) + "\n"
    d = scratch("gate-deps-")
    p = os.path.join(d, "deps-gate.swift")
    open(p, "w").write(world)
    r = judge(p)
    for ref in r["refusals"]:
        n = int(ref["address"].split(":")[1])
        for k in range(max(0, n - 2), n + 2):
            if k in srcmap:
                ref["source"] = srcmap[k]
    out = {"command": "guard deps", "requirements": len(deps), "pins": len(pins), **r}
    if orphans:
        out["orphan_pins"] = orphans
        out["verdict"] = "refused"
        out["refusals"] = out["refusals"] + [
            {"address": os.path.basename(lock_p), "claim": f"pin {o}@{pins[o]} is required by nothing: a leftover after removal"}
            for o in orphans
        ]
    out["note"] = ("a sketch, and not a product path: only orphan pins are detected. A missing "
                   "pin yields a holds that means nothing, because the judge resolves no axis "
                   "without a reading premise. Native ecosystem lockfile checkers already cover "
                   "this class")
    return out


def turned(surface):
    # ── A WHEEL THE OPERATOR TURNED, read from their own files. The bench read
    # these and the command line did not, so a declaration that said what your
    # journal shows only meant anything while a page was open — and when the
    # journal left the page, it would have meant nothing at all. A surface this
    # tool offers has to be answered by the thing that still does the showing.
    out = {}
    for _, path in bench_files():
        if not os.path.exists(path):
            continue
        # A COMMENT IS NOT A DECLARATION. `bench-atoms` documents this very wheel
        # by showing one — `///     public enum MyJournal: Journal {` — and this
        # read the example as the operator's own answer, so `gate log` in this
        # repository quietly obeyed a line written to explain it. The word typed
        # afterwards then looked broken, because it was overriding something
        # nobody had declared. Comments go before anything is read.
        text = "\n".join(ln for ln in
                         open(path, encoding="utf-8", errors="replace").read().split("\n")
                         if not ln.strip().startswith("//"))
        for m in re.finditer(r"public enum \w+: " + surface + r" \{(.*?)\n\}", text, re.S):
            for a in re.finditer(r"public typealias (\w+) = (\w+)", m.group(1)):
                out[a.group(1)] = a.group(2)
    return out


def repo_journal(n=200, scope="world", only_me=False):
    # the journal VIEW — git's own history projected, no translation needed:
    # every clone already carries it (append-only, I3). Observed, NOT judged:
    # a commit is closed iff reachable from the default branch, open otherwise.
    #
    # scope="world" (the default) is the history OF THE WORLD FILES: a client's
    # repository carries code too, and this bench is a workbench for the world.
    # git does the filtering itself, by pathspec. scope="all" is the repository.
    import csv as _csv

    base = os.path.dirname(os.path.abspath(FACTS)) if FACTS else "."
    default = None
    for cand in ("origin/HEAD", "main", "master"):
        r = subprocess.run(["git", "rev-parse", "--verify", "-q", cand],
                           cwd=base, capture_output=True, text=True)
        if r.returncode == 0:
            default = cand
            break
    merged = set()
    if default:
        merged = set(subprocess.run(["git", "rev-list", default], cwd=base,
                                    capture_output=True, text=True).stdout.split())
    identities = {}
    idcsv = os.path.join(TABLES, "identities.csv") if TABLES else None
    if idcsv and os.path.exists(idcsv):
        identities = {r["email"]: r["id"] for r in _csv.DictReader(theirs_text(idcsv))}
    world = set(os.path.relpath(p, base) for p in world_files()) if FACTS else set()
    pp = policy_path()
    if pp:   # the policy is a fact beside the world: its history belongs here
        world.add(os.path.relpath(pp, base))
    # ── AND A WORLD OF FORMS IS STILL A WORLD, HERE TOO. `status` learned this
    # and the journal did not: `world_files()` is the PLAIN court's list and
    # rightly holds no forms row, so a repository whose whole world is grammar
    # was told there was nothing narrower than the repository — and then sent to
    # `gate demo` for a world to look at, by a person standing in one. Whose
    # history this is does not depend on which court reads the file.
    if MANIFEST:
        d = os.path.dirname(MANIFEST["manifest"])
        for r in (MANIFEST.get("rows") or []):
            if r["role"] == "forms":
                fp = os.path.join(d, r["path"])
                if os.path.exists(fp):
                    world.add(os.path.relpath(fp, base))
    # ── A SCOPE THAT CANNOT BE HONOURED SAYS SO. Asking for the world's history
    # where no file is declared a world file narrowed nothing and showed the
    # whole repository under the word `the repository` — true about what was
    # printed, silent about the word having done nothing. This tool's own
    # repository is exactly that case: it declares forms and a layout and no
    # world of facts at all, so `gate log world` and `gate log` printed the same
    # hundred and ninety-nine commits and neither said why.
    narrowed = not (scope == "world" and not world)
    args = ["git", "log", "--all", f"-{n}", "--format=%x01%H%x1f%ae%x1f%aI%x1f%s", "--name-only"]
    if scope == "world" and world:
        args += ["--", *sorted(world)]
    fmt = subprocess.run(args, cwd=base, capture_output=True, text=True).stdout
    commits, cur = [], None
    for line in fmt.splitlines():
        if line.startswith("\x01"):
            if cur:
                commits.append(cur)
            h, email, when, subject = (line[1:].split("\x1f") + ["", "", "", ""])[:4]
            cur = {"hash": h, "short": h[:8], "email": email,
                   "person": identities.get(email), "when": when,
                   "subject": subject, "files": [], "touches_world": False,
                   "closed": (h in merged) if merged else None}
        elif line.strip() and cur is not None:
            cur["files"].append(line.strip())
            if line.strip() in world:
                cur["touches_world"] = True
    if cur:
        commits.append(cur)
    me = subprocess.run(["git", "config", "user.email"], cwd=base,
                        capture_output=True, text=True).stdout.strip()
    if only_me and me:
        commits = [c for c in commits if c["email"] == me]
    return {"command": "log", "default_branch": default, "scope": scope, "limit": n,
            "mine_only": bool(only_me), "narrowed": narrowed,
            "next": ("run `gate status` to have the judge read what these commits changed"
                     if world else
                     "run `gate demo` for a repository to look at, or drop a table you already export "
                     "into tables/ and run `gate status`"),
            "me": me, "world_files": sorted(world), "commits": commits}


def commit_change(sha, path=None):
    # what a commit did, read as FACTS where it can be: this is a world, and
    # `Rank: Manager -> Lead` is what changed, not `-`/`+` around plumbing.
    # Lines that are not a fact change stay lines; git's own noise (index,
    # ---/+++, @@) is never shown, because nobody reads a world through it.
    base = os.path.dirname(os.path.abspath(FACTS)) if FACTS else "."
    fmt = subprocess.run(["git", "show", "--format=%H%x1f%an%x1f%ae%x1f%aI%x1f%s", "--no-color", sha]
                         + (["--", path] if path else []),
                         cwd=base, capture_output=True, text=True).stdout.split("\n")
    head = (fmt[0].split("\x1f") + ["", "", "", "", ""])[:5]
    files, cur, owner = [], None, None
    for ln in fmt[1:]:
        if ln.startswith("diff --git"):
            cur = {"name": ln.split(" b/")[-1].strip(), "changes": []}
            files.append(cur)
            owner = None
        elif cur is None or ln[:1] in ("", None) and not ln:
            continue
        elif ln.startswith(("index ", "--- ", "+++ ", "new file", "deleted file",
                            "old mode", "new mode", "similarity", "rename ")):
            continue
        elif ln.startswith("@@"):
            m = re.search(r"@@.*@@\s*(.*)$", ln)
            d = re.search(r"(?:enum|protocol|struct)\s+(\w+)", m.group(1) if m else "")
            owner = d.group(1) if d else None
        elif ln[:1] in (" ", "-", "+"):
            body = ln[1:]
            d = re.search(r"(?:public\s+)?(?:enum|protocol|struct)\s+(\w+)", body)
            if d:
                owner = d.group(1)
            if ln[0] == " ":
                continue
            cur["changes"].append({"kind": "line", "sign": ln[0], "text": body.rstrip(),
                                   "owner": owner})
    # pair a removal with the addition that restates the same fact
    for f in files:
        paired, i = [], 0
        cs = f["changes"]
        while i < len(cs):
            a = cs[i]
            b = cs[i + 1] if i + 1 < len(cs) else None
            ma = re.match(r"\s*(?:public\s+)?typealias\s+(\w+)\s*=\s*(.+?)\s*$", a["text"])
            mb = re.match(r"\s*(?:public\s+)?typealias\s+(\w+)\s*=\s*(.+?)\s*$", b["text"]) if b else None
            if ma and mb and a["sign"] == "-" and b["sign"] == "+" and ma.group(1) == mb.group(1):
                paired.append({"kind": "fact", "owner": a["owner"], "key": ma.group(1),
                               "from": ma.group(2), "to": mb.group(2)})
                i += 2
                continue
            paired.append(a)
            i += 1
        f["changes"] = paired
    return {"hash": head[0], "short": head[0][:8], "author": head[1], "email": head[2],
            "date": head[3], "subject": head[4], "files": files}


def cmd_vendor(root):
    # init --vendor: the tool travels WITH the repository, the way ./gradlew
    # does. One person commits .gate/, and everybody who pulls has it — no
    # install step exists, no curl into a shell, and a security review reads
    # it as what it is: code in their own repo, pinned by a commit. The judge
    # is pinned too, so an old commit is judged by the judge it was written
    # with, which is what makes `git bisect` over facts exact.
    here = os.path.dirname(os.path.abspath(__file__))
    dst = os.path.join(root, ".gate")
    os.makedirs(os.path.join(dst, "bin"), exist_ok=True)
    import hashlib
    carried = []
    # the port's own front end travels too: a clone on another platform has a court
    # only if the file that speaks for it is here
    os.makedirs(os.path.join(dst, "bin"), exist_ok=True)
    pcli = os.path.join(here, "bin", "judge-cli.js")
    if os.path.exists(pcli):
        shutil.copy(pcli, os.path.join(dst, "bin", "judge-cli.js"))
    os.makedirs(os.path.join(dst, "web"), exist_ok=True)
    os.makedirs(os.path.join(dst, "docs"), exist_ok=True)
    # ── AND BOTH COURTS TRAVEL, OR THE CARRY IS HALF A TOOL. `bin/judge.js`
    # went and `bin/judge-where.js` stayed, so a vendored clone on a platform
    # the binary does not run on answered `status` with "the court was asked
    # `judge where` and did not answer in its own canon" — the guard against a
    # silent court doing its job over a hole this verb dug. Read by carrying
    # gate into a fresh repository, hiding the binary, and asking.
    for rel in ("gate", "bin/judge.js", "bin/judge-where.js", "web/ui.html",
                "web/codemirror.js", "web/codemirror.css", "LICENSE", "docs/NOTICE.md"):
        src = os.path.join(here, rel)
        if os.path.exists(src):
            shutil.copy(src, os.path.join(dst, rel))
            carried.append(rel)
    for rel in ("stdlib",):
        src = os.path.join(here, rel)
        if os.path.isdir(src):
            shutil.copytree(src, os.path.join(dst, rel), dirs_exist_ok=True)
            carried.append(rel + "/")
    jsrc = os.path.join(here, "bin", "gate-judge")
    digest = None
    if os.path.exists(jsrc):
        shutil.copy(jsrc, os.path.join(dst, "bin", "gate-judge"))
        os.chmod(os.path.join(dst, "bin", "gate-judge"), 0o755)
        with open(jsrc, "rb") as f:
            digest = hashlib.sha256(f.read()).hexdigest()
        carried.append("bin/gate-judge")
        # ── AND WHAT IT WAS BUILT FROM, which is the dependency itself. The
        # bytes travelled and the revision beside them did not, so a vendored
        # copy said "the revision this judge was built from is not recorded" —
        # losing the one fact this tool calls the real dependency, and leaving a
        # world that had written the revision down in its own row unable to
        # check its own claim. Nothing compared the two until a guard was put
        # between them; the loss had been silent since vendoring existed.
        if os.path.exists(jsrc + ".from"):
            shutil.copy(jsrc + ".from", os.path.join(dst, "bin", "gate-judge.from"))
            carried.append("bin/gate-judge.from")
    os.chmod(os.path.join(dst, "gate"), 0o755)
    shim = os.path.join(root, "gatew")
    with open(shim, "w") as f:
        f.write('#!/bin/sh\n# gate, carried by this repository. Nothing to install.\n'
                'exec python3 "$(dirname "$0")/.gate/gate" "$@"\n')
    os.chmod(shim, 0o755)
    with open(os.path.join(dst, "README.md"), "w") as f:
        f.write("# gate, carried by this repository\n\n"
                "Run `./gatew status`. Nothing to install: this directory is the tool\n"
                "itself, pinned by the commit that added it, so every clone judges with\n"
                "the same judge and an old commit is judged by the judge it was written\n"
                "with.\n\n"
                f"judge sha256: {digest}\n\n"
                "The judge is rebuilt from a public corpus: `bin/build-judge.sh <pin>`\n"
                "builds the same judge, and the battery checks a build,\n"
                "`GATE_JUDGE=path tests/smoke.py`. The linker is not byte-stable, so\n"
                "the hash above names what is here and is not the check.\n\n"
                "MIT licensed: LICENSE and docs/NOTICE.md are here beside it.\n")
    return {"carried": carried, "judge_sha256": digest, "shim": "./gatew"}


