    # forms (entry heads + gates), axes, seed coverage. Forms carry no facts:
    # a library is shareable, client data never is (SAT5: a domain has one
    # canonical crystal; two worlds are subsets of it).
    if a and a[0] == "diff":
        la, lb = json.load(open(a[1])), json.load(open(a[2]))
        A, B = set(la["forms"]), set(lb["forms"])
        return {
            "command": "library diff",
            "shared": sorted(A & B),
            "only_first": sorted(A - B),
            "only_second": sorted(B - A),
            "note": "the union is safe by construction: one domain has one canonical crystal (SAT5); a difference is teachable form, never client data",
        }
    out_path = a[a.index("-o") + 1] if "-o" in a else None
    text = open(FACTS).read()
