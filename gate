    if cmd == "declare":
        return cmd_declare(rest)
    if cmd == "seam":
        return cmd_seam(rest)
    if cmd == "aside":
        return cmd_aside(rest)
    if cmd == "attention":
        return cmd_attention(rest)
    if cmd == "badge":
        return cmd_badge(rest)
    if cmd == "import" and rest and rest[0] == "refs":
        return cmd_import_refs(rest[1:])
    if cmd == "import" and rest and rest[0] == "rbac":
        return cmd_import_rbac(rest[1:])
    if cmd == "import":
        return cmd_import(rest)
    if cmd == "export":
        return cmd_export(rest)
    if cmd == "verify":
        return cmd_verify(rest)
    if cmd == "init":
        return cmd_init(rest)
    if cmd in ("status", "fsck"):
        files = world_files()
        # A WORLD OF FORMS IS STILL A WORLD. `world_files` is the plain court's
        # list and rightly holds no forms row — but emptiness there was being
        # read as emptiness altogether, so a repository that declares its
        # grammar and nothing else was told it had nothing. That repository is
        # this one: gate's own facts about its surface are forms, judged by the
        # where court, and until now the tool could not see the shape it is.
        if not files and not (MANIFEST and MANIFEST.get("rows")):
