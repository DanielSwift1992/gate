                            # left the last shelf's name on it and no former
                            # value at all — a fact about a world, attributed to
                            # whichever world happened to be read last.
                            was = re.search(r"^public typealias " + name + r" = (.+)$",
                                            STDLIB[shelf], re.M)
                            if was:
                                overridden[name] = {"file": path, "world": shelf,
                                                    "was": was.group(1).rstrip()}
                    # AND HOW EACH FILE ASKS TO BE FIRST MET, in its own words.
                    opens = {n: opens_as(p)[0] for n, p in named
                             if os.path.exists(p) and opens_as(p)[0]}
                    # ── AND THE SIDES OF A SEAM, WHICH THE LAYOUT DECLARES AND
                    # THE RAIL DID NOT SHOW. A seam side is not a fragment of
                    # this world — its court is `gate seam`, and sweeping one
                    # into the judged list broke a world once — so it is not a
                    # bench file. It is still a row of the document open on the
                    # screen: the bench listed two files by name in the layout
                    # and offered no way to open either, which is the one thing
                    # this page must never do. Read-only, by the route that
                    # already exists for exactly this.
                    here_root = os.path.dirname(MANIFEST["manifest"]) if MANIFEST else "."
                    seam_rows = [r["path"] for r in
                                 ((MANIFEST.get("rows") if MANIFEST else None) or [])
                                 if r["role"] == "seam"
                                 and os.path.exists(os.path.join(here_root, r["path"]))]
                    body = json.dumps({"files": names,
                                       "layout": lay if lay in names else None,
                                       "forms": forms_rows,
                                       # here and nobody declared: readable, not
                                       # judged, and one gesture from being either
                                       "undeclared": here_undeclared,
                                       # and the courts a row may name, said once,
                                       # here, so the page never keeps a second list
                                       # of them to drift from this one
                                       "roles": ROLES,
                                       "opens": opens,
                                       "seams": seam_rows,
                                       "overridden": overridden,
                                       # WHERE THE COURT WAS TAKEN, so the one
                                       # line a stranger asks about — "why is
                                       # this already here, I took nothing" —
                                       # can be clicked through to the row that
                                       # says so, in their own file.
                                       "judge_claim": next(
                                           ({"file": os.path.relpath(MANIFEST["manifest"],
                                                                     os.path.dirname(FACTS)),
                                             "line": r["line"]}
                                            for r in ((MANIFEST.get("rows") if MANIFEST else None) or [])
                                            if r["role"] == "judge"), None),
                                       "personal": names[-1] if pf else None,
                                       "personal_empty": bool(pf) and not os.path.exists(pf)}).encode()
                    self.send_response(200)
                    self.send_header("Content-Type", "application/json")
                    self.send_header("Cache-Control", "no-store")
                    self.end_headers()
                    self.wfile.write(body)
                    return
                if u.path == "/world":
                    # the UI obeys the declared layout: ?f= names a file FROM the list
                    p = self.pick(q)
                    if not p:
                        return self.no_world()
                    if not os.path.exists(p):   # yours, and nobody has written in it
                        self.send_response(200)
                        self.send_header("Content-Type", "text/plain; charset=utf-8")
                        self.send_header("Cache-Control", "no-store")
                        self.end_headers()
                        self.wfile.write(PERSONAL_TEMPLATE.encode())
                        return
                    return self.send_file(p, "text/plain; charset=utf-8")
                if u.path == "/gitstatus" and not FACTS:
                    return self.no_world()
                if u.path == "/gitstatus":
                    # the honest state: a write lands in the working copy; git
                    # carries the history. This says whether the file is
                    # committed or has uncommitted changes — never our own save.
                    base = os.path.dirname(os.path.abspath(FACTS))
                    p = self.pick(q)
                    st = subprocess.run(["git", "status", "--porcelain", "--", p], cwd=base, capture_output=True, text=True)
                    tracked = subprocess.run(["git", "ls-files", "--error-unmatch", p], cwd=base, capture_output=True)
                    state = ("untracked" if tracked.returncode else
                             ("modified" if st.stdout.strip() else "committed"))
                    body = json.dumps({"file": os.path.relpath(p, base), "git": state}).encode()
                    self.send_response(200)
                    self.send_header("Content-Type", "application/json")
                    self.send_header("Cache-Control", "no-store")
                    self.end_headers()
                    self.wfile.write(body)
                    return
                if u.path == "/log":
                    # ── AND A NUMBER THAT IS NOT ONE IS SAID, NOT DROPPED. `?n=`
                    # comes off a URL, which is a place anybody can type into:
                    # `int()` raised a ValueError inside the handler, the socket
                    # closed with no response written, and the page's own fetch
                    # showed a network error with no words in it. Silence is the
                    # thing this tool exists against, and this is its own room.
                    _n = q.get("n", "200")
                    if not (_n.isdigit() and 0 < int(_n) <= 100000):
                        cannot(f"the history is read in commits, and `n={_n}` is not a count",
                               "ask for a whole number of commits, such as `?n=200`")
                    out = repo_journal(int(_n), q.get("scope", "world"))
                elif u.path == "/show":
                    out = commit_change(q.get("hash", ""), q.get("f") or None)
                elif u.path == "/status":
                    out = dispatch("status", [])
                    # the ladder, read from this room: whoever is asking is
                    # looking at the bench, so the rung that opens the bench is
                    # a rung already taken.
                    #
                    # ── AND NOT WHERE THERE IS NO WORLD TO CLIMB FROM. This line
                    # ran unconditionally and threw away the step status had
                    # chosen for a repository that has none: in a clone of
                    # hashicorp/terraform the terminal said "run `gate log` to
                    # read this repository's own history" and this page said
                    # "run `gate init .` to wire the hook", a hook over nothing,
                    # about the same tree in the same second. `next_rung` is the
                    # ladder for a world; the no-world answer carries its own
                    # step and its own second step, and neither names this room.
                    if out.get("verdict") != "no world here":
                        out["next"] = next_rung(bool(out.get("refusals")), serving=True)
                    # the bench asks the same question the terminal does, so it
                    # gets the same ready command back rather than re-deriving it
                    ready = command_in(out)
                    if ready:
                        out["command_to_run"] = ready
                elif u.path == "/attention":
                    # THE SEAMS THIS REPOSITORY IS PARTY TO. A declaration is a
                    # world in the contract grammar, so the pair is found by what
                    # the files SAY they are rather than by where they sit: one
                    # states records, the other claims them, and a repository may
                    # be either side or both. Where nobody has declared anything
                    # there is nothing to show and the bench says so — an empty
                    # account is a fact, and inventing a specimen to fill it
                    # would be the one lie this thing cannot afford.
                    out = {"command": "attention", "seams": seams_here()}
                elif u.path == "/check/view":
                    # ── AND A QUESTION MISSING A WORD IS ANSWERED, NOT DROPPED.
                    # These read the query straight, so a request without `who`
                    # raised KeyError inside the handler: the connection died
                    # with no response at all, and the page saw a network error
                    # where a sentence belonged.
                    if not (q.get("who") and q.get("doc")):
                        cannot("check view asks who, and about what",
                               "/check/view?who=Emp0042&doc=FinanceShare")
                    out = cmd_ask([q["who"], q["doc"]])
                elif u.path == "/diff/transfer":
                    if not (q.get("who") and q.get("to")):
                        cannot("diff transfer asks who moves, and where to",
                               "/diff/transfer?who=Emp0042&to=Sales")
                    out = cmd_change(["transfer", q["who"], q["to"]])
                else:
                    self.send_response(404); self.end_headers(); return
            except Cannot as e:
                out = e.said()
            except SystemExit as e:
                out = {"error": str(e)}
            # ── AND NOTHING LEAVES THIS ROOM WITHOUT WORDS. A reading this
            # handler had not thought of raised, and the socket closed with no
            # response at all: the page's fetch showed a network error, which
            # reads as "the bench is gone" rather than "that request was wrong".
            # The trace still goes to whoever is running the bench, on its own
            # stderr, because hiding it from the operator would be the other
            # half of the same mistake.
            except Exception as e:
                traceback.print_exc()
                out = {"error": f"this request was not one the bench could read: "
                                f"{type(e).__name__}", "next":
                       "the terminal answers the same questions and says more: "
                       "`gate status`, `gate log`, `gate findings`"}
            body = json.dumps(out, ensure_ascii=False).encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

        def pick(self, q):
            # only the judged list is servable or writable: the manifest's files
            # plus your personal world
            # ── AND THE DEFAULT IS A FILE THAT EXISTS. `FACTS` is the path a
            # world file WOULD have; a world laid out entirely by manifest —
            # this repository, and now the first scene — has no such file, and
            # asking without `?f=` then fell through to "yours, and nobody has
            # written in it" and served the empty personal template as the world.
            # A door that opens on the wrong room while saying nothing.
            named = dict(bench_files())
            if q.get("f", "") in named:
                return named[q["f"]]
            # ── AND A FILE NOBODY DECLARED IS STILL A FILE THAT IS HERE. It cannot be
            # judged, and refusing to show it as well would leave a person reading
            # about a file in the verdict with no way to look at it.
            if q.get("f", "") in undeclared_here():
                return os.path.join(os.path.dirname(MANIFEST["manifest"]), q["f"])
            # ── AND A NAME THIS WORLD DOES NOT CARRY IS NOT ANSWERED WITH ANOTHER
            # FILE. Asked for a file it has no row and no neighbour for, this fell
            # through to the world's first page and served it with a 200: the door
            # opening on the wrong room while saying nothing, which is the shape
            # the comment above was written against for the empty case. A name
            # given and not found is a miss, and the fallback below is for the
            # question that named nothing at all.
            if q.get("f"):
                return None
            if FACTS and os.path.exists(FACTS):
                return FACTS
            return next((p for _, p in bench_files() if os.path.exists(p)), FACTS)

        def no_world(self):
            self.send_response(404)
            self.send_header("Cache-Control", "no-store")
            self.end_headers()

        def do_PUT(self):
            # the single writing handle: world files — they ARE the source
            # (plumbing stays open, judgement stays inevitable)
            self.fresh_layout()
            u = urlparse(self.path)
            q = {k: v[0] for k, v in parse_qs(u.query).items()}
            if u.path == "/declare":
                # ── AND THE GESTURE IS A ROW, WRITTEN WHERE YOU CAN READ IT. This
                # page may not hold state the files do not hold: what a person
                # sees here is their repository, and a button that changed the
                # world through a channel outside it would be exactly the drift
                # this tool exists against. So declaring is `gate mine PATH
                # --role R`, the verb already spelled, and the answer says which
                # file it wrote and at which line, so the panel can put you in
                # front of the line rather than announce it in a bar that fades.
                # Taking the row back needs nothing from here: it is a line in a
                # file open in this editor, and deleting a line is deleting a line.
                rel, role = q.get("f", ""), q.get("role", "")
                d = os.path.dirname(MANIFEST["manifest"]) if MANIFEST else "."
                if rel not in undeclared_here():
                    out = {"asks": True, "note": f"{rel} is not an undeclared file here"}
                elif role not in ROLES:
                    out = {"asks": True, "roles": ROLES,
                           "note": "a row says which court reads the file, and this says none"}
                else:
                    out = cmd_side([os.path.join(d, rel), "--role", role], "Mine")
                    globals()["MANIFEST"] = read_manifest(d)
                    mp = out.get("declared_in")
                    said = next((r for r in ((MANIFEST or {}).get("rows") or [])
                                 if r["path"] == rel), None)
                    if mp and said:
                        out["wrote_in"] = os.path.relpath(mp, d)
                        out["at_line"] = said["line"]
                body = json.dumps(out, ensure_ascii=False).encode()
                self.send_response(200 if out.get("wrote_in") else 400)
                self.send_header("Content-Type", "application/json")
                self.send_header("Cache-Control", "no-store")
                self.end_headers()
                self.wfile.write(body)
                return
            if u.path == "/value":
                # ── SAYING A VALUE IS WRITING A DECLARATION IN A FILE OF MINE.
                # The bench could show what a world holds and never let anybody
                # answer: a table you may read and not write in. Answering does
                # not edit the world that shipped the name — nothing here may —
                # it puts your own declaration in your own file, which is what
                # an override has always been. It is born from the edit instead
                # of being typed somewhere else and discovered later.
                name, to = q.get("name", ""), q.get("to", "")
                mine = my_forms_file()
                if not re.fullmatch(r"\w+", name) or not re.fullmatch(r"-?\d+", to):
                    return self.refuse_value("a value is a name and a number")
                if not mine:
                    return self.refuse_value(
                        "no file of yours is read by the where court yet, so there is nowhere "
                        "for your answer to live. Make one and say so: "
                        "gate mine my-values.swift --role forms")
                if len(mine) > 1:
                    return self.refuse_value(
                        "you present more than one file to that court, "
                        + ", ".join(os.path.basename(m) for m in mine)
                        + ", and this cannot choose between them")
                path = mine[0]
                said = "public typealias %s = %s" % (name, spell_number(int(to)))
                body = open(path, encoding="utf-8").read() if os.path.exists(path) else ""
                lines = body.split("\n")
                at = next((i for i, ln in enumerate(lines)
                           if re.match(r"public typealias " + name + r" = ", ln.strip())), None)
                if at is None:
                    if lines and lines[-1] == "":
                        lines[-1] = said
                        lines.append("")
                    else:
                        lines.append(said)
                else:
                    lines[at] = said
                with open(path, "w", encoding="utf-8") as f:
                    f.write("\n".join(lines))
                out = json.dumps({"wrote": said,
                                  "file": os.path.relpath(path, os.path.dirname(
                                      MANIFEST["manifest"]) if MANIFEST else "."),
                                  "line": (at if at is not None else len(lines) - 1) + 1}).encode()
                self.send_response(200)
                self.send_header("Content-Type", "application/json")
                self.send_header("Cache-Control", "no-store")
                self.end_headers()
                self.wfile.write(out)
                return
            if u.path != "/world":
                self.send_response(404); self.end_headers(); return
            n = int(self.headers.get("Content-Length", 0))
            text = self.rfile.read(n).decode()
            # ── A WRITE NAMES ITS FILE OR IT DOES NOT HAPPEN. Reading may fall
            # back to something sensible; writing may not, and `pick` fell back
            # for both. In a world laid out entirely by manifest the fallback is
            # the FIRST file that exists, which is the manifest, so a PUT that
            # arrived without a name overwrote the document that says what the
            # world is. That is how a seam world lost its layout to the text of
            # an unwritten personal page: one request with an empty `?f=`.
            #
            # The list of writable names is the bench's own list and nothing
            # else. A name outside it is refused rather than routed anywhere.
            p = dict(bench_files()).get(q.get("f", ""))
            if not p:
                self.send_response(404); self.end_headers(); return
            if p == personal_path():
                write_personal(text)     # empty means gone, not an empty file
            else:
                with open(p, "wb") as f:
                    f.write(text.encode())
            self.send_response(200); self.end_headers()

        def refuse_value(self, why):
            out = json.dumps({"asks": True, "note": why}).encode()
            self.send_response(409)
            self.send_header("Content-Type", "application/json")
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(out)

        def do_POST(self):
            # /verdict?f=rel — judge the WHOLE declared list with the active
            # file replaced by the editor's unsaved text (cross-file, server-side)
            self.fresh_layout()
            u = urlparse(self.path)
            q = {k: v[0] for k, v in parse_qs(u.query).items()}
            if u.path != "/verdict":
                self.send_response(404); self.end_headers(); return
            n = int(self.headers.get("Content-Length", 0))
            text = self.rfile.read(n).decode()
            base = os.path.dirname(os.path.abspath(FACTS))
            active = self.pick(q)
