            # no commits was sent to read its own history, which sent it back to
            # status: two rungs pointing at each other and nothing to stand on.
            # Where there is nothing at all, the one step that produces something
            # is a world to look at.
            commits = subprocess.run(["git", "rev-list", "--count", "HEAD"],
                                     capture_output=True, text=True).stdout.strip()
            has_past = commits.isdigit() and int(commits) > 0
            return {"command": "status", "verdict": "no world here", "refusals": [],
                    "next": ("run `gate log` to read this repository's own history: nothing to translate"
                             if inside and has_past else
                             "run `gate demo` for a repository to look at: a CODEOWNERS, a policy, and one refusal"
                             if inside else "run `gate init .` to start a world in this folder"),
                    # ── AND THE SECOND RUNG IS THE ONE THIS REPOSITORY CAN
                    # ACTUALLY TAKE. `drop your CSVs into tables/` was the org
                    # world's path and stayed here after the first scene became
                    # a repository's own ownership: a person standing in a clone
