# and all of it was somebody else's repository being decorated by a tool that says
# it does not decorate.
#
# What is left is the hook, which is the one thing entry is FOR, and it comes with
# the line that puts it back. The letter arrives the way anything of ours arrives:
# taken, with its origin written down, through the same verb a person uses for
# everything else. Tables are theirs and arrive by `gate import`.
INIT_FILES = {
    # ── AND THE HOOK FINDS THE TOOL, OR SAYS SO AND STOPS. It ran `gate status`,
    # which works for whoever has gate on their PATH and fails with
    # `gate: command not found` for everybody else — including anybody following
    # this project's own README, which says to run it as `./gate` from a clone until
    # it is installed. Entry then broke the next commit of the repository it had
    # just entered, with a message about a shell. A vendored copy is looked for
