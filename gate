#!/usr/bin/env python3
# gate — a static layer of logical integrity over git: the world of facts
# lives in the client's own repository, the judge answers in milliseconds,
# a refusal names the line. Spec: docs/PRODUCT.md. Human output by default,
# --json for machines. Dry-run by default: apply writes only on holds.

import json, os, re, shutil, subprocess, sys, tempfile, time, traceback

# GATE_CORPUS: optional checkout of the theory corpus — needed only for the
# compiler-path verbs (check administer|delete, apply into the corpus world).
ROOT = os.environ.get("GATE_CORPUS")


# THE ROLES A ROW MAY HAVE, and each one names a different court. This is not
# decoration on a row: it decides who reads it. A world row is judged with the
# rest of my world; a seam row is judged only where it meets mine; a forms row
# is read by nothing today — the plain fragment is closed to protocols, so a
# forms row is inert and says so rather than pretending. A row whose role is
# none of these is refused, never swept into the world: that exact sweep broke
# a world once, when every path literal in the manifest was taken as a fact.
ROLES = {
    "world": "judged with the rest of my world, by the plain court",
    "seam": "judged where it meets mine, and nowhere else",
    "forms": "grammar and the certificates over it, judged by the where court",
    "judge": "the court itself: held by a reproducible build, not by judgement",
    "carried": "brought here unchanged: held by its source's name and version, "
               "and by no court of this world",
    "tool": "the tool's own source: held by the battery's parity, "
            "and by no court of this world",
}

# one spelling of the kind-and-role pairing: the manifest's atoms on one
# side, the courts' words on the other. Three readers had grown three
# copies of this table, and the day the tool role landed it had to land
# three times, which is this file failing its own cover.
ROLE_OF_KIND = {"WorldFile": "world", "SeamFile": "seam", "FormsFile": "forms",
                "JudgeFile": "judge", "CarriedFile": "carried",
                "ToolFile": "tool", "Seam": "seam"}
KIND_OF_ROLE = {"world": "WorldFile", "seam": "SeamFile", "forms": "FormsFile",
                "judge": "JudgeFile", "carried": "CarriedFile",
                "tool": "ToolFile"}


def uncommented(text):
    # ── A COMMENT IS NOT A DECLARATION, AND THIS DOCUMENT HAD NO WAY OF SAYING
    # SO. The layout was read by looking for `extension X { … typeName … }`
    # anywhere in the text, and two slashes in front of it changed nothing: a row
    # switched off the way anybody switches a line off went on being declared,
    # judged and counted. The document said one thing to the person reading it
    # and another to the tool reading it, which is the one failure this tool
    # exists against, sitting in the file whose whole job is to say what the
    # layout is. Found by hand in gate's own manifest, where a forms row had been
    # commented out for a day and the file it names was judged the whole time.
    #
    # The comment text goes and the newlines stay, so every line number a
    # refusal carries is still the line it is on in the file.
    return re.sub(r"//[^\n]*", "", text)


# ONE SPELLING OF A ROW. Two places read manifest rows with a regex of their
# own; the day the row form moves, one spelling moves with it.
MANIFEST_ROW_RE = r"public enum (\w+): (Mine|Theirs|WorldFile|SeamFile) \{"


def read_manifest_rows(d, text=None):
    # ONE LIST, AND THE COLUMNS THAT MAKE IT ONE. Whose source a file is
    # (`Mine` / `Theirs`) is one column; which court reads it is another; and
    # for anything taken, the revision it was taken at is a third. Two protocols
    # named for a ROLE — WorldFile, SeamFile — had been carrying all three at
    # once, which is why a forms file fitted nowhere: its source is theirs and its
    # role is neither of the two the names allowed.
    #
    # The older spellings are still read. A file on somebody's disk is not
    # wrong because the tool learned a better word for it.
    mp = os.path.join(d, "gate.manifest.swift")
    if text is None:
        if not os.path.exists(mp):
            return None, None
        text = open(mp, encoding="utf-8", errors="replace").read()
    code = uncommented(text)
    # WHAT A RECORD MAY SAY, IN THE SHAPE EVERY OTHER RECORD USES. An atom
    # carries its facts as AXES — `typealias Kind = Seam` — and exactly one
    # string is allowed, the `typeName` literal that gives a name its spelling.
    # I had invented `var role` and `var from` beside it, which is a second
    # notation nobody else in this world writes, and a revision is an atom of
    # its own: `At = MessagesApi_a1b2c3d`, whose typeName is the revision.
    #
    # Both spellings are read. A file on somebody's disk is not wrong because
    # the tool learned a better word for it.
    lit = {}
    for m in re.finditer(r"extension (\w+)\b[^{]*\{(.*?)\n(?=public |extension |\Z)",
                         code + "\n", re.S):
        f = re.search(r'typeName:\s*String\s*\{\s*"([^"]*)"\s*\}', m.group(2))
        if f:
            lit[m.group(1)] = f.group(1)
    ROLE_OF = ROLE_OF_KIND
    rows = []
    for m in re.finditer(MANIFEST_ROW_RE, code):
        name, atom = m.group(1), m.group(2)
        body = re.search("public enum " + name + r"\b[^{]*\{(.*?)\n\}",
                         code + "\n", re.S)
        inner = body.group(1) if body else ""
        ext = re.search("extension " + name + r"\b[^{]*\{(.*?)\n(?=public |extension |\Z)",
                        code + "\n", re.S)
        outer = ext.group(1) if ext else ""

        def field(k, b=inner + outer):
            f = re.search(k + r':\s*String\s*\{\s*"([^"]*)"\s*\}', b)
            return f.group(1) if f else None

        def axis(k, b=inner + outer):
            a = re.search(r"typealias " + k + r"\s*=\s*(\w+)", b)
            return a.group(1) if a else None
        path = lit.get(name) or field("typeName")
        if not path:
            continue
        source = "mine" if atom in ("Mine", "WorldFile") else "theirs"
        kind = axis("Kind")
        at = axis("At")
        rows.append({"name": name, "source": source, "path": path,
                     # the axis first: it is the shape this world writes in
                     "role": (ROLE_OF.get(kind, kind.lower() if kind else None)
                              or field("role")
                              or ("world" if atom == "WorldFile" else
                                  "seam" if atom == "SeamFile" else None)),
                     "from": (lit.get(at) if at else None) or field("from"),
                     # ── AND WHOSE WORDS IT IS WRITTEN IN, WHICH IS AN AXIS LIKE
                     # ANY OTHER. This lived in a comment in the page's own head,
                     # and a comment is not a declaration: the fact that decides
                     # WHICH LAWS a page's certificates are judged under was the one
                     # fact in this document nothing could judge. It points at
                     # another row of this same document, the way `At` points at a
                     # declared revision.
                     "written": axis("Written"),
                     "opens": axis("Opens"),
                     "line": code[:m.start()].count("\n") + 1})
    if not rows and "Mine" not in code and "WorldFile" not in code:
        # older layouts: a bare list of paths, every one of them a world file
        rows = [{"name": None, "source": "mine", "path": p, "role": "world",
                 "from": None, "line": 0}
                for p in re.findall(r'typeName:\s*String\s*\{\s*"([^"]+)"\s*\}', code)]
    return mp, rows


def leaves_world(path, root):
    # ── AND A LINK LEAVES THE WORLD AS SURELY AS A `..` DOES. The law here is
    # that a row is a claim about this world's own tree, and it was asked of the
    # PATH: `outside.swift` sits in the world, so a row naming it passed, and the
    # link under it pointed at a file two directories up. That world then read a
    # page it does not contain, and the bench SERVED ITS BYTES over the loopback
    # to whoever asked, against the one promise on the cover: what gate reads is
    # your working copy. Both sides are resolved, so the question is about the
    # file rather than about the spelling of the way to it.
    real = os.path.realpath(os.path.join(root, path))
    return os.path.relpath(real, os.path.realpath(root)).split(os.sep)[0] == os.pardir


def read_manifest(d):
    # the layout is a fact of the world: gate.manifest.swift declares files, and
    # the judged world is the rows whose role is `world` — nothing else in the
    # document is a fragment of it
    mp, rows = read_manifest_rows(d)
    if mp is None:
        return None
    return {"manifest": mp, "rows": rows,
            "files": [os.path.join(d, r["path"]) for r in rows if r["role"] == "world"]}


def discover_world():
    # the world is found the way .git is: walking up the tree. THE CANON:
    # gate.swift is the source, not a generated artifact (readable by
    # everything: git diff, a human, the judge, the compiler); tables/ are an
    # input for the first
    # print only (bootstrap) and never override the world. A manifest, if
    # declared, adds layout files — judgement runs over the declared list.
    d = os.getcwd()
    while True:
        w = os.path.join(d, "gate.swift")
        t = os.path.join(d, "tables")
        has_tables = os.path.exists(os.path.join(t, "people.csv")) and os.path.exists(os.path.join(t, "grants.csv"))
        m = read_manifest(d)
        if os.path.exists(w) or has_tables or m:
            return w, (t if has_tables else None), m
        parent = os.path.dirname(d)
        if parent == d:
            return None, None, None
        d = parent


_env_facts = os.environ.get("GATE_FACTS")
if _env_facts:
    FACTS, TABLES, MANIFEST = _env_facts, None, None
else:
    FACTS, TABLES, MANIFEST = discover_world()
    if FACTS is None and ROOT:  # corpus checkout as a last resort
        FACTS = os.path.join(ROOT, "Sources", "Organization", "System", "GeneratedTeam.swift")
        TABLES = None


class Cannot(SystemExit):
    # ── AND THE WORDS TRAVEL ON THE EXCEPTION, because two surfaces say them.
    # The terminal prints them and exits; the bench answers the request with
    # them. Writing them to stderr inside the raiser sent them to the SERVER'S
    # log, where the person reading the page cannot see them, and left the page
    # with `{"error": "1"}`: the exit code, rendered as a sentence.
    def __init__(self, note, then=None):
        self.note, self.then = note, then
        super().__init__(1)

    def said(self):
        return {"error": self.note, **({"next": self.then} if self.then else {})}


def cannot(note, then=None):
    # ── THE NON-ANSWER, SAID ONE WAY. A verb that cannot answer HERE is not a
    # verb with nothing to say: it names what is missing and what to do about it,
    # on stderr, with a code, the way git answers outside a repository. A shell
    # and a person read the same thing then, and a wrapper can tell the case from
    # an answer without parsing prose.
    #
    # Measured in a bare repository before this existed: twenty verbs answered in
    # three shapes. Twelve printed `usage:` on stdout and exited nought, two of
    # them (`library`, `report`) for a missing WORLD rather than a missing
    # argument; six printed a verdict word; and two printed a raw
    # `{"error": …}` object at a person, which is a machine's shape shown to
    # somebody who did not ask for one. `--json` still gets the object, since
    # that is the flag that asks for it.
    raise Cannot(note, then)


def world_files():
    # the judged file list: the main world plus the manifest-declared layout
    files = [FACTS] if FACTS and os.path.exists(FACTS) else []
    if MANIFEST:
        files += [p for p in MANIFEST["files"] if p not in files]
    return files


def world_people():
    # ── WHO THE WORLD DECLARES, ASKED IN ONE PLACE. A person is a record, so a
    # person is declared by a file THIS WORLD DECLARES: the judged list, and the
    # rows the manifest names that carry declarations. The shelf is not one of
    # those, and says so in its own listing: printouts of what the judge carries,
    # not files your world is made of. It is present in every repository on
    # earth, so a set that reads it makes `Anyone`, a bench atom, a person
    # everywhere.
    #
    # Two guards asked this and got two answers. `status` asked the judged files,
    # the manifest's forms rows AND the whole shelf; `guard merge` asked the
    # judged files alone, under a comment reading "the same as the policy". So an
    # identity naming `Anyone` made `status` hold and `guard merge` refuse
    # `gate.policy.swift:1` for naming nobody: one world, one line, two verdicts.
    #
    # AND THE ROWS ARE HERE BECAUSE A REPOSITORY-SHAPED WORLD KEEPS ITS RECORDS
    # IN ONE. `gate demo` and `gate import codeowners` write ownership.swift, a
    # page of grants vocabulary with the owners declared under it, and file it as
    # `forms`: there is no gate.swift on that road at all. Asking the judged list
    # alone refused `Owner_alice` at the very rung the ladder had just offered,
    # in a world whose own line 65 declares them. A manifest row is your file,
    # written by you and reviewed by you; the shelf is theirs. That is the line
    # this set draws, and the wide set in `policy_guards` still stands for a
    # RANK, which is a word of a form and may be one the judge carries with no
    # file here.
    names = set()
    seen = list(world_files())
    base = os.path.dirname(MANIFEST["manifest"]) if MANIFEST else "."
    for r in ((MANIFEST.get("rows") if MANIFEST else None) or []):
        p = os.path.join(base, r["path"])
        if r["role"] in ("world", "forms", "seam") and os.path.exists(p) and p not in seen:
            seen.append(p)
    for p in seen:
        names |= set(re.findall(r"(?:public\s+)?enum\s+(\w+)\s*:",
                                open(p, encoding="utf-8", errors="replace").read()))
    return names


def manifest_guards(rows=None, text=None):
    # layout guards, both directions (the playground manifest's forms):
    # a declared file exists; a neighbouring *.swift is declared (no shadows)
    #
    # `rows` overrides what is on disk, so the bench can hold the layout to the
    # same promise as every other file it opens: judged as you type. Reading the
    # saved copy while somebody edits an unsaved one shows green over a lie.
    # `text` is the document those rows were read from, and it comes with them for
    # the same reason: two of the checks below ask what the DOCUMENT says, and
    # asking the saved copy about rows parsed from an unsaved one is the same
    # green over the same lie, one step further in.
    if not MANIFEST:
        return []
    bad = []
    man = os.path.basename(MANIFEST["manifest"])
    d = os.path.dirname(MANIFEST["manifest"])
    live = MANIFEST.get("rows") if rows is None else rows
    if text is None:
        text = open(MANIFEST["manifest"], encoding="utf-8").read() \
            if os.path.exists(MANIFEST["manifest"]) else ""
    live_text = uncommented(text)
    seen_paths = {}
    for r in live or []:
        # A ROLE IS NOT OPTIONAL, because it names the court. Left unsaid it has
        # to be guessed, and the one time this document was read by guessing —
        # every path literal taken as a world file — the seams were swept into
        # the judged world and the world broke. Guessing is the failure mode, so
        # the row that does not say is refused at its own line.
        # AND THIS IS A SCAFFOLD, SAID PLAINLY. Routing by role is gate's own
        # mechanics until the prism empties, and the name a role gives ought to
        # be resolved by the judge the way `Rank = Blah` already is — «the name
        # Blah resolves to nothing». It is not, yet: that tier fires only for an
        # axis whose requirements the judge knows, and those come from a map
        # naming one reference world's protocols. So the check below is a stand-in wearing its
        # own name, not a court. A scaffold with a judged input would be honest;
        # a scaffold calling itself a court would not, and the difference is the
        # whole of what this tool sells.
        atom = KIND_OF_ROLE.get(r["role"])
        # only where the row is written as an AXIS to an atom. The older
        # spelling made the role the protocol itself — `enum GrantsFile:
        # WorldFile` — and that document has no atom to declare; this tool reads
        # it on purpose, and a guard that refuses what the reader accepts would
        # be the two halves disagreeing about one file.
        if atom and ("public typealias Kind = " + atom) in live_text \
                and ("public enum " + atom + ": Role {}") not in live_text:
            bad.append({"address": f"{man}:{r['line']}",
                        "claim": f"`{r['name']}` is filed under `{r['role']}` and this document "
                                 f"declares no `{atom}`: a column is an axis to a declared atom, "
                                 "and a name nothing declares names nothing"})
        if r["path"] in seen_paths:
            bad.append({"address": f"{man}:{r['line']}",
                        "claim": f"`{r['name']}` is a second row about {r['path']}, which "
                                 f"`{seen_paths[r['path']]}` already speaks for: one file, one "
                                 "row, or two rows can say different things about it"})
        seen_paths[r["path"]] = r["name"]
        # ── AND A ROW MAY NOT NAME A FILE OUTSIDE THE WORLD. Found by walking
        # this repository's own history: eight rows once named absolute paths
        # into a test run's temp directories, and the world held, because those
        # files existed on the machine that wrote them. On any other machine the
        # same document refuses. A row is a claim about this world's own tree, so
        # a path that leaves the world is not a row about anything anybody else
        # can read.
        if leaves_world(r["path"], d):
            bad.append({"address": f"{man}:{r['line']}",
                        "claim": f"`{r['name']}` names {r['path']}, which is outside this world: "
                                 "a row is a claim about this world's own tree, and a path that "
                                 "leaves it holds only on the machine that wrote it"})
        if not r["role"]:
            bad.append({"address": f"{man}:{r['line']}",
                        "claim": f"`{r['name']}` does not say what it is for. A row names its court: "
                                 + " · ".join(f"`{k}` — {v}" for k, v in ROLES.items())})
        elif r["role"] == "seam" and os.path.exists(os.path.join(d, r["path"])) \
                and not is_seam_side(os.path.join(d, r["path"])):
            # ── AND A ROW MAY NOT SEND A FILE TO A COURT THAT CANNOT READ IT.
            # The check above asks only whether the role names A court, not
            # whether it names the right one — so `Kind = SeamFile` on a file of
            # forms held, and the row said "judge this where it meets somebody
            # else's world" about a file that meets nobody. For most courts what
            # "right" means is not readable from the file. For a seam it is: a
            # side says which side it is, in its own first lines, and that rule
            # is already how seams are found at all.
            bad.append({"address": f"{man}:{r['line']}",
                        "claim": f"`{r['name']}` is filed under `seam`, and {r['path']} does not "
                                 "say it is one side of one: a side states a contract or claims "
                                 "to carry one, in its own first lines"})
        elif r["role"] not in ROLES:
            bad.append({"address": f"{man}:{r['line']}",
                        "claim": f"`{r['name']}` is for `{r['role']}`, which no court here reads. "
                                 "A row gate cannot place is refused, never quietly taken as a "
                                 "fragment of your world: " + " · ".join(ROLES)})
        # AND WHAT IS TAKEN IS TAKEN AT A REVISION. There are no ranges anywhere
        # in this tool, which is the whole reason no version solver exists — but
        # a pin nobody wrote down pins nothing, and until now the revision lived
        # in side channels beside the file rather than in the list that accounts
        # for it.
        if r["source"] == "theirs" and not r["from"]:
            bad.append({"address": f"{man}:{r['line']}",
                        "claim": f"`{r['name']}` is theirs and does not say which revision it was "
                                 "taken at. Taken means taken from somewhere, at something: "
                                 "`gate theirs " + r["path"] + " --at REV`"})
    # ── AND A ROW THAT NAMES NO FILE NAMES NOTHING. Every check above judges a
    # row the reader built, and the reader builds one only where a `typeName` says
    # which file the row is about. So a record with a role and no name at all was
    # not refused, it was invisible: the document carried a column about nothing
    # and nothing said a word. This is the law the writing verbs already keep —
    # a write names its file or it does not happen — read from the other end.
    named = {r["name"] for r in (live or [])}
    for m in re.finditer(MANIFEST_ROW_RE, live_text):
        if m.group(1) in named:
            continue
        at = live_text[:m.start()].count("\n") + 1
        bad.append({"address": f"{man}:{at}",
                    "claim": f"`{m.group(1)}` is a row and names no file: a row is about one file, "
                             f"said as `extension {m.group(1)} {{ public static var typeName: "
                             "String { \"path\" } }`. Give it one or take the row out"})
    # ── A ROW OF ANY ROLE NAMES A FILE, AND A GHOST IS A GHOST WHICHEVER COURT
    # WOULD HAVE READ IT. The shadow check below was widened to every role and
    # this one was left at `world`, so a declared forms file could simply vanish
    # and nothing said a word. This repository is entirely forms rows: deleting
    # `stdlib/bench-palette.swift` took a hundred and thirty-two equalities out
    # of the court and `gate status` answered `holds`. The only trace was the
    # width — the count went from 180 to 48 — and a green that quietly narrows
    # is the exact failure this tool exists against, standing in its own repo.
    # A COURT OF THIS WORLD READS world, seam and forms, and their absence
    # narrows it silently; `judge` and `carried` name a dependency rather than a
    # file this world judges — the judge's row is provenance held by a
    # reproducible build, and those two are accounted for by guards of their own.
    for r in (live or []):
        if r["role"] not in ("world", "seam", "forms"):
            continue
        p = os.path.join(d, r["path"])
        if not os.path.exists(p):
            bad.append({"address": f"{man}:{r['line']}",
                        "claim": f"the manifest declares {r['path']}, and no such file exists: "
                                 "either the file is gone or the row is, and a row for a file "
                                 "nobody has is a court with nothing to check"})
    # ── AND A PAGE MAY NOT SAY IN PROSE WHAT ITS ROW DOES NOT DECLARE. Whose words
    # a page is written in decides which laws its certificates are judged under, and
    # it lived in a comment in the page's own head — the one fact in this document
    # nothing could judge, doing a declaration's work. The comment may stay as
    # prose; it may not be the only place the fact is said.
    for r in (live or []):
        if r["role"] != "forms" or not r.get("path"):
            continue
        p = os.path.join(d, r["path"])
        if not os.path.exists(p):
            continue
        head = open(p, encoding="utf-8", errors="replace").read(1200).split("\n")[:8]
        said = next((re.search(r"stdlib show ([\w-]+)", ln) for ln in head
                     if ln.startswith("//") and "written in" in ln), None)
        if not said:
            continue
        want = said.group(1) + ".swift"
        # ── AND A PAGE THAT CARRIES THE WORDS NEEDS NO ROW FOR THEM. An emitted
        # world glues the forms it is written in INTO itself — the importer prints
        # both on one page — and there the head line is provenance, not a boundary:
        # the names are right here. The column is owed only where the words are
        # somewhere else, which is the whole of what it is for.
        mine_names = {n for n, _ in top_names(open(p, encoding="utf-8", errors="replace").read())}
        theirs = {n for n, _ in top_names(STDLIB.get(said.group(1), ""))}
        if theirs & mine_names:
            continue
        row = next((x for x in (live or []) if x.get("name") == r.get("written")), None)
        if not row or os.path.basename(row["path"]) != want:
            bad.append({"address": f"{man}:{r['line']}",
                        "claim": f"`{r['name']}` says in its own head that it is written in "
                                 f"{want}, and this row does not declare it: add "
                                 f"`public typealias Written = <the row for {want}>`. Which laws a "
                                 "page is judged under is a column, not a comment"})
    # A SHADOW IS A FILE NOBODY SPOKE FOR, and a row of ANY role has been spoken
    # for. Reading only the world rows here called a declared seam side — and
    # then a declared forms file — a shadow, which is an accusation about
    # something that was claimed out loud in the document being read.
    declared = ({os.path.join(d, r["path"]) for r in (live or [])}
                | {MANIFEST["manifest"], os.path.join(d, "gate.swift"),
                   os.path.join(d, "gate.policy.swift")})  # meta, like the manifest itself
    # AND A SHADOW IS A SHADOW WHEREVER THE WORLD KEEPS ITS FILES. This walked the
    # manifest's own directory alone, so «no shadows» was a promise about one
    # folder while the world lived in another: an undeclared file beside eleven
    # declared ones in `stdlib/` was nobody's shadow, and this repository keeps
    # every one of its worlds there. The walk goes wherever a row points, which is
    # the only set of directories this document speaks about at all.
    # one reading of what is here and undeclared, shared with the panel: the guard
    # refuses it, the rail offers the row that would end the refusal
    for rel in undeclared_here():
        bad.append({"address": rel,
                    "claim": "this file sits beside the judged ones and has no row in the "
                             "manifest, so it is not judged. `gate mine PATH --role R` adds "
                             "the row"})
    return bad


def undeclared_here():
    # ── WHAT IS HERE AND NOBODY DECLARED. The shadow guard already walks exactly this
    # set to refuse it, and the panel had no way to show it: drop a row and the file
    # left the rail at the moment the verdict began naming it, gone from the place you
    # could click and present in the place you can only read. One reading, two uses:
    # the guard says it is not judged, the rail says it is here and offers the row.
    if not MANIFEST:
        return []
    d = os.path.dirname(MANIFEST["manifest"])
    rows = MANIFEST.get("rows") or []
    declared = ({os.path.join(d, r["path"]) for r in rows if r.get("path")}
                | {MANIFEST["manifest"], os.path.join(d, "gate.swift"),
                   os.path.join(d, "gate.policy.swift")})
    spoken = {d} | {os.path.dirname(os.path.join(d, r["path"])) for r in rows if r.get("path")}
    out = []
    for dd in sorted(spoken):
        if not os.path.isdir(dd):
            continue
        for f in sorted(os.listdir(dd)):
            p = os.path.join(dd, f)
            # ── AND A LINK THAT LEAVES IS NOT A FILE OF THIS WORLD AT ALL. This
            # list is what the shadow guard names and what the bench SERVES on
            # `/world?f=`, so a symlink pointing two directories up put a page
            # from outside on the loopback for anybody to read, against the one
            # promise on the cover: what gate reads is your working copy. The
            # declaring guard refuses such a row, so listing it also offered a
            # step the tool would refuse.
            if f.endswith(".swift") and p not in declared and not is_seam_side(p) \
                    and not leaves_world(os.path.relpath(p, d), d):
                out.append(os.path.relpath(p, d))
    return out


def law_notes(*texts):
    # ── A LAW'S OWN SENTENCE, READ FROM THE FILE THE LAW IS WRITTEN IN. A `///`
    # note directly above a declaration is what somebody wrote about that record
    # — the bench has always shown them — and a law is a record like any other.
    # So the sentence a refusal wears is not a table in this file: it is the
    # world's, in the world's words, and a fork that renames the law renames what
    # its refusals say without anyone touching the tool.
    out = {}
    for text in texts:
        lines = (text or "").split("\n")
        for i, line in enumerate(lines):
            m = re.match(r"public (?:protocol|enum|typealias) (\w+)", line.strip())
            if not m or m.group(1) in out:
                continue
            said = []
            for j in range(i - 1, -1, -1):
                s = lines[j].strip()
                if not s.startswith("///"):
                    break
                said.insert(0, s[3:].strip())
            if said:
                out[m.group(1)] = " ".join(said).strip()
    return out


def plainly(claim, notes):
    # the where court's sentence, said the way the plain court says its own:
    # `X against Y`, and then the law in the words the law was written in. The
    # raw line names two GENERIC PARAMETERS — `Who.Post`, `What.Place` — which
    # belong to the form's declaration and to nothing the reader wrote.
    m = re.match(r"'(\w+)[^']*' requires the types '[^']*' \(aka '([^']+)'\) and "
                 r"'[^']*' \(aka '([^']+)'\) be equivalent(?: \[(\w+)\])?", claim)
    if not m:
        return claim
    cert, left, right, law = m.groups()
    said = notes.get(law or "")
    return f"{cert} · {left} against {right}" + (f": {said}" if said else "")


def forms_guards(size=None, live=None):
    # ── AND HOW WIDE IT WAS. `size`, if given, is filled with what the where
    # court counted. A green with no width is the one thing this tool says it
    # will not print — and in its own repository, which is forms only, that is
    # exactly what `gate status` printed: `holds`, and no number under it. The
    # court has always counted; nothing read the line.
    # A FORMS ROW IS JUDGED, AND I HAD SIMPLY NOT CALLED THE COURT. It was
    # reported inert on the strength of one probe — a conformance the plain
    # judge refuses — and the probe was the wrong shape: `where` does not check
    # bare conformance at all, so a green over nought uses said nothing either
    # way. Given the certificates it does read, it judges them with teeth: the
    # bench's own palette holds 119 equalities under it.
    #
    # AND THE SET IT JUDGES IS THE EFFECTIVE ONE. A world you present replaces a
    # value in a world this tool ships — and for a while nothing then judged the
    # result: the certificates stayed in the shipped file, the numbers moved to
    # yours, and the two never met. So an operator could repaint the verdict
    # channel green and be shown refusals in the colour of agreement, with the
    # court silent. Freedom to say any number is the point; freedom to escape
    # the law about it never was. Your line stands where theirs stood, and every
    # certificate that shipped goes on testing what you put there.
    if not MANIFEST:
        return []
    d = os.path.dirname(MANIFEST["manifest"])
    live = live or {}
    # ── JUDGED AS YOU TYPE, HERE TOO. The layout was held to that promise and
    # the forms rows were not: this court read the SAVED copy while somebody was
    # editing an unsaved one, so a law broken in the editor stayed invisible and
    # the bench showed the old verdict calmly. In the first scene the file a
    # person is invited to break IS a forms row, so the whole lesson happened
    # where nothing was looking.
    rows = [r for r in (MANIFEST.get("rows") or []) if r["role"] == "forms"
            and (r["path"] in live or os.path.exists(os.path.join(d, r["path"])))]
    if not rows:
        return []
    # The certificate court runs on either judge: the binary answers it as
    # `judge where`, and the port answers it in bin/judge-where.js with the
    # same lines, held together by the battery's parity checks. For a stretch
    # this returned the rows as unjudged wherever the binary could not run,
    # because a court that did not sit may not look like one that found
    # nothing; the port now sits.
    bad = []
    # ONE STREAM PER SHIPPED WORLD, in the order the manifest gives — `where`
    # over a LIST is blind, and its silence is selective by order.
    def body_of(r):
        return live.get(r["path"]) if r["path"] in live else \
            open(os.path.join(d, r["path"]), encoding="utf-8", errors="replace").read()

    streams, seen = [], set()
    for shelf in sorted(STDLIB):
        text, mine, clash = presented_over(shelf, live)
        bad += clash
        if mine:
            streams.append((shelf, text, mine, {}, None))
            seen |= set(mine)
    # ONE WORLD, ONE ENCODING: the forms rows of one layout are one world laid out
    # in files, so they are glued and judged together, in the order the manifest
    # gives. A law split across two of them is judged rather than skipped, and that
    # guarantee is older than this note and stands on its own vector.
    #
    # WHAT I TRIED HERE AND TOOK BACK OUT: judging each row as its own encoding, to
    # stop a law two pages both declare from being counted twice. It does stop that,
    # and it breaks the guarantee above, and the duplicate it was working around is
    # not a fact of the design — it is a defect of THIS repository's own shelf, which
    # is exempt from the very check that refuses it in anybody else's (see
    # `presented_over`: shipped paths are skipped). Thirteen of the equalities this
    # repository printed were one law counted a second time, and the fix is to stop
    # declaring one law twice, not to regroup the court.
    own = []
    for r in rows:
        own.append(body_of(r))
    streams.append((None, "\n".join(own), {}, {}, None))
    where = {}
    for r in rows:
        for i, line in enumerate(body_of(r).split("\n"), 1):
            m = re.match(r"public (?:typealias|enum|protocol) (\w+)", line.strip())
            if m and m.group(1) not in where:
                where[m.group(1)] = f"{r['path']}:{i}"
    streams = [(s, t, mi, (w or where), h) for s, t, mi, w, h in streams]
    tmp = scratch("gate-forms-")
    for shelf, text, mine, where, home in streams:
        fp = os.path.join(tmp, (shelf or "presented") + ".swift")
        open(fp, "w").write(text)
        out = judge_call(["judge", "where", fp]).stdout
        bad += canon_guard(out, ("THE WHERE" in out and "canon v" in out) or "✗" in out,
                           "judge where")
        for cert, claim in where_refused(out):
            # the address is the file that SAYS the certificate; where a shipped
            # law refuses a value you presented, it lands on the line you wrote
            spot = where.get(cert) if cert else None
            if not spot and mine:
                touched = [n for n in mine if n in claim]
                spot = where.get(touched[0]) if touched else None
                if not spot and touched:
                    spot = mine[touched[0]]
            bad.append({"address": spot or home or rows[0]["path"],
                        "claim": plainly(claim, law_notes(text))})
        if size is not None:
            m = re.search(r"(\d+) equalities and (\d+) memberships judged across (\d+) uses", out)
            if m:
                size["equalities"] = size.get("equalities", 0) + int(m.group(1))
                size["memberships"] = size.get("memberships", 0) + int(m.group(2))
                size["uses"] = size.get("uses", 0) + int(m.group(3))
    shutil.rmtree(tmp, ignore_errors=True)
    return bad



ONE_LINE_GATE = re.compile(r"^\s*(?:public )?extension\s+\w+\s*:\s*\w+\b.*\bwhere\b.*\{\s*\}\s*$")


def gate_shape_guards():
    # ── A LAW WRITTEN ON ONE LINE IS NOT A LAW, AND BOTH COURTS GO SILENT
    # TOGETHER. Found by hand on this tool's own demo world: move a single
    # newline in the forms file —
    #
    #     extension Owns: Owned                        →  extension Owns: Owned
    #     where Who.Key: Administers, …  {}               where … {}   (one line)
    #
    # — and `refused 1` becomes `holds` over nought judged, in the shipped
    # binary and in the browser port alike. Every certificate over that law stops
    # being checked and nothing says a word, which is the exact silence this
    # tool exists against. Swift accepts both spellings identically, so the
    # compiler tier would still catch it; the fast tier, which is the one anybody
    # runs on a keystroke, would not — and that is the tier people trust.
    #
    # The judge is the corpus's and pinned; this is not ours to fix there. What
    # is ours is to refuse the shape rather than let a world be quietly unjudged.
    bad = []
    seen = []
    if MANIFEST:
        d = os.path.dirname(MANIFEST["manifest"])
        seen += [(r["path"], os.path.join(d, r["path"]))
                 for r in (MANIFEST.get("rows") or []) if r["role"] == "forms"]
    for name, path in seen:
        if not os.path.exists(path):
            continue
        for i, line in enumerate(open(path, encoding="utf-8", errors="replace")
                                 .read().split("\n"), 1):
            if ONE_LINE_GATE.match(line):
                bad.append({"address": f"{name}:{i}",
                            "claim": "a gated conformance written on one line is read by no court: "
                                     "break the line before `where` and the law is judged again. "
                                     "Left as it is, every certificate over it holds without "
                                     "being checked"})
    return bad


def own_surface_guards():
    # ── THE TABLE OF VERBS AND THE DISPATCH, HELD TO EACH OTHER BY NAME. gate's
    # own reference is a world of records rather than a page of prose, and a
    # world is only worth the guard that holds it to what it is about. A verb
    # with no record is undocumented; a record with no verb is a promise this
    # tool no longer keeps. Both are refused at a line.
    #
    # Which file a thing is cannot be judged — it is bytes and paths, and no
    # world speaks about a filesystem. So this is a guard from fact, and it says
    # so: the reference is judged for what it says about itself, and held here
    # for whether it is true of this tool.
    if not MANIFEST:
        return []
    d = os.path.dirname(MANIFEST["manifest"])
    rows = [r for r in (MANIFEST.get("rows") or []) if r["role"] == "forms"
            and os.path.abspath(os.path.join(d, r["path"])) in SHIPPED_PATHS
            # ── THE TABLE OF VERBS LIVES IN THE PAGE THAT IS THE TABLE. It used to
            # be the second half of the letter, and a letter carrying sixty-eight
            # records of somebody else's content is a letter with ballast: the
            # records subtract a real second truth (a doc claiming a verb is safe
            # beside a tool where it writes) and they do not do it on a first
            # screen. Split, they are held in their own world and the guard follows
            # the table rather than the name of a page.
            and os.path.basename(r["path"]) == "verbs.swift"]
    if not rows:
        return []
    name = rows[0]["path"]
    text = open(os.path.join(d, name), encoding="utf-8", errors="replace").read()
    lines = text.split("\n")
    said, at = {}, {}
    for i, line in enumerate(lines, 1):
        m = re.match(r"public enum (\w+): (Verb|Spelling) \{", line.strip())
        if m:
            spelt = re.search("extension " + m.group(1) + r" \{ public static var typeName: "
                              r'String \{ "([^"]+)" \} \}', text)
            if spelt:
                said[spelt.group(1)] = m.group(1)
                at[spelt.group(1)] = i
    src = open(os.path.abspath(__file__), encoding="utf-8").read()
    verbs = set(re.findall(r'cmd\s*==\s*"([a-z-]+)"', src))
    for grp in re.findall(r'cmd\s+in\s+\(([^)]*)\)', src):
        verbs |= set(re.findall(r'"([a-z-]+)"', grp))
    for grp in re.findall(r'args\[0\]\s+in\s+\(([^)]*)\)', src):
        verbs |= set(x.lstrip("-") for x in re.findall(r'"([a-z-]+)"', grp))
    bad = []
    for word in sorted(said.keys() - verbs):
        bad.append({"address": f"{name}:{at[word]}",
                    "claim": f"`gate {word}` is a record here and no word the dispatch answers to: "
                             "a promise this tool no longer keeps"})
    for word in sorted(verbs - said.keys()):
        bad.append({"address": name,
                    "claim": f"`gate {word}` is a word this tool answers to and no record here says "
                             "so: a verb nobody is told about"})
    return bad


def is_seam_side(path):
    # ONE SIDE OF A SEAM IS NOT A SHADOW OF THIS WORLD. It is a different kind of
    # thing entirely — what somebody said about an agreement — and it says which
    # it is in its own first lines. Read as a stray world file it earned two
    # refusals from anybody who both declared a layout and used a seam, which is
    # the whole of what this tool is against: an accusation about something that
    # was never claimed.
    try:
        head = open(path, encoding="utf-8", errors="replace").read(4000)
    except OSError:
        return False
    return bool(re.search(r"^public enum \w+: Carrier \{\}", head, re.M)
                or re.search(r"^public enum F_\w+: Declared \{", head, re.M))


# ── the personal world: yours, in your own git, never in the shared repo ──
# A file hidden inside the shared repo would be state without history, and the
# canon is that git is the only state. So the personal layer is a repository of
# its own, in your home, made on first use. The shared clone stays untouched:
# nothing to review, nothing to ignore, and CI — which has no such home — judges
# the shared world alone. Privacy is the repository boundary, not a policy.

PERSONAL_TEMPLATE = """\
// Yours. It is judged together with the files beside it, and it is never in the
// shared repository: your colleagues and CI do not have it. Write a claim you
// want to keep true, and the judge names the line when somebody else's change
// breaks it. Left as it is, it is not stored anywhere.
//
// It lives on this machine, in a git of its own at ~/.gate/me, and every state
// that holds is kept there. It goes nowhere else: no clone of the shared
// repository will have it, and neither will your other computer, unless you
// give that repository a remote of your own.
//
// One thing about the page: the record below names its theme. Change Dark to
// Light and the page follows on the next keystroke, which is the whole
// mechanism of this place in one line: the file is the panel. Delete the
// record and the page follows this machine's own setting instead. For a
// while these lines were left commented, so that your first word here would
// be yours; written out they show where changing something lands, and that
// is worth more.

public enum MyBench: Bench {
    public typealias Theme = Dark
}
"""



def personal_root():
    return os.environ.get("GATE_ME") or os.path.join(os.path.expanduser("~"), ".gate", "me")


_origin_read = {}


def git_home(base):
    # the directory that holds `.git`, found by walking up the way git does.
    # Real path, because that is what git itself prints, and this stands in for
    # `git rev-parse --show-toplevel` where the answer is plainly on disk.
    d = os.path.realpath(base)
    while True:
        g = os.path.join(d, ".git")
        if os.path.isdir(g):
            return d
        if os.path.isfile(g):        # a worktree or a submodule: .git points elsewhere
            return None
        parent = os.path.dirname(d)
        if parent == d:
            return None
        d = parent


def origin_url(base):
    # ── AND ASKING GIT COSTS A PROCESS. The answer takes microseconds and
    # starting git takes ten milliseconds, and this is asked once per file the
    # bench lists, on every request: opening one file spent most of its time
    # launching git five times to be told the same URL, which is the pause a
    # person feels between clicking a name and seeing the page. The URL lives in
    # .git/config, which is a file. Its bytes are read every time, so a remote
    # added a second ago is seen; git is asked again only when they differ.
    home = git_home(base)
    cfg = os.path.join(home, ".git", "config") if home else None
    raw = None
    if cfg and os.path.exists(cfg):
        try:
            raw = open(cfg, "rb").read()
        except OSError:
            raw = None
    seen = _origin_read.get(cfg)
    if raw is not None and seen and seen[0] == raw:
        return seen[1]
    url = subprocess.run(["git", "remote", "get-url", "origin"], cwd=base,
                         capture_output=True, text=True).stdout.strip()
    if raw is not None:
        _origin_read[cfg] = (raw, url)
    return url


def repo_key():
    # one personal world per shared repository: the origin URL normalized (two
    # clones of one origin share a personal world), the clone's path when there
    # is no remote yet.
    base = os.path.dirname(os.path.abspath(FACTS)) if FACTS else os.getcwd()
    url = origin_url(base)
    if url:
        k = re.sub(r"^[a-zA-Z+]+://", "", url)
        k = re.sub(r"^[^@/]+@", "", k)
        k = re.sub(r"\.git$", "", k).replace(":", "/")
        return re.sub(r"[^A-Za-z0-9._-]", "_", k.strip("/"))
    import hashlib
    # the same walk, and git only where the walk cannot answer: a clone with no
    # remote asks this for every file the bench lists, and a process to be told
    # which directory holds the .git beside it is a process spent on nothing
    top = git_home(base) or subprocess.run(
        ["git", "rev-parse", "--show-toplevel"], cwd=base,
        capture_output=True, text=True).stdout.strip() or base
    return re.sub(r"[^A-Za-z0-9._-]", "_", os.path.basename(top)) + "-" + hashlib.sha1(top.encode()).hexdigest()[:8]


def personal_path():
    # where your own world would be, whether or not you have written in it
    return (os.path.join(personal_root(), "worlds", repo_key(), "my.swift")
            if FACTS else None)


def personal_file():
    # the file, only when it exists: an empty personal world is no file at all.
    # Nothing is created for somebody who has not asked for anything.
    p = personal_path()
    return p if p and os.path.exists(p) else None


def write_personal(text):
    # writing is what brings it into being, and emptying it takes it away.
    # Text still equal to the comment it started with means nobody wrote
    # anything, so there is nothing to keep.
    p = personal_path()
    if not p:
        return None
    if not text.strip() or text.strip() == PERSONAL_TEMPLATE.strip():
        if os.path.exists(p):
            os.remove(p)
        return None
    root = personal_root()
    os.makedirs(os.path.dirname(p), exist_ok=True)
    if not os.path.isdir(os.path.join(root, ".git")):
        subprocess.run(["git", "init", "-q", root], capture_output=True)
    with open(p, "w") as f:
        f.write(text)
    # Only text that holds is ever written here, so every commit is a state
    # that held. This is gate's own repository, not yours, and keeping it is
    # what makes "since when have I watched this" a question git can answer.
    subprocess.run(["git", "add", "-A"], cwd=root, capture_output=True)
    subprocess.run(["git", "-c", "user.email=you@localhost", "-c", "user.name=you",
                    "-c", "commit.gpgsign=false", "commit", "-qm", "your world"],
                   cwd=root, capture_output=True)
    return p


def bench_files():
    # [(shown name, real path)] — the shared world plus your personal world.
    # The CLI's status keeps judging the shared world alone, so a hook and CI
    # behave the same for everyone; the personal world is judged in the bench,
    # where it is yours to see. A repo with no world yet has none of these,
    # and the bench still opens: the journal needs no translation.
    if not FACTS:
        return []
    base = os.path.dirname(os.path.abspath(FACTS))
    out = [(os.path.relpath(p, base), p) for p in world_files()]
    # AND THE FORMS THIS WORLD PRESENTS. They are the operator's own files —
    # what a record may say is written there, in their repository, theirs to
    # change — so the bench opens them and reads the words they declare. Without
    # this, adding a rank to your own file left the bench offering the ones it
    # was born knowing and not the one you had just written.
    for r in (MANIFEST.get("rows") if MANIFEST else None) or []:
        if r["role"] == "forms":
            p = os.path.join(base, r["path"])
            if os.path.exists(p) and (r["path"], p) not in out:
                out.append((r["path"], p))
    # AND THE DOCUMENT WHERE YOU WRITE WHAT YOU TOOK. It is your file, in your
    # language, and it was the one file this bench would not open — so a command
    # that writes a row for you looked like the way in rather than the shortcut
    # it is. A dependency belongs in code, written by the person who depends.
    #
    # It comes after the rows it declares, because the bench opens on the first
    # file in this list and a layout is not a greeting. A world whose whole world
    # is grammar — this repository, and the first scene — opened on its own
    # accounting document, which is the last page anybody arriving wants. The
    # first row a layout declares is the front door, and now it is the door.
    if MANIFEST and os.path.exists(MANIFEST["manifest"]):
        out.append((os.path.relpath(MANIFEST["manifest"], base), MANIFEST["manifest"]))
    # AND THE POLICY, which `gate demo` writes and this bench would not show.
    # It is a file of facts beside the world — who somebody is, what an action
    # demands — introduced by its own first line, judged by its own guard, and
    # served happily by URL; it was simply missing from the list, so a newcomer
    # who ran `demo`, listed the folder and looked at the panel found one file
    # on disk that the tool did not admit to having. Not being in the plain
    # judged stream is a fact about which court reads it, never a reason to be
    # invisible — the layout is in exactly that position and has always shown.
    pp = policy_path()
    if pp and os.path.exists(pp):
        rel = os.path.relpath(pp, base)
        if not any(n == rel for n, _ in out):
            out.append((rel, pp))
    pf = personal_path()
    if pf:   # the slot is always offered; the file may not exist yet
        name = "my.swift" if not any(n == "my.swift" for n, _ in out) else "personal-my.swift"
        out.append((name, pf))
    return out


def judged_paths():
    # what the bench actually hands the judge: files that exist
    return [p for _, p in bench_files() if os.path.exists(p)]


