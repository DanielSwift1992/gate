#!/usr/bin/env python3
# gate — a static layer of logical integrity over git: the world of facts
# lives in the client's own repository, the judge answers in milliseconds,
# a refusal names the line. Spec: docs/PRODUCT.md. Human output by default,
# --json for machines. Dry-run by default: apply writes only on holds.

import json, os, re, shutil, subprocess, sys, tempfile, time

# GATE_CORPUS: optional checkout of the theory corpus — needed only for the
# compiler-path verbs (check administer|delete, apply into the corpus world).
ROOT = os.environ.get("GATE_CORPUS")


# THE ROLES A ROW MAY HAVE, and each one names a different court. This is not
# decoration on a row: it decides who reads it. A world row is judged with the
# rest of my world; a seam row is judged only where it meets mine; a forms row
# is read by nothing today — the plain fragment is closed to protocols, so a
# forms row is inert and says so rather than pretending. A row whose role is
# none of these is refused, never swept into the world: that exact sweep broke
# a world once, when every path literal in the manifest was taken as a fact.
ROLES = {
    "world": "judged with the rest of my world, by the plain court",
    "seam": "judged where it meets mine, and nowhere else",
    "forms": "grammar and the certificates over it, judged by the where court",
    "judge": "the court itself: held by a reproducible build, not by judgement",
}


def read_manifest_rows(d, text=None):
    # ONE LIST, AND THE COLUMNS THAT MAKE IT ONE. Whose source a file is
    # (`Mine` / `Theirs`) is one column; which court reads it is another; and
    # for anything taken, the revision it was taken at is a third. Two protocols
    # named for a ROLE — WorldFile, SeamFile — had been carrying all three at
    # once, which is why a forms file fitted nowhere: its source is theirs and its
    # role is neither of the two the names allowed.
    #
    # The older spellings are still read. A file on somebody's disk is not
    # wrong because the tool learned a better word for it.
    mp = os.path.join(d, "gate.manifest.swift")
    if text is None:
        if not os.path.exists(mp):
            return None, None
        text = open(mp, encoding="utf-8", errors="replace").read()
    # WHAT A RECORD MAY SAY, IN THE SHAPE EVERY OTHER RECORD USES. An atom
    # carries its facts as AXES — `typealias Kind = Seam` — and exactly one
    # string is allowed, the `typeName` literal that gives a name its spelling.
    # I had invented `var role` and `var from` beside it, which is a second
    # notation nobody else in this world writes, and a revision is an atom of
    # its own: `At = MessagesApi_a1b2c3d`, whose typeName is the revision.
    #
    # Both spellings are read. A file on somebody's disk is not wrong because
    # the tool learned a better word for it.
    lit = {}
    for m in re.finditer(r"extension (\w+)\b[^{]*\{(.*?)\n(?=public |extension |\Z)",
                         text + "\n", re.S):
        f = re.search(r'typeName:\s*String\s*\{\s*"([^"]*)"\s*\}', m.group(2))
        if f:
            lit[m.group(1)] = f.group(1)
    ROLE_OF = {"WorldFile": "world", "SeamFile": "seam", "FormsFile": "forms",
               "JudgeFile": "judge", "Seam": "seam"}
    rows = []
    for m in re.finditer(r"public enum (\w+): (Mine|Theirs|WorldFile|SeamFile) \{", text):
        name, atom = m.group(1), m.group(2)
        body = re.search("public enum " + name + r"\b[^{]*\{(.*?)\n\}",
                         text + "\n", re.S)
        inner = body.group(1) if body else ""
        ext = re.search("extension " + name + r"\b[^{]*\{(.*?)\n(?=public |extension |\Z)",
                        text + "\n", re.S)
        outer = ext.group(1) if ext else ""

        def field(k, b=inner + outer):
            f = re.search(k + r':\s*String\s*\{\s*"([^"]*)"\s*\}', b)
            return f.group(1) if f else None

        def axis(k, b=inner + outer):
            a = re.search(r"typealias " + k + r"\s*=\s*(\w+)", b)
            return a.group(1) if a else None
        path = lit.get(name) or field("typeName")
        if not path:
            continue
        source = "mine" if atom in ("Mine", "WorldFile") else "theirs"
        kind = axis("Kind")
        at = axis("At")
        rows.append({"name": name, "source": source, "path": path,
                     # the axis first: it is the shape this world writes in
                     "role": (ROLE_OF.get(kind, kind.lower() if kind else None)
                              or field("role")
                              or ("world" if atom == "WorldFile" else
                                  "seam" if atom == "SeamFile" else None)),
                     "from": (lit.get(at) if at else None) or field("from"),
                     "line": text[:m.start()].count("\n") + 1})
    if not rows and "Mine" not in text and "WorldFile" not in text:
        # older layouts: a bare list of paths, every one of them a world file
        rows = [{"name": None, "source": "mine", "path": p, "role": "world",
                 "from": None, "line": 0}
                for p in re.findall(r'typeName:\s*String\s*\{\s*"([^"]+)"\s*\}', text)]
    return mp, rows


def read_manifest(d):
    # the layout is a fact of the world: gate.manifest.swift declares files, and
    # the judged world is the rows whose role is `world` — nothing else in the
    # document is a fragment of it
    mp, rows = read_manifest_rows(d)
    if mp is None:
        return None
    return {"manifest": mp, "rows": rows,
            "files": [os.path.join(d, r["path"]) for r in rows if r["role"] == "world"]}


def discover_world():
    # the world is found the way .git is: walking up the tree. THE CANON:
    # gate.swift is the source, not a generated artifact (readable by
    # everything: git diff, a human, the judge, the compiler); tables/ are an
    # input for the first
    # print only (bootstrap) and never override the world. A manifest, if
    # declared, adds layout files — judgement runs over the declared list.
    d = os.getcwd()
    while True:
        w = os.path.join(d, "gate.swift")
        t = os.path.join(d, "tables")
        has_tables = os.path.exists(os.path.join(t, "people.csv")) and os.path.exists(os.path.join(t, "grants.csv"))
        m = read_manifest(d)
        if os.path.exists(w) or has_tables or m:
            return w, (t if has_tables else None), m
        parent = os.path.dirname(d)
        if parent == d:
            return None, None, None
        d = parent


_env_facts = os.environ.get("GATE_FACTS")
if _env_facts:
    FACTS, TABLES, MANIFEST = _env_facts, None, None
else:
    FACTS, TABLES, MANIFEST = discover_world()
    if FACTS is None and ROOT:  # corpus checkout as a last resort
        FACTS = os.path.join(ROOT, "Sources", "Organization", "System", "GeneratedTeam.swift")
        TABLES = None


def world_files():
    # the judged file list: the main world plus the manifest-declared layout
    files = [FACTS] if FACTS and os.path.exists(FACTS) else []
    if MANIFEST:
        files += [p for p in MANIFEST["files"] if p not in files]
    return files


def manifest_guards(rows=None):
    # layout guards, both directions (the playground manifest's forms):
    # a declared file exists; a neighbouring *.swift is declared (no shadows)
    #
    # `rows` overrides what is on disk, so the bench can hold the layout to the
    # same promise as every other file it opens: judged as you type. Reading the
    # saved copy while somebody edits an unsaved one shows green over a lie.
    if not MANIFEST:
        return []
    bad = []
    man = os.path.basename(MANIFEST["manifest"])
    d = os.path.dirname(MANIFEST["manifest"])
    live = MANIFEST.get("rows") if rows is None else rows
    for r in live or []:
        # A ROLE IS NOT OPTIONAL, because it names the court. Left unsaid it has
        # to be guessed, and the one time this document was read by guessing —
        # every path literal taken as a world file — the seams were swept into
        # the judged world and the world broke. Guessing is the failure mode, so
        # the row that does not say is refused at its own line.
        # AND THIS IS A SCAFFOLD, SAID PLAINLY. Routing by role is gate's own
        # mechanics until the prism empties, and the name a role gives ought to
        # be resolved by the judge the way `Rank = Blah` already is — «the name
        # Blah resolves to nothing». It is not, yet: that tier fires only for an
        # axis whose requirements the judge knows, and those come from a map
        # naming one reference world's protocols. So the check below is a stand-in wearing its
        # own name, not a court. A scaffold with a judged input would be honest;
        # a scaffold calling itself a court would not, and the difference is the
        # whole of what this tool sells.
        if not r["role"]:
            bad.append({"address": f"{man}:{r['line']}",
                        "claim": f"`{r['name']}` does not say what it is for. A row names its court: "
                                 + " · ".join(f"`{k}` — {v}" for k, v in ROLES.items())})
        elif r["role"] not in ROLES:
            bad.append({"address": f"{man}:{r['line']}",
                        "claim": f"`{r['name']}` is for `{r['role']}`, which no court here reads. "
                                 "A row gate cannot place is refused, never quietly taken as a "
                                 "fragment of your world: " + " · ".join(ROLES)})
        # AND WHAT IS TAKEN IS TAKEN AT A REVISION. There are no ranges anywhere
        # in this tool, which is the whole reason no version solver exists — but
        # a pin nobody wrote down pins nothing, and until now the revision lived
        # in side channels beside the file rather than in the list that accounts
        # for it.
        if r["source"] == "theirs" and not r["from"]:
            bad.append({"address": f"{man}:{r['line']}",
                        "claim": f"`{r['name']}` is theirs and does not say which revision it was "
                                 "taken at. Taken means taken from somewhere, at something: "
                                 "`gate theirs " + r["path"] + " --at REV`"})
    for p in ([os.path.join(d, r["path"]) for r in live if r["role"] == "world"]
              if rows is not None else MANIFEST["files"]):
        if not os.path.exists(p):
            bad.append({"address": man, "claim": f"the manifest declares {os.path.relpath(p, d)}, and no such file exists"})
    # A SHADOW IS A FILE NOBODY SPOKE FOR, and a row of ANY role has been spoken
    # for. Reading only the world rows here called a declared seam side — and
    # then a declared forms file — a shadow, which is an accusation about
    # something that was claimed out loud in the document being read.
    declared = ({os.path.join(d, r["path"]) for r in (live or [])}
                | {MANIFEST["manifest"], os.path.join(d, "gate.swift"),
                   os.path.join(d, "gate.policy.swift")})  # meta, like the manifest itself
    for f in sorted(os.listdir(d)):
        p = os.path.join(d, f)
        if f.endswith(".swift") and p not in declared and not is_seam_side(p):
            bad.append({"address": f, "claim": "a world file the manifest never declares: a shadow outside the judged list"})
    return bad


def forms_guards():
    # A FORMS ROW IS JUDGED, AND I HAD SIMPLY NOT CALLED THE COURT. It was
    # reported inert on the strength of one probe — a conformance the plain
    # judge refuses — and the probe was the wrong shape: `where` does not check
    # bare conformance at all, so a green over nought uses said nothing either
    # way. Given the certificates it does read, it judges them with teeth: the
    # bench's own palette holds 110 equalities under it.
    #
    # So the grammar a world is written in is answerable after all, by the court
    # that fits it, and that court is asked here. It is one stream per row: two
    # files as two arguments are two canons that never meet.
    if not MANIFEST:
        return []
    d = os.path.dirname(MANIFEST["manifest"])
    rows = [r for r in (MANIFEST.get("rows") or []) if r["role"] == "forms"
            and os.path.exists(os.path.join(d, r["path"]))]
    if not rows:
        return []
    # ONE STREAM, IN THE ORDER THE MANIFEST GIVES. Judging each row on its own
    # is the trap this project already paid for and wrote down: `where` over a
    # LIST is blind, and its silence is selective by order — a law split across
    # two files goes green in isolation and refuses the moment they are glued.
    # I shipped the isolated form because I had not read what was already known.
    # The glued stream is the proven shape; the order comes from the document
    # rather than from the folder, so the same repository always reads the same.
    glued, where, at = [], {}, 0
    for r in rows:
        text = open(os.path.join(d, r["path"]), encoding="utf-8", errors="replace").read()
        for i, line in enumerate(text.split("\n"), 1):
            m = re.match(r"public (?:typealias|enum|protocol) (\w+)", line)
            if m and m.group(1) not in where:
                where[m.group(1)] = f"{r['path']}:{i}"
        glued.append(text)
        at += text.count("\n")
    tmp = tempfile.mkdtemp(prefix="gate-forms-")
    p = os.path.join(tmp, "forms.swift")
    open(p, "w").write("\n".join(glued))
    out = subprocess.run([JUDGE, "judge", "where", p], capture_output=True, text=True).stdout
    shutil.rmtree(tmp, ignore_errors=True)
    bad = []
    for line in out.split("\n"):
        if not line.strip().startswith("✗"):
            continue
        claim = line.strip()[1:].strip()
        # the address is the file that SAYS the certificate, not the stream it
        # was read in — a refusal must land where somebody can go and fix it
        m = re.match(r"'(\w+)", claim)
        bad.append({"address": where.get(m.group(1)) if m else None
                    or rows[0]["path"], "claim": claim})
    return bad


def is_seam_side(path):
    # ONE SIDE OF A SEAM IS NOT A SHADOW OF THIS WORLD. It is a different kind of
    # thing entirely — what somebody said about an agreement — and it says which
    # it is in its own first lines. Read as a stray world file it earned two
    # refusals from anybody who both declared a layout and used a seam, which is
    # the whole of what this tool is against: an accusation about something that
    # was never claimed.
    try:
        head = open(path, encoding="utf-8", errors="replace").read(4000)
    except OSError:
        return False
    return bool(re.search(r"^public enum \w+: Carrier \{\}", head, re.M)
                or re.search(r"^public enum F_\w+: Declared \{", head, re.M))


# ── the personal world: yours, in your own git, never in the shared repo ──
# A file hidden inside the shared repo would be state without history, and the
# canon is that git is the only state. So the personal layer is a repository of
# its own, in your home, made on first use. The shared clone stays untouched:
# nothing to review, nothing to ignore, and CI — which has no such home — judges
# the shared world alone. Privacy is the repository boundary, not a policy.

PERSONAL_TEMPLATE = """\
// Yours. It is judged together with the files beside it, and it is never in the
// shared repository: your colleagues and CI do not have it. Write a claim you
// want to keep true, and the judge names the line when somebody else's change
// breaks it. Left as it is, it is not stored anywhere.
//
// It lives on THIS machine, in a git of its own at ~/.gate/me, and every state
// that holds is kept there. It goes nowhere else: no clone of the shared
// repository will have it, and neither will your other computer, unless you
// give that repository a remote of your own.
//
// The bench itself is configured here, by declaration and not by a toggle.
// Uncomment the lines below to wear the dark theme — the page follows the
// declaration at once, and your git remembers the day you chose it:
//
//     public enum MyBench: Bench {
//         public typealias Theme = Dark
//     }
"""



def personal_root():
    return os.environ.get("GATE_ME") or os.path.join(os.path.expanduser("~"), ".gate", "me")


def repo_key():
    # one personal world per shared repository: the origin URL normalized (two
    # clones of one origin share a personal world), the clone's path when there
    # is no remote yet.
    base = os.path.dirname(os.path.abspath(FACTS)) if FACTS else os.getcwd()
    url = subprocess.run(["git", "remote", "get-url", "origin"], cwd=base,
                         capture_output=True, text=True).stdout.strip()
    if url:
        k = re.sub(r"^[a-zA-Z+]+://", "", url)
        k = re.sub(r"^[^@/]+@", "", k)
        k = re.sub(r"\.git$", "", k).replace(":", "/")
        return re.sub(r"[^A-Za-z0-9._-]", "_", k.strip("/"))
    import hashlib
    top = subprocess.run(["git", "rev-parse", "--show-toplevel"], cwd=base,
                         capture_output=True, text=True).stdout.strip() or base
    return re.sub(r"[^A-Za-z0-9._-]", "_", os.path.basename(top)) + "-" + hashlib.sha1(top.encode()).hexdigest()[:8]


def personal_path():
    # where your own world would be, whether or not you have written in it
    return (os.path.join(personal_root(), "worlds", repo_key(), "my.swift")
            if FACTS else None)


def personal_file():
    # the file, only when it exists: an empty personal world is no file at all.
    # Nothing is created for somebody who has not asked for anything.
    p = personal_path()
    return p if p and os.path.exists(p) else None


def write_personal(text):
    # writing is what brings it into being, and emptying it takes it away.
    # Text still equal to the comment it started with means nobody wrote
    # anything, so there is nothing to keep.
    p = personal_path()
    if not p:
        return None
    if not text.strip() or text.strip() == PERSONAL_TEMPLATE.strip():
        if os.path.exists(p):
            os.remove(p)
        return None
    root = personal_root()
    os.makedirs(os.path.dirname(p), exist_ok=True)
    if not os.path.isdir(os.path.join(root, ".git")):
        subprocess.run(["git", "init", "-q", root], capture_output=True)
    with open(p, "w") as f:
        f.write(text)
    # Only text that holds is ever written here, so every commit is a state
    # that held. This is gate's own repository, not yours, and keeping it is
    # what makes "since when have I watched this" a question git can answer.
    subprocess.run(["git", "add", "-A"], cwd=root, capture_output=True)
    subprocess.run(["git", "-c", "user.email=you@localhost", "-c", "user.name=you",
                    "-c", "commit.gpgsign=false", "commit", "-qm", "your world"],
                   cwd=root, capture_output=True)
    return p


def bench_files():
    # [(shown name, real path)] — the shared world plus your personal world.
    # The CLI's status keeps judging the shared world alone, so a hook and CI
    # behave the same for everyone; the personal world is judged in the bench,
    # where it is yours to see. A repo with no world yet has none of these,
    # and the bench still opens: the journal needs no translation.
    if not FACTS:
        return []
    base = os.path.dirname(os.path.abspath(FACTS))
    out = [(os.path.relpath(p, base), p) for p in world_files()]
    # AND THE DOCUMENT WHERE YOU WRITE WHAT YOU TOOK. It is your file, in your
    # language, and it was the one file this bench would not open — so a command
    # that writes a row for you looked like the way in rather than the shortcut
    # it is. A dependency belongs in code, written by the person who depends.
    if MANIFEST and os.path.exists(MANIFEST["manifest"]):
        out.append((os.path.relpath(MANIFEST["manifest"], base), MANIFEST["manifest"]))
    pf = personal_path()
    if pf:   # the slot is always offered; the file may not exist yet
        name = "my.swift" if not any(n == "my.swift" for n, _ in out) else "personal-my.swift"
        out.append((name, pf))
    return out


def judged_paths():
    # what the bench actually hands the judge: files that exist
    return [p for _, p in bench_files() if os.path.exists(p)]


def ensure_world():
    # bootstrap only: no world yet but input tables present — print ONCE.
    # From then on the world is the source; tables never override it (no
    # second truth): to pull fresh CSVs in, run an explicit `gate import`.
    if TABLES and not os.path.exists(FACTS):
        cmd_import([os.path.join(TABLES, "people.csv"), os.path.join(TABLES, "grants.csv"), "-o", FACTS])
        return True
    return False
_PACKAGED = os.path.join(os.path.dirname(os.path.abspath(__file__)), "bin", "gate-judge")
JUDGE = os.environ.get("GATE_JUDGE") or _PACKAGED
if not os.path.exists(JUDGE):
    raise SystemExit("gate: no judge binary (bin/gate-judge missing; build it with bin/build-judge.sh or set GATE_JUDGE)")


def refine_addresses(text, refusals, fname):
    # the judge pins a refusal to the previous drain's line — refine the
    # address to the line holding the refusal's subject, in a window nearby
    file_lines = text.split("\n")
    for ref in refusals:
        n = int(ref["address"].split(":")[1])
        m = (re.search(r"requires (\w+)\.", ref["claim"])
             or re.search(r"(\w+)(?:\.\w+)? resolves to nothing", ref["claim"])
             or re.match(r"(\w+)\.", ref["claim"]))
        if not m:
            continue
        subject = m.group(1)
        for k in range(max(0, n - 4), min(len(file_lines), n + 8)):
            if re.search(rf"\b{subject}\b", file_lines[k]):
                ref["address"] = f"{fname}:{k + 1}"
                break
    return refusals


def locate_claim(text, claim):
    # the line where this text actually makes this claim, or None. An entry
    # spans lines — the form, then its parties — so read one entry at a time,
    # from the form to the line that closes it, and require every party the
    # claim names to be inside THAT entry: two entries about one person are
    # two different claims.
    names = re.findall(r"\b[A-Z]\w*", claim)
    if not names:
        return None
    form = names[0]
    parties = re.findall(r"\b([A-Z]\w*)\.\w+", claim)
    lines = text.split("\n")
    for i, ln in enumerate(lines):
        if not re.search(rf"\b{re.escape(form)}\b", ln):
            continue
        end = i
        while end < min(len(lines), i + 10) and ">" not in lines[end]:
            end += 1
        entry = lines[i:end + 1]
        joined = "\n".join(entry)
        if not all(re.search(rf"\b{re.escape(p)}\b", joined) for p in parties):
            continue
        want = parties[0] if parties else form
        for k, line in enumerate(entry):
            if re.search(rf"\b{re.escape(want)}\b", line):
                return i + k + 1
        return i + 1
    return None


def attribute_refusals(refusals, sources):
    # Given several files, the judge repeats every refusal once per file, with
    # the line of whichever file it read the claim in — so a file that never
    # mentions the form still gets an address, at a line it may not even have.
    # A refusal belongs to the file that makes the claim: find that line, in
    # every file that makes it, and drop the broadcast copies.
    # sources: [(shown name, text)]
    first, order = {}, []
    for r in refusals:
        if r["claim"] not in first:
            first[r["claim"]] = r
            order.append(r["claim"])
    out = []
    for claim in order:
        orig = first[claim]["address"]
        ofile, _, oline = orig.partition(":")
        oline = int(oline) if oline.isdigit() else None
        # Only a GATE claim needs placing. The judge pins one to the line the
        # entry before it ended on, and repeats it once per file it was given.
        # Everything else — a name that resolves to nothing, an unknown gate —
        # it addresses exactly, in the one file that says it, and moving that
        # is how a refusal ends up pointing at somebody else's line.
        if " requires " not in claim:
            out.append(first[claim])
            continue
        placed = False
        for name, text in sources:
            line = locate_claim(text, claim)
            if not line:
                continue
            if name == ofile and oline:
                # the judge named THIS file, so its own line stands. An entry
                # spans several lines and the judge pins the refusal to the one
                # the entry before it ended on, so a match a few lines away is
                # a refinement; a match far away is our locator losing the
                # thread, and then the judge is the one to believe.
                line = line if abs(line - oline) <= 8 else oline
            out.append({"address": f"{name}:{line}", "claim": claim})
            placed = True
        if not placed:
            out.append(first[claim])   # unlocatable: keep the judge's own word
    return out


def judge(path):
    t0 = time.time()
    out = subprocess.run([JUDGE, "judge", path], capture_output=True, text=True).stdout
    wall_ms = round((time.time() - t0) * 1000, 1)
    refusals = [
        {"address": m.group(1), "claim": m.group(2).strip()}
        for m in re.finditer(r"^\s+(\S+\.swift:\d+)\s+(.+)$", out, re.M)
    ]
    refusals = refine_addresses(open(path).read(), refusals, os.path.basename(path))
    holds = "THE JUDGE holds" in out
    times = re.findall(r"([\d.]+) ms", out)
    return {
        "verdict": "holds" if holds else "refused",
        "refusals": refusals,
        "judge_ms": float(times[-1]) if times else None,
        "wall_ms": wall_ms,
    }


def must_sub(text, pattern, repl, what, count=1):
    found = len(re.findall(pattern, text, re.S))
    if found != count:
        raise SystemExit(json.dumps({"error": f"{what}: anchor x{found}, want {count}"}))
    return re.sub(pattern, repl, text, count=count, flags=re.S)


def with_temp(text):
    d = tempfile.mkdtemp(prefix="gate-")
    # the probe carries the real world's filename: addresses read as native
    p = os.path.join(d, os.path.basename(FACTS))
    with open(p, "w") as f:
        f.write(text)
    return p


def last_entry_insert(text, head, args, indent):
    # insert a new entry after the LAST entry of the same form (and same axis arguments, when given)
    pat = head + r"<\s*(\w+),\s*(\w+)\s*>\.self;?"
    hits = [m for m in re.finditer(pat, text)]
    if args.get("second"):
        hits = [m for m in hits if m.group(2) == args["second"]]
    if not hits:
        raise SystemExit(json.dumps({"error": f"no {head} entries to anchor on"}))
    m = hits[-1]
    pad, inner = " " * indent, " " * (indent + 4)
    entry = (
        f"\n{pad}{head}<\n{inner}{args['first']},\n{inner}{args['args_second']}\n{pad}>.self"
    )
    return text[: m.end()] + entry + text[m.end() :]


def cmd_ask(a):
    # ask view WHO DOC — would this view entry stand? a probe entry + judgement, nothing changes
    who, doc = a[0], a[1]
    text = open(FACTS).read()
    probe = last_entry_insert(
        text, "VerifiedView", {"first": who, "args_second": doc}, indent=12
    )
    r = judge(with_temp(probe))
    return {"command": "ask view", "who": who, "doc": doc, **r, "mutates": False}


def cmd_ask_build(kind, a):
    # check administer|delete WHO DOC — compiler gates (Granted/Authorized):
    # a probe entry in CertifiedAccesses + swift build; seconds, the full arbiter
    if not ROOT:
        raise SystemExit(json.dumps({"error": "check " + kind + " needs GATE_CORPUS (a checkout of the theory corpus with Team.swift)"}))
    who, doc = a[0], a[1]
    team = os.path.join(ROOT, "Sources", "Organization", "System", "Team.swift")
    text = open(team).read()
    anchor = "        Granted<Delete<Alice, FinanceVault>>.self         // only the owner, and only at manager rank, deletes"
    assert text.count(anchor) == 1
    gate_name = kind.capitalize()
    probe = text.replace(anchor, anchor + f"\n        Granted<{gate_name}<{who}, {doc}>>.self // gate probe")
    open(team, "w").write(probe)
    t0 = time.time()
    out = subprocess.run(["swift", "build"], cwd=ROOT, capture_output=True, text=True)
    secs = round(time.time() - t0, 2)
    subprocess.run(["git", "checkout", "--", team], cwd=ROOT, capture_output=True)
    reasons = sorted(set(re.findall(r"error: (.+)$", out.stdout + out.stderr, re.M)))
    return {
        "command": f"ask {kind}",
        "who": who,
        "doc": doc,
        "verdict": "holds" if out.returncode == 0 else "refused",
        "compiler_says": reasons[:3],
        "build_s": secs,
        "mutates": False,
    }


def transfer_text(text, who, dept):
    # the mechanics of a transfer: Home in the roster + the team entry (both
    # facts); view grants are NOT touched: re-pointing or revoking access is
    # a decision of intent, left to the human (the reply hints grant/revoke)
    text = must_sub(
        text,
        rf"(public enum {who}: Employee, Person \{{[^}}]*?public typealias Home = )\w+",
        rf"\g<1>{dept}",
        f"roster entry of {who}",
    )
    text = re.sub(
        rf"(VerifiedInDepartment<\s*{who},\s*)\w+",
        rf"\g<1>{dept}",
        text,
    )
    return text


def grant_text(text, who, doc):
    return last_entry_insert(text, "VerifiedView", {"first": who, "args_second": doc}, 12)


def revoke_text(text, who, doc):
    pat = rf"\n\s*VerifiedView<\s*{who},\s*{doc}\s*>\.self;?"
    found = len(re.findall(pat, text))
    if found != 1:
        raise SystemExit(json.dumps({"error": f"revoke: grant {who}->{doc} found x{found}, want 1"}))
    return re.sub(pat, "", text, count=1)


def hire_text(text, f):
    block = (
        f"\n\npublic enum {f['id']}: Employee, Person {{\n"
        f"    public typealias Rank = {f['rank']}\n"
        f"    public typealias Home = {f['home']}\n"
        f"    public typealias Given = {f['given']}\n"
        f"    public typealias Family = {f['family']}\n"
        f"    public typealias Born = {f['born']}\n"
        f"    public typealias Site = {f['site']}\n"
        f"    public typealias Sex = Given.Sex\n}}"
    )
    rosters = [m for m in re.finditer(r"public enum \w+: Employee, Person \{.*?\n\}", text, re.S)]
    if not rosters:
        raise SystemExit(json.dumps({"error": "hire: no roster entries to anchor on"}))
    m = rosters[-1]
    text = text[: m.end()] + block + text[m.end() :]
    slices = [m for m in re.finditer(r"(Emp\w+\.self;?)(?=\s*\n\s*\})", text)]
    if slices:  # the corpus world carries a Company list; an imported one does not, and the judge needs none
        s = slices[0]
        text = text[: s.end()] + f" {f['id']}.self;" + text[s.end() :]
    text = last_entry_insert(text, "VerifiedView", {"first": f["id"], "args_second": f["home"] + "Share"}, 12)
    text = last_entry_insert(text, "VerifiedInDepartment", {"first": f["id"], "args_second": f["home"], "second": f["home"]}, 8)
    text = last_entry_insert(text, "VerifiedAtRank", {"first": f["id"], "args_second": f["rank"], "second": f["rank"]}, 8)
    text = last_entry_insert(text, "VerifiedAtWorkplace", {"first": f["id"], "args_second": f["site"], "second": f["site"]}, 8)
    return text


def cmd_change(a):
    # change transfer WHO DEPT [--apply] · change hire ID RANK HOME GIVEN FAMILY BORN SITE [--apply]
    # The SINGLE source — the world — is edited; the diff stays a Swift git diff.
    apply_it = "--apply" in a
    a = [x for x in a if x != "--apply"]
    text = open(FACTS).read()
    if a[0] == "transfer":
        who, dept = a[1], a[2]
        new = transfer_text(text, who, dept)
        label = {"command": "change transfer", "who": who, "to": dept,
                 "note": "roster and team entry moved; view grants are intent — resolve leftovers with grant/revoke"}
    elif a[0] == "grant":
        who, doc = a[1], a[2]
        new = grant_text(text, who, doc)
        label = {"command": "change grant", "who": who, "doc": doc}
    elif a[0] == "revoke":
        who, doc = a[1], a[2]
        new = revoke_text(text, who, doc)
        label = {"command": "change revoke", "who": who, "doc": doc}
    elif a[0] == "hire":
        f = dict(zip(["id", "rank", "home", "given", "family", "born", "site"], a[1:8]))
        new = hire_text(text, f)
        label = {"command": "change hire", **f}
    else:
        raise SystemExit(json.dumps({"error": f"unknown change {a[0]}"}))
    r = judge(with_temp(new))
    applied = False
    if apply_it and r["verdict"] == "holds":
        open(FACTS, "w").write(new)
        applied = True
    return {**label, **r, "dry_run": not apply_it, "applied": applied}


def cmd_import(a):
    # import people.csv grants.csv -o gate.swift — a mechanical translation
    # of the client's facts into the world's facts layer. CSV columns = the
    # world's axes; refusal addresses translate back to the client's CSV lines.
    import csv

    people_csv, grants_csv = a[0], a[1]
    out_path = a[a.index("-o") + 1] if "-o" in a else "gate.swift"
    lines = []  # (text, source|None)

    def emit(chunk, src=None):
        for ln in chunk.split("\n"):
            lines.append((ln, src))

    # THREE THOUGHTS, SAID APART. A blank comment line is where the writer
    # stopped, and a reader — a person or the Bare view — has no other way to
    # know. Run together they read as one long sentence that changes subject
    # twice, which is what they did until somebody looked at them set as prose.
    emit("// the facts world — the source you read and edit, not a generated")
    emit("// artifact. The tables only seeded it once (below); the world, not the")
    emit("// tables, is the truth. A gate.manifest.swift may split it across")
    emit("// several files, all judged together. git carries the history.")
    emit("//")
    emit(f"// seeded by gate import from: {os.path.basename(people_csv)}, {os.path.basename(grants_csv)}")
    emit("//")
    emit("// the language it is written in: `gate stdlib show forms-organization`.")
    emit("// Those words are carried by the judge; `materialize` writes them out")
    emit("// beside this file to READ — editing that copy adds no word to the language.")
    people = list(csv.DictReader(open(people_csv)))
    grants = list(csv.DictReader(open(grants_csv)))

    # the atom pools: distinct given/family/year values from the data, Next rings closed in a circle
    def ring(names, conf, extra=None):
        names = list(dict.fromkeys(names))
        for i, n in enumerate(names):
            nxt = names[(i + 1) % len(names)]
            body = f"    public typealias Next = {nxt}\n"
            if extra:
                body += f"    public typealias Sex = {extra[n]}\n"
            emit(f"\npublic enum {n}: {conf} {{\n{body}}}")

    sexes = {p["given"]: p.get("sex", "Male") for p in people}
    ring([p["given"] for p in people], "GivenNameCycle", sexes)
    ring([p["family"] for p in people], "FamilyNameCycle")
    ring([p["born"] for p in people], "BirthYearCycle")
    for i, p in enumerate(people):
        src = f"{os.path.basename(people_csv)}:{i + 2}"
        emit(
            f"\npublic enum {p['id']}: Employee, Person {{\n"
            f"    public typealias Rank = {p['rank']}\n"
            f"    public typealias Home = {p['home']}\n"
            f"    public typealias Given = {p['given']}\n"
            f"    public typealias Family = {p['family']}\n"
            f"    public typealias Born = {p['born']}\n"
            f"    public typealias Site = {p['site']}\n"
            f"    public typealias Sex = Given.Sex\n}}",
            src,
        )
    emit("\npublic enum ImportedTeam: Team {\n    @StructureBuilder\n    public static var body: some Structure {")
    for i, p in enumerate(people):
        src = f"{os.path.basename(people_csv)}:{i + 2}"
        emit(f"        VerifiedInDepartment<\n            {p['id']},\n            {p['home']}\n        >.self", src)
        emit(f"        VerifiedAtRank<\n            {p['id']},\n            {p['rank']}\n        >.self", src)
        emit(f"        VerifiedAtWorkplace<\n            {p['id']},\n            {p['site']}\n        >.self", src)
    emit("    }\n}")
    emit("\npublic enum ImportedAccesses: AccessLedger {\n    @StructureBuilder\n    public static var body: some Structure {")
    for i, g in enumerate(grants):
        src = f"{os.path.basename(grants_csv)}:{i + 2}"
        emit(f"            VerifiedView<\n                {g['who']},\n                {g['doc']}\n            >.self", src)
    emit("    }\n}")

    with open(out_path, "w") as f:
        f.write("\n".join(t for t, _ in lines) + "\n")
    r = judge(out_path)
    for ref in r["refusals"]:
        # the judge pins a refusal to the previous drain's line — refine to
        # the line holding the refusal's subject, in a window around the address
        n = int(ref["address"].split(":")[1])
        src = lines[n - 1][1] if n - 1 < len(lines) else None
        m = re.search(r"requires (\w+)\.", ref["claim"]) or re.match(r"(\w+)\.", ref["claim"])
        if m:
            subject = m.group(1)
            for k in range(max(0, n - 4), min(len(lines), n + 8)):
                if re.search(rf"\b{subject}\b", lines[k][0]) and lines[k][1]:
                    src = lines[k][1]
                    ref["address"] = f"{os.path.basename(out_path)}:{k + 1}"
                    break
        ref["source"] = src
    return {
        "command": "import",
        "world": out_path,
        "people": len(people),
        "grants": len(grants),
        **r,
    }


def cmd_export(a):
    # export gate.swift -o people.csv grants.csv — the world prints the
    # tables back. Round-trip: import → export → empty diff vs the originals
    # ⇒ the fact translation is proven mechanically, no trust in the translator.
    world = a[0]
    people_out, grants_out = a[a.index("-o") + 1], a[a.index("-o") + 2]
    text = open(world).read()
    rows = []
    for m in re.finditer(
        r"public enum (\w+): Employee, Person \{(.*?)\n\}", text, re.S
    ):
        f = dict(re.findall(r"public typealias (\w+) = ([\w.]+)", m.group(2)))
        sex_pool = dict(
            re.findall(r"public enum (\w+): GivenNameCycle \{.*?Sex = (\w+)", text, re.S)
        )
        rows.append(
            [m.group(1), f["Rank"], f["Home"], f["Given"], f["Family"], f["Born"], f["Site"], sex_pool.get(f["Given"], "")]
        )
    with open(people_out, "w") as f:
        f.write("id,rank,home,given,family,born,site,sex\n")
        f.writelines(",".join(r) + "\n" for r in rows)
    grants = re.findall(r"VerifiedView<\s*(\w+),\s*(\w+)\s*>\.self;?", text)
    with open(grants_out, "w") as f:
        f.write("who,doc\n")
        f.writelines(f"{w},{d}\n" for w, d in grants)
    return {
        "command": "export",
        "people": len(rows),
        "grants": len(grants),
        "wrote": [people_out, grants_out],
    }


def seeds(people, grants):
    # the seed catalogue: one violation per rule form, drawn from the data itself
    p0 = people[0]
    other_home = next(p["home"] for p in people if p["home"] != p0["home"])
    yield "cross-view", people, grants + [{"who": p0["id"], "doc": other_home + "Share"}]
    yield "duplicate-grant", people, grants + [dict(grants[0])]
    yield "dangling-who", people, grants + [{"who": "Emp9999", "doc": p0["home"] + "Share"}]
    yield "dangling-doc", people, grants + [{"who": p0["id"], "doc": "NoSuchShare"}]
    moved = [dict(p) for p in people]
    moved[0]["home"] = other_home
    yield "stale-after-transfer", moved, grants


def cmd_verify(a):
    # verify people.csv grants.csv --against CMD — differential rule check:
    # catalogue seeds are judged by the world AND the client's old checker; a
    # verdict split = the address of an untranslated rule (or one the client lacks).
    import csv

    people_csv, grants_csv = a[0], a[1]
    against = a[a.index("--against") + 1] if "--against" in a else None
    people = list(csv.DictReader(open(people_csv)))
    grants = list(csv.DictReader(open(grants_csv)))
    d = tempfile.mkdtemp(prefix="gate-verify-")

    # step 0: the base must be clean on BOTH sides — background violations
    # would mask the seeds and "covered" would mean nothing
    base_world = cmd_import([people_csv, grants_csv, "-o", os.path.join(d, "base.swift")])
    base_legacy = (
        subprocess.run(against.split() + [people_csv, grants_csv], capture_output=True, text=True)
        if against
        else None
    )
    if base_world["verdict"] != "holds" or (base_legacy and base_legacy.returncode != 0):
        return {
            "command": "verify",
            "base": "dirty: fix these before seeding",
            "world_says": [r["claim"] + " · " + str(r["source"]) for r in base_world["refusals"]],
            "legacy_says": base_legacy.stdout.strip().splitlines() if base_legacy else [],
        }
    rows = []
    for name, ps, gs in seeds(people, grants):
        pp, gp = os.path.join(d, "people.csv"), os.path.join(d, "grants.csv")
        with open(pp, "w") as f:
            f.write("id,rank,home,given,family,born,site,sex\n")
            f.writelines(",".join(p[k] for k in ["id", "rank", "home", "given", "family", "born", "site", "sex"]) + "\n" for p in ps)
        with open(gp, "w") as f:
            f.write("who,doc\n")
            f.writelines(f"{g['who']},{g['doc']}\n" for g in gs)
        world = cmd_import([pp, gp, "-o", os.path.join(d, "gate.swift")])
        w = world["verdict"]
        if against:
            legacy = subprocess.run(against.split() + [pp, gp], capture_output=True, text=True)
            l = "refused" if legacy.returncode else "holds"
            verdict = {
                ("refused", "refused"): "covered: both refuse",
                ("refused", "holds"): "WORLD STRICTER: the client's checker misses this",
                ("holds", "refused"): "NOT TRANSLATED: the legacy rule has no gate in the world",
                ("holds", "holds"): "weak seed: neither side refuses",
            }[(w, l)]
            legacy_says = legacy.stdout.strip().splitlines()[:2]
        else:
            # --self: seeds against the world alone — which rules hold at all
            l, legacy_says = "n/a", []
            verdict = "held by the world" if w == "refused" else "NO GATE HOLDS THIS SEED"
        rows.append({
            "seed": name,
            "world": w,
            "world_says": [r["claim"] for r in world["refusals"]][:2],
            "legacy": l,
            "legacy_says": legacy_says,
            "reading": verdict,
        })
    holes = [r for r in rows if r["reading"].startswith(("NOT TRANSLATED", "NO GATE"))]
    return {"command": "verify", "seeds": rows, "translation_holes": len(holes)}


