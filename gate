def codeowners_pair_guards():
    # THE PRINT AND ITS SOURCE ARE A PAIR. `import codeowners` writes into the
    # world the inputs it read, on the world's own `from:` line, so the pair
    # is declared where the translation lands, never guessed from what is
    # lying nearby. From then on the file and the world are two records of
    # one fact, and this holds them the way every pair here is held: the same
    # translator prints the world again, and the certificates are compared.
    # The refusal names the first claim the two no longer share, at the line
    # that makes it: in their file for a rule the world does not hold, in the
    # world for a claim their file no longer writes.
    out = []
    if not FACTS:
        return out
    # the judged records, not the folder: a pair lives in a judged file, and
    # the manifest says where those sit, whatever their role, so the walk is
    # over every declared row rather than over what is lying beside anything
    judged = set(world_files()) | {os.path.abspath(FACTS)}
    if MANIFEST:
        mdir = os.path.dirname(MANIFEST["manifest"])
        judged |= {os.path.join(mdir, r["path"])
                   for r in (MANIFEST.get("rows") or [])}
    for path in sorted(p for p in judged if os.path.exists(p)):
        try:
            text = open(path, encoding="utf-8").read()
        except (OSError, UnicodeDecodeError):
            # a declared row may be a binary, the judge or a carried editor,
            # and a binary is nobody's half of a printed pair
            continue
        if "printed by gate import codeowners" not in text:
            continue
        m = re.search(r"^// from: (\S+)(?: --policy (\S+))?$", text, re.M)
        if not m:
            continue
        name = os.path.basename(path)
        # the declaration is read from where it was made: the world names its
        # source relative to itself
        srcp = os.path.join(os.path.dirname(os.path.abspath(path)), m.group(1))
        if not os.path.exists(srcp):
            out.append({"address": f"{name}:1", "claim":
                        f"printed from {m.group(1)}, and no file of that name is here now"})
            continue
        policy = (read_owners_policy(os.path.join(
            os.path.dirname(os.path.abspath(path)), m.group(2)))
            if m.group(2) else {})
        _, lines, srcmap, _ = codeowners_world_lines(srcp, policy, "")
        fresh = {l for l in lines if l.startswith("public typealias Owns_")}
        disk = text.split("\n")
        held = {l for l in disk if l.startswith("public typealias Owns_")}
        for lost in sorted(fresh - held):
            cert = lost.split()[2]
            spot = srcmap.get(cert, "").split(" · ")[0] or f"{m.group(1)}:1"
            out.append({"address": spot, "claim":
                        f"{m.group(1)} writes this rule, and the world does not "
                        f"hold it: `{lost}`. Run the import again, or take the rule out"})
        for extra in sorted(held - fresh):
            out.append({"address": f"{name}:{disk.index(extra) + 1}", "claim":
                        f"the world holds this claim, and {m.group(1)} no longer "
                        f"writes it: `{extra}`. Run the import again, or put the "
                        f"line back"})
    return out


def said_path(root):
    # the way a person will type it: relative where a relative path exists,
    # and the absolute path where one does not (another drive, on Windows,
    # is a ValueError rather than a longer path)
    try:
        return os.path.relpath(root)
    except ValueError:
        return root


