def cmd_badge(a):
    # badge [-o FILE.svg] [--since DATE] — the souvenir, and the only numbers on
    # it are ones nobody can raise by hand. A coverage badge can be gamed by
    # writing tests that assert nothing; this one cannot, because the claims are
    # counted by the judge and the days are counted by REPLAYING the world's own
    # history through it. Anybody may re-run it and get the same answer.
    #
    # What it does NOT say is `no silent error`, because that is exactly what
    # nobody saw. It says how many claims were judged and how long every commit
    # that touched them has held — provable, and duller, and true.
    from datetime import date as _date
    out_path = a[a.index("-o") + 1] if "-o" in a else None
    since = a[a.index("--since") + 1] if "--since" in a else None
    # a badge counts JUDGED claims, so it belongs to a world and to nothing else.
    # It once spoke for a seam too, over premises no one had declared — a badge
    # over an observation is a verdict wearing a number, and there was no court.
    files = world_files()
    if not files:
        return {"command": "badge", "verdict": "no world here", "refusals": [],
                "next": "run `gate init .` to start a world in this folder",
                "then": "then `gate badge -o gate.svg` prints a badge nobody can forge", "mutates": False}
    t0 = time.time()
    raw = subprocess.run([JUDGE, "judge", *files], capture_output=True, text=True).stdout
    m = re.search(r"(\d+) declarations · (\d+) lookups · (\d+) premises", raw)
    claims = int(m.group(3)) if m else 0
    holds = "THE JUDGE holds" in raw
    root = (subprocess.run(["git", "rev-parse", "--show-toplevel"],
                           capture_output=True, text=True).stdout or "").strip()
    root = os.path.realpath(root) if root else ""
    rels = [os.path.relpath(os.path.realpath(f), root) for f in files] if root else []
    shallow = root and (subprocess.run(["git", "-C", root, "rev-parse", "--is-shallow-repository"],
                                       capture_output=True, text=True).stdout or "").strip() == "true"
    marks = ([l.split(None, 1) for l in git_lines(
        root, "log", "--format=%H %as", *(["--since=" + since] if since else []), "--", *rels)]
        if root and not shallow else [])
    # newest first, back until one refuses: the leash is the run of commits since
    # the last time this world did not hold
    judged, broke = 0, None
    for sha, when in marks:
        d = tempfile.mkdtemp(prefix="gate-badge-")
        wrote = []
        for rel in rels:
            blob = subprocess.run(["git", "-C", root, "show", f"{sha}:{rel}"],
                                  capture_output=True, text=True)
            if blob.returncode:
                continue                       # the file was not in that tree yet
            p = os.path.join(d, os.path.basename(rel))
            open(p, "w").write(blob.stdout)
            wrote.append(p)
        ok = wrote and "THE JUDGE holds" in subprocess.run(
            [JUDGE, "judge", *wrote], capture_output=True, text=True).stdout
        shutil.rmtree(d, ignore_errors=True)
        if not wrote:
            continue
        judged += 1
        if not ok:
            broke = when
            break
    span = marks[0][1] if marks else None
    days = ((_date.today() - _date.fromisoformat(broke)).days if broke
            else (_date.today() - _date.fromisoformat(marks[-1][1])).days if marks else None)
    right = f"{claims} claims · {'holds' if holds else 'refused'}" + (f" · {days}d" if days is not None else "")
    if out_path:
        lw, rw = 40, 8 + int(len(right) * 6.2)
        open(out_path, "w").write(BADGE_SVG.format(
            w=lw + rw, lw=lw, rw=rw, tx=lw + 5, right=esc_xml(right),
            fill="#007D36" if holds else "#BF4035", alt="gate: " + right))
    return {"command": "badge", "claims": claims, "verdict": "holds" if holds else "refused",
            "commits_judged": judged, "unbroken_days": days, "last_refusal": broke,
            "shallow": bool(shallow), "wrote": out_path, "text": right,
            "ms": round((time.time() - t0) * 1000, 1),
            "note": (("this repository arrived without history, so only today is counted"
                      if shallow or not marks else
                      f"{judged} commits that touched this world were judged again, oldest {marks[-1][1]}"
                      + (f", and the last that did not hold was {broke}" if broke else ", and every one held"))
                     + " — the judge counts the claims again on every run"),
            "next": ("put it in the README beside the build: it says how WIDE the green is, "
                     "which a badge that only says green does not"),
            "mutates": bool(out_path)}


def esc_xml(s):
    return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def git_lines(root, *args):
    r = subprocess.run(["git", "-C", root] + list(args), capture_output=True, text=True, errors="replace")
    return [l for l in r.stdout.split("\n") if l.strip()]


def contract_revisions(path, since=None):
    # every revision of a contract, oldest first, read out of git and never off
    # the disk: one `cat-file --batch` for the lot, because a hundred and fifty
    # `git show` calls is a minute of somebody's morning.
    # through realpath on BOTH sides: git answers with the real path, and on a
    # mac the temp directory is a symlink, so a path taken as written produced a
    # relative name climbing out of the repository and a history of nothing.
    full = os.path.realpath(path)
    here = os.path.dirname(full) or "."
    root = (subprocess.run(["git", "-C", here, "rev-parse", "--show-toplevel"],
                           capture_output=True, text=True).stdout or "").strip()
    if not root:
        return None, []
    root = os.path.realpath(root)
    rel = os.path.relpath(full, root)
    if rel.startswith(".."):
        return None, []
    args = ["log", "--reverse", "--format=%H %as"] + (["--since=" + since] if since else []) + ["--", rel]
    marks = [l.split(None, 1) for l in git_lines(root, *args)]
    if not marks:
        return root, []
    p = subprocess.Popen(["git", "-C", root, "cat-file", "--batch"],
                         stdin=subprocess.PIPE, stdout=subprocess.PIPE)
    blob, _ = p.communicate("\n".join(f"{sha}:{rel}" for sha, _d in marks).encode())
    out, i = [], 0
    for (_sha, when) in marks:
        j = blob.find(b"\n", i)
        if j < 0:
            break
        head = blob[i:j].split()
        if len(head) < 3:                      # the path did not exist in that tree
            i = j + 1
            continue
        size = int(head[2])
        out.append((when, blob[j + 1:j + 1 + size]))
        i = j + 1 + size + 1
    return root, out


def first_mentions(root, names, only=None, without=None):
    # when each name first appeared in a library, read from the diffs themselves.
    # A name is looked for in every spelling the library might use, which is why
    # this sees a Go client the contract door cannot: `json:"with_vector"` holds
    # the wire name even where the field beside it is written `WithVector`.
    # and only where the library IS. Two ways this lies if it is let loose over a
    # whole repository: a monorepo answers for a sibling package, and — worse —
    # a contract kept beside its client answers for the client, since the commit
    # that adds a field to the spec adds the name in a line beginning with a
    # plus. That reads as same-day adoption of everything, forever.
    where = ["--", only] if only else []
    if without:
        where = (where or ["--"]) + [":(exclude)" + without]
    left = {n: re.compile(r"\b(?:" + "|".join(re.escape(v) for v in name_variants(n)) + r")\b")
            for n in names}
    seen, when = {}, None
    p = subprocess.Popen(["git", "-C", root, "log", "--reverse", "-p", "--no-color",
                          "--format=~gate~ %as", *where],
                         stdout=subprocess.PIPE, text=True, errors="replace")
    for line in p.stdout:
        if line.startswith("~gate~ "):
            when = line[7:].strip()
            continue
        if not line.startswith("+") or line.startswith("+++"):
            continue
        for n in [n for n, rx in left.items() if rx.search(line)]:
            seen[n] = when
            del left[n]
        if not left:
            break
    p.stdout.close()
    p.terminate()
    return seen


DECLARE_HEADER = """// printed by gate declare — one side of a seam, SAID rather than found.
// Whoever runs this owns what it says: it is a view of a document they publish,
// emitted by their own build and signed by merging it. Nothing here was read out
// of anybody's source, because judgement has no jurisdiction over a world that
// has not entered — and this file IS the entering.
//
"""

CARRIER_HEADER = """// printed by gate declare carrier — what a library says it carries, emitted from
// what that library already keeps: its own generated schema, its own types. The
// emitter lives on its side and belongs to it; this only renders what it said
// into the grammar both sides are judged in. Where its own name for a field
// differs from the contract's, the correspondence is stated too — and only
// where it does not follow, since a declaration that restates what already
// matches is a second copy, and a second copy drifts.
//
"""


def declare_side(path, kind, role, frm=None):
    # ONE MOVEMENT, TWO DIRECTIONS, AND NOBODY SPECIAL. Everything here is an
    # emitted view of somebody's source: my world is a view of my facts, their
    # spec is a view of theirs, and the judge in bin/ is a view of the corpus —
    # `build-judge.sh` clones at a revision, builds, and writes the revision
    # down beside the binary, which is this same act spelled in sh.
    #
    #   Mine    my source.     I emit it, it is judged, and changing it changes
    #                          the verdict.
    #   Theirs  their source.  I took it, at a revision I write down. I read it
    #                          and never rewrite it.
    #
    # The row also says its ROLE, because that is which court reads it, and gate
    # refuses a row it cannot place rather than guessing — guessing is how the
    # seams once got swept into the judged world.
    #
    # gate never fetches and never sends: a file of theirs arrives because an
    # operator brought it — a checkout in CI, a copy, whatever they already
    # trust — and this only writes down that it is here, whose it is, and when.
    #
    # The other direction is a pull request. Put a side and its two lines in
    # THEIR repository and their own CI holds them to it: touch the field and
    # the seam parts on their side, with an address. Unsubscribing is deleting
    # the file, which is a commit like any other — visible, dated, and nobody's
    # to do quietly.
    d = os.path.dirname(os.path.abspath(path)) or "."
    mp = os.path.join(d, "gate.manifest.swift")
    name = sanitize(os.path.splitext(os.path.basename(path))[0]).title().replace("_", "") or "Side"
    ROLE_ATOM = {"world": "WorldFile", "seam": "SeamFile", "forms": "FormsFile",
                 "judge": "JudgeFile"}
    text = open(mp, encoding="utf-8").read() if os.path.exists(mp) else (
        "// ONE LIST, AND THREE COLUMNS. Whose source a file is, what court reads\n"
        "// it, and — for anything taken — the revision it was taken at. gate\n"
        "// obeys this document and never guesses at a row.\n"
        "//\n"
        "// Written the way every record in this world is written: the columns are\n"
        "// AXES to declared atoms, and the one string is the `typeName` literal\n"
        "// that spells a name. A revision is an atom of its own, so two rows taken\n"
        "// at the same revision say the same name rather than the same text.\n"
        "public protocol Role {}\n"
        "public enum WorldFile: Role {}\n"
        "public enum SeamFile: Role {}\n"
        "public enum FormsFile: Role {}\n"
        "public enum JudgeFile: Role {}\n"
        "\npublic protocol Mine {}\n")
    if kind == "Theirs" and "public protocol Theirs {}" not in text:
        text += ("\n// and what this world took from somewhere else. A file is here because\n"
                 "// this side said so, never because it was lying beside the others, and it\n"
                 "// says the revision it was taken at: there are no ranges anywhere in this\n"
                 "// tool, which is why nothing here has to be solved.\n"
                 "public protocol Theirs {}\n")
    rev = ""
    if frm:
        rev_atom = "Rev_" + re.sub(r"\W+", "_", frm).strip("_")
        if "public enum " + rev_atom + " {}" not in text:
            rev = ('public enum ' + rev_atom + ' {}\n'
                   'extension ' + rev_atom + ' { public static var typeName: String { "'
                   + frm + '" } }\n')
    line = (rev
            + 'public enum ' + name + ': ' + kind + ' {\n'
            + '    public typealias Kind = ' + ROLE_ATOM[role] + '\n'
            + ('    public typealias At = Rev_' + re.sub(r"\W+", "_", frm).strip("_") + '\n'
               if frm else '')
            + '}\n'
            + 'extension ' + name + ' { public static var typeName: String { "'
            + os.path.basename(path) + '" } }\n')
    if line not in text:
        # KEPT IN ITS OWN GROUP, because this document is read by a person: what
        # I write and what I only read are the one distinction it exists to draw,
        # and appending everything to the bottom mixes them back together.
        rows = text.split("\n")
        last = max((i for i, r in enumerate(rows) if r.startswith("public enum ")
                    and r.endswith(": " + kind + " {}")), default=-1)
        if last >= 0:
            # PAST THE WHOLE BLOCK, not past one line of it. A row is written as
            # an extension BODY now, and stepping over it by its first line put
            # the next row inside the previous one's braces — where it parsed as
            # something, so the reader kept going and simply lost the row it had
            # swallowed. An account that quietly stops being true is the one
            # failure this tool exists to make impossible, so it is a brace
            # count now and not a guess at a shape.
            while last + 1 < len(rows) and rows[last + 1].startswith("extension "):
                depth = 0
                while last + 1 < len(rows):
                    last += 1
                    depth += rows[last].count("{") - rows[last].count("}")
                    if depth <= 0:
                        break
            rows.insert(last + 1, line.rstrip("\n"))
            text = "\n".join(rows)
        else:
            text += line
    open(mp, "w").write(text)
    return os.path.basename(mp)


def forget_side(path, d):
    # UNSUBSCRIBING IS DELETING A LINE, and it has to be as cheap as writing one
    # or the list rots: a row nobody can remove without opening the file by hand
    # is a row people stop maintaining, and then the account lies. The FILE is
    # not touched — taking a thing out of your account is not the same act as
    # throwing it away, and gate does not get to decide the second one.
    mp = os.path.join(d, "gate.manifest.swift")
    if not os.path.exists(mp):
        return None, None
    text = open(mp, encoding="utf-8").read()
    _, rows = read_manifest_rows(d)
    row = next((r for r in (rows or []) if r["path"] == path
                or os.path.basename(r["path"]) == os.path.basename(path)), None)
    if not row or not row["name"]:
        return None, None
    # BY BRACES, NOT BY SHAPE. A row is an enum body and an extension body now,
    # and a pattern written for the one-line form matched neither — so this said
    # the row was gone and left it there, which is the same silent lie the
    # grouping insert told a day ago. Anything that edits this document counts
    # braces; nothing about it is guessed from how a line happens to look.
    n, rows_out, i = row["name"], [], 0
    lines = text.split("\n")
    heads = ("public enum " + n + ":", "extension " + n + " ", "extension " + n + "{")
    while i < len(lines):
        if lines[i].startswith(heads[0]) or lines[i].startswith(heads[1]) \
                or lines[i].startswith(heads[2]):
            depth = lines[i].count("{") - lines[i].count("}")
            i += 1
            while depth > 0 and i < len(lines):
                depth += lines[i].count("{") - lines[i].count("}")
                i += 1
            continue
        rows_out.append(lines[i])
        i += 1
    open(mp, "w").write("\n".join(rows_out))
    return os.path.basename(mp), row


def declare_mine(path, argv):
    at = argv[argv.index("--at") + 1] if "--at" in argv else None
    return declare_side(path, "Theirs", "seam", at)


def cmd_side(a, kind):
    # gate mine PATH [--role R] · gate theirs PATH --at REV [--role R]
    #
    # The same command shape both directions, so that saying a true thing about
    # a file I emitted costs exactly what saying one about a file I took costs.
    # The asymmetry that remains is the one that is really there: what I took, I
    # took from somewhere at something, and that is a fact about it the way its
    # path is.
    word = "mine" if kind == "Mine" else "theirs"
    role = a[a.index("--role") + 1] if "--role" in a else ("world" if kind == "Mine" else "seam")
    at = a[a.index("--at") + 1] if "--at" in a else None
    rest = [x for x in a if not x.startswith("--")]
    for flag in ("--role", "--at"):
        if flag in a and a.index(flag) + 1 < len(a):
            rest = [x for x in rest if x != a[a.index(flag) + 1]]
    usage = (f"gate {word} PATH" + ("" if kind == "Mine" else " --at REV")
             + " [--role " + "|".join(ROLES) + "] · " + f"gate {word} PATH --forget")
    if not rest:
        # THE SAME WORD ASKS AND ANSWERS. With a path it declares; with none it
        # is the question an owner actually has — what have I got, whose is it,
        # and how fresh. Answering that needed no new noun, and a list you can
        # only get by opening a file in an editor is a list nobody looks at.
        d = os.path.dirname(os.path.abspath(FACTS)) if FACTS else os.getcwd()
        _, rows = read_manifest_rows(d)
        held = [r for r in (rows or []) if r["source"] == word]
        if not held:
            return {"command": word, "asks": True, "note": usage,
                    "next": ("a file you emit, judged with the rest of your world"
                             if kind == "Mine" else
                             "a file you took from somewhere, at the revision you took it at")}
        return {"command": word, "held": [
            {"file": r["path"], "role": r["role"], "at": r["from"]} for r in held],
            "note": usage, "mutates": False}
    path = rest[0]
    if "--forget" in a:
        d = os.path.dirname(os.path.abspath(path)) or "."
        mp, row = forget_side(os.path.basename(path), d)
        if not mp:
            return {"command": word, "asks": True,
                    "note": f"{os.path.basename(path)} is not in your list",
                    "next": f"gate {word} — what is in it"}
        return {"command": word, "forgot": row["path"], "declared_in": mp, "mutates": True,
                "note": "out of your account. The file is still on disk: taking a thing out of "
                        "your list is not throwing it away, and that second act is yours alone",
                "next": "delete the file too if you meant that — a commit like any other, "
                        "visible and dated"}
    if not os.path.exists(path):
        return {"command": word, "asks": True, "note": f"no file at {path}",
                "next": "bring the file here first — gate never fetches: a file of theirs "
                        "arrives by a checkout, a copy, a vendor step you already trust"}
    if role not in ROLES:
        return {"command": word, "asks": True,
                "note": f"`{role}` is not a court anything here reads",
                "next": "a row says what it is for: "
                        + " · ".join(f"`{k}` — {v}" for k, v in ROLES.items())}
    if kind == "Theirs" and not at:
        # THE PIN IS THE POINT. Nothing in this tool expresses a range, which is
        # exactly why no version solver exists here — the problem is not solved,
        # it cannot be stated. A revision nobody wrote down gives that away for
        # free, so taking without one is not a thing that happens.
        return {"command": word, "asks": True,
                "note": "what is taken is taken at a revision, and this one says none",
                "next": f"gate theirs {os.path.basename(path)} --at REV — a commit, a tag, a "
                        "release: whatever the source calls the thing you actually took"}
    mp = declare_side(path, kind, role, at)
    out = {"command": word, "file": os.path.basename(path), "declared_in": mp,
           "role": role, "role_means": ROLES[role], "mutates": True}
    if kind == "Mine":
        out["note"] = ("mine: I emit it, it is judged with the rest of my world, and changing "
                       "it changes the verdict")
        out["next"] = "gate status — it is judged from here on"
        return out
    out["at"] = at
    out["note"] = (f"theirs, taken at {at}: I read it and never rewrite it. To move it, take it "
                   "again at a newer revision — there is nothing here to solve")
    out["next"] = ("gate attention — what now waits for a word, read the same from either side"
                   if role == "seam" else
                   "gate status — the row is accounted for, and its court is `" + role + "`")
    return out


def cmd_declare(a):
    # declare contract SPEC [-o F] · declare carrier DECL.json [-o F]
    #
    # THE ACT OF ENTRY. Everything gate judges is on this side of it, and nothing
    # else is: what a walk finds outside remains an observation forever. The two
    # halves are asymmetric on purpose. A contract states its own types in a
    # public format, so one emitter serves everybody and we ship it. A library's
    # grammar is its own, so we ship no reader for it at all — its build emits a
    # small declaration, and this renders that into the shared words.
    import json as _json
    what = a[0] if a else ""
    out_path = a[a.index("-o") + 1] if "-o" in a else None
    if what == "contract":
        src = a[1]
        mine_too = "--theirs" in a or "--mine" in a
        fields = [f for f in read_contract(src) if f.get("shape")]
        lines = [DECLARE_HEADER + STDLIB["forms-contract"], ""]
        for f in fields:
            rec = "F_" + sanitize(f["route"]) + "_" + sanitize(f["field"])
            lines += [f"// {f['route']} · {f['field']}",
                      f"public enum {rec}: Declared {{",
                      f"    public typealias Of = {f['shape']}", "}"]
        world = "\n".join(lines) + "\n"
        if out_path:
            open(out_path, "w").write(world)
        mine = declare_side(out_path, "Theirs", "seam",
                            a[a.index("--at") + 1] if "--at" in a else
                            os.path.basename(src)) if (mine_too and out_path) else None
        return {"command": "declare contract", "of": os.path.basename(src), "declared_in": mine,
                "declares": len(fields), "wrote": out_path, "world": None if out_path else world,
                "note": ("a view of that document: every field it states a type for, as a record "
                         "whose shape is an axis. Fields it leaves open state no shape and are not "
                         "here — a contract that says `anyOf` has not said which"),
                "next": "commit it: from here on it is what you have said, and it is judged",
                "mutates": bool(out_path)}
    if what == "carrier":
        decl = _json.load(open(a[1], encoding="utf-8"))
        who = sanitize(decl.get("carrier") or "Carrier")
        against = decl.get("against") or {}
        lines = [CARRIER_HEADER
                 + f"// {who} · against {against.get('contract', 'a contract')}"
                 + (f" at {against['revision']}" if against.get("revision") else "") + "\n",
                 f"public enum {who}: Carrier {{}}", ""]
        for i, c in enumerate(decl.get("carries") or []):
            rec = "F_" + sanitize(c["route"]) + "_" + sanitize(c["field"])
            mine = f" (it calls it {c['mine']})" if c.get("mine") else ""
            lines += [f"// {c['route']} · {c['field']}{mine}",
                      f"public typealias Carry_{i} = Carries<{who}, {rec}, {c['as']}>"]
        world = "\n".join(lines) + "\n"
        if out_path:
            open(out_path, "w").write(world)
        # THE PIN IT ALREADY CARRIES. A carrier declaration says what contract it
        # was built against and at what revision; asking the operator to type
        # that again would be asking for a second copy of a fact, and a second
        # copy drifts. `--at` overrides where the emitter said nothing.
        pin = (a[a.index("--at") + 1] if "--at" in a
               else against.get("revision") or against.get("contract"))
        mine = (declare_side(out_path, "Theirs", "seam", pin)
                if (("--theirs" in a or "--mine" in a) and out_path) else None)
        return {"command": "declare carrier", "carrier": who, "declared_in": mine,
                "declares": len(decl.get("carries") or []), "wrote": out_path,
                "world": None if out_path else world,
                "against": against,
                "note": ("what this library says it carries. It is not judgeable alone — a carrier "
                         "declaration is about a contract, and the pair is judged by `gate seam`"),
                "next": ("run it again with --theirs to write it into gate.manifest.swift, and put "
                         "this file plus those two lines in THEIR repository: their own CI then "
                         "holds them to what you carry" if not mine else
                         "put this file and its two manifest lines in THEIR repository: from then "
                         "on their CI parts the seam the day they touch what you carry"),
                "mutates": bool(out_path)}
    return {"command": "declare", "asks": True,
            "note": "declare contract SPEC [-o F]  ·  declare carrier DECL.json [-o F]",
            "next": ("the carrier declaration is emitted by that library's own build: "
                     '{"carrier": N, "against": {...}, "carries": [{"route", "field", "as", "mine"?}]}')}


def seam_read(left, right):
    # the two declarations, taken apart: what the contract stated, what the
    # carrier claimed, and whose name is on the claims.
    stated = {(m.group(1), m.group(2)) for m in re.finditer(r"^// (\S+) · (\S+)$", left, re.M)}
    claims = {}
    for m in re.finditer(r"^// (\S+) · (\S+)(?: \(it calls it (\S+)\))?\npublic typealias (Carry_\d+)",
                         right, re.M):
        claims[m.group(4)] = (m.group(1), m.group(2), m.group(3))
    who = re.search(r"public enum (\w+): Carrier", right)
    return stated, claims, (who.group(1) if who else "that library")


def declared_seam_files(base):
    # WHICH SEAMS ARE MINE IS MINE TO SAY. Sniffing the folder for files that
    # look like seam sides is guessing at somebody's relationships from the shape
    # of what happens to be lying about — the same sin as reading a library's
    # source, one storey up. The layout file already declares what belongs to
    # this world; it declares the seams this world is party to the same way, and
    # the rail shows exactly that and nothing else.
    # Membership is DECLARED; which side a file is, that file says about itself
    # in its own first lines. Mine to say what is mine; theirs to say what theirs
    # is.
    mp, rows = read_manifest_rows(base)
    if mp is None:
        return []
    return [os.path.join(base, r["path"]) for r in rows if r["role"] == "seam"]


def seams_here(root=None):
    # the pairs this folder has DECLARED itself party to, and a `known.json`
    # beside them if somebody has said a divergence is meant.
    base = os.path.abspath(root or (os.path.dirname(os.path.abspath(FACTS)) if FACTS else "."))
    stated, claimed = [], []
    for full in declared_seam_files(base):
        if not (os.path.exists(full) and is_seam_side(full)):
            continue
        txt = open(full, encoding="utf-8", errors="replace").read(4000)
        if re.search(r"^public enum \w+: Carrier \{\}", txt, re.M):
            claimed.append(full)
        else:
            stated.append(full)
    known = os.path.join(base, "known.json")
    tick = os.path.join(base, "tickets.json")
    out = []
    # A SIDE DECLARED ALONE IS A STATE, NOT A BLANK. Somebody who has just said
    # what they carry and is waiting for the other end to arrive would otherwise
    # see nothing at all and think the declaration had not taken — which is the
    # ordinary state of whoever moves first, and moving first is what we ask.
    if not (stated and claimed):
        for f in (stated + claimed):
            side = "carries" if f in claimed else "states"
            out.append({"command": "attention", "alone": side,
                        "carrier": re.search(r"public enum (\w+): Carrier",
                                             open(f, encoding="utf-8").read())
                        .group(1) if f in claimed else os.path.basename(f),
                        "contract_file": os.path.basename(f), "carrier_file": os.path.basename(f),
                        "stated": 0, "claimed": 0, "waits_on_you": [], "you_wait_on": [],
                        "parted": [], "known": [], "expired": [], "against": None,
                        "read_known": None, "read_tracker": None})
        return out
    for c in stated:
        for k in claimed:
            args = [c, k]
            if os.path.exists(known):
                args += ["--known", known]
            if os.path.exists(tick):
                args += ["--tracker", tick]
            a = cmd_attention(args)
            import json as _j
            try:
                decl = re.search(r"^// \w+ · against ([^\n]+)$",
                                 open(k, encoding="utf-8").read(2000), re.M)
                a["against"] = decl.group(1) if decl else None
            except OSError:
                a["against"] = None
            a["contract_file"] = os.path.basename(c)
            a["carrier_file"] = os.path.basename(k)
            # AND THE PIN, WHERE THE OWNER IS LOOKING. `against` is what the
            # other side said it built against; this is what YOU wrote down when
            # you took each file, which is the fact you can act on — and it was
            # readable only by opening the manifest in an editor.
            _mp, _rows = read_manifest_rows(os.path.dirname(os.path.abspath(c)))
            _row = {r["path"]: r for r in (_rows or [])}
            # AND THE VIEW POINTS AT THE PRIMARY. What is taken is a reading of
            # a claim, and the claim is a line in a file the operator wrote — so
            # the row carries the address of that line rather than standing as a
            # thing of its own. Nothing here is editable: you go and change the
            # sentence you wrote, and this changes with it.
            a["took"] = [{"file": os.path.basename(f),
                          "at": (_row.get(os.path.basename(f)) or {}).get("from"),
                          "claim": os.path.basename(_mp) if _mp else None,
                          "line": (_row.get(os.path.basename(f)) or {}).get("line")}
                         for f in (c, k)]
            a["read_known"] = os.path.basename(known) if os.path.exists(known) else None
            a["read_tracker"] = os.path.basename(tick) if os.path.exists(tick) else None
            out.append(a)
    return out


def cmd_attention(a):
    # attention CONTRACT.swift CARRIER.swift [--as WHO] [--known K.json] [--tracker T.json]
    #
    # NOT WHAT CHANGED — WHAT WAITS FOR A WORD. History is diachronic and git
    # already keeps it; this is the other cut, the standing ledger of who owes
    # whom a sentence. It is two-sided by construction rather than by design: an
    # unanswered axis sits on the side that owes the answer, so the same movement
    # that shows a front-end what its back-end is waiting for shows the back-end
    # what the front-end is waiting for. A sensor opens a hole for a technologist
    # exactly as a client opens one for a contract.
    #
    # AND INTENTION IS DECLARED, NEVER GUESSED. A divergence somebody said out
    # loud is a fact with an author; one nobody said is, by construction,
    # unintended — that is the gate's own law, applied to disagreement. But a
    # declaration without a term is an amnesty, and every temporary exception
    # outlives its reason, so a declared divergence must CITE something that can
    # close. When the tracker says it closed, the exception stops holding and the
    # item comes back — louder, because the ground it stood on is gone.
    import json as _json
    if len(a) < 2:
        return {"command": "attention", "asks": True,
                "note": "attention CONTRACT.swift CARRIER.swift [--as WHO] [--known K.json] [--tracker T.json]",
                "next": "gate declare contract … and gate declare carrier … first"}
    left, right = open(a[0], encoding="utf-8").read(), open(a[1], encoding="utf-8").read()
    stated, claims, carrier = seam_read(left, right)
    me = a[a.index("--as") + 1] if "--as" in a else carrier
    known = _json.load(open(a[a.index("--known") + 1], encoding="utf-8")) if "--known" in a else {}
    tracker = read_tracker(a[a.index("--tracker") + 1]) if "--tracker" in a else {}

    d = tempfile.mkdtemp(prefix="gate-att-")
    path = os.path.join(d, "seam.swift")
    open(path, "w").write(left + "\n" + right)
    outp = subprocess.run([JUDGE, "judge", "where", path], capture_output=True, text=True).stdout
    shutil.rmtree(d, ignore_errors=True)
    claimed = {(r, f) for r, f, _ in claims.values()}
    parted = {}
    for m in re.finditer(r"^✗ '(\w+)[^']*' requires the types '[^']*' \(aka '([^']+)'\) and "
                         r"'[^']*' \(aka '([^']+)'\)", outp, re.M):
        cert, want, got = m.groups()
        route, field, mine = claims.get(cert, ("?", cert, None))
        # a claim about something the contract never stated is not a
        # DISAGREEMENT — there is nothing to disagree with. It is the contract
        # owing a sentence, and it belongs in the other column entirely; left
        # here it read as a conflict with a record that does not exist.
        if (route, field) in stated:
            parted[(route, field)] = (want.lower(), got.lower(), mine)
    # who owes what: the carrier owes an answer on a field the contract stated
    # and it has not spoken of; the contract owes one on a field the carrier
    # carries and it never declared — the same shape, pointing the other way
    owes_carrier = sorted(stated - claimed)
    owes_contract = sorted(claimed - stated)

    def excuse(route, field):
        # a declared divergence, and whether the thing it cites is still open
        for k in (known.get("diverges") or []):
            if k.get("route") == route and k.get("field") == field:
                why = k.get("because") or ""
                state = tracker.get(why)
                return {"address": f"{route} · {field}", "because": why,
                        "declared_by": k.get("declared_by") or "somebody",
                        "state": state or ("unread" if tracker else "not checked")}
        return None

    def sort(items, kind):
        live, dead, plain = [], [], []
        for route, field in items:
            ex = excuse(route, field)
            if ex is None:
                plain.append({"address": f"{route} · {field}", "kind": kind})
            elif ex["state"] == "Closed":
                dead.append({**ex, "kind": kind})
            else:
                live.append({**ex, "kind": kind})
        return plain, live, dead

    waits_on_me, known_mine, expired_mine = sort(owes_carrier if me == carrier else owes_contract,
                                                 "unanswered")
    i_wait, known_theirs, expired_theirs = sort(owes_contract if me == carrier else owes_carrier,
                                                "unanswered")
    parts, known_part, expired_part = sort(sorted(parted), "parted")
    for p in parts + known_part + expired_part:
        route, field = p["address"].split(" · ")
        want, got, mine = parted[(route, field)]
        p["why"] = (f"the contract states {want}; {carrier} declares "
                    + (f"its own {mine} as " if mine else "") + got)
    return {"command": "attention", "as": me, "carrier": carrier,
            "waits_on_you": waits_on_me, "you_wait_on": i_wait, "parted": parts,
            "known": known_mine + known_theirs + known_part,
            "expired": expired_mine + expired_theirs + expired_part,
            "stated": len(stated), "claimed": len(claims),
            "note": ("a standing account of who owes whom a word. An unanswered axis sits with "
                     "whoever owes the answer, so this reads the same from either side" + ("; a divergence somebody declared is set aside while the "
                     "thing it cites is open, and comes back when that closes" if known else "")),
            "next": ("answer the first line above, or declare the divergence with something that can "
                     "close" if waits_on_me else
                     "nothing waits on you here" if not (i_wait or parts) else
                     "these wait on the other side; they are listed so you know what you are waiting for"),
            "mutates": False}


def cmd_aside(a):
    # aside ROUTE FIELD --because KEY [--by WHO] [-o known.json] — say out loud
    # that a divergence is meant, and name the thing that will end it.
    #
    # FRICTION IS NOT EVENLY DESERVED. Saying a true thing should cost nothing;
    # setting a true thing aside should cost a reason that can close, because an
    # exception with no term is an amnesty and every temporary one outlives what
    # it was for. So this asks for the reason and refuses without it — and then
    # takes the two hand-edits it used to take and makes them one sentence.
    import json as _json
    if len(a) < 2 or "--because" not in a:
        return {"command": "aside", "asks": True,
                "note": "aside ROUTE FIELD --because KEY [--by WHO] [-o known.json]",
                "next": ("the reason is not optional: name something that can close — a ticket, a "
                         "release — and this stands aside only while that is open")}
    route, field = a[0], a[1]
    because = a[a.index("--because") + 1]
    by = a[a.index("--by") + 1] if "--by" in a else (
        subprocess.run(["git", "config", "user.name"], capture_output=True, text=True).stdout.strip()
        or "somebody")
    path = a[a.index("-o") + 1] if "-o" in a else "known.json"
    known = {"diverges": []}
    if os.path.exists(path):
        try:
            known = _json.load(open(path, encoding="utf-8"))
        except Exception:
            known = {"diverges": []}
    rows = [d for d in (known.get("diverges") or [])
            if not (d.get("route") == route and d.get("field") == field)]
    rows.append({"route": route, "field": field, "because": because, "declared_by": by})
    known["diverges"] = rows
    _json.dump(known, open(path, "w"), indent=1)
    return {"command": "aside", "address": f"{route} · {field}", "because": because,
            "declared_by": by, "wrote": path, "standing": len(rows),
            "note": (f"{by} says this one is meant, while {because} is open. It stands out of the "
                     f"way until {because} closes, and comes back by itself when it does"),
            "next": (f"point a tracker export at it — `gate attention … --known {path} --tracker "
                     "tickets.json` — and the day it closes this returns first"),
            "mutates": True}


def cmd_seam(a):
    # seam CONTRACT.swift CARRIER.swift — two declarations, one world, one court.
    #
    # This is the only place gate refuses anything about a pair, and it can only
    # do it because both sides are here BY THEIR OWN WORD. The refusal is never
    # about somebody's code: it is about two sentences that do not agree, each
    # signed by whoever wrote it.
    if len(a) < 2:
        return {"command": "seam", "asks": True,
                "note": "seam CONTRACT.swift CARRIER.swift — both sides, as each declared them",
                "next": "gate declare contract … and gate declare carrier … first"}
    left, right = open(a[0], encoding="utf-8").read(), open(a[1], encoding="utf-8").read()
    m = re.search(r"public enum (\w+): Carrier", right)
    who = m.group(1) if m else "that library"
    where = {}
    for m in re.finditer(r"^// (\S+) · (\S+)(?: \(it calls it (\S+)\))?\npublic typealias (Carry_\d+)",
                         right, re.M):
        where[m.group(4)] = (m.group(1), m.group(2), m.group(3))
    d = tempfile.mkdtemp(prefix="gate-seam-")
    path = os.path.join(d, "seam.swift")
    open(path, "w").write(left + "\n" + right)
    t0 = time.time()
    outp = subprocess.run([JUDGE, "judge", "where", path], capture_output=True, text=True).stdout
    ms = round((time.time() - t0) * 1000, 1)
    refusals = []
    for m in re.finditer(r"^✗ '(\w+)[^']*' requires the types '[^']*' \(aka '([^']+)'\) and "
                         r"'[^']*' \(aka '([^']+)'\)", outp, re.M):
        cert, want, got = m.groups()
        route, field, mine = where.get(cert, ("?", cert, None))
        refusals.append({"address": f"{route} · {field}",
                         "claim": (f"the contract declares it {want.lower()}; {who} declares "
                                   + (f"its own {mine} as " if mine else "it ")
                                   + f"{got.lower()}")})
    # a field the contract declares and no carrier claims: not a disagreement,
    # since a claim never made cannot be refused — named beside the judgement
    claimed = {(r, f) for r, f, _ in where.values()}
    silent = [m.group(1) + " · " + m.group(2)
              for m in re.finditer(r"^// (\S+) · (\S+)$", left, re.M)
              if (m.group(1), m.group(2)) not in claimed]
    shutil.rmtree(d, ignore_errors=True)
    return {"command": "seam", "verdict": "refused" if refusals else "holds",
            "refusals": refusals, "judged": len(where), "unclaimed": silent,
            "judge_ms": ms,
            "carrier": who,
            "note": (f"{len(where)} claims judged"
                     + (f"; {len(silent)} field{'s' if len(silent) != 1 else ''} the contract declares "
                        + ("are" if len(silent) != 1 else "is")
                        + " claimed by nobody: a claim never made cannot be refused, so it stands "
                        "beside the judgement" if silent else "")),
            "next": ("open the address above: two declarations, both signed, do not agree"
                     if refusals else "wire it into CI: neither side can move without the other seeing"),
            "mutates": False}


def cmd_drift(a):
    # drift CONTRACT --client DIR [--since DATE] [--name N] [--fail-over DAYS]
    #
    # OBSERVATION, AND NOTHING ELSE. This looks at a world that has not entered
    # ours, so it holds no court and carries no verdict: what it prints are
    # lexical facts about git objects — a string is in this diff, a commit bears
    # this date — and the reader may re-run every one of them. Judgement waits
    # for the gate; nothing outside it can be judged, because nobody there has
    # spoken for anything.
    #
    # Two kinds of fact, and they are not equally certified. PRESENCE is an
    # object: the commit that introduced a string is named by its own hash.
    # ABSENCE is a walk, and a walk is only as good as its bounds — so the bounds
    # are printed beside every absence, and a reader who points at one excluded
    # file has refuted the claim, which is exactly what makes it a claim.
    import json as _json
    from datetime import date as _date
    # the first thing a stranger types is `--help`, and taking it for a filename
    # printed an observation of a contract that does not exist
    if not a or a[0].startswith("-") or not os.path.exists(a[0]):
        return {"command": "drift", "asks": True,
                "note": ("drift CONTRACT --client DIR [--since DATE] [--name N] [--fail-over DAYS]"
                         + ("" if not a or a[0].startswith("-") else
                            f" — no such contract here: {a[0]}")),
                "next": "the contract is a JSON OpenAPI document in a git checkout; "
                        "for YAML, `yq -o=json '.' spec.yml > spec.json` first"}
    src = a[0]
    root = a[a.index("--client") + 1] if "--client" in a else "."
    since = a[a.index("--since") + 1] if "--since" in a else None
    who = a[a.index("--name") + 1] if "--name" in a else sanitize(os.path.basename(os.path.abspath(root)))
    over = int(a[a.index("--fail-over") + 1]) if "--fail-over" in a else None
    t0 = time.time()
    _sroot, revs = contract_revisions(src, since)
    # HISTORY DATES; TODAY WALKS. The union over every revision is what the
    # contract has EVER said, and dating needs that — but a name the contract
    # retired two years ago is not one the library is missing, and asking the
    # walk about it turned one true absence into thirty. So the walk asks the
    # contract as it stands, and only the dates come from the union.
    declared, current, routes = {}, [], {}
    for when, blob in revs:
        try:
            spec = _json.loads(blob.decode("utf-8", "replace"))
        except Exception:
            continue                            # a revision that did not parse says nothing
        for f in contract_fields(spec):
            declared.setdefault(f["field"], when)
    try:
        now = contract_fields(_json.loads(open(src, encoding="utf-8").read()))
    except Exception:
        now = []
    for f in now:
        current.append(f["field"])
        routes.setdefault(f["route"], True)
        declared.setdefault(f["field"], None)

    # ── the walk, and its bounds
    body, scope = read_carrier(root)
    words = set(re.findall(r"\w+", body))
    spoken = set(re.findall(r"[\"'`/]([A-Za-z0-9_.\-]+)(?=[\"'`/?]|$)", body, re.M))
    unwritten = sorted({n for n in current if not (name_variants(n) & words)})
    silent = []
    if any(all(s in spoken for s in [x for x in r.split("/") if x and not x.startswith("{")])
           for r in routes):
        # a library that writes no URL at all is not a library that lacks every
        # endpoint: it is one that keeps its paths somewhere this walk did not go
        for r in sorted(routes):
            segs = [x for x in r.split("/") if x and not x.startswith("{")]
            if segs and not all(s in spoken for s in segs):
                silent.append(r)

    # ── the history, where there is one
    croot = (subprocess.run(["git", "-C", root, "rev-parse", "--show-toplevel"],
                            capture_output=True, text=True).stdout or "").strip()
    croot = os.path.realpath(croot) if croot else ""

    def shallow(r):
        return r and (subprocess.run(["git", "-C", r, "rev-parse", "--is-shallow-repository"],
                                     capture_output=True, text=True).stdout or "").strip() == "true"
    thin = [w for w, r, n in ((os.path.basename(src), _sroot, len(revs)), (who, croot, 2))
            if not r or shallow(r) or n < 2]
    late, undatable, median, worst = [], [], 0, []
    if not thin:
        here = os.path.relpath(os.path.realpath(root), croot)
        spec_rel = (os.path.relpath(os.path.realpath(src), croot)
                    if os.path.realpath(src).startswith(croot + os.sep) else None)
        seen = first_mentions(croot, list(declared),
                              only=None if here in (".", "") else here, without=spec_rel)
        # A WINDOW HAS AN EDGE, and it is the loudest wrong number here. With
        # --since, whatever the contract already declared when the window opened
        # carries the window's own date rather than the day it was said, so a
        # field five years old reads as new. On box that inflated nine true
        # readings into thirty-two.
        edge = revs[0][0] if since else None
        for f, sd in declared.items():
            if sd is None or sd == edge:
                undatable.append(f)
                continue
            cd = seen.get(f)
            if cd is None:
                continue                        # absence is the walk's business, above
            days = (_date.fromisoformat(cd) - _date.fromisoformat(sd)).days
            if days > 0:
                late.append({"field": f, "contract": sd, "carrier": cd, "days": days})
        late.sort(key=lambda x: -x["days"])
        mid = sorted(x["days"] for x in late)
        median = 0 if not mid else (mid[len(mid) // 2] if len(mid) % 2 else
                                    (mid[len(mid) // 2 - 1] + mid[len(mid) // 2]) // 2)
        worst = late[:5]
    # the exit code is the OPERATOR'S threshold, declared by them, and never a
    # verdict: this command has no standing to fail anybody's build on its own
    # reading of a world that never entered.
    return {"command": "drift", "contract": os.path.basename(src), "carrier": who,
            "revisions": len(revs), "declares": len(current), "since": since,
            "thin": thin, "scope": scope,
            "unwritten": unwritten, "silent_routes": silent,
            "late": len(late), "median_days": median,
            "worst_days": late[0]["days"] if late else 0, "worst": worst,
            "undatable": len(undatable),
            "over_threshold": bool(over is not None and median > over),
            "threshold": over,
            "ms": round((time.time() - t0) * 1000, 1),
            "note": ("an observation, of a world that has not entered: git objects, and a walk. "
                     + (f"no history to date anything: {' and '.join(thin)} arrived with one commit "
                        "standing in for all of them. " if thin else
                        f"{len(revs)} revisions of the contract were read, and the library's history "
                        "walked once. ")
                     + f"Absence is a fact about this walk: {scope['files']} files under "
                     + f"{scope['root']}, kinds {scope['kinds']}, skipping {scope['skipped']}"
                     + (f"; {len(undatable)} names cannot be dated, being already declared when the "
                        "window opened" if undatable else "")),
            "next": ("re-run it yourself: everything above is a git object or a walk whose bounds "
                     "are printed with it" if not thin else
                     f"git fetch --unshallow in {thin[0]}, and the dates become readable")}


# a name both sides can say: letters, digits, underscores and hyphens, because a
# hyphen converts between conventions and a dot does not — a dot inside a key is
# the wire encoding a structure, and no source anywhere carries it as a word.
SPELLABLE = re.compile(r"[A-Za-z_]\w*(?:-\w+)*")


def read_contract(path):
    # an OpenAPI document, read for the one thing a client must agree with: the
    # fields of a request body and the sort of thing each one is.
    import json as _json
    return contract_fields(_json.load(open(path, encoding="utf-8")))


def body_media(spec):
    # what a contract sends its requests AS. Asked only when nothing was read,
    # to say why: twilio posts sixty-two bodies and every one of them is a form,
    # so a reader that takes JSON alone finds no field, judges nothing, and says
    # `holds` — which is the empty green again, in a contract that never spoke
    # this reader's language at all.
    seen = {}
    for _r, ops in (spec.get("paths") or {}).items():
        for _v, op in (ops or {}).items():
            if not isinstance(op, dict):
                continue
            for k in ((op.get("requestBody") or {}).get("content") or {}):
                seen[k] = seen.get(k, 0) + 1
    return seen


# what a contract SAYS a field is. This is not inference and never was: an
# OpenAPI document states the type outright, in its own words, and reading it is
# reading a declaration rather than guessing at one. The reader that inferred
# shapes from a client's SOURCE is what went; a document that declares its own
# types is a different thing entirely, and its author signs it by publishing it.
DECLARED = {"string": "Text", "integer": "Count", "number": "Count",
            "boolean": "Flag", "array": "Many", "object": "Nested"}


def declared_shape(t):
    if isinstance(t, list):
        t = [x for x in t if x != "null"]
        t = t[0] if len(t) == 1 else None       # two types is the contract leaving it open
    return DECLARED.get(t)


def contract_fields(spec):
    # the same reading, from a document already in hand — because the drift
    # command reads a hundred and fifty of them out of git without writing one
    # to disk
    shelf = dict(spec.get("definitions") or {})
    shelf.update((spec.get("components") or {}).get("schemas") or {})

    def resolve(s):
        if "$ref" in s:
            return shelf.get(s["$ref"].split("/")[-1], {})
        return s
    # what the contract also SENDS BACK. A spec may describe one shape for both
    # directions — weaviate posts an `Object` and receives an `Object` — and then
    # its fields say nothing about what a request carries: the timestamps in it
    # are stamped by the server, and a client is not behind for leaving them out
    # or for keeping a flag of that name instead. Where the contract itself does
    # not separate the directions, this door does not pretend to.
    returned = set()

    def gather(node):
        if isinstance(node, dict):
            if "$ref" in node and isinstance(node["$ref"], str):
                returned.add(node["$ref"])
            for v in node.values():
                gather(v)
        elif isinstance(node, list):
            for v in node:
                gather(v)

    for _r, _ops in (spec.get("paths") or {}).items():
        for _v, _op in (_ops or {}).items():
            if isinstance(_op, dict):
                gather(_op.get("responses"))

    out = []
    for route, ops in (spec.get("paths") or {}).items():
        if not isinstance(ops, dict):
            continue
        # A REQUEST IS NOT ONLY ITS BODY. Half of what a contract declares stands
        # in its parameters — the id in the path, the limit in the query — and
        # reading bodies alone judged forty-six per cent of these contracts and
        # called that the whole of them. Deepgram declares seventeen body fields
        # and two hundred and forty-six parameters: six per cent judged, and a
        # green over it would have meant almost nothing. The contract states
        # each one outright, name and place and sort, so there is nothing to
        # guess here — only something that was not being read.
        shared = [p for p in (ops.get("parameters") or []) if isinstance(p, dict)]
        for verb, op in ops.items():
            if not isinstance(op, dict):
                continue
            for p in (op.get("parameters") or []) + shared:
                # QUERY ONLY, and the reason is what a name IS. A query key goes
                # on the wire exactly as written, so both sides must spell it the
                # same and may be judged against each other. The name inside
                # `{braces}` never goes anywhere: it is documentation of a slot,
                # and a client owes it nothing — typesense writes
                # `{curationSetName}` and its library calls the same thing
                # `name`, which is not drift and must not be reported as any.
                if not isinstance(p, dict) or p.get("in") != "query" or not p.get("name"):
                    continue
                sch = p.get("schema") or {}
                inner = resolve(sch).get("properties") if sch else None
                if inner:
                    # a query parameter declared as an object carries its fields
                    # in its properties; its own name is a wrapper nobody writes
                    for nm, pr in sorted(inner.items()):
                        out.append({"route": route, "field": nm, "where": "query",
                                    "shape": declared_shape((pr or {}).get("type"))})
                    continue
                # `project_ids[]` is how a repeated key is written ON THE WIRE;
                # the name a library spells is `project_ids`, and the brackets
                # belong to the transport, not to either side's vocabulary
                nm = re.sub(r"\[\]$", "", p["name"])
                # and only a name a library could spell. Twilio writes the
                # comparison into the key — `StartTime<`, `StartTime>` — and no
                # source anywhere can carry that word, so looking for it finds
                # nothing and reports an absence that means only that the wire
                # has a syntax. The same ground as the path names: judge what
                # both sides are able to say.
                if not SPELLABLE.fullmatch(nm):
                    continue
                out.append({"route": route, "field": nm, "where": "query",
                            "shape": declared_shape((p.get("schema") or {}).get("type") or p.get("type"))})
            content = (op.get("requestBody") or {}).get("content") or {}
            body = (content.get("application/json") or {}).get("schema")
            if not body:
                # A FORM IS A REQUEST TOO. Twilio declares sixty-two bodies and
                # every one of them is x-www-form-urlencoded, so a reader that
                # took JSON alone saw none of them and said `holds`. The field
                # names in a form go on the wire exactly as written — the same
                # thing that makes a query key judgeable — and the schema beside
                # them is shaped identically. JSON is preferred where both are
                # offered, because that is the one a typed client writes.
                for kind in ("application/x-www-form-urlencoded", "multipart/form-data"):
                    if (content.get(kind) or {}).get("schema"):
                        body = content[kind]["schema"]
                        break
            if not body:
                # swagger 2.0 puts the body among the parameters, marked `in:
                # body`, and its schemas live under `definitions`. Two of the
                # projects looked at here are written that way and the door read
                # nothing at all of either — not a refusal, not a silence, just
                # a contract that appeared to declare no fields.
                for p in (op.get("parameters") or []):
                    if isinstance(p, dict) and p.get("in") == "body" and p.get("schema"):
                        body = p["schema"]
                        break
            if not body:
                continue
            if isinstance(body, dict) and body.get("$ref") in returned:
                continue
            for name, prop in sorted((resolve(body).get("properties") or {}).items()):
                # a property may point at a schema instead of naming a type, so
                # follow the ref one hop. What must NOT happen is a default: a
                # contract that says `anyOf` has not named a shape, it has left
                # the shape open, and calling that open field `nested` invents a
                # claim the contract never made and then accuses a library of
                # breaking it. Nineteen such accusations against a correct client
                # is what this cost before the shape was allowed to be nothing.
                prop = prop or {}
                if not SPELLABLE.fullmatch(name):
                    # `Parameter1.Name` … `Parameter99.Value` is how twilio writes
                    # a list of pairs ON THE WIRE, and no library spells it: a dot
                    # inside a key belongs to the encoding, and looking for it in
                    # source found nothing three hundred and ninety-six times.
                    # A hyphen does convert — `log-slow-requests-time-ms` is
                    # `log_slow_requests_time_ms` in Python — so it stays.
                    continue
                if prop.get("readOnly"):
                    # the contract's own word that this field travels out and
                    # never in: it is no part of a request, so a client that does
                    # not carry it is not behind anything
                    continue
                out.append({"route": route, "field": name, "where": "body",
                            "shape": declared_shape(prop.get("type") or resolve(prop).get("type"))})
    return out


def snake_of(name):
    return re.sub(r"(?<!^)(?=[A-Z])", "_", name).lower()


def name_variants(name):
    # a wire name is rarely the name a library writes: the contract's
    # `log-slow-requests-time-ms` is `log_slow_requests_time_ms` in Python and
    # `logSlowRequestsTimeMs` in a typed client. Reading only the wire spelling
    # accused a library of not carrying a field it carries in full, which is the
    # worst kind of wrong: it reads as news.
    plain = name.replace("-", "_")
    camel = re.sub(r"[-_](\w)", lambda m: m.group(1).upper(), name)
    return {name, plain, snake_of(plain), camel}
















CARRIER_KINDS = (".py", ".ts", ".js", ".rs", ".go", ".rb", ".java", ".kt")


def read_carrier(root):
    # what a client library names, and — said out loud — WHERE THIS LOOKED. A
    # hash certifies that bytes exist; nothing certifies that they do not, so
    # `the library never names it` is a fact about a WALK, and a walk without its
    # bounds is unfalsifiable in form and refutable in substance: point at one
    # excluded file and the claim is gone. So the bounds travel with every
    # absence this reader reports.
    text, files = [], 0
    for dirpath, dirs, names in os.walk(root):
        dirs[:] = [d for d in dirs
                   if d not in (".git", "node_modules", "target", "dist", "build", ".venv", "proto")
                   and "test" not in d.lower() and "example" not in d.lower()]
        for f in names:
            if os.path.splitext(f)[1] not in CARRIER_KINDS:
                continue
            if "test" in f.lower() or "example" in f.lower():
                continue
            # a protobuf stub is not this library's word about a REST request.
            # Weaviate vendors several versioned copies of one, and in them
            # `creation_time_unix: bool` is a flag asking gRPC to include a
            # timestamp — read as the timestamp itself it accused the client of
            # carrying a number as a boolean, thirty-two times.
            if "_pb2" in f or f.endswith("_pb.js") or f.endswith("_pb.ts"):
                continue
            try:
                text.append(open(os.path.join(dirpath, f), encoding="utf-8", errors="replace").read())
            except OSError:
                continue
            files += 1
    return "\n".join(text), {
        "files": files, "root": os.path.abspath(root),
        "kinds": " ".join(CARRIER_KINDS),
        "skipped": "directories named test/example, and .git node_modules target dist build .venv proto; "
                   "files named test/example; protobuf stubs (_pb2, _pb.js, _pb.ts)",
    }



REFS_HEADER = """// printed by gate import refs — the citations this code makes to a tracker,
// written in the reference crystal (`gate stdlib show forms-reference`). A
// tracked thing carries its state on an axis, a site is a place in your own
// file, and a citation holds only while the thing it cites is open.
//
"""


def read_tracker(path):
    # a tracker export, in the shape every tracker can produce: a list of
    # {key, status}. What counts as open is the tracker's word, not ours —
    # anything it does not call done or closed is still open.
    import json as _json
    raw = _json.load(open(path, encoding="utf-8"))
    items = raw.get("issues", raw) if isinstance(raw, dict) else raw
    out = {}
    for it in items:
        key = str(it.get("key") or it.get("id") or "").strip()
        if not key:
            continue
        st = str(it.get("status") or it.get("state") or "").strip().lower()
        out[key] = "Closed" if st in ("done", "closed", "resolved", "completed") else "Open"
    return out


def read_citations(root):
    # every place the code names a ticket: TODO(KEY), FIXME(KEY), or a bare
    # mention in a comment. The address is the reader's own file and line.
    hits = []
    pat = re.compile(r"\b(?:TODO|FIXME|HACK|XXX)\s*[(\[:]?\s*([A-Z][A-Z0-9]+-\d+)")
    for dirpath, dirs, files in os.walk(root):
        dirs[:] = [d for d in dirs if d not in (".git", "node_modules", "__pycache__", ".venv")]
        for f in files:
            if os.path.splitext(f)[1] not in (".py", ".ts", ".js", ".rs", ".go", ".rb", ".java", ".swift", ".md"):
                continue
            p = os.path.join(dirpath, f)
            try:
                text = open(p, encoding="utf-8", errors="replace").read()
            except OSError:
                continue
            for n, line in enumerate(text.split("\n"), 1):
                for m in pat.finditer(line):
                    hits.append({"file": os.path.relpath(p, root), "line": n, "key": m.group(1)})
    return hits


def cmd_import_refs(a):
    # import refs <tracker.json> --code DIR [-o refs-gate.swift] — what the code
    # says is still open, against what the tracker says. Neither system reads the
    # other, so the two copies drift; here they are one world, and a citation of
    # something closed is refused at the line of your own file.
    src = a[0]
    code = a[a.index("--code") + 1] if "--code" in a else "."
    # the world this prints is a CHECK, not a file to keep: dropped into a repo
    # that declares its layout it would read as a shadow — a world file the
    # manifest never names — and `status` would refuse it, which is a red the
    # reader did not earn. So without -o it is written where nothing keeps it,
    # judged, and removed. Ask for it by name and it stays.
    keep = "-o" in a
    out_path = (a[a.index("-o") + 1] if keep
                else os.path.join(tempfile.mkdtemp(prefix="gate-refs-"), "refs-gate.swift"))
    tracked = read_tracker(src)
    cites = read_citations(code)
    lines = [REFS_HEADER + STDLIB["forms-reference"], ""]
    for key in sorted({c["key"] for c in cites} | set(tracked)):
        state = tracked.get(key)
        if state is None:
            continue                      # cited but the tracker has never heard of it
        lines.append(f"public enum {sanitize(key)}: Tracked {{")
        lines.append(f"    public typealias State = {state}")
        lines.append("}")
    srcmap, seen = {}, set()
    for i, c in enumerate(cites):
        site = f"At_{sanitize(c['file'])}_L{c['line']}"
        if site in seen:
            continue
        seen.add(site)
        lines.append(f"public enum {site}: Site {{}}")
        cert = f"Cite_{i}"
        lines.append(f"public typealias {cert} = Cites<{site}, {sanitize(c['key'])}>")
        srcmap[cert] = {"address": f"{c['file']}:{c['line']}", "key": c["key"]}
    world = "\n".join(lines) + "\n"
    with open(out_path, "w") as f:
        f.write(world)
    t0 = time.time()
    outp = subprocess.run([JUDGE, "judge", "where", out_path], capture_output=True, text=True).stdout
    ms = round((time.time() - t0) * 1000, 1)
    refusals = []
    for m in re.finditer(r"^✗ '(\w+)[^']*' requires the types '[^']*' \(aka '([^']+)'\)", outp, re.M):
        cert, found = m.group(1), m.group(2)
        if cert not in srcmap:
            continue
        where = srcmap[cert]
        claim = (f"the code cites {where['key']}, and the tracker has no such thing"
                 if found.endswith(".State")
                 else f"the code cites {where['key']} as live work, and the tracker calls it {found.lower()}")
        refusals.append({"address": where["address"], "claim": claim})
    if not keep:
        shutil.rmtree(os.path.dirname(out_path), ignore_errors=True)
    return {"command": "import refs", "wrote": out_path if keep else None, "tracked": len(tracked),
            "citations": len(cites), "ms": ms,
            "verdict": "refused" if refusals else "holds", "refusals": refusals,
            "next": ("open the address above: the citation outlived the thing it cites"
                     if refusals else "wire it into CI: a citation cannot outlive its ticket again"),
            "mutates": True}


CODEOWNERS_HEADER = """// printed by gate import codeowners — who owns what in this repository,
// written in the access crystal (`gate stdlib show forms-grants`). A zone is
// a top of the tree, a room is a pattern, and an owner keeps a zone: owning
// is entry at the warden's threshold, judged like any other claim.
//
"""


def codeowners_zone(pattern):
    # the zone a pattern belongs to: its first real segment, or the root
    p = pattern.strip().lstrip("/")
    if not p or p.startswith("*"):
        return "Root"
    return sanitize(p.split("/")[0]) or "Root"


def read_codeowners(path):
    # every rule, with the line it stands on: an address in THEIR file
    rules = []
    for n, raw in enumerate(open(path), 1):
        line = raw.split("#")[0].strip()
        if not line:
            continue
        parts = line.split()
        owners = [p for p in parts[1:] if p.startswith("@") or "@" in p]
        if owners:
            rules.append({"line": n, "pattern": parts[0], "owners": owners})
    return rules


def cmd_import_codeowners(a):
    # import codeowners CODEOWNERS [--tree DIR] [-o out.swift] — a repository's
    # own ownership, as a judged world. What CODEOWNERS cannot say, this can:
    # an owner nobody declares is refused, and a pattern matching no file in
    # the tree is named by the line it sits on.
    src = a[0]
    out_path = a[a.index("-o") + 1] if "-o" in a else "codeowners-gate.swift"
    tree = a[a.index("--tree") + 1] if "--tree" in a else None
    # WHO MAY OWN WHAT is the thing CODEOWNERS cannot say: without it, every
    # rule is its own authority and the gate has nothing to hold. A policy —
    # owner,zone — makes each rule a claim against a stated zone, and a rule
    # reaching outside it is refused by the line it sits on.
    import csv as _csv
    policy = {}
    if "--policy" in a:
        for row in _csv.DictReader(open(a[a.index("--policy") + 1])):
            policy.setdefault(row["owner"].lstrip("@"), row["zone"])
    rules = read_codeowners(src)
    zones = sorted({codeowners_zone(r["pattern"]) for r in rules})
    lines = [CODEOWNERS_HEADER + STDLIB["forms-grants"], ""]
    for z in sorted(set(zones) | {sanitize(v) for v in policy.values()}):
        lines.append(f"public enum Zone_{z}: Realm {{}}")
    lines.append("")
    keepers, srcmap = {}, {}
    for i, r in enumerate(rules):
        zone = codeowners_zone(r["pattern"])
        room = f"Path_{i}_{sanitize(r['pattern'])[:40]}"
        lines.append(f"public enum {room}: Room {{")
        lines.append(f"    public typealias Place = Zone_{zone}")
        lines.append("}")
        for owner in r["owners"]:
            plain = owner.lstrip("@")
            kept = policy.get(plain)          # the zone this owner may keep
            keeper = (f"Owner_{sanitize(plain)}" if kept
                      else f"Owner_{sanitize(plain)}_in_{zone}")
            if keeper not in keepers:
                keepers[keeper] = (owner, kept or zone)
                lines.append(f"public enum {keeper}: Keeper {{")
                lines.append(f"    public typealias Post = Zone_{sanitize(kept) if kept else zone}")
                lines.append("    public typealias Key = WardenKey")
                lines.append("}")
            cert = f"Owns_{i}_{sanitize(owner.lstrip('@'))}"
            lines.append(f"public typealias {cert} = Owns<{keeper}, {room}>")
            srcmap[cert] = f"{os.path.basename(src)}:{r['line']} · {r['pattern']} {owner}"
    world = "\n".join(lines) + "\n"
    with open(out_path, "w") as f:
        f.write(world)
    t0 = time.time()
    outp = subprocess.run([JUDGE, "judge", "where", out_path], capture_output=True, text=True).stdout
    ms = round((time.time() - t0) * 1000, 1)
    refusals = []
    for m in re.finditer(r"^✗ '(\w+)[^']*' requires the types '[^']*' \(aka '([^']+)'\) and '[^']*' \(aka '([^']+)'\) be equivalent", outp, re.M):
        cert, left, right = m.groups()
        if cert in srcmap:
            refusals.append({"certificate": cert, "source": srcmap[cert],
                             "claim": f"the owner keeps {left}, the path lives in {right}: an owner and the path they own must share one zone"})
    # a pattern matching no file in the tree: CODEOWNERS says it, the tree does not
    ghosts = []
    if tree:
        import fnmatch
        paths = []
        for root, dirs, files in os.walk(tree):
            dirs[:] = [d for d in dirs if d != ".git"]
            for f in files:
                paths.append(os.path.relpath(os.path.join(root, f), tree))
        for r in rules:
            pat = r["pattern"].strip("/")
            hit = any(fnmatch.fnmatch(p, pat) or fnmatch.fnmatch(p, pat + "/*")
                      or p.startswith(pat + "/") or fnmatch.fnmatch(os.path.basename(p), pat)
                      for p in paths)
            if not hit:
                ghosts.append({"address": f"{os.path.basename(src)}:{r['line']}",
                               "claim": f"a ghost path: CODEOWNERS names `{r['pattern']}`, and the tree has no such file"})
    return {
        "command": "import codeowners",
        "world": out_path,
        "zones": len(zones),
        "paths": len(rules),
        "owners": len(keepers),
        "policy": (f"{len(policy)} owners have a stated zone" if policy else None),
        "verdict": "refused" if (refusals or ghosts) else "holds",
        "refusals": refusals + ghosts,
        "judge_ms": ms,
        "canon_handshake": "canon v2" in outp,
        "note": ("ownership is the warden's threshold: the compiler holds the key's class "
                 "when the world is built as Swift, and this run holds the zone equalities"
                 if policy else
                 "no ownership policy given (--policy owner,zone): every rule is its own "
                 "authority, so the equalities hold trivially. The ghost paths above are "
                 "read from the tree, not judged."),
    }


def repo_findings(n=400):
    # What is true of THIS repository, said in sentences a person can act on.
    # This is the one producer behind `gate findings`, the survey, the audit
    # page and the text of an issue: read the clone, name what is worth
    # naming, and mark plainly which of it the judge checked and which was
    # only read. Nothing here needs a translated world — a repository that
    # has never heard of gate still has findings.
    out = []
    j = repo_journal(n)
    commits = j["commits"]
    base = os.path.dirname(os.path.abspath(FACTS)) if FACTS else "."

    if not commits:
        return out
    authors = {}
    for c in commits:
        authors.setdefault(c["email"], []).append(c)

    # what the world says, if there is one: refusals are findings of the first order
    if FACTS and os.path.exists(FACTS):
        r = dispatch("status", [])
        for ref in r.get("refusals", []):
            out.append({"kind": "judged", "subject": ref["address"],
                        "sentence": f"{ref['address']} — {ref['claim']}",
                        "evidence": "the judge, on this working copy"})

    # who touches the facts, and whether anything checked those edits
    world = set(j.get("world_files") or [])
    if world:
        touchers = {c["email"] for c in commits if c["touches_world"]}
        edits = sum(1 for c in commits if c["touches_world"])
        ci = os.path.isdir(os.path.join(base, ".github", "workflows"))
        hooked = subprocess.run(["git", "config", "--get", "core.hooksPath"], cwd=base,
                                capture_output=True, text=True).stdout.strip()
        if edits and not (ci or hooked):
            out.append({"kind": "observed", "subject": "unchecked edits",
                        "sentence": f"{len(touchers)} people changed these facts across "
                                    f"{edits} commits, and nothing checked those edits: "
                                    "there is no hook and no workflow in this repository.",
                        "evidence": f"git log over {', '.join(sorted(world))}"})
        unnamed = sorted({c["email"] for c in commits if c["touches_world"] and not c["person"]})
        if unnamed:
            out.append({"kind": "observed", "subject": "unnamed authors",
                        "sentence": f"{len(unnamed)} of the people who changed these facts are "
                                    "not tied to anyone in the world: an email is not a person "
                                    "until something says it is.",
                        "evidence": ", ".join(unnamed[:4])})

    # ownership, if this repository states any: a stale owner is worth a sentence
    co = os.path.join(base, "CODEOWNERS")
    for cand in (co, os.path.join(base, ".github", "CODEOWNERS"),
                 os.path.join(base, "docs", "CODEOWNERS")):
        if os.path.exists(cand):
            rules = read_codeowners(cand)
            owners = {o.lstrip("@") for r_ in rules for o in r_["owners"]}
            seen = {c["email"].split("@")[0] for c in commits} | {
                (c["person"] or "").lower() for c in commits}
            quiet = sorted(o for o in owners if "/" not in o and o.lower() not in seen)
            # a history too short to be evidence proves nothing about anyone
            if quiet and len(commits) >= 50:
                out.append({"kind": "observed", "subject": "quiet owners",
                            "sentence": f"{len(quiet)} of the {len(owners)} owners named in "
                                        f"CODEOWNERS have not appeared in the last "
                                        f"{len(commits)} commits: ownership outlives people, "
                                        "and nothing here notices.",
                            "evidence": ", ".join("@" + q for q in quiet[:4])})
            out.append({"kind": "offer", "subject": "CODEOWNERS",
                        "sentence": f"CODEOWNERS states {len(rules)} rules over "
                                    f"{len(owners)} owners, and no tool checks them. "
                                    "`gate import codeowners` reads them as a world: a path "
                                    "no file matches, or an owner outside their zone, is "
                                    "named by the line it sits on.",
                        "evidence": os.path.relpath(cand, base)})
            break

    # the shape of the work, from the history itself
    top = sorted(authors.items(), key=lambda kv: -len(kv[1]))[:1]
    if top and len(commits) >= 20:
        who, cs = top[0]
        share = round(100 * len(cs) / len(commits))
        if share >= 50:
            out.append({"kind": "observed", "subject": "concentration",
                        "sentence": f"{share}% of the last {len(commits)} commits are one "
                                    f"person's ({who}): what they know is not written down "
                                    "anywhere this repository can check.",
                        "evidence": f"{len(cs)} of {len(commits)} commits"})
    return out


def cmd_findings(a):
    # findings [--md] [N] — what is true of this repository, in sentences.
    nums = [x for x in a if x.isdigit()]
    found = repo_findings(int(nums[0]) if nums else 400)
    return {"command": "findings", "findings": found,
            "next": "run `gate status`: what is judged answers in milliseconds, and this does not",
            "judged": sum(1 for f in found if f["kind"] == "judged"),
            "observed": sum(1 for f in found if f["kind"] != "judged"),
            "markdown": findings_markdown(found) if "--md" in a else None,
            "mutates": False}


def findings_markdown(found):
    # the same findings as a note somebody could read in an issue: what was
    # checked, what was only read, and how to see it for yourself.
    if not found:
        return "Nothing to report: this repository states no facts gate can read yet.\n"
    lines = ["### What this repository says about itself", ""]
    for f in found:
        mark = "**checked**" if f["kind"] == "judged" else ("**offer**" if f["kind"] == "offer" else "read")
        lines.append(f"- {f['sentence']}  \n  <sub>{mark} · {f['evidence']}</sub>")
    lines += ["", "Everything marked *read* comes from the git history and is not a verdict.",
              "To see it yourself: `gate findings` in a clone — nothing leaves the machine.", ""]
    return "\n".join(lines)


def cmd_init(a):
    vendor = "--vendor" in a
    a = [x for x in a if x != "--vendor"]
    root = a[0] if a else "world"
    made = []
    for rel, content in INIT_FILES.items():
        p = os.path.join(root, rel)
        os.makedirs(os.path.dirname(p), exist_ok=True)
        if not os.path.exists(p):
            with open(p, "w") as f:
                f.write(content)
            made.append(rel)
    hook = os.path.join(root, ".githooks", "pre-commit")
    if os.path.exists(hook):
        os.chmod(hook, 0o755)
    vendored = cmd_vendor(root) if vendor else None
    hooks_note, undo, prior = None, None, None
    if os.path.isdir(os.path.join(root, ".git")):  # seamless: the hook wires itself
        prior = subprocess.run(["git", "config", "--local", "core.hooksPath"], cwd=root,
                               capture_output=True, text=True).stdout.strip() or None
        subprocess.run(["git", "config", "core.hooksPath", ".githooks"], cwd=root, capture_output=True)
        hooks_note = "pre-commit hook wired (core.hooksPath = .githooks)"
        # this is somebody else's repository: say what moved and how to put it back
        undo = (f"git config core.hooksPath {prior}" if prior
                else "git config --unset core.hooksPath")
        if prior:
            hooks_note += f" — it was {prior}"
    return {"command": "init", "root": root, "created": made, "hooks": hooks_note,
            "next": next_rung(False),
            "undo_hooks": undo, "changed_git_config": bool(hooks_note), "vendored": vendored}


def world_rows(text):
    people = []
    for m in re.finditer(r"public enum (\w+): Employee, Person \{(.*?)\n\}", text, re.S):
        f = dict(re.findall(r"public typealias (\w+) = ([\w.]+)", m.group(2)))
        people.append({"id": m.group(1), **{k.lower(): v for k, v in f.items() if k != "Sex"}})
    grants = [{"who": w, "doc": d} for w, d in re.findall(r"VerifiedView<\s*(\w+),\s*(\w+)\s*>\.self;", text)]
    return people, grants


def cmd_report(a):
    # report [-o report.html] — the printable audit page: the world's tables
    # + the verdict. No server: one self-contained html, mailable to an audit.
    out_path = a[a.index("-o") + 1] if "-o" in a else "report.html"
    text = open(FACTS).read()
    people, grants = world_rows(text)
    r = judge(FACTS)
    bad_lines = {ref["claim"] for ref in r["refusals"]}

    def table(rows, cols):
        head = "".join(f"<th>{c}</th>" for c in cols)
        body = "".join(
            "<tr>" + "".join(f"<td>{row.get(c, '')}</td>" for c in cols) + "</tr>"
            for row in rows
        )
        return f"<table><tr>{head}</tr>{body}</table>"

    verdict_html = (
        "<p class='ok'>holds: every claim checked</p>"
        if r["verdict"] == "holds"
        else "<ul class='bad'>"
        + "".join(f"<li><code>{ref['address']}</code> · {ref['claim']}</li>" for ref in r["refusals"])
        + "</ul>"
    )
    # who may do what, and when that last changed: an audit asks for both, and
    # git already answers the second — the policy's own history, from the journal
    ids, rules, where = read_policy()
    policy_html = ""
    if ids or rules:
        rows = ([{"what": f"{action} requires", "who": rank} for action, rank in sorted(rules.items())]
                + [{"what": mail, "who": person} for mail, person in sorted(ids.items())])
        j = repo_journal(50)
        pf = os.path.basename(policy_path() or "")
        changes = [c for c in j["commits"] if pf and pf in c["files"]]
        hist = "".join(
            f"<li><code>{c['short']}</code> {c['when'][:10]} · {c['person'] or c['email']} · {c['subject']}</li>"
            for c in changes[:10])
        policy_html = ("<h2>Policy</h2>" + table(rows, ["what", "who"])
                       + ("<p>Last changed:</p><ul>" + hist + "</ul>" if hist
                          else "<p>Stated, and unchanged in the last 50 commits.</p>"))

    found = repo_findings(200)
    findings_html = ""
    if found:
        items = "".join(
            f"<li>{f['sentence']}<br><small>{'checked by the judge' if f['kind'] == 'judged' else 'read from git history, not a verdict'} · {f['evidence']}</small></li>"
            for f in found)
        findings_html = f"<h2>Findings</h2><ul class='findings'>{items}</ul>"

    html = f"""<!-- printed by gate report; the table is read from the world, never stored -->
<meta charset="utf-8"><title>gate report</title>
<style>
body{{font:14px/1.5 -apple-system,sans-serif;max-width:60em;margin:2em auto;padding:0 1em;color:#1d1d1f}}
table{{border-collapse:collapse;margin:1em 0}}td,th{{border:1px solid #d2d2d7;padding:.3em .8em;text-align:left}}
th{{background:#f5f5f7}}.ok{{color:#248a3d}}.bad li{{color:#c4453b;margin:.3em 0}}code{{background:#f5f5f7;padding:0 .3em}}
.findings li{{margin:.6em 0}}.findings small{{color:#8e8e93}}
</style>
<h1>gate report</h1>
<p>{len(people)} people · {len(grants)} grants · judged in {r['judge_ms']} ms</p>
<h2>Verdict</h2>{verdict_html}
<h2>People</h2>{table(people, ["id", "rank", "home", "site", "given", "family", "born"])}
<h2>Grants</h2>{table(grants, ["who", "doc"])}
{policy_html}
{findings_html}
"""
    with open(out_path, "w") as f:
        f.write(html)
    return {"command": "report", "wrote": out_path, "people": len(people), "grants": len(grants), **{k: r[k] for k in ("verdict", "judge_ms")}, "refusals": r["refusals"]}


def cmd_serve(a):
    # serve [port] [--no-open] — the bench, and the local JSON surface it reads.
    # THE CONTRACT (the bench depends on exactly this, and nothing else):
    #   GET  /  and /ui              the bench itself
    #   GET  /version                {gate: VERSION} — what is actually running,
    #                                since the page comes off the disk and the
    #                                answers come out of memory
    #   GET  /files                  {files: [name], personal: name|null}
    #   GET  /shelf                  {modules: [name]} — what the shelf carries
    #   GET  /shelf?m=name           the text of one shelf module, to read
    #   GET  /world?f=name           the text of one file from that list
    #   GET  /gitstatus?f=name       {git: committed|modified|untracked}
    #   GET  /log?n=&scope=          the journal (scope: world|all) — observed
    #   GET  /show?hash=&f=          one commit, read as the facts it changed
    #   GET  /status                 the verdict, as the CLI gives it
    #   GET  /attention              the seams this folder is party to: who owes
    #                                whom a word, read the same from either side
    #   GET  /seamside?f=name        one side of a seam, to read: every address
    #                                the bench prints must be reachable
    #   GET  /check/view?who=&doc=   a question, answered by a verdict
    #   GET  /diff/transfer?who=&to= what would break (changes nothing)
    #   POST /verdict?f=name         judge the whole list with this file's
    #                                unsaved text in place of its own
    #   PUT  /world?f=name           write one file (the bench writes only
    #                                when the judge holds)
    # Loopback only, no caching, and no route reaches outside the repository.
    from http.server import BaseHTTPRequestHandler, HTTPServer
    from urllib.parse import urlparse, parse_qs

    nums = [x for x in a if x.isdigit()]
    port = int(nums[0]) if nums else 4744

    open_it = "--no-open" not in a

    here = os.path.dirname(os.path.abspath(__file__))
    playground = os.path.dirname(os.path.dirname(here))  # typed-playground root

    class H(BaseHTTPRequestHandler):
        def send_file(self, path, ctype):
            with open(path, "rb") as f:
                body = f.read()
            self.send_response(200)
            self.send_header("Content-Type", ctype)
            # never cached: an updated gate must not be hidden behind a bench
            # (or a judge) the browser kept from the last version
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

        def do_GET(self):
            u = urlparse(self.path)
            q = {k: v[0] for k, v in parse_qs(u.query).items()}
            try:
                if u.path == "/ladder.css":
                    # the named steps, emitted from the judged world so the page
                    # can say `var(--apart)` and never a number of its own
                    body = (palette_tokens() + ladder_tokens()).encode()
                    self.send_response(200)
                    self.send_header("Content-Type", "text/css; charset=utf-8")
                    self.send_header("Cache-Control", "no-store")
                    self.send_header("Content-Length", str(len(body)))
                    self.end_headers()
                    self.wfile.write(body)
                    return
                if u.path in ("/", "/ui"):
                    return self.send_file(os.path.join(here, "ui.html"), "text/html; charset=utf-8")
                if u.path == "/seamside":
                    # one side of a seam, to READ. Every address this bench prints
                    # should be reachable: a line you cannot open is a line you
                    # are asked to take on trust, which is the one thing nothing
                    # here asks for.
                    base = os.path.dirname(os.path.abspath(FACTS)) if FACTS else os.getcwd()
                    want = os.path.join(base, os.path.basename(q.get("f", "")))
                    if not (want.endswith(".swift") and os.path.exists(want) and is_seam_side(want)):
                        self.send_response(404); self.end_headers(); return
                    return self.send_file(want, "text/plain; charset=utf-8")
                if u.path == "/version":
                    # WHAT IS ACTUALLY RUNNING. The bench serves its page off the
                    # disk and its answers out of memory, so a gate updated while
                    # it runs leaves a new page talking to an old server — every
                    # file fresh, every endpoint stale, and nothing saying so.
                    body = json.dumps({"gate": VERSION, "judge_from": judge_from()}).encode()
                    self.send_response(200)
                    self.send_header("Content-Type", "application/json")
                    self.send_header("Cache-Control", "no-store")
                    self.end_headers()
                    self.wfile.write(body)
                    return
                if u.path == "/judge.js":
                    return self.send_file(os.path.join(here, "judge.js"), "text/javascript")
                if u.path == "/codemirror.js":
                    return self.send_file(os.path.join(here, "codemirror.js"), "text/javascript")
                if u.path == "/codemirror.css":
                    return self.send_file(os.path.join(here, "codemirror.css"), "text/css")
                if u.path == "/shelf":
                    mod = q.get("m")
                    if not mod:
                        # what the shelf carries. The bench reads each one with
                        # the SAME judge that judges and builds its vocabulary
                        # from that parse — the shelf has one reader, not a regex
                        # here beside the judge over there.
                        body = json.dumps({"modules": list(STDLIB),
                                           "roles": {k: stdlib_role(k) for k in STDLIB}}).encode()
                        self.send_response(200)
                        self.send_header("Content-Type", "application/json")
                        self.send_header("Cache-Control", "no-store")
                        self.end_headers()
                        self.wfile.write(body)
                        return
                    if mod not in STDLIB:
                        return self.no_world()
                    body = STDLIB[mod].encode()
                    self.send_response(200)
                    self.send_header("Content-Type", "text/plain; charset=utf-8")
                    self.send_header("Cache-Control", "no-store")
                    self.end_headers()
                    self.wfile.write(body)
                    return
                if u.path == "/files":
                    named = bench_files()
                    names = [n for n, _ in named]
                    pf = personal_path()
                    lay = (os.path.relpath(MANIFEST["manifest"],
                                           os.path.dirname(os.path.abspath(FACTS)))
                           if MANIFEST and os.path.exists(MANIFEST["manifest"]) else None)
                    body = json.dumps({"files": names,
                                       "layout": lay if lay in names else None,
                                       "personal": names[-1] if pf else None,
                                       "personal_empty": bool(pf) and not os.path.exists(pf)}).encode()
                    self.send_response(200)
                    self.send_header("Content-Type", "application/json")
                    self.send_header("Cache-Control", "no-store")
                    self.end_headers()
                    self.wfile.write(body)
                    return
                if u.path == "/world":
                    # the UI obeys the declared layout: ?f= names a file FROM the list
                    p = self.pick(q)
                    if not p:
                        return self.no_world()
                    if not os.path.exists(p):   # yours, and nobody has written in it
                        self.send_response(200)
                        self.send_header("Content-Type", "text/plain; charset=utf-8")
                        self.send_header("Cache-Control", "no-store")
                        self.end_headers()
                        self.wfile.write(PERSONAL_TEMPLATE.encode())
                        return
                    return self.send_file(p, "text/plain; charset=utf-8")
                if u.path == "/gitstatus" and not FACTS:
                    return self.no_world()
                if u.path == "/gitstatus":
                    # the honest state: a write lands in the working copy; git
                    # carries the history. This says whether the file is
                    # committed or has uncommitted changes — never our own save.
                    base = os.path.dirname(os.path.abspath(FACTS))
                    p = self.pick(q)
                    st = subprocess.run(["git", "status", "--porcelain", "--", p], cwd=base, capture_output=True, text=True)
                    tracked = subprocess.run(["git", "ls-files", "--error-unmatch", p], cwd=base, capture_output=True)
                    state = ("untracked" if tracked.returncode else
                             ("modified" if st.stdout.strip() else "committed"))
                    body = json.dumps({"file": os.path.relpath(p, base), "git": state}).encode()
                    self.send_response(200)
                    self.send_header("Content-Type", "application/json")
                    self.send_header("Cache-Control", "no-store")
                    self.end_headers()
                    self.wfile.write(body)
                    return
                if u.path == "/log":
                    out = repo_journal(int(q.get("n", 200)), q.get("scope", "world"))
                elif u.path == "/show":
                    out = commit_change(q.get("hash", ""), q.get("f") or None)
                elif u.path == "/status":
                    out = dispatch("status", [])
                elif u.path == "/attention":
                    # THE SEAMS THIS REPOSITORY IS PARTY TO. A declaration is a
                    # world in the contract grammar, so the pair is found by what
                    # the files SAY they are rather than by where they sit: one
                    # states records, the other claims them, and a repository may
                    # be either side or both. Where nobody has declared anything
                    # there is nothing to show and the bench says so — an empty
                    # account is a fact, and inventing a specimen to fill it
                    # would be the one lie this thing cannot afford.
                    out = {"command": "attention", "seams": seams_here()}
                elif u.path == "/check/view":
                    out = cmd_ask([q["who"], q["doc"]])
                elif u.path == "/diff/transfer":
                    out = cmd_change(["transfer", q["who"], q["to"]])
                else:
                    self.send_response(404); self.end_headers(); return
            except SystemExit as e:
                out = {"error": str(e)}
            body = json.dumps(out, ensure_ascii=False).encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

        def pick(self, q):
            # only the judged list is servable or writable: the manifest's files
            # plus your personal world
            return dict(bench_files()).get(q.get("f", ""), FACTS)

        def no_world(self):
            self.send_response(404)
            self.send_header("Cache-Control", "no-store")
            self.end_headers()

        def do_PUT(self):
            # the single writing handle: world files — they ARE the source
            # (plumbing stays open, judgement stays inevitable)
            u = urlparse(self.path)
            q = {k: v[0] for k, v in parse_qs(u.query).items()}
            if u.path != "/world":
                self.send_response(404); self.end_headers(); return
            n = int(self.headers.get("Content-Length", 0))
            text = self.rfile.read(n).decode()
            p = self.pick(q)
            if p == personal_path():
                write_personal(text)     # empty means gone, not an empty file
            else:
                with open(p, "wb") as f:
                    f.write(text.encode())
            self.send_response(200); self.end_headers()

        def do_POST(self):
            # /verdict?f=rel — judge the WHOLE declared list with the active
            # file replaced by the editor's unsaved text (cross-file, server-side)
            u = urlparse(self.path)
            q = {k: v[0] for k, v in parse_qs(u.query).items()}
            if u.path != "/verdict":
                self.send_response(404); self.end_headers(); return
            n = int(self.headers.get("Content-Length", 0))
            text = self.rfile.read(n).decode()
            base = os.path.dirname(os.path.abspath(FACTS))
            active = self.pick(q)
            d = tempfile.mkdtemp(prefix="gate-bench-")
            paths = []
            layout = MANIFEST["manifest"] if MANIFEST else None
            for name, p in bench_files():
                if p != active and not os.path.exists(p):
                    continue                      # a personal world nobody wrote
                tp = os.path.join(d, name.replace(os.sep, "__"))
                with open(tp, "w") as f:
                    f.write(text if p == active else open(p).read())
                # THE LAYOUT IS OPENABLE, NOT PLAIN-JUDGED. It is the operator's
                # own document and belongs in the bench — a dependency is written
                # by whoever depends, and this was the one file of theirs the
                # bench would not open. But it is not a fragment of the world:
                # it declares protocols, which the plain court refuses on sight,
                # so putting it in this stream turned every row into a refusal.
                # Its court is the guards, and they answer below.
                if p != layout:
                    paths.append(tp)
            raw = subprocess.run([JUDGE, "judge", *paths], capture_output=True, text=True).stdout
            refusals = [{"address": m.group(1).replace("__", "/"), "claim": m.group(2).strip()}
                        for m in re.finditer(r"^\s+(\S+\.swift:\d+)\s+(.+)$", raw, re.M)]
            # refine each address to the line of its subject, per file (the same
            # move the CLI makes — the judge pins to the previous drain's line)
            by_file = {}
            for ref in refusals:
                fname = ref["address"].split(":")[0]
                by_file.setdefault(fname, []).append(ref)
            byname = dict(bench_files())
            sources = [(n, text if p == active else (open(p).read() if os.path.exists(p) else ""))
                       for n, p in bench_files()
                       if (p == active or os.path.exists(p)) and p != layout]
            if len(sources) > 1:
                refusals = attribute_refusals(refusals, sources)
            else:
                for fname, group in by_file.items():
                    real = byname.get(fname, os.path.join(base, fname))
                    src = text if real == active else (open(real).read() if os.path.exists(real) else "")
                    refine_addresses(src, group, fname)
            # the same guards the CLI runs, over the text in the editor: the
            # bench may not say holds where a hook would refuse
            refusals += duplicate_guards_over(sources)
            refusals += entry_guards_over(sources)
            # the layout is held to the same promise as every other file here:
            # judged as you type, from the editor's text and not the saved copy
            live = read_manifest_rows(base, text)[1] if active == layout else None
            refusals += manifest_guards(live) + forms_guards() + policy_guards() + stdlib_guards() + vendored_guards()
            times = re.findall(r"([\d.]+) ms", raw)
            # AND THE WIDTH OF IT. The judge counts what it checked and says so;
            # dropping that on the way to the bench left a green over several
            # files saying only `judged together`, which is a verdict with no
            # measure — the same empty green the doors spent a day losing.
            size = re.search(r"(\d+) declarations · (\d+) lookups · (\d+) premises", raw)
            body = json.dumps({"verdict": "holds" if not refusals else "refused",
                               "refusals": refusals,
                               "declarations": int(size.group(1)) if size else None,
                               "premises": int(size.group(3)) if size else None,
                               "judge_ms": float(times[-1]) if times else None}).encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

        def log_message(self, *args):
            pass

    print(json.dumps({"command": "serve", "url": f"http://127.0.0.1:{port}", "routes": ["/status", "/log", "/show?hash=&f=", "/check/view?who=&doc=", "/diff/transfer?who=&to="], "mutating_routes": "none, by design"}))
    sys.stdout.flush()
    if open_it:   # the bench is the point of serve; the loopback, never a network
        try:
            import webbrowser, threading
            threading.Timer(0.4, webbrowser.open, [f"http://127.0.0.1:{port}/ui"]).start()
        except Exception:
            pass
    HTTPServer(("127.0.0.1", port), H).serve_forever()


