             '<text x="{tx}" y="14" fill="#FDFDFD">{right}</text></g></svg>')


def cmd_badge(a):
    # badge [-o FILE.svg] [--since DATE] — the souvenir, and the only numbers on
    # it are ones nobody can raise by hand. A coverage badge can be gamed by
    # writing tests that assert nothing; this one cannot, because the claims are
    # counted by the judge and the days are counted by REPLAYING the world's own
    # history through it. Anybody may re-run it and get the same answer.
    #
    # What it does NOT say is `no silent error`, because that is exactly what
    # nobody saw. It says how many claims were judged and how long every commit
    # that touched them has held — provable, and duller, and true.
    from datetime import date as _date
    out_path = a[a.index("-o") + 1] if "-o" in a else None
    since = a[a.index("--since") + 1] if "--since" in a else None
    # a badge counts JUDGED claims, so it belongs to a world and to nothing else.
    # It once spoke for a seam too, over premises no one had declared — a badge
    # over an observation is a verdict wearing a number, and there was no court.
    # ── AND A WORLD OF FORMS IS STILL A WORLD, WHICH THIS WAS THE LAST PLACE NOT
    # TO KNOW. `world_files()` is the plain court's list and rightly holds no
    # forms row, so `gate badge` in gate's own repository printed "no world here"
    # and told the reader to run `gate init .`, two lines after `gate status`
    # said "holds · 186 equalities" about the same tree. The souvenir this
    # project offers, and this project could not print its own.
    files = world_files()
    forms = [] if files else [os.path.join(os.path.dirname(MANIFEST["manifest"]), r["path"])
                              for r in ((MANIFEST.get("rows") if MANIFEST else None) or [])
                              if r["role"] == "forms"
                              and os.path.exists(os.path.join(os.path.dirname(MANIFEST["manifest"]),
                                                              r["path"]))]
    if not files and not forms:
        return {"command": "badge", "verdict": "no world here", "refusals": [],
                "next": "run `gate init .` to start a world in this folder",
                "then": "then `gate badge -o gate.svg` prints a badge nobody can forge", "mutates": False}
    t0 = time.time()
    # AND THE NUMBER IS THE ONE STATUS COUNTS, asked rather than worked out
    # again. Reading the forms files straight through the where court answers 0
    # equalities where status answers 186: the grouping status judges them in is
    # a reading of its own, and a badge that made its own would be a second
    # number for one question. Premises where the plain court sits, equalities
    # where the where court does; both are claims judged, and neither can be
    # raised by hand.
    said = dispatch("status", [])
    holds = said.get("verdict") == "holds"
    claims = ((said.get("world") or {}).get("premises")
              if files else (said.get("forms") or {}).get("equalities")) or 0
    root = (subprocess.run(["git", "rev-parse", "--show-toplevel"],
                           capture_output=True, text=True).stdout or "").strip()
    root = os.path.realpath(root) if root else ""
    # ── AND THE RUN OF DAYS IS COUNTED WHERE IT CAN BE COUNTED HONESTLY. The
    # replay judges each past commit with the plain court over the world's own
    # files, and a forms world is not judged that way: status reads its pages in
    # a grouping of its own, and replaying them any other way would print a run
    # of green days over a period nobody checked, which is the one thing this
    # badge exists against. So the days are counted for a plain world, and a
    # forms world gets the claims and the verdict with the gap named in the note
    # rather than a number nobody stands behind.
    rels = [os.path.relpath(os.path.realpath(f), root) for f in files] if root else []
    shallow = root and (subprocess.run(["git", "-C", root, "rev-parse", "--is-shallow-repository"],
                                       capture_output=True, text=True).stdout or "").strip() == "true"
    # `rels` empty means no path filter, so the walk below took the WHOLE
    # repository's history and the badge printed a run of days over commits that
    # never touched a world: 15d beside a note saying the days are not counted
    marks = ([l.split(None, 1) for l in git_lines(
        root, "log", "--format=%H %as", *(["--since=" + since] if since else []), "--", *rels)]
        if root and not shallow and rels else [])
    # newest first, back until one refuses: the leash is the run of commits since
    # the last time this world did not hold
    judged, broke = 0, None
    for sha, when in marks:
        d = scratch("gate-badge-")
        wrote = []
        for rel in rels:
            blob = subprocess.run(["git", "-C", root, "show", f"{sha}:{rel}"],
                                  capture_output=True, text=True)
            if blob.returncode:
                continue                       # the file was not in that tree yet
            p = os.path.join(d, os.path.basename(rel))
            open(p, "w").write(blob.stdout)
            wrote.append(p)
        ok = wrote and "THE JUDGE holds" in subprocess.run(
            [JUDGE, "judge", *wrote], capture_output=True, text=True).stdout
        shutil.rmtree(d, ignore_errors=True)
        if not wrote:
            continue
        judged += 1
        if not ok:
            broke = when
            break
    span = marks[0][1] if marks else None
    days = ((_date.today() - _date.fromisoformat(broke)).days if broke
            else (_date.today() - _date.fromisoformat(marks[-1][1])).days if marks else None)
    # ── AND A RED BADGE DOES NOT REPORT NOUGHT CLAIMS. The count of claims comes
    # from the court's own holding line, and a refusal does not print one, so a
    # world with eighty-two premises and two refusals wore `0 claims · refused`
    # in the file people put in a README. This badge exists to say how WIDE the
    # green is, and on a red world there is no green to be wide: it says how many
    # were refused, which is the number that is true then.
    refused_n = len(said.get("refusals", []))
    right = (f"{claims} claims · holds" if holds else
             f"refused {refused_n}") + (f" · {days}d" if days is not None else "")
    if out_path:
        lw, rw = 40, 8 + int(len(right) * 6.2)
        open(out_path, "w").write(BADGE_SVG.format(
            w=lw + rw, lw=lw, rw=rw, tx=lw + 5, right=esc_xml(right),
            fill="#007D36" if holds else "#BF4035", alt="gate: " + right))
    return {"command": "badge", "claims": claims, "verdict": "holds" if holds else "refused",
            "commits_judged": judged, "unbroken_days": days, "last_refusal": broke,
            "shallow": bool(shallow), "wrote": out_path, "text": right,
            "ms": round((time.time() - t0) * 1000, 1),
            "note": (("this world is forms, and the run of days is not counted for one yet: "
                      "replaying its pages any way other than the one status reads them in "
                      "would print green days over a period nothing checked"
                      if not files else
                      "this repository arrived without history, so only today is counted"
                      if shallow or not marks else
                      f"{judged} commits that touched this world were judged again, oldest {marks[-1][1]}"
                      + (f", and the last that did not hold was {broke}" if broke else ", and every one held"))
                     + ": the judge counts the claims again on every run"),
            "next": ("put it in the README beside the build: it says how WIDE the green is, "
                     "which a badge that only says green does not"),
            "mutates": bool(out_path)}


def esc_xml(s):
    return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def git_lines(root, *args):
    r = subprocess.run(["git", "-C", root] + list(args), capture_output=True, text=True, errors="replace")
    return [l for l in r.stdout.split("\n") if l.strip()]


def contract_revisions(path, since=None):
    # every revision of a contract, oldest first, read out of git and never off
    # the disk: one `cat-file --batch` for the lot, because a hundred and fifty
    # `git show` calls is a minute of somebody's morning.
    # through realpath on BOTH sides: git answers with the real path, and on a
    # mac the temp directory is a symlink, so a path taken as written produced a
    # relative name climbing out of the repository and a history of nothing.
    full = os.path.realpath(path)
    here = os.path.dirname(full) or "."
    root = (subprocess.run(["git", "-C", here, "rev-parse", "--show-toplevel"],
                           capture_output=True, text=True).stdout or "").strip()
    if not root:
        return None, []
    root = os.path.realpath(root)
    rel = os.path.relpath(full, root)
    if rel.startswith(".."):
        return None, []
    args = ["log", "--reverse", "--format=%H %as"] + (["--since=" + since] if since else []) + ["--", rel]
    marks = [l.split(None, 1) for l in git_lines(root, *args)]
    if not marks:
        return root, []
    p = subprocess.Popen(["git", "-C", root, "cat-file", "--batch"],
                         stdin=subprocess.PIPE, stdout=subprocess.PIPE)
    blob, _ = p.communicate("\n".join(f"{sha}:{rel}" for sha, _d in marks).encode())
    out, i = [], 0
    for (_sha, when) in marks:
        j = blob.find(b"\n", i)
        if j < 0:
            break
        head = blob[i:j].split()
        if len(head) < 3:                      # the path did not exist in that tree
            i = j + 1
            continue
        size = int(head[2])
        out.append((when, blob[j + 1:j + 1 + size]))
        i = j + 1 + size + 1
    return root, out


def first_mentions(root, names, only=None, without=None):
    # when each name first appeared in a library, read from the diffs themselves.
    # A name is looked for in every spelling the library might use, which is why
    # this sees a Go client the contract door cannot: `json:"with_vector"` holds
    # the wire name even where the field beside it is written `WithVector`.
    # and only where the library IS. Two ways this lies if it is let loose over a
    # whole repository: a monorepo answers for a sibling package, and — worse —
    # a contract kept beside its client answers for the client, since the commit
    # that adds a field to the spec adds the name in a line beginning with a
    # plus. That reads as same-day adoption of everything, forever.
    where = ["--", only] if only else []
    if without:
        where = (where or ["--"]) + [":(exclude)" + without]
    left = {n: re.compile(r"\b(?:" + "|".join(re.escape(v) for v in name_variants(n)) + r")\b")
            for n in names}
    seen, when = {}, None
    p = subprocess.Popen(["git", "-C", root, "log", "--reverse", "-p", "--no-color",
                          "--format=~gate~ %as", *where],
                         stdout=subprocess.PIPE, text=True, errors="replace")
    for line in p.stdout:
        if line.startswith("~gate~ "):
            when = line[7:].strip()
            continue
        if not line.startswith("+") or line.startswith("+++"):
            continue
        for n in [n for n, rx in left.items() if rx.search(line)]:
            seen[n] = when
            del left[n]
        if not left:
            break
    p.stdout.close()
    p.terminate()
    return seen


DECLARE_HEADER = """// printed by gate declare: one side of a seam, stated rather than found.
// Whoever runs this owns what it says: it is a view of a document they publish,
// emitted by their own build and signed by merging it. Nothing here was read out
// of anybody's source, because judgement has no jurisdiction over a world that
// has not entered. This file is the entering.
//
"""

CARRIER_HEADER = """// printed by gate declare carrier: what a library says it carries, emitted from
// what that library already keeps: its own generated schema, its own types. The
// emitter lives on its side and belongs to it. This only renders what it said
// into the grammar both sides are judged in. Where its own name for a field
// differs from the contract's, the correspondence is stated too, and only
// where it does not follow, since a declaration that restates what already
// matches is a second copy, and a second copy drifts.
//
"""


# the directory a world is being founded in, while `init` is founding it: set
# for that call and nowhere else, so the walk above stops where the new world is
# rather than joining an older one overhead
_FOUNDING = None


def world_root_for(path):
    # the world a file belongs to is found the way .git is: walking up from the
    # FILE — not from wherever the command was typed. Declaring `people/roster`
    # from the root once wrote a second manifest inside `people/`; walking from
    # the file finds the one world above it. And a file under no world at all
    # founds one where it sits, which is how a bench in a fresh directory
    # begins — the temporary worlds the battery builds are exactly this.
    # ── AND A WORLD BEING FOUNDED RIGHT HERE STOPS THE WALK. `gate init DIR`
    # writes DIR's first files and declares them, and the walk up from the first
    # one ran BEFORE DIR had a manifest: it found the world ABOVE and put the
    # rows there. `gate demo` is that, in a repository that already has a world:
    # four rows about `gate-demo/` landed in the host's own manifest and the
    # host's `status` went red with the demo's planted refusal, which the demo
    # ships on purpose. The same trap catches `gate init` in any subproject of a
    # repository whose root is already a world.
    if _FOUNDING and not os.path.relpath(os.path.abspath(path), _FOUNDING).startswith(os.pardir):
        return _FOUNDING
    d = os.path.dirname(os.path.abspath(path)) or "."
    walk = d
    while True:
        if os.path.exists(os.path.join(walk, "gate.swift")) \
                or os.path.exists(os.path.join(walk, "gate.manifest.swift")):
            return walk
        up = os.path.dirname(walk)
        if up == walk:
            break
        walk = up
    # ── AND WITH NO WORLD ABOVE IT, THE WORLD IS FOUNDED WHERE YOU STAND. The
    # fallback was the FILE'S OWN directory, so `gate mine src/main.go` typed at
    # the root of a repository with no world wrote `src/gate.manifest.swift` and
    # said "written down in gate.manifest.swift": a world founded one directory
    # down, under a name that reads like the one in front of you, and `gate
    # status` at the root then saw nothing at all. The comment two functions down
    # already states the law this breaks, and states it for the other end only.
    # Standing outside the file's tree is still the file's own directory: there
    # is nowhere else it could go, and `mine` refuses that case by name.
    here = os.path.abspath(".")
    return here if not os.path.relpath(d, here).startswith(os.pardir) else d


def founds_world(path):
    # TRUE WHEN THIS CLAIM WOULD FOUND A WORLD RATHER THAN JOIN ONE. There is no
    # world above the file, so the row has nowhere to go but a new manifest, and
    # where that manifest lands decides whether this is a bench beginning or a
    # stranger's directory being written in.
    root = world_root_for(path)
    return not (os.path.exists(os.path.join(root, "gate.swift"))
                or os.path.exists(os.path.join(root, "gate.manifest.swift")))


MOVING_NAMES = {"latest", "head", "tip", "main", "master", "trunk", "default",
                "stable", "edge", "dev", "develop", "nightly", "current", "next"}


def moving_pin(at):
    # ── A PIN NAMES A MOMENT, AND THIS IS WHY — not housekeeping, a precondition.
    # A seam's verdict is a pure function of the two revisions its sides were
    # taken at. The corpus requires that the facts a comparison reveals be
    # PRE-EXISTING: COMPARE discloses what is already the case, it does not make
    # it so (V=I §5.20). A range or a branch name breaks exactly that — the text
    # on the other side changes under you, so there is nothing fixed for a
    # verdict to be a function of, and the seam has no determinate state at all.
    #
    # The consequence runs the other way too, and it is the whole reason there
    # is no version solver in here. `^1.2.0` does not make resolution HARD; it
    # CREATES the problem, by breaking the precondition under which the question
    # had an answer. This tool had said as much in a comment for weeks and then
    # written `latest` into a row without a word.
    a = (at or "").strip()
    if not a:
        return "a revision nobody wrote down"
    if a.lower() in MOVING_NAMES:
        return (f"`{a}` is a name that moves: whatever it points at today, it points somewhere "
                "else tomorrow, and a row that says it stops being a fact the moment it is true")
    if re.search(r"[\^~*]|[<>]=?|,\s*[<>^~]|\|\|", a):
        return (f"`{a}` is a range, not a revision: it names a SET of revisions, and this world "
                "took exactly one")
    if re.fullmatch(r"[\d.]*[xX](\.[\dxX]+)*", a) and re.search(r"\d", a):
        return f"`{a}` is a range with a wildcard in it, and this world took exactly one revision"
    return None


def row_atom(rel):
    # ONE RULE FOR THE NAME A ROW WEARS, IN ONE PLACE. A row that points at another
    # row has to spell that row's name exactly, and spelling it a second time
    # somewhere else is how two spellings of one name begin.
    return sanitize(os.path.splitext(rel)[0]).title().replace("_", "").replace("/", "") or "Side"


def declare_side(path, kind, role, frm=None, written=None, opens=None):
    # ONE MOVEMENT, TWO DIRECTIONS, AND NOBODY SPECIAL. Everything here is an
    # emitted view of somebody's source: my world is a view of my facts, their
    # spec is a view of theirs, and the judge in bin/ is a view of the corpus —
    # `build-judge.sh` clones at a revision, builds, and writes the revision
    # down beside the binary, which is this same act spelled in sh.
    #
    #   Mine    my source.     I emit it, it is judged, and changing it changes
    #                          the verdict.
    #   Theirs  their source.  I took it, at a revision I write down. I read it
    #                          and never rewrite it.
    #
    # The row also says its ROLE, because that is which court reads it, and gate
    # refuses a row it cannot place rather than guessing — guessing is how the
    # seams once got swept into the judged world.
    #
    # gate never fetches and never sends: a file of theirs arrives because an
    # operator brought it — a checkout in CI, a copy, whatever they already
    # trust — and this only writes down that it is here, whose it is, and when.
    #
    # The other direction is a pull request. Put a side and its two lines in
    # THEIR repository and their own CI holds them to it: touch the field and
    # the seam parts on their side, with an address. Unsubscribing is deleting
    # the file, which is a commit like any other — visible, dated, and nobody's
    # to do quietly.
    # ── THE MANIFEST BELONGS TO THE WORLD, NOT TO THE FOLDER A FILE SITS IN.
    # Declaring `people/roster.swift` wrote a second manifest inside `people/`
    # and recorded the row as `roster.swift`, so the world root never learned of
    # the file and the path to it was thrown away. A world may be laid out in
    # folders — that is the whole point of a declared layout — and a row says
    # where a file is, relative to the world that declares it.
    # the world a file belongs to is found the way .git is: walking up from the
    # file itself, never from wherever the command happened to be typed
    d = world_root_for(path)
    mp = os.path.join(d, "gate.manifest.swift")
    rel = os.path.relpath(os.path.abspath(path), d)
    # ── AND A ROW MAY NOT POINT OUT OF THE WORLD THAT MAKES IT. A row says where
    # a file is relative to its world; `../../../../var/folders/...` says the
    # file is somewhere else entirely, and a world cannot answer for what is not
    # in it. This is the floor that reading already stands on — a checkout may
    # not be read out of — said for writing, and it was missing: an older walk
    # started from the working directory instead of the file and put sixteen
    # such rows in this tool's own manifest, claims about temporary directories
    # deleted the same minute, and nothing downstream could tell them from real
    # ones. Walking from the file is what prevents it; this is what catches it
    # if the walk is ever wrong again.
    # and a link is asked the same question as a `..`: the path may sit in the
    # world while the file it names does not, which the reading guard catches and
    # this one let through, so the row was written and refused a second later
    if rel.split(os.sep)[0] == os.pardir or leaves_world(rel, d):
        raise ValueError(f"{path} is not inside the world at {d}: a row says where a "
                         "file is relative to the world that declares it")
    name = row_atom(rel)
    ROLE_ATOM = KIND_OF_ROLE
    # ── A DOCUMENT LISTS WHAT IT HAS. The template wrote every role atom this
    # tool can imagine into every world's layout, so a person opening theirs met
    # five words before two facts, two of them naming courts nothing here uses.
    # The atom is written when the first row needs it, like the `Theirs`
    # protocol already was — one list, of this world.
    def ensure(text, line):
        return text if line in text else text.rstrip("\n") + "\n" + line + "\n"
    text = open(mp, encoding="utf-8").read() if os.path.exists(mp) else (
        "// One list, three columns: whose source a file is, which court reads it,\n"
        "// and, for anything taken, the revision it was taken at. gate obeys this\n"
        "// document and never guesses at a row.\n"
        "//\n"
        "// If you are looking for the import: a row is the import. The judged set is\n"
        "// what this document lists, so a file is read because it has a line here and\n"
        "// for no other reason. The words the rows are written in are declared below,\n"
        "// in this file, which is why nothing is fetched.\n"
        "//\n"
        "// It is written the way every record in this world is written: each column\n"
        "// is an axis to a declared atom, and the one string is the `typeName`\n"
        "// literal that spells a name. A revision is an atom of its own, so two\n"
        "// rows taken at the same revision say the same name, not merely the same\n"
        "// text. `Written` names another row: the words a page is written in, so the\n"
        "// two are read together.\n"
        "public protocol Role {}\n")
    # the role atom this row needs, and only that one
    atom = ROLE_ATOM[role]
    if "public enum " + atom + ": Role {}" not in text:
        text = ensure(text, "public enum " + atom + ": Role {}")
    if opens and "public protocol View {}" not in text:
        text = ensure(text, "public protocol View {}")
    if opens and ("public enum " + opens + ": View {}") not in text:
        text = ensure(text, "public enum " + opens + ": View {}")
    if kind == "Mine" and "public protocol Mine {}" not in text:
        text = ensure(text, "\npublic protocol Mine {}")
    if kind == "Theirs" and "public protocol Theirs {}" not in text:
        text += ("\n// What this world took from somewhere else. A file is listed because this\n"
                 "// side said so, and a row here says which file and whose it is. Every taken\n"
                 "// row names the revision it was taken at. This tool has no ranges, so\n"
                 "// nothing here needs a solver.\n"
                 "public protocol Theirs {}\n")
    rev = ""
    if frm:
        rev_atom = "Rev_" + re.sub(r"\W+", "_", frm).strip("_")
        if "public enum " + rev_atom + " {}" not in text:
            rev = ('public enum ' + rev_atom + ' {}\n'
                   'extension ' + rev_atom + ' { public static var typeName: String { "'
                   + frm + '" } }\n')
    line = (rev
            + 'public enum ' + name + ': ' + kind + ' {\n'
            + '    public typealias Kind = ' + ROLE_ATOM[role] + '\n'
            + ('    public typealias At = Rev_' + re.sub(r"\W+", "_", frm).strip("_") + '\n'
               if frm else '')
            # ── AND WHOSE WORDS IT IS WRITTEN IN, WHERE THE OTHER COLUMNS ARE. The
            # page carried this in a comment in its own head, and the fact decides
            # which laws its certificates are judged under: the encoding boundary,
            # written where nothing could judge it.
            + ('    public typealias Written = ' + written + '\n' if written else '')
            + ('    public typealias Opens = ' + opens + '\n' if opens else '')
            + '}\n'
            + 'extension ' + name + ' { public static var typeName: String { "'
            + rel + '" } }\n')
    if line not in text:
        # KEPT IN ITS OWN GROUP, because this document is read by a person: what
        # I write and what I only read are the one distinction it exists to draw,
        # and appending everything to the bottom mixes them back together.
        rows = text.split("\n")
        last = max((i for i, r in enumerate(rows) if r.startswith("public enum ")
                    and r.endswith(": " + kind + " {}")), default=-1)
        if last >= 0:
            # PAST THE WHOLE BLOCK, not past one line of it. A row is written as
            # an extension BODY now, and stepping over it by its first line put
            # the next row inside the previous one's braces — where it parsed as
            # something, so the reader kept going and simply lost the row it had
            # swallowed. An account that quietly stops being true is the one
            # failure this tool exists to make impossible, so it is a brace
            # count now and not a guess at a shape.
            while last + 1 < len(rows) and rows[last + 1].startswith("extension "):
                depth = 0
                while last + 1 < len(rows):
                    last += 1
                    depth += rows[last].count("{") - rows[last].count("}")
                    if depth <= 0:
                        break
            rows.insert(last + 1, line.rstrip("\n"))
            text = "\n".join(rows)
        else:
            text += line
    open(mp, "w").write(text)
    return os.path.basename(mp)


def forget_side(path, d):
    # UNSUBSCRIBING IS DELETING A LINE, and it has to be as cheap as writing one
    # or the list rots: a row nobody can remove without opening the file by hand
    # is a row people stop maintaining, and then the account lies. The FILE is
    # not touched — taking a thing out of your account is not the same act as
    # throwing it away, and gate does not get to decide the second one.
    mp = os.path.join(d, "gate.manifest.swift")
    if not os.path.exists(mp):
        return None, None
    text = open(mp, encoding="utf-8").read()
    _, rows = read_manifest_rows(d)
    # by the path the row says, not by the name at the end of it: two files may
    # share a basename in two folders, and forgetting the wrong row is worse
    # than forgetting none. The caller hands the path relative to this world.
    row = next((r for r in (rows or []) if r["path"] == path), None)
    if not row or not row["name"]:
        return None, None
    # BY BRACES, NOT BY SHAPE. A row is an enum body and an extension body now,
    # and a pattern written for the one-line form matched neither — so this said
    # the row was gone and left it there, which is the same silent lie the
    # grouping insert told a day ago. Anything that edits this document counts
    # braces; nothing about it is guessed from how a line happens to look.
    n, rows_out, i = row["name"], [], 0
    lines = text.split("\n")
    heads = ("public enum " + n + ":", "extension " + n + " ", "extension " + n + "{")
    while i < len(lines):
        if lines[i].startswith(heads[0]) or lines[i].startswith(heads[1]) \
                or lines[i].startswith(heads[2]):
            depth = lines[i].count("{") - lines[i].count("}")
            i += 1
            while depth > 0 and i < len(lines):
                depth += lines[i].count("{") - lines[i].count("}")
                i += 1
            continue
        rows_out.append(lines[i])
        i += 1
    open(mp, "w").write("\n".join(rows_out))
    return os.path.basename(mp), row


def declare_mine(path, argv):
    at = argv[argv.index("--at") + 1] if "--at" in argv else None
    return declare_side(path, "Theirs", "seam", at)


def take_shelf(mod, into="."):
    # ── ONE ACT OF TAKING, AND EVERY DOOR USES IT. Making a shelf world your own
    # is the third verb, and the act of entry is the same act performed once for
    # somebody who has not typed anything yet: a copy lands where they stand,
    # carrying where it came from, declared in the same movement, judged from that
    # second. Written twice, it would be the tool keeping two accounts of its own
    # most-used gesture, which is the shape it exists to refuse.
    dest = os.path.abspath(os.path.join(into, mod + ".swift"))
    if os.path.exists(dest):
        return None, dest
    # the court is the one that reads what the file IS, never the label the
    # shelf wears about itself: `gate's own` says whose furniture it is, and
    # a copy in somebody's repository is theirs, read by the where court
    # like every other world of values they present.
    court = stdlib_role(mod) if stdlib_role(mod) in ROLES else "forms"
    came = judge_from()
    body = STDLIB[mod].split("\n")
    # ── AND THE FILE'S OWN WORD ABOUT HOW IT IS MET TRAVELS WITH IT. The head
    # lines of a shelf page are the shelf's identity and are dropped on purpose,
    # and `// opens: bare` was going with them — so a letter whose own first lines
    # say «meet me as prose» arrived in somebody's repository as code, every line
    # wearing slashes, and that is the first thing they see. Role already survived
    # the copy for exactly this reason; this is the same law, one line down.
    opens = next((ln.strip() for ln in body[:8] if ln.strip().startswith("// opens:")), None)
    # ── AND A PAGE ARRIVES WITH THE FORMS IT IS WRITTEN IN. Its own head line
    # names them, and taken without them its certificates are read by nobody:
    # eleven promises in the very first file a newcomer is handed, judged over
    # nought equalities, because the words that give `Run<V>` its meaning stayed
    # on the shelf. A world names the forms it is written in — the battery has
    # held that of printed worlds for weeks — so taking one page is taking both.
    written = next((ln.strip() for ln in body[:8] if "written in" in ln and ln.startswith("//")), None)
    grammar = re.search(r"stdlib show ([\w-]+)", written or "")
    while body and body[0].startswith("//"):
        body.pop(0)
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    # ── AND THE FIRST LINE OF A PAGE IS FOR WHOEVER OPENS IT. This one said
    # «taken as your own starting point from the judge at 0fd0b38» — a word nobody
    # had introduced yet, a revision nobody had asked for, and the tone of a service
    # announcing itself, all before the page said anything at all. Ownership is the
    # only thing that belongs there. Where it came from and how to get it back are
    # facts about this copy, and facts about a copy go at its foot, where somebody
    # who wants them looks. And ownership is ONE sentence: after the first, the
    # reader is already deciding whether to read on, so a second sentence up here
    # is spent before it can work.
    # ── AND NOTHING MECHANICAL SITS IN THE HEAD. `// role:` and `// opens:`
    # were the tool talking to itself on the reader's first screen: both facts
    # are columns of the manifest row now (Kind, Opens), where the judge reads
    # them. The head keeps the one line that is for the person.
    view = (re.search(r"opens:\s*(\S+)", opens).group(1).strip().lower()
            if opens else None)
    with open(dest, "w") as f:
        f.write("// This copy is yours: read it, change it, break it, delete it when you are\n"
                "// done.\n"
                # one blank line, so the head this tool wrote and the page the
                # reader came for are not one wall of slashes
                + "\n" + "\n".join(body).rstrip("\n").lstrip("\n") + "\n"
                + "\n// Origin: gate's shelf"
                + (f", built from {came[:7]}" if came else "")
                + f". `gate stdlib show {mod}` prints what shipped, unchanged,\n"
                "// for comparing or restoring by hand. Deleting this file and its row in\n"
                "// `gate.manifest.swift` removes it completely.\n")
    # the grammar arrives FIRST, so the row for this page can point at its row:
    # whose words a page is written in is a column of the record, not a comment
    with_it, grammar_atom = [], None
    if grammar and grammar.group(1) != mod and grammar.group(1) in STDLIB:
        also, adest = take_shelf(grammar.group(1), into)
        grammar_atom = row_atom(os.path.relpath(adest, os.path.abspath(into)))
        if also:
            with_it.append(also["wrote"])
    mp = declare_side(dest, "Mine", court, written=grammar_atom,
                      opens=(view.capitalize() if view else None))
    return {"wrote": os.path.relpath(dest, os.path.abspath(into)), "with": with_it,
            "declared_in": mp, "from": came, "court": court}, dest


def cmd_side(a, kind):
    # gate mine PATH [--role R] · gate theirs PATH --at REV [--role R]
    #
    # The same command shape both directions, so that saying a true thing about
    # a file I emitted costs exactly what saying one about a file I took costs.
    # The asymmetry that remains is the one that is really there: what I took, I
    # took from somewhere at something, and that is a fact about it the way its
    # path is.
    word = "mine" if kind == "Mine" else "theirs"
    role = a[a.index("--role") + 1] if "--role" in a else ("world" if kind == "Mine" else "seam")
    at = a[a.index("--at") + 1] if "--at" in a else None
    rest = [x for x in a if not x.startswith("--")]
    for flag in ("--role", "--at"):
        if flag in a and a.index(flag) + 1 < len(a):
            rest = [x for x in rest if x != a[a.index(flag) + 1]]
    usage = (f"gate {word} PATH" + ("" if kind == "Mine" else " --at REV")
             + " [--role " + "|".join(ROLES) + "] · " + f"gate {word} PATH --forget")
    if not rest:
        # THE SAME WORD ASKS AND ANSWERS. With a path it declares; with none it
        # is the question an owner actually has — what have I got, whose is it,
        # and how fresh. Answering that needed no new noun, and a list you can
        # only get by opening a file in an editor is a list nobody looks at.
        d = os.path.dirname(os.path.abspath(FACTS)) if FACTS else os.getcwd()
        _, rows = read_manifest_rows(d)
        held = [r for r in (rows or []) if r["source"] == word]
        if not held:
            return {"command": word, "asks": True, "note": usage,
                    "next": ("a file you emit, judged with the rest of your world"
                             if kind == "Mine" else
                             "a file you took from somewhere, at the revision you took it at")}
        return {"command": word, "held": [
            {"file": r["path"], "role": r["role"], "at": r["from"]} for r in held],
            "note": usage, "mutates": False}
    path = rest[0]
    if "--forget" in a:
        # ── AND A ROW IS FOUND WHERE IT WAS WRITTEN, BY THE PATH IT SAYS. This
        # looked for the manifest in the FILE'S OWN directory and asked for the
        # row by BASENAME, so `gate mine b/page.swift --forget` in a world whose
        # list sits at the root answered "page.swift is not in your list" about a
        # row plainly in it: a declared layout is exactly a world with files in
        # folders, and none of them could be forgotten. The world is found the
        # way everything else finds it, and the row is asked for by the path it
        # carries.
        d = world_root_for(path)
        mp, row = forget_side(os.path.relpath(os.path.abspath(path), d), d)
        if not mp:
            return {"command": word, "asks": True,
                    "note": f"{os.path.basename(path)} is not in your list",
                    "next": f"gate {word} — what is in it"}
        return {"command": word, "forgot": row["path"], "declared_in": mp, "mutates": True,
                "note": "out of your account. The file is still on disk: taking a thing out of "
                        "your list is not throwing it away, and that second act is yours alone",
                "next": "delete the file too if you meant that: a commit like any other, "
                        "visible and dated"}
    # ── MAKING SOMETHING YOURS IS THE THIRD VERB, and it had no word. There was
    # `theirs` — I read it — and `mine` — I write it — and between them the act
    # everybody actually performs: I saw somebody's and took it as my starting
    # point. Without it a person could only look at a shelf world; the nearest
    # gesture, `stdlib materialize`, writes the file and then argues against
    # itself — "a printout, not a source… here to be READ". So the path from
    # seeing to saying was blocked by the tool's own words.
    #
    # It needs no new noun. `gate mine bench-palette` says what it does in the
    # word already learned: the copy lands here, carrying where it came from and
    # at what revision, declared in the same movement, judged from that second.
    # Everything of ours was once somebody else's — the language, the forms, the
    # judge — and learning is taking a thing in hand.
    if kind == "Mine" and not os.path.exists(path) and path in STDLIB:
        mod = path
        took, dest = take_shelf(mod)
        if took is None:
            return {"command": word, "asks": True,
                    "note": f"{mod}.swift is already here",
                    "next": f"gate {word} {mod}.swift — declare the copy you have, or move it "
                            "aside first: nothing here overwrites a file you wrote"}
        return {"command": word, "made_mine": mod, "wrote": os.path.basename(dest),
                "with": took["with"], "court": took["court"],
                "declared_in": took["declared_in"], "from": took["from"], "mutates": True,
                "note": f"{mod} is yours: a copy is here, declared, and judged from now on. "
                        "What the shelf ships is unchanged and still shipped. Yours simply "
                        "stands where it stood",
                "next": "gate status: it is judged with the rest of your world"}
    # ── AND A NAMED FILE THAT IS NOT THERE IS A MISTAKE, NOT A QUESTION. Typing
    # the verb bare is somebody asking what it takes, and that answers with a
    # usage line and a nought exit. Naming a file that does not exist is a typo,
    # a file not written yet, a relative path run from the wrong directory: the
    # same answer there exits nought too, so a Makefile reads "this world now
    # holds your file" from a run that held nothing.
    if not os.path.exists(path):
        cannot(f"no file at {path}",
               ("bring the file here first, or name one this tool ships: "
                + " · ".join(sorted(STDLIB)) if kind == "Mine" else
                "bring the file here first. gate never fetches: a file of theirs "
                "arrives by a checkout, a copy, a vendor step you already trust"))
    if role not in ROLES:
        return {"command": word, "asks": True, "misread": True,
                "note": f"`{role}` is not a court anything here reads",
                "next": "a row says what it is for: "
                        + " · ".join(f"`{k}` — {v}" for k, v in ROLES.items())}
    if kind == "Theirs" and at and moving_pin(at):
        return {"command": word, "asks": True, "note": moving_pin(at),
                "next": "write down the revision you actually took: a commit, a tag, a release. "
                        "What holds between two sides is a fact about two fixed texts. Name a "
                        "moving one and there is nothing for it to be a fact about, which is "
                        "the whole reason nothing here has to be solved"}
    if kind == "Theirs" and not at:
        # THE PIN IS THE POINT. Nothing in this tool expresses a range, which is
        # exactly why no version solver exists here — the problem is not solved,
        # it cannot be stated. A revision nobody wrote down gives that away for
        # free, so taking without one is not a thing that happens.
        return {"command": word, "asks": True, "misread": True,
                "note": "what is taken is taken at a revision, and this one says none",
                "next": f"gate theirs {os.path.basename(path)} --at REV — a commit, a tag, a "
                        "release: whatever the source calls the thing you actually took"}
    # ── AND A CLAIM MAY NOT POINT OUT OF THE WORLD THAT MAKES IT. A row says
    # where a file is relative to its world; a row saying `../../../../var/...`
    # says the file is somewhere else entirely, and a world cannot answer for
    # what is not in it. This is the same floor as reading — a checkout may not
    # be read out of — spelled for writing, and it was missing: an older walk
    # wrote sixteen such rows into this tool's own manifest and they sat in a
    # commit, claims about temporary directories that had long since been
    # deleted. Nothing downstream could tell them from real ones.
    # ── A WORLD IS FOUNDED WHERE YOU STAND, NOT WHEREVER YOU POINT. With no world
    # above the file the row has nowhere to go but a new manifest, and that is
    # how a bench in a fresh directory begins — `gate mine x.swift`, right here.
    # Pointing at somebody's file elsewhere is a different act wearing the same
    # word: it founded a whole world around a stranger's file, in a directory
    # nobody meant as one, and said nothing. Standing in a world and naming a
    # file outside it is the same mistake from the other end.
    here = os.path.abspath(".")
    outside = os.path.relpath(os.path.abspath(path), here).split(os.sep)[0] == os.pardir
    if outside and founds_world(path):
        return {"command": word, "asks": True,
                "note": f"{path} is not inside the world here, and there is no world around it",
                "next": "a world is founded where you stand: run this from the directory that "
                        "world is in, or bring the file into this one. A world judges what "
                        "is in it"}
    # ── AND A FILE IS DECLARED ONCE. Two rows about one file are two truths
    # about one thing, which is what this whole tool exists to make impossible —
    # and its own layout document accepted them silently, under two names, and
    # said `holds`. Found while opening a world to play in: the demo declares
    # its seam sides, a person declares them again by hand, and the morning cut
    # counted every field four times.
    _, _rows = read_manifest_rows(world_root_for(path))
    _rel = os.path.relpath(os.path.abspath(path), world_root_for(path))
    _said = next((r for r in (_rows or []) if r["path"] == _rel), None)
    if _said:
        return {"command": word, "asks": True,
                "note": f"{_rel} is already declared, as `{_said['name']}` "
                        f"({_said['source']}, {_said['role']})",
                "next": f"gate {word} {_rel} --forget, then say it again — a file is declared "
                        "once, or the list stops being an account of anything"}
    try:
        mp = declare_side(path, kind, role, at)
    except ValueError as e:
        return {"command": word, "asks": True, "note": str(e),
                "next": "bring the file into the world first. A world judges what is in "
                        "it, and a row that points outside is a claim it cannot keep"}
    out = {"command": word, "file": os.path.basename(path), "declared_in": mp,
           "role": role, "role_means": ROLES[role], "mutates": True}
    if kind == "Mine":
        out["note"] = ("mine: I emit it, it is judged with the rest of my world, and changing "
                       "it changes the verdict")
        out["next"] = "gate status: it is judged from here on"
        return out
    out["at"] = at
    out["note"] = (f"theirs, taken at {at}: I read it and never rewrite it. To move it, take it "
                   "again at a newer revision. There is nothing here to solve")
    out["next"] = ("gate attention: what now waits for a word, read the same from either side"
                   if role == "seam" else
                   "gate status: the row is accounted for, and its court is `" + role + "`")
    return out


def cmd_declare(a):
    # declare contract SPEC [-o F] · declare carrier DECL.json [-o F]
    #
    # THE ACT OF ENTRY. Everything gate judges is on this side of it, and nothing
    # else is: what a walk finds outside remains an observation forever. The two
    # halves are asymmetric on purpose. A contract states its own types in a
    # public format, so one emitter serves everybody and we ship it. A library's
    # grammar is its own, so we ship no reader for it at all — its build emits a
    # small declaration, and this renders that into the shared words.
    import json as _json
    what = a[0] if a else ""
    out_path = a[a.index("-o") + 1] if "-o" in a else None
    if what in ("contract", "carrier") and len(a) < 2:
        # the word without its document is somebody asking what the act takes
        return {"command": "declare", "asks": True,
                "note": "declare contract SPEC [-o F]  ·  declare carrier DECL.json [-o F]",
                "next": "the spec is a JSON OpenAPI document, and the carrier declaration is "
                        "what your build emits. After this it is what you have SAID, and judged"}
    if what == "contract":
        src = a[1]
        mine_too = "--theirs" in a or "--mine" in a
        fields = [f for f in read_contract(src) if f.get("shape")]
        lines = [DECLARE_HEADER + STDLIB["forms-contract"], ""]
        for f in fields:
            rec = "F_" + sanitize(f["route"]) + "_" + sanitize(f["field"])
            lines += [f"// {f['route']} · {f['field']}",
                      f"public enum {rec}: Declared {{",
                      f"    public typealias Of = {f['shape']}", "}"]
        world = "\n".join(lines) + "\n"
        if out_path:
            open(out_path, "w").write(world)
        mine = declare_side(out_path, "Theirs", "seam",
                            a[a.index("--at") + 1] if "--at" in a else
                            os.path.basename(src)) if (mine_too and out_path) else None
        return {"command": "declare contract", "of": os.path.basename(src), "declared_in": mine,
                "declares": len(fields), "wrote": out_path, "world": None if out_path else world,
                "note": ("a view of that document: every field it states a type for, as a record "
                         "whose shape is an axis. Fields it leaves open state no shape and are not "
                         "here. A contract that says `anyOf` has not said which"),
                "next": "commit it: from here on it is what you have said, and it is judged",
                "mutates": bool(out_path)}
    if what == "carrier":
        decl = theirs_json(a[1], "a carrier declaration your build emits")
        who = sanitize(decl.get("carrier") or "Carrier")
        against = decl.get("against") or {}
        lines = [CARRIER_HEADER
                 + f"// {who} · against {against.get('contract', 'a contract')}"
                 + (f" at {against['revision']}" if against.get("revision") else "") + "\n",
                 f"public enum {who}: Carrier {{}}", ""]
        for i, c in enumerate(decl.get("carries") or []):
            rec = "F_" + sanitize(c["route"]) + "_" + sanitize(c["field"])
            mine = f" (it calls it {c['mine']})" if c.get("mine") else ""
            lines += [f"// {c['route']} · {c['field']}{mine}",
                      f"public typealias Carry_{i} = Carries<{who}, {rec}, {c['as']}>"]
        world = "\n".join(lines) + "\n"
        if out_path:
            open(out_path, "w").write(world)
        # THE PIN IT ALREADY CARRIES. A carrier declaration says what contract it
        # was built against and at what revision; asking the operator to type
        # that again would be asking for a second copy of a fact, and a second
        # copy drifts. `--at` overrides where the emitter said nothing.
        pin = (a[a.index("--at") + 1] if "--at" in a
               else against.get("revision") or against.get("contract"))
        mine = (declare_side(out_path, "Theirs", "seam", pin)
                if (("--theirs" in a or "--mine" in a) and out_path) else None)
        return {"command": "declare carrier", "carrier": who, "declared_in": mine,
                "declares": len(decl.get("carries") or []), "wrote": out_path,
                "world": None if out_path else world,
                "against": against,
                "note": ("what this library says it carries. It is not judgeable alone: a carrier "
                         "declaration is about a contract, and the pair is judged by `gate seam`"),
                "next": ("run it again with --theirs to write it into gate.manifest.swift, and put "
                         "this file plus those two lines in THEIR repository: their own CI then "
                         "holds them to what you carry" if not mine else
                         "put this file and its two manifest lines in THEIR repository: from then "
                         "on their CI parts the seam the day they touch what you carry"),
                "mutates": bool(out_path)}
    return {"command": "declare", "asks": True,
            "note": "declare contract SPEC [-o F]  ·  declare carrier DECL.json [-o F]",
            "next": ("the carrier declaration is emitted by that library's own build: "
                     '{"carrier": N, "against": {...}, "carries": [{"route", "field", "as", "mine"?}]}')}


def seam_read(left, right):
    # the two declarations, taken apart: what the contract stated, what the
    # carrier claimed, and whose name is on the claims.
    stated = {(m.group(1), m.group(2)) for m in re.finditer(r"^// (\S+) · (\S+)$", left, re.M)}
    claims = {}
    for m in re.finditer(r"^// (\S+) · (\S+)(?: \(it calls it (\S+)\))?\npublic typealias (Carry_\d+)",
                         right, re.M):
        claims[m.group(4)] = (m.group(1), m.group(2), m.group(3))
    who = re.search(r"public enum (\w+): Carrier", right)
    return stated, claims, (who.group(1) if who else "that library")


def declared_seam_files(base):
    # WHICH SEAMS ARE MINE IS MINE TO SAY. Sniffing the folder for files that
    # look like seam sides is guessing at somebody's relationships from the shape
    # of what happens to be lying about — the same sin as reading a library's
    # source, one storey up. The layout file already declares what belongs to
    # this world; it declares the seams this world is party to the same way, and
    # the rail shows exactly that and nothing else.
    # Membership is DECLARED; which side a file is, that file says about itself
    # in its own first lines. Mine to say what is mine; theirs to say what theirs
    # is.
    mp, rows = read_manifest_rows(base)
    if mp is None:
        return []
    return [os.path.join(base, r["path"]) for r in rows if r["role"] == "seam"]


def seams_here(root=None):
    # the pairs this folder has DECLARED itself party to, and a `known.json`
    # beside them if somebody has said a divergence is meant.
    base = os.path.abspath(root or (os.path.dirname(os.path.abspath(FACTS)) if FACTS else "."))
    stated, claimed = [], []
    for full in declared_seam_files(base):
        if not (os.path.exists(full) and is_seam_side(full)):
            continue
        txt = open(full, encoding="utf-8", errors="replace").read(4000)
        if re.search(r"^public enum \w+: Carrier \{\}", txt, re.M):
            claimed.append(full)
        else:
            stated.append(full)
    known = os.path.join(base, "known.json")
    tick = os.path.join(base, "tickets.json")
    out = []
    # A SIDE DECLARED ALONE IS A STATE, NOT A BLANK. Somebody who has just said
    # what they carry and is waiting for the other end to arrive would otherwise
    # see nothing at all and think the declaration had not taken — which is the
    # ordinary state of whoever moves first, and moving first is what we ask.
    if not (stated and claimed):
        for f in (stated + claimed):
            side = "carries" if f in claimed else "states"
            out.append({"command": "attention", "alone": side,
                        "carrier": re.search(r"public enum (\w+): Carrier",
                                             open(f, encoding="utf-8").read())
                        .group(1) if f in claimed else os.path.basename(f),
                        "contract_file": os.path.basename(f), "carrier_file": os.path.basename(f),
                        "stated": 0, "claimed": 0, "waits_on_you": [], "you_wait_on": [],
                        "parted": [], "known": [], "expired": [], "against": None,
                        "read_known": None, "read_tracker": None})
        return out
    for c in stated:
        for k in claimed:
            args = [c, k]
            if os.path.exists(known):
                args += ["--known", known]
            if os.path.exists(tick):
                args += ["--tracker", tick]
            a = cmd_attention(args)
            import json as _j
            try:
                decl = re.search(r"^// \w+ · against ([^\n]+)$",
                                 open(k, encoding="utf-8").read(2000), re.M)
                a["against"] = decl.group(1) if decl else None
            except OSError:
                a["against"] = None
            a["contract_file"] = os.path.basename(c)
            a["carrier_file"] = os.path.basename(k)
            # AND THE PIN, WHERE THE OWNER IS LOOKING. `against` is what the
            # other side said it built against; this is what YOU wrote down when
            # you took each file, which is the fact you can act on — and it was
            # readable only by opening the manifest in an editor.
            _mp, _rows = read_manifest_rows(os.path.dirname(os.path.abspath(c)))
            _row = {r["path"]: r for r in (_rows or [])}
            # AND THE VIEW POINTS AT THE PRIMARY. What is taken is a reading of
            # a claim, and the claim is a line in a file the operator wrote — so
            # the row carries the address of that line rather than standing as a
            # thing of its own. Nothing here is editable: you go and change the
            # sentence you wrote, and this changes with it.
            a["took"] = [{"file": os.path.basename(f),
                          "at": (_row.get(os.path.basename(f)) or {}).get("from"),
                          "claim": os.path.basename(_mp) if _mp else None,
                          "line": (_row.get(os.path.basename(f)) or {}).get("line")}
                         for f in (c, k)]
            a["read_known"] = os.path.basename(known) if os.path.exists(known) else None
            a["read_tracker"] = os.path.basename(tick) if os.path.exists(tick) else None
            out.append(a)
    return out


def cmd_attention(a):
    # attention CONTRACT.swift CARRIER.swift [--as WHO] [--known K.json] [--tracker T.json]
    #
    # NOT WHAT CHANGED — WHAT WAITS FOR A WORD. History is diachronic and git
    # already keeps it; this is the other cut, the standing ledger of who owes
    # whom a sentence. It is two-sided by construction rather than by design: an
    # unanswered axis sits on the side that owes the answer, so the same movement
    # that shows a front-end what its back-end is waiting for shows the back-end
    # what the front-end is waiting for. A sensor opens a hole for a technologist
    # exactly as a client opens one for a contract.
    #
    # AND INTENTION IS DECLARED, NEVER GUESSED. A divergence somebody said out
    # loud is a fact with an author; one nobody said is, by construction,
    # unintended — that is the gate's own law, applied to disagreement. But a
    # declaration without a term is an amnesty, and every temporary exception
    # outlives its reason, so a declared divergence must CITE something that can
    # close. When the tracker says it closed, the exception stops holding and the
    # item comes back — louder, because the ground it stood on is gone.
    import json as _json
    if len(a) < 2:
        # ── AND WITH NO ARGUMENTS IT IS THE MORNING QUESTION. `attention` needed
        # two files named by hand, so the one thing an owner asks daily — what
        # waits on my word today — could only be asked one pair at a time, by
        # somebody who already knew which pairs there were. The list is declared;
        # this world knows its own seams. Same reading, asked of all of them.
        here = seams_here()
        if here:
            return {"command": "attention", "seams": here,
                    "waiting_on_you": sum(len(s.get("waits_on_you") or []) for s in here),
                    "you_wait_on": sum(len(s.get("you_wait_on") or []) for s in here),
                    "parted": sum(len(s.get("parted") or []) for s in here),
                    "came_back": sum(len(s.get("expired") or []) for s in here),
                    "next": "gate attention CONTRACT.swift CARRIER.swift  one pair, in full"}
        return {"command": "attention", "asks": True,
                "note": "no seam is declared here, so nobody is waiting on anybody",
                "next": "gate theirs their-side.swift --role seam --at REV  say which pair you "
                        "are party to, and this becomes the question you ask each morning"}
    left, right = (theirs_text(a[0], "the contract side of the pair").read(),
                   theirs_text(a[1], "the carrier side of the pair").read())
    stated, claims, carrier = seam_read(left, right)
    me = a[a.index("--as") + 1] if "--as" in a else carrier
    known = (theirs_json(a[a.index("--known") + 1], "the divergences you declared")
             if "--known" in a else {})
    tracker = read_tracker(a[a.index("--tracker") + 1]) if "--tracker" in a else {}

    d = scratch("gate-att-")
    path = os.path.join(d, "seam.swift")
    open(path, "w").write(left + "\n" + right)
    outp = judge_call(["judge", "where", path]).stdout
    shutil.rmtree(d, ignore_errors=True)
    claimed = {(r, f) for r, f, _ in claims.values()}
    parted = {}
    for m in re.finditer(r"^✗ '(\w+)[^']*' requires the types '[^']*' \(aka '([^']+)'\) and "
                         r"'[^']*' \(aka '([^']+)'\)", outp, re.M):
        cert, want, got = m.groups()
        route, field, mine = claims.get(cert, ("?", cert, None))
        # a claim about something the contract never stated is not a
        # DISAGREEMENT — there is nothing to disagree with. It is the contract
        # owing a sentence, and it belongs in the other column entirely; left
        # here it read as a conflict with a record that does not exist.
        if (route, field) in stated:
            parted[(route, field)] = (want.lower(), got.lower(), mine)
    # ── THE STATE OF EVERY ADDRESS IS |S|, AND THE THREE COLUMNS COME OUT OF IT.
    # A seam is the premise V=I §5.4 leaves outside itself — that two encodings
    # are semantics-preserving — and it can be asked as a V=I game one level up
    # (§5.13 sub-game spawn, §5.15 structural recurrence): the candidates are the
    # correspondences between what one side STATES and what the other CLAIMS,
    # and the examples are the addresses both sides spoke about.
    #
    # Then the vocabulary is not ours to choose. |S| ∈ ℕ and {0, 1, >1} partition
    # ℕ (§5 Outcome Classification), so an address is in exactly one of three
    # states and there is no fourth to write:
    #
    #   |S| = 1   both spoke and they agree — the correspondence is identified
    #   |S| = 0   both spoke and nothing passes — parted
    #   |S| > 1   one side is silent, so nothing distinguishes; the finer
    #             distinction that would settle it IS the other side's word
    #
    # This used to be three lists computed side by side, each correct, none of
    # them saying why there were three. The lists come out of the sizes now, so
    # a fourth column cannot be added without first inventing a fourth size.
    addresses = sorted(stated | claimed)
    sizes = {(r, f): (0 if (r, f) in parted else
                      1 if ((r, f) in stated and (r, f) in claimed) else 2)
             for (r, f) in addresses}
    # the carrier owes an answer where the contract stated and it stayed silent;
    # the contract owes one the other way — the same size, read from two ends
    owes_carrier = [a for a in addresses if sizes[a] == 2 and a in stated]
    owes_contract = [a for a in addresses if sizes[a] == 2 and a in claimed]

    def excuse(route, field):
        # a declared divergence, and whether the thing it cites is still open
        for k in (known.get("diverges") or []):
            if k.get("route") == route and k.get("field") == field:
                why = k.get("because") or ""
                state = tracker.get(why)
                return {"address": f"{route} · {field}", "because": why,
                        "declared_by": k.get("declared_by") or "somebody",
                        "state": state or ("unread" if tracker else "not checked")}
        return None

    def sort(items, kind):
        live, dead, plain = [], [], []
        for route, field in items:
            ex = excuse(route, field)
            if ex is None:
                plain.append({"address": f"{route} · {field}", "kind": kind})
            elif ex["state"] == "Closed":
                dead.append({**ex, "kind": kind})
            else:
                live.append({**ex, "kind": kind})
        return plain, live, dead

    waits_on_me, known_mine, expired_mine = sort(owes_carrier if me == carrier else owes_contract,
                                                 "unanswered")
    i_wait, known_theirs, expired_theirs = sort(owes_contract if me == carrier else owes_carrier,
                                                "unanswered")
    parts, known_part, expired_part = sort(sorted(parted), "parted")
    for p in parts + known_part + expired_part:
        route, field = p["address"].split(" · ")
        want, got, mine = parted[(route, field)]
        p["why"] = (f"the contract states {want}; {carrier} declares "
                    + (f"its own {mine} as " if mine else "") + got)
    return {"command": "attention", "as": me, "carrier": carrier,
            # what the game answered, address by address, so a reader of this
            # payload derives the same three states and cannot invent a fourth
            "sizes": {f"{r} · {f}": n for (r, f), n in sizes.items()},
            "waits_on_you": waits_on_me, "you_wait_on": i_wait, "parted": parts,
            "known": known_mine + known_theirs + known_part,
            "expired": expired_mine + expired_theirs + expired_part,
            "stated": len(stated), "claimed": len(claims),
            "note": ("a standing account of who owes whom a word. An unanswered axis stays with "
                     "whoever owes the answer, so this reads the same from either side" + (", and a divergence somebody declared is set aside while the "
                     "thing it cites is open, and comes back when that closes" if known else "")),
            "next": ("answer the first line above, or declare the divergence with something that can "
                     "close" if waits_on_me else
                     "nothing waits on you here" if not (i_wait or parts) else
                     "these wait on the other side, and they are listed so you know what you are waiting for"),
            "mutates": False}


def cmd_aside(a):
    # aside ROUTE FIELD --because KEY [--by WHO] [-o known.json] — say out loud
    # that a divergence is meant, and name the thing that will end it.
    #
    # FRICTION IS NOT EVENLY DESERVED. Saying a true thing should cost nothing;
    # setting a true thing aside should cost a reason that can close, because an
    # exception with no term is an amnesty and every temporary one outlives what
    # it was for. So this asks for the reason and refuses without it — and then
    # takes the two hand-edits it used to take and makes them one sentence.
    import json as _json
    if len(a) < 2 or "--because" not in a:
        return {"command": "aside", "asks": True, "misread": bool(a),
                "note": "aside ROUTE FIELD --because KEY [--by WHO] [-o known.json]",
                "next": ("the reason is not optional: name something that can close, such as a ticket, a "
                         "release. This stands aside only while that is open")}
    route, field = a[0], a[1]
    because = a[a.index("--because") + 1]
    by = a[a.index("--by") + 1] if "--by" in a else (
        subprocess.run(["git", "config", "user.name"], capture_output=True, text=True).stdout.strip()
        or "somebody")
    path = a[a.index("-o") + 1] if "-o" in a else "known.json"
    known = {"diverges": []}
    if os.path.exists(path):
        try:
            known = _json.load(theirs_text(path, "the divergences you declared"))
        except Exception:
            known = {"diverges": []}
    rows = [d for d in (known.get("diverges") or [])
            if not (d.get("route") == route and d.get("field") == field)]
    rows.append({"route": route, "field": field, "because": because, "declared_by": by})
    known["diverges"] = rows
    _json.dump(known, open(path, "w"), indent=1)
    return {"command": "aside", "address": f"{route} · {field}", "because": because,
            "declared_by": by, "wrote": path, "standing": len(rows),
            "note": (f"{by} says this one is meant, while {because} is open. It stands out of the "
                     f"way until {because} closes, and comes back by itself when it does"),
            "next": (f"point a tracker export at it — `gate attention … --known {path} --tracker "
                     "tickets.json`, and the day it closes this returns first"),
            "mutates": True}


def cmd_seam(a):
    # seam CONTRACT.swift CARRIER.swift — two declarations, one world, one court.
    #
    # This is the only place gate refuses anything about a pair, and it can only
    # do it because both sides are here BY THEIR OWN WORD. The refusal is never
    # about somebody's code: it is about two sentences that do not agree, each
    # signed by whoever wrote it.
    if len(a) < 2:
        return {"command": "seam", "asks": True, "misread": bool(a),
                "note": "seam CONTRACT.swift CARRIER.swift  both sides, as each declared them",
                "next": "gate declare contract … and gate declare carrier … first"}
    for _side in a[:2]:
        # both sides are files, and a side that is not there is a sentence: this
        # opened them straight and raised, where the vein said which one is missing
        if not os.path.exists(_side):
            cannot(f"no such side: {_side}",
                   "both sides are files: `gate declare contract SPEC -o api.swift` and "
                   "`gate declare carrier DECL.json -o sdk.swift` write them")
    left, right = (theirs_text(a[0], "the contract side of the pair").read(),
                   theirs_text(a[1], "the carrier side of the pair").read())
    m = re.search(r"public enum (\w+): Carrier", right)
    who = m.group(1) if m else "that library"
    where = {}
    for m in re.finditer(r"^// (\S+) · (\S+)(?: \(it calls it (\S+)\))?\npublic typealias (Carry_\d+)",
                         right, re.M):
        where[m.group(4)] = (m.group(1), m.group(2), m.group(3))
    d = scratch("gate-seam-")
    path = os.path.join(d, "seam.swift")
    open(path, "w").write(left + "\n" + right)
    t0 = time.time()
    outp = judge_call(["judge", "where", path]).stdout
    ms = round((time.time() - t0) * 1000, 1)
    refusals = []
    for m in re.finditer(r"^✗ '(\w+)[^']*' requires the types '[^']*' \(aka '([^']+)'\) and "
                         r"'[^']*' \(aka '([^']+)'\)", outp, re.M):
        cert, want, got = m.groups()
        route, field, mine = where.get(cert, ("?", cert, None))
        refusals.append({"address": f"{route} · {field}",
                         "claim": (f"the contract declares it {want.lower()}; {who} declares "
                                   + (f"its own {mine} as " if mine else "it ")
                                   + f"{got.lower()}")})
    # a field the contract declares and no carrier claims: not a disagreement,
    # since a claim never made cannot be refused — named beside the judgement
    claimed = {(r, f) for r, f, _ in where.values()}
    silent = [m.group(1) + " · " + m.group(2)
              for m in re.finditer(r"^// (\S+) · (\S+)$", left, re.M)
              if (m.group(1), m.group(2)) not in claimed]
    shutil.rmtree(d, ignore_errors=True)
    return {"command": "seam", "verdict": "refused" if refusals else "holds",
            "refusals": refusals, "judged": len(where), "unclaimed": silent,
            "judge_ms": ms,
            "carrier": who,
            "note": (f"{len(where)} claims judged"
                     + (f"; {len(silent)} field{'s' if len(silent) != 1 else ''} the contract declares "
                        + ("are" if len(silent) != 1 else "is")
                        + " claimed by nobody: a claim never made cannot be refused, so it stands "
                        "beside the judgement" if silent else "")),
            "next": ("open the address above: two declarations, both signed, do not agree"
                     if refusals else "wire it into CI: neither side can move without the other seeing"),
            "mutates": False}


def cmd_drift(a):
    # drift CONTRACT --client DIR [--since DATE] [--name N] [--fail-over DAYS]
    #
    # OBSERVATION, AND NOTHING ELSE. This looks at a world that has not entered
    # ours, so it holds no court and carries no verdict: what it prints are
    # lexical facts about git objects — a string is in this diff, a commit bears
    # this date — and the reader may re-run every one of them. Judgement waits
    # for the gate; nothing outside it can be judged, because nobody there has
    # spoken for anything.
    #
    # Two kinds of fact, and they are not equally certified. PRESENCE is an
    # object: the commit that introduced a string is named by its own hash.
    # ABSENCE is a walk, and a walk is only as good as its bounds — so the bounds
    # are printed beside every absence, and a reader who points at one excluded
    # file has refuted the claim, which is exactly what makes it a claim.
    import json as _json
    from datetime import date as _date
    # the first thing a stranger types is `--help`, and taking it for a filename
    # printed an observation of a contract that does not exist
    _spec_next = ("the contract is a JSON OpenAPI document in a git checkout, and "
                  "for YAML, `yq -o=json '.' spec.yml > spec.json` first")
    if not a or a[0].startswith("-"):
        return {"command": "drift", "asks": True,
                "note": "drift CONTRACT --client DIR [--since DATE] [--name N] [--fail-over DAYS]",
                "next": _spec_next}
    # and a contract that was named and is not there is the other answer: asked
    # and mistyped are two different things, and only one of them exits nought
    if not os.path.exists(a[0]):
        cannot(f"no such contract here: {a[0]}", _spec_next)
    src = a[0]
    root = a[a.index("--client") + 1] if "--client" in a else "."
    since = a[a.index("--since") + 1] if "--since" in a else None
    who = a[a.index("--name") + 1] if "--name" in a else sanitize(os.path.basename(os.path.abspath(root)))
    over = int(a[a.index("--fail-over") + 1]) if "--fail-over" in a else None
    t0 = time.time()
    _sroot, revs = contract_revisions(src, since)
    # HISTORY DATES; TODAY WALKS. The union over every revision is what the
    # contract has EVER said, and dating needs that — but a name the contract
    # retired two years ago is not one the library is missing, and asking the
    # walk about it turned one true absence into thirty. So the walk asks the
    # contract as it stands, and only the dates come from the union.
    declared, current, routes = {}, [], {}
    for when, blob in revs:
        try:
            spec = _json.loads(blob.decode("utf-8", "replace"))
        except Exception:
            continue                            # a revision that did not parse says nothing
        for f in contract_fields(spec):
            declared.setdefault(f["field"], when)
    try:
        now = contract_fields(_json.loads(open(src, encoding="utf-8").read()))
    except Exception:
        now = []
    for f in now:
        current.append(f["field"])
        routes.setdefault(f["route"], True)
        declared.setdefault(f["field"], None)

    # ── the walk, and its bounds
    body, scope = read_carrier(root)
    words = set(re.findall(r"\w+", body))
    spoken = set(re.findall(r"[\"'`/]([A-Za-z0-9_.\-]+)(?=[\"'`/?]|$)", body, re.M))
    unwritten = sorted({n for n in current if not (name_variants(n) & words)})
    silent = []
    if any(all(s in spoken for s in [x for x in r.split("/") if x and not x.startswith("{")])
           for r in routes):
        # a library that writes no URL at all is not a library that lacks every
        # endpoint: it is one that keeps its paths somewhere this walk did not go
        for r in sorted(routes):
            segs = [x for x in r.split("/") if x and not x.startswith("{")]
            if segs and not all(s in spoken for s in segs):
                silent.append(r)

    # ── the history, where there is one
    croot = (subprocess.run(["git", "-C", root, "rev-parse", "--show-toplevel"],
                            capture_output=True, text=True).stdout or "").strip()
    croot = os.path.realpath(croot) if croot else ""

    def shallow(r):
        return r and (subprocess.run(["git", "-C", r, "rev-parse", "--is-shallow-repository"],
                                     capture_output=True, text=True).stdout or "").strip() == "true"
    thin = [w for w, r, n in ((os.path.basename(src), _sroot, len(revs)), (who, croot, 2))
            if not r or shallow(r) or n < 2]
    late, undatable, median, worst = [], [], 0, []
    if not thin:
        here = os.path.relpath(os.path.realpath(root), croot)
        spec_rel = (os.path.relpath(os.path.realpath(src), croot)
                    if os.path.realpath(src).startswith(croot + os.sep) else None)
        seen = first_mentions(croot, list(declared),
                              only=None if here in (".", "") else here, without=spec_rel)
        # A WINDOW HAS AN EDGE, and it is the loudest wrong number here. With
        # --since, whatever the contract already declared when the window opened
        # carries the window's own date rather than the day it was said, so a
        # field five years old reads as new. On box that inflated nine true
        # readings into thirty-two.
        edge = revs[0][0] if since else None
        for f, sd in declared.items():
            if sd is None or sd == edge:
                undatable.append(f)
                continue
            cd = seen.get(f)
            if cd is None:
                continue                        # absence is the walk's business, above
            days = (_date.fromisoformat(cd) - _date.fromisoformat(sd)).days
            if days > 0:
                late.append({"field": f, "contract": sd, "carrier": cd, "days": days})
        late.sort(key=lambda x: -x["days"])
        mid = sorted(x["days"] for x in late)
        median = 0 if not mid else (mid[len(mid) // 2] if len(mid) % 2 else
                                    (mid[len(mid) // 2 - 1] + mid[len(mid) // 2]) // 2)
        worst = late[:5]
    # the exit code is the OPERATOR'S threshold, declared by them, and never a
    # verdict: this command has no standing to fail anybody's build on its own
    # reading of a world that never entered.
    return {"command": "drift", "contract": os.path.basename(src), "carrier": who,
            "revisions": len(revs), "declares": len(current), "since": since,
            "thin": thin, "scope": scope,
            "unwritten": unwritten, "silent_routes": silent,
            "late": len(late), "median_days": median,
            "worst_days": late[0]["days"] if late else 0, "worst": worst,
            "undatable": len(undatable),
            "over_threshold": bool(over is not None and median > over),
            "threshold": over,
            "ms": round((time.time() - t0) * 1000, 1),
            "note": ("an observation, of a world that has not entered: git objects, and a walk. "
                     + (f"no history to date anything: {' and '.join(thin)} arrived with one commit "
                        "standing in for all of them. " if thin else
                        f"{len(revs)} revisions of the contract were read, and the library's history "
                        "walked once. ")
                     + f"Absence is a fact about this walk: {scope['files']} files under "
                     + f"{scope['root']}, kinds {scope['kinds']}, skipping {scope['skipped']}"
                     + (f"; {len(undatable)} names cannot be dated, being already declared when the "
                        "window opened" if undatable else "")),
            "next": ("re-run it yourself: everything above is a git object or a walk whose bounds "
                     "are printed with it" if not thin else
                     f"git fetch --unshallow in {thin[0]}, and the dates become readable")}


# a name both sides can say: letters, digits, underscores and hyphens, because a
# hyphen converts between conventions and a dot does not — a dot inside a key is
# the wire encoding a structure, and no source anywhere carries it as a word.
SPELLABLE = re.compile(r"[A-Za-z_]\w*(?:-\w+)*")


def read_contract(path):
    # an OpenAPI document, read for the one thing a client must agree with: the
    # fields of a request body and the sort of thing each one is.
    import json as _json
    return contract_fields(theirs_json(path, "an OpenAPI document"))


def body_media(spec):
    # what a contract sends its requests AS. Asked only when nothing was read,
    # to say why: twilio posts sixty-two bodies and every one of them is a form,
    # so a reader that takes JSON alone finds no field, judges nothing, and says
    # `holds` — which is the empty green again, in a contract that never spoke
    # this reader's language at all.
    seen = {}
    for _r, ops in (spec.get("paths") or {}).items():
        for _v, op in (ops or {}).items():
            if not isinstance(op, dict):
                continue
            for k in ((op.get("requestBody") or {}).get("content") or {}):
                seen[k] = seen.get(k, 0) + 1
    return seen


# what a contract SAYS a field is. This is not inference and never was: an
# OpenAPI document states the type outright, in its own words, and reading it is
# reading a declaration rather than guessing at one. The reader that inferred
# shapes from a client's SOURCE is what went; a document that declares its own
# types is a different thing entirely, and its author signs it by publishing it.
DECLARED = {"string": "Text", "integer": "Count", "number": "Count",
            "boolean": "Flag", "array": "Many", "object": "Nested"}


def declared_shape(t):
    if isinstance(t, list):
        t = [x for x in t if x != "null"]
        t = t[0] if len(t) == 1 else None       # two types is the contract leaving it open
    return DECLARED.get(t)


def contract_fields(spec):
    # the same reading, from a document already in hand — because the drift
    # command reads a hundred and fifty of them out of git without writing one
    # to disk
    shelf = dict(spec.get("definitions") or {})
    shelf.update((spec.get("components") or {}).get("schemas") or {})

    def resolve(s):
        if "$ref" in s:
            return shelf.get(s["$ref"].split("/")[-1], {})
        return s
    # what the contract also SENDS BACK. A spec may describe one shape for both
    # directions — weaviate posts an `Object` and receives an `Object` — and then
    # its fields say nothing about what a request carries: the timestamps in it
    # are stamped by the server, and a client is not behind for leaving them out
    # or for keeping a flag of that name instead. Where the contract itself does
    # not separate the directions, this door does not pretend to.
    returned = set()

    def gather(node):
        if isinstance(node, dict):
            if "$ref" in node and isinstance(node["$ref"], str):
                returned.add(node["$ref"])
            for v in node.values():
                gather(v)
        elif isinstance(node, list):
            for v in node:
                gather(v)

    for _r, _ops in (spec.get("paths") or {}).items():
        for _v, _op in (_ops or {}).items():
            if isinstance(_op, dict):
                gather(_op.get("responses"))

    out = []
    for route, ops in (spec.get("paths") or {}).items():
        if not isinstance(ops, dict):
            continue
        # A REQUEST IS NOT ONLY ITS BODY. Half of what a contract declares stands
        # in its parameters — the id in the path, the limit in the query — and
        # reading bodies alone judged forty-six per cent of these contracts and
        # called that the whole of them. Deepgram declares seventeen body fields
        # and two hundred and forty-six parameters: six per cent judged, and a
        # green over it would have meant almost nothing. The contract states
        # each one outright, name and place and sort, so there is nothing to
        # guess here — only something that was not being read.
        shared = [p for p in (ops.get("parameters") or []) if isinstance(p, dict)]
        for verb, op in ops.items():
            if not isinstance(op, dict):
                continue
            for p in (op.get("parameters") or []) + shared:
                # QUERY ONLY, and the reason is what a name IS. A query key goes
                # on the wire exactly as written, so both sides must spell it the
                # same and may be judged against each other. The name inside
                # `{braces}` never goes anywhere: it is documentation of a slot,
                # and a client owes it nothing — typesense writes
                # `{curationSetName}` and its library calls the same thing
                # `name`, which is not drift and must not be reported as any.
                if not isinstance(p, dict) or p.get("in") != "query" or not p.get("name"):
                    continue
                sch = p.get("schema") or {}
                inner = resolve(sch).get("properties") if sch else None
                if inner:
                    # a query parameter declared as an object carries its fields
                    # in its properties; its own name is a wrapper nobody writes
                    for nm, pr in sorted(inner.items()):
                        out.append({"route": route, "field": nm, "where": "query",
                                    "shape": declared_shape((pr or {}).get("type"))})
                    continue
                # `project_ids[]` is how a repeated key is written ON THE WIRE;
                # the name a library spells is `project_ids`, and the brackets
                # belong to the transport, not to either side's vocabulary
                nm = re.sub(r"\[\]$", "", p["name"])
                # and only a name a library could spell. Twilio writes the
                # comparison into the key — `StartTime<`, `StartTime>` — and no
                # source anywhere can carry that word, so looking for it finds
                # nothing and reports an absence that means only that the wire
                # has a syntax. The same ground as the path names: judge what
                # both sides are able to say.
                if not SPELLABLE.fullmatch(nm):
                    continue
                out.append({"route": route, "field": nm, "where": "query",
                            "shape": declared_shape((p.get("schema") or {}).get("type") or p.get("type"))})
            content = (op.get("requestBody") or {}).get("content") or {}
            body = (content.get("application/json") or {}).get("schema")
            if not body:
                # A FORM IS A REQUEST TOO. Twilio declares sixty-two bodies and
                # every one of them is x-www-form-urlencoded, so a reader that
                # took JSON alone saw none of them and said `holds`. The field
                # names in a form go on the wire exactly as written — the same
                # thing that makes a query key judgeable — and the schema beside
                # them is shaped identically. JSON is preferred where both are
                # offered, because that is the one a typed client writes.
                for kind in ("application/x-www-form-urlencoded", "multipart/form-data"):
                    if (content.get(kind) or {}).get("schema"):
                        body = content[kind]["schema"]
                        break
            if not body:
                # swagger 2.0 puts the body among the parameters, marked `in:
                # body`, and its schemas live under `definitions`. Two of the
                # projects looked at here are written that way and the door read
                # nothing at all of either — not a refusal, not a silence, just
                # a contract that appeared to declare no fields.
                for p in (op.get("parameters") or []):
                    if isinstance(p, dict) and p.get("in") == "body" and p.get("schema"):
                        body = p["schema"]
                        break
            if not body:
                continue
            if isinstance(body, dict) and body.get("$ref") in returned:
                continue
            for name, prop in sorted((resolve(body).get("properties") or {}).items()):
                # a property may point at a schema instead of naming a type, so
                # follow the ref one hop. What must NOT happen is a default: a
                # contract that says `anyOf` has not named a shape, it has left
                # the shape open, and calling that open field `nested` invents a
                # claim the contract never made and then accuses a library of
                # breaking it. Nineteen such accusations against a correct client
                # is what this cost before the shape was allowed to be nothing.
                prop = prop or {}
                if not SPELLABLE.fullmatch(name):
                    # `Parameter1.Name` … `Parameter99.Value` is how twilio writes
                    # a list of pairs ON THE WIRE, and no library spells it: a dot
                    # inside a key belongs to the encoding, and looking for it in
                    # source found nothing three hundred and ninety-six times.
                    # A hyphen does convert — `log-slow-requests-time-ms` is
                    # `log_slow_requests_time_ms` in Python — so it stays.
                    continue
                if prop.get("readOnly"):
                    # the contract's own word that this field travels out and
                    # never in: it is no part of a request, so a client that does
                    # not carry it is not behind anything
                    continue
                out.append({"route": route, "field": name, "where": "body",
                            "shape": declared_shape(prop.get("type") or resolve(prop).get("type"))})
    return out


def snake_of(name):
    return re.sub(r"(?<!^)(?=[A-Z])", "_", name).lower()


def name_variants(name):
    # a wire name is rarely the name a library writes: the contract's
    # `log-slow-requests-time-ms` is `log_slow_requests_time_ms` in Python and
    # `logSlowRequestsTimeMs` in a typed client. Reading only the wire spelling
    # accused a library of not carrying a field it carries in full, which is the
    # worst kind of wrong: it reads as news.
    plain = name.replace("-", "_")
    camel = re.sub(r"[-_](\w)", lambda m: m.group(1).upper(), name)
    return {name, plain, snake_of(plain), camel}
















CARRIER_KINDS = (".py", ".ts", ".js", ".rs", ".go", ".rb", ".java", ".kt")


def read_carrier(root):
    # what a client library names, and — said out loud — WHERE THIS LOOKED. A
    # hash certifies that bytes exist; nothing certifies that they do not, so
    # `the library never names it` is a fact about a WALK, and a walk without its
    # bounds is unfalsifiable in form and refutable in substance: point at one
    # excluded file and the claim is gone. So the bounds travel with every
    # absence this reader reports.
    text, files = [], 0
    for dirpath, dirs, names in os.walk(root):
        dirs[:] = [d for d in dirs
                   if d not in (".git", "node_modules", "target", "dist", "build", ".venv", "proto")
                   and "test" not in d.lower() and "example" not in d.lower()]
        for f in names:
            if os.path.splitext(f)[1] not in CARRIER_KINDS:
                continue
            if "test" in f.lower() or "example" in f.lower():
                continue
            # a protobuf stub is not this library's word about a REST request.
            # Weaviate vendors several versioned copies of one, and in them
            # `creation_time_unix: bool` is a flag asking gRPC to include a
            # timestamp — read as the timestamp itself it accused the client of
            # carrying a number as a boolean, thirty-two times.
            if "_pb2" in f or f.endswith("_pb.js") or f.endswith("_pb.ts"):
                continue
            try:
                text.append(open(os.path.join(dirpath, f), encoding="utf-8", errors="replace").read())
            except OSError:
                continue
            files += 1
    return "\n".join(text), {
        "files": files, "root": os.path.abspath(root),
        "kinds": " ".join(CARRIER_KINDS),
        "skipped": "directories named test/example, and .git node_modules target dist build .venv proto, "
                   "files named test/example, protobuf stubs (_pb2, _pb.js, _pb.ts)",
    }



REFS_HEADER = """// printed by gate import refs: the citations this code makes to a tracker,
// written in the reference vocabulary (`gate stdlib show forms-reference`). A
// tracked thing carries its state on an axis, a site is a place in your own
// file, and a citation holds only while the thing it cites is open.
//
"""


def read_tracker(path):
    # a tracker export, in the shape every tracker can produce: a list of
    # {key, status}. What counts as open is the tracker's word, not ours —
    # anything it does not call done or closed is still open.
    raw = theirs_json(path, "a tracker export: a list of {key, status}")
    items = raw.get("issues", raw) if isinstance(raw, dict) else raw
    out = {}
    for it in items:
        key = str(it.get("key") or it.get("id") or "").strip()
        if not key:
            continue
        st = str(it.get("status") or it.get("state") or "").strip().lower()
        out[key] = "Closed" if st in ("done", "closed", "resolved", "completed") else "Open"
    return out


def read_citations(root):
    # every place the code names a ticket: TODO(KEY), FIXME(KEY), or a bare
    # mention in a comment. The address is the reader's own file and line.
    hits = []
    pat = re.compile(r"\b(?:TODO|FIXME|HACK|XXX)\s*[(\[:]?\s*([A-Z][A-Z0-9]+-\d+)")
    for dirpath, dirs, files in os.walk(root):
        dirs[:] = [d for d in dirs if d not in (".git", "node_modules", "__pycache__", ".venv")]
        for f in files:
            if os.path.splitext(f)[1] not in (".py", ".ts", ".js", ".rs", ".go", ".rb", ".java", ".swift", ".md"):
                continue
            p = os.path.join(dirpath, f)
            try:
                text = open(p, encoding="utf-8", errors="replace").read()
            except OSError:
                continue
            for n, line in enumerate(text.split("\n"), 1):
                for m in pat.finditer(line):
                    hits.append({"file": os.path.relpath(p, root), "line": n, "key": m.group(1)})
    return hits


def cmd_import_refs(a):
    # import refs <tracker.json> --code DIR [-o refs-gate.swift] — what the code
    # says is still open, against what the tracker says. Neither system reads the
    # other, so the two copies drift; here they are one world, and a citation of
    # something closed is refused at the line of your own file.
    src = a[0]
    code = a[a.index("--code") + 1] if "--code" in a else "."
    # the world this prints is a CHECK, not a file to keep: dropped into a repo
    # that declares its layout it would read as a shadow — a world file the
    # manifest never names — and `status` would refuse it, which is a red the
    # reader did not earn. So without -o it is written where nothing keeps it,
    # judged, and removed. Ask for it by name and it stays.
    keep = "-o" in a
    out_path = (a[a.index("-o") + 1] if keep
                else os.path.join(scratch("gate-refs-"), "refs-gate.swift"))
    tracked = read_tracker(src)
    cites = read_citations(code)
    lines = [REFS_HEADER + STDLIB["forms-reference"], ""]
    for key in sorted({c["key"] for c in cites} | set(tracked)):
        state = tracked.get(key)
        if state is None:
            continue                      # cited but the tracker has never heard of it
        lines.append(f"public enum {sanitize(key)}: Tracked {{")
        lines.append(f"    public typealias State = {state}")
        lines.append("}")
    srcmap, seen = {}, set()
    for i, c in enumerate(cites):
        site = f"At_{sanitize(c['file'])}_L{c['line']}"
        if site in seen:
            continue
        seen.add(site)
        lines.append(f"public enum {site}: Site {{}}")
        cert = f"Cite_{i}"
        lines.append(f"public typealias {cert} = Cites<{site}, {sanitize(c['key'])}>")
        srcmap[cert] = {"address": f"{c['file']}:{c['line']}", "key": c["key"]}
    world = "\n".join(lines) + "\n"
    with open(out_path, "w") as f:
        f.write(world)
    t0 = time.time()
    outp = judge_call(["judge", "where", out_path]).stdout
    ms = round((time.time() - t0) * 1000, 1)
    refusals = []
    for m in re.finditer(r"^✗ '(\w+)[^']*' requires the types '[^']*' \(aka '([^']+)'\)", outp, re.M):
        cert, found = m.group(1), m.group(2)
        if cert not in srcmap:
            continue
        where = srcmap[cert]
        claim = (f"the code cites {where['key']}, and the tracker has no such thing"
                 if found.endswith(".State")
                 else f"the code cites {where['key']} as live work, and the tracker calls it {found.lower()}")
        refusals.append({"address": where["address"], "claim": claim})
    if not keep:
        shutil.rmtree(os.path.dirname(out_path), ignore_errors=True)
    return {"command": "import refs", "wrote": out_path if keep else None, "tracked": len(tracked),
            "citations": len(cites), "ms": ms,
            "verdict": "refused" if refusals else "holds", "refusals": refusals,
            "next": ("open the address above: the citation outlived the thing it cites"
                     if refusals else "wire it into CI: a citation cannot outlive its ticket again"),
            "mutates": True}


CODEOWNERS_HEADER = """// printed by gate import codeowners: who owns what in this repository,
// written in the grants vocabulary (`gate stdlib show forms-grants`). A zone is
// a top of the tree, a room is a pattern, and an owner keeps a zone: owning
// is entry whose key administers, judged like any other claim.
//
"""


def codeowners_zone(pattern):
    # the zone a pattern belongs to: its first real segment, or the root
    p = pattern.strip().lstrip("/")
    if not p or p.startswith("*"):
        return "Root"
    return sanitize(p.split("/")[0]) or "Root"


def theirs_json(path, what):
    # ── AND A FILE OF THE WRONG KIND IS SAID, NOT RAISED. Every verb here that
    # reads somebody's JSON handed it straight to the parser, so a text file, a
    # YAML, or a spec saved half-written met a person with a JSONDecodeError and
    # a stack trace: six verbs did it, and `drift` alone answered in words. The
    # law is the one this tool repeats everywhere: a verb meets a person with a
    # sentence. The parser's own line and column travel in it, because that is
    # the address of the thing that is wrong.
    import json as _json
    try:
        return _json.load(theirs_text(path, what))
    except _json.JSONDecodeError as e:
        cannot(f"{path} is not the JSON this reads ({what}): {e.msg} at line {e.lineno}, "
               f"column {e.colno}",
               "point it at the document itself. For YAML, `yq -o=json '.' file.yml > file.json` "
               "writes the JSON this reads")
    except OSError:
        cannot(f"no such file: {path}", f"point it at {what}")


def theirs_text(path, what="the file you mean"):
    # ── SOMEBODY ELSE'S FILE, READ THE WAY THEY SAVED IT. A CODEOWNERS, a CSV or
    # a spec written by a Windows editor begins with a byte-order mark, and
    # python's default read hands it to the first line: the first CODEOWNERS
    # pattern then carried it, its zone parsed as empty, and gate REFUSED A RULE
    # THAT WAS RIGHT (`Zone_src against Zone__`). The policy CSV and the contract
    # JSON did not survive it at all: both raised. Every file that came from
    # outside is read through here, and `utf-8-sig` is plain utf-8 when there is
    # no mark to drop.
    # ── AND A FILE THAT IS NOT THERE IS SAID HERE TOO. `attention` opened both
    # sides of a seam straight from argv and met a mistyped path with a
    # FileNotFoundError: the same shape `theirs_json` was written against, one
    # door further out. Every reading of somebody else's text comes through
    # here, so the sentence is written once.
    try:
        return open(path, encoding="utf-8-sig")
    except OSError:
        cannot(f"no such file: {path}", f"point it at {what}")


def read_codeowners(path):
    # every rule, with the line it stands on: an address in THEIR file
    rules = []
    for n, raw in enumerate(theirs_text(path), 1):
        line = raw.split("#")[0].strip()
        if not line:
            continue
        # ── AND A SPACE IN A PATH IS ESCAPED, WHICH THIS SPLIT DID NOT KNOW.
        # A CODEOWNERS pattern escapes a space as `\ `, which is the documented
        # way to own a folder whose name has one. Splitting on whitespace read
        # `/src/my\ code/ @alice` as the pattern `/src/my\` and the owner
        # `code/`, so the pattern matched nothing and gate REFUSED A RULE THAT
        # MATCHES A REAL DIRECTORY: a false refusal, at the one place this whole
        # tool sells, in somebody else's file. The escape is honoured first, and
        # the split happens on the spaces that are not escaped.
        parts = [p.replace("\x00", " ") for p in
                 line.replace("\\ ", "\x00").split()]
        owners = [p for p in parts[1:] if p.startswith("@") or "@" in p]
        if owners:
            rules.append({"line": n, "pattern": parts[0], "owners": owners})
    return rules


def read_owners_policy(path):
    # WHO MAY OWN WHAT is the thing CODEOWNERS cannot say: without it, every
    # rule is its own authority and the gate has nothing to hold. A policy,
    # owner and zone, makes each rule a claim against a stated zone, and a
    # rule reaching outside it is refused by the line it sits on.
    import csv as _csv
    policy = {}
    for row in _csv.DictReader(theirs_text(path)):
        policy.setdefault(row["owner"].lstrip("@"), row["zone"])
    return policy


def ghost_patterns(rules, paths, said_name):
    # ONE READER FOR THE HALF THE COURT CANNOT SEE. A pattern that matches no
    # file is a divergence of the pair with no claim to refuse: the world holds,
    # and the rule addresses nothing. The import walks a working tree for its
    # paths and the history walk asks git for a commit's paths, so the matching
    # itself lives here once and both callers ask it the same question.
    import fnmatch
    out = []
    for r in rules:
        pat = r["pattern"].strip("/")
        hit = any(fnmatch.fnmatch(p, pat) or fnmatch.fnmatch(p, pat + "/*")
                  or p.startswith(pat + "/") or fnmatch.fnmatch(os.path.basename(p), pat)
                  for p in paths)
        if not hit:
            out.append({"address": f"{said_name}:{r['line']}",
                        "claim": f"CODEOWNERS names `{r['pattern']}`, and no file in "
                                 "the tree matches it: the rule matches nothing"})
    return out


def codeowners_world_lines(src, policy, said_from):
    # ONE TRANSLATOR, WHOEVER ASKS. The import prints a world with this, and
    # the pair guard prints the same world again to compare: two calls of one
    # function cannot disagree about what the translation is. The world names
    # its own inputs on the `from:` line, so the pair is declared where the
    # translation lands, never guessed from what is lying nearby.
    rules = read_codeowners(src)
    zones = sorted({codeowners_zone(r["pattern"]) for r in rules})
    lines = [CODEOWNERS_HEADER + "// from: " + said_from + "\n//\n"
             + STDLIB["forms-grants"], ""]
    for z in sorted(set(zones) | {sanitize(v) for v in policy.values()}):
        lines.append(f"public enum Zone_{z}: Realm {{}}")
    lines.append("")
    keepers, srcmap = {}, {}
    for i, r in enumerate(rules):
        zone = codeowners_zone(r["pattern"])
        room = f"Path_{i}_{sanitize(r['pattern'])[:40]}"
        lines.append(f"public enum {room}: Room {{")
        lines.append(f"    public typealias Place = Zone_{zone}")
        lines.append("}")
        for owner in r["owners"]:
            plain = owner.lstrip("@")
            kept = policy.get(plain)          # the zone this owner may keep
            keeper = (f"Owner_{sanitize(plain)}" if kept
                      else f"Owner_{sanitize(plain)}_in_{zone}")
            if keeper not in keepers:
                keepers[keeper] = (owner, kept or zone)
                lines.append(f"public enum {keeper}: Keeper {{")
                lines.append(f"    public typealias Post = Zone_{sanitize(kept) if kept else zone}")
                lines.append("    public typealias Key = WardenKey")
                lines.append("}")
            cert = f"Owns_{i}_{sanitize(owner.lstrip('@'))}"
            lines.append(f"public typealias {cert} = Owns<{keeper}, {room}>")
            srcmap[cert] = f"{os.path.basename(src)}:{r['line']} · {r['pattern']} {owner}"
    return rules, lines, srcmap, keepers


def cmd_import_codeowners(a):
    # import codeowners CODEOWNERS [--tree DIR] [-o out.swift] — a repository's
    # own ownership, as a judged world. What CODEOWNERS cannot say, this can:
    # an owner nobody declares is refused, and a pattern matching no file in
    # the tree is named by the line it sits on.
    # ── AND NOTHING LANDS IN SOMEBODY'S REPOSITORY UNASKED. This defaulted to
    # `codeowners-gate.swift` and dropped that file into the working copy of
    # anybody who ran the verb, while the road beside it promises, in so many
    # words, that unless you ask for it by name with `-o` your repository is
    # left as it was. `report` and `badge` keep that promise; this one did not,
    # and it is the verb the cover invites a stranger to run in a repository
    # they already have. Found by walking the pilot letter's own reproduce line
    # on a fresh clone of somebody else's repository, where it left an untracked
    # file behind under a letter promising read-only.
    #
    # The file is still written, because the court reads a path: it goes to the
    # scratch the verb sweeps, and the answer says where the world would land.
    # ── AND THE VERB THE COVER SELLS FINDS THE FILE IT IS NAMED AFTER. `gate
    # import codeowners`, typed bare, read argv[0] of an empty argv and met a
    # person with an IndexError: the same shape `check` was mended of, in the
    # verb a stranger is invited to run in a repository they already have. The
    # pair lives in three known places, so the verb looks there before it asks.
    src = a[0] if a and not a[0].startswith("-") else next(
        (p for p in CODEOWNERS_PLACES if os.path.exists(p)), None)
    if src is None:
        cannot("this reads a CODEOWNERS, and there is none at " +
               ", ".join(CODEOWNERS_PLACES),
               "name the file: `gate import codeowners PATH`, or run `gate demo` for a "
               "repository that has one")
    asked = a[a.index("-o") + 1] if "-o" in a else None
    kept = scratch("gate-codeowners-") if asked is None else None
    out_path = asked or os.path.join(kept, "codeowners-gate.swift")
    tree = a[a.index("--tree") + 1] if "--tree" in a else None
    policy_path = a[a.index("--policy") + 1] if "--policy" in a else None
    policy = read_owners_policy(policy_path) if policy_path else {}
    said_from = src + (f" --policy {policy_path}" if policy_path else "")
    rules, lines, srcmap, keepers = codeowners_world_lines(src, policy, said_from)
    world = "\n".join(lines) + "\n"
    with open(out_path, "w") as f:
        f.write(world)
    t0 = time.time()
    outp = judge_call(["judge", "where", out_path]).stdout
    ms = round((time.time() - t0) * 1000, 1)
    # ── ONE FACT, ONE SENTENCE. This carried its own wording of the law while
    # `gate status` printed the judge's raw line about the very same refusal, so
    # a person met the readable half first and the unreadable half in the verb
    # they would use every day. The words belong to the law, in the file the law
    # is written in; both surfaces read them from there. For a while this line
    # also mixed the shipped grants shelf into the notes, words no row of the
    # world had taken — and the comment above it said otherwise. A world that
    # did not copy the law's words has none, and the sentence honestly stops
    # at the two sides.
    notes = law_notes(world)
    refusals = []
    for cert, claim in where_refused(outp):
        if cert and cert in srcmap:
            refusals.append({"certificate": cert, "source": srcmap[cert],
                             "claim": plainly(claim, notes)})
    # a pattern matching no file in the tree: CODEOWNERS says it, the tree does not
    ghosts = []
    if tree:
        paths = []
        for root, dirs, files in os.walk(tree):
            dirs[:] = [d for d in dirs if d != ".git"]
            for f in files:
                paths.append(os.path.relpath(os.path.join(root, f), tree))
        # ── AND THE ADDRESS NAMES THE FILE THAT MAKES THE CLAIM. This passed the
        # BASENAME, so a repository keeping its rules at `.github/CODEOWNERS`
        # (six of the fifteen public ones read for the pilot) was handed
        # `CODEOWNERS:7`, an address with no file behind it: an editor's problem
        # matcher opens nothing, and a person pasting it into the bench asks for
        # a file that is not there. Inside the walked tree the address is
        # relative to it, which is how the reader's own editor opens it; a rules
        # file from outside that tree is addressed by the path the caller gave,
        # because that is the one they can open.
        rel = os.path.relpath(os.path.abspath(src), os.path.abspath(tree))
        ghosts = ghost_patterns(rules, paths, src if rel.startswith("..") else rel)
    return {
        "command": "import codeowners",
        "world": asked,
        "wrote": asked,
        "zones": len({codeowners_zone(r["pattern"]) for r in rules}),
        "paths": len(rules),
        "owners": len(keepers),
        "policy": (f"{len(policy)} owners have a stated zone" if policy else None),
        # ── A GREEN NOBODY COULD HAVE BROKEN IS NOT A GREEN. Without a policy
        # every rule is its own authority: the zone equalities cannot fail, so
        # `holds` would be the verdict of a court that never sat — and the note
        # under it said as much while the word above it said the opposite. This
        # is the README's own first line, so the very first thing a person ran
        # printed a verdict the tool itself calls trivial. `observed` is the word
        # already used where nothing is judged (`log`, `drift`); a ghost path is
        # read from the tree either way, so a run with no policy can still refuse.
        "verdict": ("refused" if (refusals or ghosts)
                    else "holds" if policy else "observed"),
        "refusals": refusals + ghosts,
        "judge_ms": ms,
        "canon_handshake": "canon v2" in outp,
        # ── AND BOTH HALVES ARE HELD NOW, SAID WHERE THE WORLD IS PRINTED.
        # This note said the key's class is not judged on this road, and the
        # battery held that sentence to a run so it would go red the day a
        # court arrived, instead of standing as a true sentence about a road
        # that moved. The court arrived: the membership walk at the judge's
        # pin resolves the axis through the world's own tables and climbs
        # the ladder the world presents, so the sentence moves with it.
        "note": ("ownership is the warden's threshold and this run holds both halves of "
                 "it: the zone equalities against one canon, and the key's class through "
                 "the ladder this world presents (docs/DETAILS.md, "
                 "what this road does not judge)"
                 if policy else
                 "no ownership policy given (--policy owner,zone): every rule is its own "
                 "authority, so the equalities hold trivially. The unmatched patterns above "
                 "are read from the tree, not judged."),
        # ── AND THE STEP IS TRUE OF THE REPOSITORY IT IS SAID IN. "commit it:
        # from here on it is judged" was said to everybody, and in a world that
        # declares a layout the file is judged by NOTHING until the manifest has
        # a row for it: walking the cover's own recipe in a fresh clone of this
        # repository, the very next command refused the file it had just been
        # told to commit. An offer is a statement about the law, and this one
        # was a statement about a different world's law.
        "next": ("nothing was written: this read your CODEOWNERS and your tree and left "
                 "both as they were. Add `-o ownership.swift` to keep the world it printed"
                 if not asked else
                 f"declare it: `gate mine {asked} --role forms` adds the row the layout "
                 "in gate.manifest.swift asks for, and then commit. Until it has one, "
                 "status names it as a file standing beside the judged ones"
                 if MANIFEST and asked not in
                 [r["path"] for r in ((MANIFEST.get("rows") if MANIFEST else None) or [])]
                 else "commit it: from here on it is what you have said, and it is judged"),
    }


def repo_findings(n=400):
    # What is true of THIS repository, said in sentences a person can act on.
    # This is the one producer behind `gate findings`, the survey, the audit
    # page and the text of an issue: read the clone, name what is worth
    # naming, and mark plainly which of it the judge checked and which was
    # only read. Nothing here needs a translated world — a repository that
    # has never heard of gate still has findings.
    out = []
    # ── AND THIS ONE READS THE REPOSITORY, WHICH IS WHAT IT SAYS IT DOES. It took
    # the journal's default scope, which is the history OF THE WORLD FILES — right
    # for a workbench, wrong for the one verb whose whole claim is that a repository
    # which has never heard of gate still has findings. At entry it was silent for
    # the worst possible reason: the files that had just arrived were untracked, so
    # no commit touched the world, so there was no history, so there was nothing to
    # say — about a repository with four hundred commits and a CODEOWNERS sitting in
    # it. The comment above this line had said «needs no translated world» all
    # along, and the code asked for one.
    j = repo_journal(n, scope="all")
    commits = j["commits"]
    base = os.path.dirname(os.path.abspath(FACTS)) if FACTS else "."

    if not commits:
        return out
    authors = {}
    for c in commits:
        authors.setdefault(c["email"], []).append(c)

    # what the world says, if there is one: refusals are findings of the first order.
    # ── AND A WORLD OF FORMS IS STILL A WORLD, WHICH THIS ASKED WRONG. It asked
    # whether the FACTS file was on disk, and a world whose rows are all forms has
    # none: the first scene this tool ships, whose whole point is one live refusal
    # at its own line, answered `gate findings` with unnamed authors and an offer
    # and never mentioned the refusal. `status` learned this and wrote the sentence
    # down twenty lines from here; it had not travelled.
    if world_files() or (MANIFEST and MANIFEST.get("rows")):
        r = dispatch("status", [])
        for ref in r.get("refusals", []):
            out.append({"kind": "judged", "subject": ref["address"],
                        "sentence": f"{ref['address']} — {ref['claim']}",
                        "evidence": "the judge, on this working copy"})

    # who touches the facts, and whether anything checked those edits
    world = set(j.get("world_files") or [])
    if world:
        touchers = {c["email"] for c in commits if c["touches_world"]}
        edits = sum(1 for c in commits if c["touches_world"])
        ci = os.path.isdir(os.path.join(base, ".github", "workflows"))
        hooked = subprocess.run(["git", "config", "--get", "core.hooksPath"], cwd=base,
                                capture_output=True, text=True).stdout.strip()
        if edits and not (ci or hooked):
            out.append({"kind": "observed", "subject": "unchecked edits",
                        "sentence": f"{len(touchers)} people changed these facts across "
                                    f"{edits} commits, and nothing checked those edits: "
                                    "there is no hook and no workflow in this repository.",
                        "evidence": f"git log over {', '.join(sorted(world))}"})
        unnamed = sorted({c["email"] for c in commits if c["touches_world"] and not c["person"]})
        if unnamed:
            out.append({"kind": "observed", "subject": "unnamed authors",
                        "sentence": f"{len(unnamed)} of the people who changed these facts "
                                    f"{'is' if len(unnamed) == 1 else 'are'} not tied to anyone "
                                    "in the world: an email is not a person until something "
                                    "says it is.",
                        "evidence": ", ".join(unnamed[:4])})

    # ownership, if this repository states any: a stale owner is worth a sentence
    for cand in [os.path.join(base, p) for p in CODEOWNERS_PLACES]:
        if os.path.exists(cand):
            rules = read_codeowners(cand)
            owners = {o.lstrip("@") for r_ in rules for o in r_["owners"]}
            seen = {c["email"].split("@")[0] for c in commits} | {
                (c["person"] or "").lower() for c in commits}
            quiet = sorted(o for o in owners if "/" not in o and o.lower() not in seen)
            # a history too short to be evidence proves nothing about anyone
            if quiet and len(commits) >= 50:
                out.append({"kind": "observed", "subject": "quiet owners",
                            "sentence": f"{len(quiet)} of the {len(owners)} owners named in "
                                        f"CODEOWNERS have not appeared in the last "
                                        f"{len(commits)} commits: ownership outlives people, "
                                        "and nothing here notices.",
                            "evidence": ", ".join("@" + q for q in quiet[:4])})
            them = "it" if len(rules) == 1 else "them"
            out.append({"kind": "offer", "subject": "CODEOWNERS",
                        # a count reads as a count: one rule is not «1 rules», and this
                        # sentence is the first thing the letter sends anybody to
                        "sentence": f"CODEOWNERS states {len(rules)} "
                                    + ("rule" if len(rules) == 1 else "rules")
                                    + f" over {len(owners)} "
                                    + ("owner" if len(owners) == 1 else "owners")
                                    + f", and nothing checks {them}. "
                                    + f"`gate import codeowners` reads {them} as a world: a path "
                                      "no file matches, or an owner outside their zone, is "
                                      "named by the line it sits on.",
                        "evidence": os.path.relpath(cand, base)})
            break

    # the shape of the work, from the history itself
    top = sorted(authors.items(), key=lambda kv: -len(kv[1]))[:1]
    if top and len(commits) >= 20:
        who, cs = top[0]
        share = round(100 * len(cs) / len(commits))
        if share >= 50:
            out.append({"kind": "observed", "subject": "concentration",
                        "sentence": f"{share}% of the last {len(commits)} commits are one "
                                    f"person's ({who}): what they know is not written down "
                                    "anywhere this repository can check.",
                        "evidence": f"{len(cs)} of {len(commits)} commits"})
    return out


# ── WHERE A REPOSITORY KEEPS THIS PAIR, WRITTEN DOWN ONCE. Three places, in the
# order git itself reads them. Two verbs looked for the same file and only one of
# them knew all three: `findings` named `.github/CODEOWNERS` in apache/superset
# and offered the pair, and `findings --history` answered "0 commits carry the
# pair" about the same repository in the same second, over 14829 commits that
# carry it. Measured across twenty public repositories: of the fifteen that keep
# a CODEOWNERS, six keep it under `.github`, so two pairs in five were invisible
# to the curve. The same shape as every entry defect this month: a question asked
# about a NAME rather than about the repository.
CODEOWNERS_PLACES = ("CODEOWNERS", ".github/CODEOWNERS", "docs/CODEOWNERS")


def history_divergence(n=200, owners=None, policy_name=None):
    # ── THE PAIR'S IMAGE, COMMIT BY COMMIT. `findings` says what is true of a
    # repository now; this says what has been true of one pair over its history.
    # At each commit the two sides are read out of git (the rules file, and the
    # tree the rules address), translated by the ONE translator the import verb
    # uses, and the image's divergences counted: claims the court refuses, plus
    # rules that address nothing. Nothing is checked out and nothing is written
    # into the repository: a commit's text is read from the object store into a
    # scratch directory that goes when the walk does.
    #
    # WHAT THIS COUNTS, said here because the number is easy to over-read: the
    # divergences of the pair's JUDGED IMAGE under the declared translation, not
    # the distance between the two records. A divergence of the image is a
    # divergence of the pair; the reverse is not claimed.
    base = os.path.dirname(os.path.abspath(FACTS)) if FACTS else os.getcwd()

    def git(*args):
        return subprocess.run(["git", *args], cwd=base, capture_output=True, text=True)

    # ── AND THE WALK IS THE MAIN LINE, WHICH IS THE ONLY ONE THAT IS A TIME.
    # Plain `git log --reverse` walks the whole graph, so on a repository that
    # merges, adjacent rows sit on different branches and the same weeks are read
    # several times over. Measured on crossplane/crossplane: of 3000 rows, 206
    # step BACKWARDS in time, and the curve they draw swings 2, 0, 2, 3, 1, 3
    # while nothing about the pair changed. `--date-order` does not mend it (213
    # backwards); `--first-parent` reads 5. It is also the right sequence to
    # claim: the first-parent line is the states this repository actually stood
    # in, one after another, which is what a curve over its history means.
    log = git("log", f"-{n}", "--format=%H%x1f%aI", "--reverse",
              "--first-parent").stdout.strip()
    if not log:
        return [], True
    # ── AND THE WALK KNOWS WHETHER IT REACHED THE START. git was asked for n
    # commits and answered with fewer, so there is no older one: that fact is
    # the whole difference between "parted before this reading" and "never
    # agreed", and it costs nothing to carry out of here.
    # ── AND A LINE CUT BY A CLONE IS NOT A LINE THAT ENDED. `--depth 3` gives
    # git three commits and no older ones to give, so "asked for n, got fewer"
    # reads as "this is the start" and the walk would say the two records have
    # never agreed about a repository whose first commit agreed. git says which
    # it is, so the walk asks instead of assuming.
    whole = (len(log.split("\n")) < n
             and git("rev-parse", "--is-shallow-repository").stdout.strip() != "true")
    rows, tmp = [], scratch("gate-history-")
    # AND THE PAIR IS LOOKED FOR AT EVERY COMMIT, not once at the tip. A file
    # moves: a CODEOWNERS written at the root and later filed under `.github` is
    # the same pair, and a walk that asks one path draws the history of a name
    # instead. The place that answered last is tried first, so the usual walk
    # costs one `git show` a commit and a move costs two.
    places = [owners] if owners else list(CODEOWNERS_PLACES)
    try:
        for line in log.split("\n"):
            sha, when = (line.split("\x1f") + ["", ""])[:2]
            for i, place in enumerate(places):
                said = git("show", f"{sha}:{place}")
                if not said.returncode:
                    if i:
                        places.insert(0, places.pop(i))
                    break
            if said.returncode:
                continue                    # the pair does not exist at this commit
            paths = [p for p in git("ls-tree", "-r", "--name-only", sha).stdout.split("\n") if p]
            pol = {}
            if policy_name:
                pt = git("show", f"{sha}:{policy_name}")
                if not pt.returncode:
                    pp = os.path.join(tmp, "policy.csv")
                    open(pp, "w").write(pt.stdout)
                    pol = read_owners_policy(pp)
            here = places[0]
            cp = os.path.join(tmp, os.path.basename(here))
            open(cp, "w").write(said.stdout)
            rules, lines, srcmap, _ = codeowners_world_lines(cp, pol, here)
            wp = os.path.join(tmp, "world.swift")
            open(wp, "w").write("\n".join(lines) + "\n")
            out = judge_call(["judge", "where", wp]).stdout
            # and the court answered in its own voice, or this row is not a
            # reading at all: a silence parses as nought refusals, which would
            # draw a flat curve over a court that never sat
            spoke = ("THE WHERE" in out and "canon v" in out) or "✗" in out
            refused = [c for cert, c in where_refused(out) if cert in srcmap]
            ghosts = ghost_patterns(rules, paths, os.path.basename(here))
            rows.append({"at": sha[:8], "when": when[:10], "rules": len(rules), "file": here,
                         "refusals": len(refused) if spoke else None,
                         "unmatched": len(ghosts),
                         "divergences": (len(refused) + len(ghosts)) if spoke else None,
                         "judged": bool(pol),
                         "read": spoke})
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    return rows, whole


def cmd_findings(a):
    # findings [--md] [--history] [N] — what is true of this repository, in
    # sentences; with --history, what has been true of one pair over its commits.
    nums = [x for x in a if x.isdigit()]
    if "--history" in a:
        pol = os.path.basename(a[a.index("--policy") + 1]) if "--policy" in a else None
        # ── AND A DIRECTORY THAT IS NOT A REPOSITORY IS TOLD SO. This verb read
        # nought commits there and answered "0 commits carry the pair, read from
        # git" beside no git at all: a true-sounding sentence about a thing that
        # is not there. A repository with no commits yet is a different answer,
        # and gets the honest nought.
        _base = os.path.dirname(os.path.abspath(FACTS)) if FACTS else os.getcwd()
        if subprocess.run(["git", "rev-parse", "--git-dir"], cwd=_base,
                          capture_output=True, text=True).returncode:
            cannot("this walks a repository's commits, and this directory is not one",
                   "run it inside a git repository, or ask `gate findings` for what is "
                   "true here now")
        rows, whole = history_divergence(int(nums[0]) if nums else 200, policy_name=pol)
        # ── AND WHAT A FALL IS, SAID WHERE ONE IS VISIBLE. A curve that drops
        # reads like a thing that was fixed and stays fixed, and it is not: with
        # no court in the repository, a drop is somebody who compared the two
        # records by hand. That comparison is recorded nowhere, so nothing
        # carries it, and the level comes back. Read on seven public
        # repositories: istio cleaned 13 to 11 to 9 and stands at nine, not at
        # nought, and loki went 0 to 1 to 0 with nothing recorded either way.
        # The sentence is printed only where a fall is in the window, because a
        # curve nobody has seen fall does not need it.
        fell = any(a["divergences"] is not None and b["divergences"] is not None
                   and b["divergences"] < a["divergences"]
                   for a, b in zip(rows, rows[1:]))
        # ── AND THE WALK IS FOLDED INTO ONE SENTENCE. Two hundred rows are the
        # evidence, not the finding: a person reading this wants when it parted,
        # how long ago, and how much has gone past since. Measured on myself:
        # cutting the pilot letter meant writing two scripts to fold these rows
        # by hand, which is the tool asking its reader to finish it.
        #
        # EVERY NUMBER HERE IS GIT'S OWN, and the bounds are said with them. The
        # count is of commits ON THE WALKED LINE, which is the first-parent line
        # within the window this run read: not of pull requests, not of reviews,
        # and nothing about what any of them did. A claim about merges would be
        # a claim about somebody's forge, and this tool reads git.
        #
        # AND A PAIR THAT CAME BACK HAS NOT PARTED. The sentence is about a gap
        # that is open now, so it is written only when today's row is still
        # apart; a curve that rose and fell is a fixed thing, and saying "parted
        # 149 days ago" about it would be a false alarm carrying a true date.
        #
        # AND A PARTING OLDER THAN THE WINDOW IS STILL SAID, AS A BOUND. This
        # walk reads N commits, and on a repository that has been apart for
        # years there is no rise inside the window to point at: every row is
        # apart, including the oldest one read. Saying nothing there would keep
        # the sentence for toy histories and lose it on the repositories it was
        # written for. Read on seven public ones: six of the seven part before
        # the window opens. So the fold says how far back it looked, that it was
        # already apart there, and that the parting is older than its reading.
        # (named `x, y` and not `a, b`: `a` is this verb's argv, and a loop that
        # rebinds it leaves every flag read after this point reading a row of
        # the table instead. `--md` was taken and dropped that way for one
        # commit's worth of time)
        at = None
        for x, y in zip(rows, rows[1:]):
            if x["divergences"] == 0 and (y["divergences"] or 0) > 0:
                at = y
        # (a repository with no commits, and a directory that is no repository,
        # both walk nought rows: reading the last of them is how this verb
        # learned to raise instead of answer)
        parted, standing = None, rows[-1]["divergences"] if rows else None
        read = [r for r in rows if r["read"]]
        if standing and (at or (read and read[0]["divergences"])):
            from datetime import date as _d
            beyond = at is None
            mark = at or read[0]
            since = rows[len(rows) - 1 - rows[::-1].index(mark):]
            days = (_d.today() - _d.fromisoformat(mark["when"])).days
            # ── AND NEVER AGREED IS NOT THE SAME AS PARTED LONG AGO. If the walk
            # reached the start of this line, there is no older commit for the
            # parting to hide in, and the honest reading is that the two records
            # have not agreed since the pair was written. Guessing between the
            # two would be the tool inventing a past.
            parted = {
                "at": None if beyond else mark["at"], "when": mark["when"], "days": days,
                "commits_since": len(since) - 1, "standing": standing, "beyond": beyond,
                "never": beyond and whole,
                # and the number in "apart at every one of N" counts rows the
                # court actually spoke on: a commit whose reading is silent is
                # not a commit found apart, and rolling it into the claim would
                # be counting silence as evidence
                "said": (f"apart at every one of the {len([r for r in since if r['read']])} "
                         f"commits this run read, "
                         f"back to {mark['when']}, {days} days ago; " +
                         ("the two records have not agreed since the pair was written"
                          if whole else "it parted before this run's reading") +
                         f"; {standing} still apart today") if beyond else
                        (f"parted at {mark['at']} on {mark['when']}: {days} days and "
                         f"{len(since) - 1} commits carrying the pair ago; "
                         f"{standing} still apart today")}
        return {"command": "findings history", "history": rows, "parted": parted,
                # ── AND `--md` MEANS HERE WHAT IT MEANS EVERYWHERE ELSE. The
                # flag was taken and dropped on this route: accepted, and then
                # nothing. A flag that is quietly ignored is the tool lying
                # about itself in the cheapest possible way.
                "markdown": history_markdown(rows, parted) if "--md" in a else None,
                "shape": ("a fall here is somebody comparing the two records by hand. "
                          "That comparison is recorded nowhere, so nothing carries it "
                          "and the level comes back: with no court, nothing is obliged "
                          "to fall and nothing holds a fall either") if fell else None,
                # the sentence a number this shape has to arrive with
                "measure": "divergences of the pair's judged image at each commit: "
                           "claims the court refuses, plus rules that address nothing. "
                           "A divergence of the image is a divergence of the pair; the "
                           "distance between the two records is not measured here",
                "commits": len(rows),
                "next": ("run `gate import codeowners` to see one of these commits "
                         "translated in full" if rows else
                         "no commit in this history carries the file this reads"),
                "mutates": False}
    found = repo_findings(int(nums[0]) if nums else 400)
    return {"command": "findings", "findings": found,
            "next": "run `gate status`: what is judged answers in milliseconds, and this does not",
            "judged": sum(1 for f in found if f["kind"] == "judged"),
            "observed": sum(1 for f in found if f["kind"] != "judged"),
            "markdown": findings_markdown(found) if "--md" in a else None,
            "mutates": False}


def history_markdown(rows, parted):
    # the walk as a note somebody could paste into an issue: the sentence
    # first, and then the TURNING POINTS only. Pasting two hundred rows into a
    # thread is the same mistake the fold exists against, so what goes in is
    # where the count changed, with how many were read said next to it.
    if not rows:
        return "Nothing to report: no commit in this history carries the file this reads.\n"
    turns = [r for i, r in enumerate(rows)
             if i == 0 or r["divergences"] != rows[i - 1]["divergences"]]
    lines = [f"### The pair over {len(rows)} commits", ""]
    lines.append(parted["said"] if parted else
                 "the two records agree at this repository's tip.")
    lines += ["", f"| commit | date | divergences | rules |", "| --- | --- | --- | --- |"]
    for r in turns:
        n = "not read" if r["divergences"] is None else str(r["divergences"])
        lines.append(f"| `{r['at']}` | {r['when']} | {n} | {r['rules']} |")
    lines += ["", f"<sub>{len(turns)} row{'' if len(turns) == 1 else 's'} where the count "
                  f"changed, of {len(rows)} read. "
                  "Divergences of the pair's judged image: claims the court refuses, plus "
                  "rules that address nothing. Read it yourself with "
                  "`gate findings --history`.</sub>", ""]
    return "\n".join(lines)


def findings_markdown(found):
    # the same findings as a note somebody could read in an issue: what was
    # checked, what was only read, and how to see it for yourself.
    if not found:
        return "Nothing to report: this repository states no facts gate can read yet.\n"
    lines = ["### What this repository says about itself", ""]
    for f in found:
        mark = "**checked**" if f["kind"] == "judged" else ("**offer**" if f["kind"] == "offer" else "read")
        lines.append(f"- {f['sentence']}  \n  <sub>{mark} · {f['evidence']}</sub>")
    lines += ["", "Everything marked *read* comes from the git history and is not a verdict.",
              "To see it yourself: `gate findings` in a clone. Nothing leaves the machine.", ""]
    return "\n".join(lines)


def relearn_world(root):
    # ── AND A COMMAND THAT MAKES A WORLD KNOWS THE WORLD IT MADE. Discovery runs
    # once, when the process starts, so `init` ended by printing the rung for the
    # repository as it stood BEFORE it ran: it had just put a letter in somebody's
    # hands and told them to go declare a merge policy. The same law the panel
    # already keeps — the layout is read from disk, never remembered — said for a
    # command that writes one.
    m = read_manifest(root)
    globals()["MANIFEST"] = m
    w = os.path.join(root, "gate.swift")
    if os.path.exists(w) or m:
        globals()["FACTS"] = w


def cmd_init(a):
    # ── WITH NO PATH, "HERE" MEANS HERE WHEN HERE IS ALREADY A WORLD. The
    # default was a new folder called `world`, unconditionally — so `gate init
    # --vendor`, typed by somebody standing in the world they had just made,
    # built a SECOND world inside the first and vendored the tool into that.
    # The line printed said `created 8 files` and was true; the files a person
    # then looked for were one directory further down than they were looking.
    # A second world inside a world is the two-truths shape, in the filesystem.
    # ── AND A GIT REPOSITORY IS ALREADY THE PLACE. Without a world here the
    # default was a new folder called `world`, so entering somebody's repository
    # began by making a room inside it — the same nesting shape, one step earlier,
    # and against what this tool is: it deploys on top of git, and git is already
    # there. Where there is neither a world nor a `.git`, a folder is still the
    # kind thing to make: nobody is standing anywhere yet.
    vendor = "--vendor" in a
    a = [x for x in a if x != "--vendor"]
    here_is_world = os.path.exists("gate.swift") or os.path.exists("gate.manifest.swift")
    root = a[0] if a else ("." if here_is_world or os.path.isdir(".git") else "world")
    made = []
    for rel, content in INIT_FILES.items():
        p = os.path.join(root, rel)
        # ── AND A WORLD THAT CANNOT BE PUT THERE IS SAID, NOT RAISED. `gate init
        # /no/such/parent` met an OSError from makedirs: a read-only mount, a
        # path that does not exist, a directory somebody else owns. The founding
        # verb is the first one anybody runs, so it is the worst place to hand
        # over a stack trace.
        try:
            os.makedirs(os.path.dirname(p), exist_ok=True)
        except OSError as e:
            cannot(f"a world cannot be founded at {root}: {e.strerror.lower()}",
                   "name a directory you can write in, or `gate init .` to found one here")
        if not os.path.exists(p):
            with open(p, "w") as f:
                f.write(content)
            made.append(rel)
    hook = os.path.join(root, ".githooks", "pre-commit")
    if os.path.exists(hook):
        os.chmod(hook, 0o755)
    # ── AND THE LETTER ARRIVES BY THE VERB EVERYTHING ARRIVES BY. There is one act
    # of taking in this tool and entry is that act, performed once for somebody who
    # has not typed anything yet: the copy lands here with the revision it came
    # from written into its first line, declared in the same movement, judged from
    # that second. So the first screen is never empty and nothing on it appeared
    # without a row saying whose it is — which is the law the rest of the product
    # is built on, kept at the one moment it would have been easiest to break.
    letter = None
    layout_was = os.path.exists(os.path.join(root, "gate.manifest.swift"))
    # this world is founded HERE, so every row entry writes belongs to it and
    # not to a world overhead; the walk up is right for a file joining a world
    # that already stands, and wrong for the moment one is being founded
    global _FOUNDING
    _FOUNDING = os.path.abspath(root)
    # ── AND A PAGE THIS WORLD ALREADY DECLARES IS NOT TAKEN A SECOND TIME.
    # Taking asks whether the destination path is free, which is a question about
    # a filename rather than about the world: a repository that declares
    # `stdlib/readme.swift` had a second copy laid at its root, with a row of its
    # own, and the two rows collided on one name. Entering this tool's own
    # repository refused, at the front door, for that reason. What entry owes is
    # a world with the letter in it; a world that already declares the page has
    # one, wherever the page sits.
    declared_pages = set()
    _man = os.path.join(root, "gate.manifest.swift")
    if os.path.exists(_man):
        declared_pages = {os.path.basename(p) for p in
                          re.findall(r'typeName:\s*String\s*\{\s*"([^"]+)"\s*\}',
                                     open(_man, encoding="utf-8").read())}

    def already_declared(page):
        return page + ".swift" in declared_pages

    if "readme" in STDLIB and not already_declared("readme"):
        # ── AND THE LAYOUT IS ONE OF THE FILES THIS LEAVES. Taking a page declares
        # it, and declaring it writes the document that says so — a file appearing
        # in somebody's repository, counted by nobody: `created 3 files` while four
        # were there. What a tool writes in a repository that is not its own, it
        # names, and the count is part of the naming.
        took, _dest = take_shelf("readme", root)
        if took:
            letter = took["wrote"]
            made += [letter] + took["with"]
    # ── AND THE REFERENCE COMES AFTER THE LETTER, IN THAT ORDER. The letter names
    # it and stops there: it is the promises at that page's foot that make it safe
    # to run any of this on a clone somebody cares about, and a promise nobody can
    # check is worth nothing — held to the dispatch of the tool THIS repository has,
    # it is the one copy that could lie to them, so it travels. Taken first, it also
    # took the first row, and the bench opens on the first row: the newcomer met a
    # page of grammar instead of the letter written to them.
    if "verbs" in STDLIB and not already_declared("verbs"):
        took_ref, _rp = take_shelf("verbs", root)
        if took_ref:
            made += [took_ref["wrote"]] + took_ref["with"]
    if not layout_was and os.path.exists(os.path.join(root, "gate.manifest.swift")):
        made.append("gate.manifest.swift")
    relearn_world(root)
    vendored = cmd_vendor(root) if vendor else None
    hooks_note, undo, prior = None, None, None
    if os.path.isdir(os.path.join(root, ".git")):  # seamless: the hook wires itself
        prior = subprocess.run(["git", "config", "--local", "core.hooksPath"], cwd=root,
                               capture_output=True, text=True).stdout.strip() or None
        subprocess.run(["git", "config", "core.hooksPath", ".githooks"], cwd=root, capture_output=True)
        hooks_note = "pre-commit hook wired (core.hooksPath = .githooks)"
        # this is somebody else's repository: say what moved and how to put it back
        undo = (f"git config core.hooksPath {prior}" if prior
                else "git config --unset core.hooksPath")
        if prior:
            hooks_note += f". It was {prior}"
        # ── AND A HOOK THAT WILL NOT FIND THE TOOL SAYS SO NOW, NOT AT THE FIRST
        # COMMIT. The hook looks for `./gatew`, then `./gate`, then `gate` on
        # PATH, and refuses the commit loudly when it finds none, which is right:
        # a hook that cannot check must not wave a commit through. But somebody
        # who founded a world by running a checkout — `python3 ~/src/gate/gate
        # init .`, the way the cover itself shows a stranger — got that sentence
        # for the first time at their next commit, about a setting this verb had
        # just made. The three places are known here, so the answer names it.
        if not (os.access(os.path.join(root, "gatew"), os.X_OK)
                or os.access(os.path.join(root, "gate"), os.X_OK)
                or shutil.which("gate")):
            hooks_note += (". It will not find gate from here, and will refuse every commit "
                           "until it can: run `gate init . --vendor` to carry the tool in "
                           "this repository, or put gate on PATH")
    # ── AND THE ONE THING MISSING IS NAMED WITHOUT BEING GUESSED. The world that
    # arrives is ours; the only thing nobody has said yet is who is keeping it, and
    # this repository's own git already carries a name. So the name is OFFERED, as
    # a thing read and not a thing judged: writing it for them would be the tool
    # legislating on a guess, which is the failure it exists against, and silence
    # here is not a mistake but an open place with a known shape.
    observed = None
    signed = subprocess.run(["git", "config", "user.name"], cwd=root,
                            capture_output=True, text=True).stdout.strip() if hooks_note else ""
    if signed:
        observed = (f"read from git, and not judged: commits in this clone are signed {signed}. "
                    "If that is you, say so in my.swift. Nothing here writes your name for you")
    _FOUNDING = None      # the founding is over; a later row joins the world it is under
    return {"command": "init", "root": root, "created": made, "hooks": hooks_note,
            "readme": letter, "observed": observed, "next": next_rung(False),
            "undo_hooks": undo, "changed_git_config": bool(hooks_note), "vendored": vendored}


def world_rows(text):
    people = []
    for m in re.finditer(r"public enum (\w+): Employee, Person \{(.*?)\n\}", text, re.S):
        f = dict(re.findall(r"public typealias (\w+) = ([\w.]+)", m.group(2)))
        people.append({"id": m.group(1), **{k.lower(): v for k, v in f.items() if k != "Sex"}})
    grants = [{"who": w, "doc": d} for w, d in re.findall(r"VerifiedView<\s*(\w+),\s*(\w+)\s*>\.self;", text)]
    return people, grants


def cmd_report(a):
    # report [-o report.html] — the printable audit page: the world's tables
    # + the verdict. No server: one self-contained html, mailable to an audit.
    # ── AND NOTHING LANDS IN SOMEBODY'S REPOSITORY UNASKED. This defaulted to
    # `report.html` and dropped the file into the working copy of anybody who
    # typed the verb to see what it did — while the page beside it promised, in
    # so many words, that "unless you ask for it by name with `-o`, your
    # repository is left as it was". Found by holding the reference's own
    # `Asked` class to that sentence: five verbs kept it and this one did not.
    out_path = a[a.index("-o") + 1] if "-o" in a else None
    # a page is printed OUT OF a world, and this read FACTS without asking
    # whether there is one: in a repository with none it opened None and raised
    if not (FACTS and os.path.exists(FACTS)):
        cannot("report prints a world and its verdict as one page, and there is no "
               "world here",
               "run `gate init .` to start one, or `gate demo` for a repository to look "
               "at. `report -o audit.html` writes the page; without `-o` nothing is "
               "written")
    text = open(FACTS).read()
    people, grants = world_rows(text)
    r = judge(FACTS)
    bad_lines = {ref["claim"] for ref in r["refusals"]}

    def table(rows, cols):
        head = "".join(f"<th>{c}</th>" for c in cols)
        body = "".join(
            "<tr>" + "".join(f"<td>{row.get(c, '')}</td>" for c in cols) + "</tr>"
            for row in rows
        )
        return f"<table><tr>{head}</tr>{body}</table>"

    verdict_html = (
        "<p class='ok'>holds: every claim checked</p>"
        if r["verdict"] == "holds"
        else "<ul class='bad'>"
        + "".join(f"<li><code>{ref['address']}</code> · {ref['claim']}</li>" for ref in r["refusals"])
        + "</ul>"
    )
    # who may do what, and when that last changed: an audit asks for both, and
    # git already answers the second — the policy's own history, from the journal
    ids, rules, where = read_policy()
    policy_html = ""
    if ids or rules:
        rows = ([{"what": f"{action} requires", "who": rank} for action, rank in sorted(rules.items())]
                + [{"what": mail, "who": person} for mail, person in sorted(ids.items())])
        j = repo_journal(50)
        pf = os.path.basename(policy_path() or "")
        changes = [c for c in j["commits"] if pf and pf in c["files"]]
        hist = "".join(
            f"<li><code>{c['short']}</code> {c['when'][:10]} · {c['person'] or c['email']} · {c['subject']}</li>"
            for c in changes[:10])
        policy_html = ("<h2>Policy</h2>" + table(rows, ["what", "who"])
                       + ("<p>Last changed:</p><ul>" + hist + "</ul>" if hist
                          else "<p>Stated, and unchanged in the last 50 commits.</p>"))

    found = repo_findings(200)
    findings_html = ""
    if found:
        items = "".join(
            f"<li>{f['sentence']}<br><small>{'checked by the judge' if f['kind'] == 'judged' else 'read from git history, not a verdict'} · {f['evidence']}</small></li>"
            for f in found)
        findings_html = f"<h2>Findings</h2><ul class='findings'>{items}</ul>"

    html = f"""<!-- printed by gate report; the table is read from the world, never stored -->
<meta charset="utf-8"><title>gate report</title>
<style>
body{{font:14px/1.5 -apple-system,sans-serif;max-width:60em;margin:2em auto;padding:0 1em;color:#1d1d1f}}
table{{border-collapse:collapse;margin:1em 0}}td,th{{border:1px solid #d2d2d7;padding:.3em .8em;text-align:left}}
th{{background:#f5f5f7}}.ok{{color:#248a3d}}.bad li{{color:#c4453b;margin:.3em 0}}code{{background:#f5f5f7;padding:0 .3em}}
.findings li{{margin:.6em 0}}.findings small{{color:#8e8e93}}
</style>
<h1>gate report</h1>
<p>{len(people)} people · {len(grants)} grants · judged in {r['judge_ms']} ms</p>
<h2>Verdict</h2>{verdict_html}
<h2>People</h2>{table(people, ["id", "rank", "home", "site", "given", "family", "born"])}
<h2>Grants</h2>{table(grants, ["who", "doc"])}
{policy_html}
{findings_html}
"""
    if out_path:
        with open(out_path, "w") as f:
            f.write(html)
    return {"command": "report", "wrote": out_path, "people": len(people), "grants": len(grants),
            **{k: r[k] for k in ("verdict", "judge_ms")}, "refusals": r["refusals"],
            "note": (None if out_path else
                     "nothing written: name a file to keep this page. "
                     "`gate report -o report.html`"),
            "mutates": bool(out_path)}


def cmd_serve(a):
    # serve [port] [--no-open] — the bench, and the local JSON surface it reads.
    # THE CONTRACT (the bench depends on exactly this, and nothing else):
    #   GET  /  and /ui              the bench itself
    #   GET  /language               where the language is declared: the counting
    #                                forms the mechanism knows by right, the file
    #                                and line in the corpus, the revision, and the
    #                                command that brings it. With ?f=PATH it reads
    #                                that file out of GATE_CORPUS if this machine
    #                                has the checkout, and refuses any path that
    #                                climbs out of it. gate still fetches nothing.
    #   GET  /judge.js               the judge this page reads with, served whole
    #   GET  /codemirror.js  and /codemirror.css
    #                                the editor, vendored unmodified at the version
    #                                gate's own manifest carries it at
    #   GET  /ladder.css             the palette, the steps and the registers,
    #                                emitted from the worlds that declare them
    #   GET  /version                {gate: VERSION} — what is actually running,
    #                                since the page comes off the disk and the
    #                                answers come out of memory
    #   GET  /files                  {files: [name], personal: name|null}
    #   GET  /shelf                  {modules: [name]} — what the shelf carries
    #   GET  /shelf?m=name           the text of one shelf module, to read
    #   GET  /world?f=name           the text of one file from that list
    #   GET  /gitstatus?f=name       {git: committed|modified|untracked}
    #   GET  /log?n=&scope=          the journal (scope: world|all) — observed
    #   GET  /show?hash=&f=          one commit, read as the facts it changed
    #   GET  /status                 the verdict, as the CLI gives it
    #   GET  /attention              the seams this folder is party to: who owes
    #                                whom a word, read the same from either side
    #   GET  /seamside?f=name        one side of a seam, to read: every address
    #                                the bench prints must be reachable
    #   GET  /check/view?who=&doc=   a question, answered by a verdict
    #   GET  /diff/transfer?who=&to= what would break (changes nothing)
    #   POST /verdict?f=name         judge the whole list with this file's
    #                                unsaved text in place of its own
    #   PUT  /world?f=name           write one file (the bench writes only
    #                                when the judge holds)
    #   PUT  /value?name=N&to=K      say a value: the declaration goes in a file
    #                                of mine, never in the world that ships it
    #   PUT  /declare?f=name&role=R  declare a file that is here and undeclared:
    #                                the row goes in your manifest, and the answer
    #                                says which file and line to look at
    # Loopback only, no caching, and no route reaches outside the repository.
    from http.server import BaseHTTPRequestHandler, HTTPServer
    from urllib.parse import urlparse, parse_qs

    nums = [x for x in a if x.isdigit()]
    port = int(nums[0]) if nums else 4744

    open_it = "--no-open" not in a

    here = os.path.dirname(os.path.abspath(__file__))

    class H(BaseHTTPRequestHandler):
        def send_file(self, path, ctype):
            with open(path, "rb") as f:
                body = f.read()
            self.send_response(200)
            self.send_header("Content-Type", ctype)
            # never cached: an updated gate must not be hidden behind a bench
            # (or a judge) the browser kept from the last version
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

        def fresh_layout(self):
            # ── THE LAYOUT IS READ FROM DISK, NOT REMEMBERED. This process took
            # it once at start and held it for its whole life, so a row added to
            # the manifest changed nothing anybody could see: the file was on
            # disk, judged, and absent from the panel until the server itself
            # was restarted. A tool whose canon is that it keeps no state of its
            # own may not keep the one document that says what a world is.
            # ── AND READING IT IS NOT PARSING IT AGAIN. This ran on every
            # request and was most of what a request to this server cost: the
            # page asks for five files in order to open one, and each of those
            # answers paid for a parse of a document nobody had touched. The
            # disk is still the authority every single time — the bytes are read
            # here — and what is skipped is only the parse of bytes that came
            # back identical, which cannot say anything different.
            if not FACTS:
                return
            d = os.path.dirname(os.path.abspath(FACTS))
            try:
                raw = open(os.path.join(d, "gate.manifest.swift"), "rb").read()
            except OSError:
                raw = None
            if raw is not None and raw == getattr(H, "_layout_read", None) and MANIFEST:
                return
            H._layout_read = raw
            globals()["MANIFEST"] = read_manifest(d)

