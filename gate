    # The verdict is not worked out a second time here: this asks the status verb
    # and prints what it said. A survey that judged on its own would be a second
    # reading of the same question, which is the defect this whole tool is about.
    world = None
    if world_files() or (MANIFEST and MANIFEST.get("rows")):
        said = dispatch("status", [])
        world = {"facts": FACTS if (FACTS and os.path.exists(FACTS))
                          else os.path.basename(MANIFEST["manifest"]),
                 "verdict": said.get("verdict"), "refusals": len(said.get("refusals", []))}
    return {
        "command": "survey",
        # and the step is chosen by the same reading as the fabric above: this
        # asked `world_files()` alone and told a repository whose world holds
