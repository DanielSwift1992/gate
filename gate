NO_COURT_NEXT = ("install node, which serves both courts through bin/judge.js and "
                 "bin/judge-where.js, or build the binary with `bin/build-judge.sh` "
                 "and point GATE_JUDGE at it")
# the name of the court that answered, said wherever a verdict is printed: a tool
# that quietly swapped one arbiter for another would be the second truth it exists
# against
JUDGE_SAID = ("the judge" if JUDGE_KIND == "binary" else
              "the port under node")


def judge_call(args, **kw):
    # ONE PLACE THAT CALLS A COURT, so no caller has to know which one exists here.
    if NO_COURT:
        cannot(NO_COURT, NO_COURT_NEXT)
    if JUDGE_KIND == "binary":
        return subprocess.run([JUDGE, *args], capture_output=True, text=True, **kw)
    said = subprocess.run([shutil.which("node"), _PORT_CLI, *args],
                          capture_output=True, text=True, **kw)
    # ── AND A NODE THAT DOES NOT RUN IS NOT A COURT THAT SAT. A node on the PATH
    # that exits without a word of its own — the wrong architecture, a broken
    # install, a shim in a container — came back as a court that answered
    # nothing, so `status` printed "refused 3 · judged by the port under node"
    # and named the world's own files. Every one of those refusals was about the
    # machine, and a person would have gone looking at their files. The canon
    # guard below is what caught it; this says which of the two it is.
    if said.returncode and not said.stdout.strip():
        cannot(f"the port under node did not run: node exited {said.returncode}"
               + (f" saying `{said.stderr.strip().splitlines()[0][:80]}`"
                  if said.stderr.strip() else " with nothing on either channel"),
               "check `node --version` on this machine, or build the binary with "
               "`bin/build-judge.sh` and point GATE_JUDGE at it")
    return said


def judged_refusals(out, rename=None):
    # THE PLAIN VERDICT HAS ONE READER. Four callers had grown this regex
    # again, each a second reading of one format; a change to the judge's
    # line would have found some of them and missed the rest.
    return [{"address": rename(m.group(1)) if rename else m.group(1),
             "claim": m.group(2).strip()}
            for m in re.finditer(r"^\s+(\S+\.swift:\d+)\s+(.+)$", out, re.M)]


def canon_guard(out, spoke, verb):
    # ── A COURT THAT DID NOT ANSWER IS NOT A COURT THAT FOUND NOTHING. Every
    # verdict here is read out of a court's own printed lines, so an answer
    # carrying none of them reads exactly like a clean run: nothing parses as a
    # refusal, and the word is `holds`. Measured by substituting the court in one
    # line: `gate status` printed `holds · 0.0 ms` and exited nought, in the demo
    # world whose whole point is one live refusal, with no width under it.
    #
    # So each court is held to its own voice, which is the handshake it already
    # prints and both carriers print alike: the plain court names itself, and the
    # certificate court names itself and the canon both sides fold terms in. This
    # is not the judge judging itself. It is reading whether the answer came from
    # the thing that was asked, which is the one question a caller may always ask.
    #
    # What the voice is was measured, not assumed, and the first spelling of this
    # guard was wrong twice: the certificate court prints its name and the canon
    # when it HOLDS and prints bare `✗` lines when it refuses, so demanding the
    # canon refused every world that had a real refusal in it; and the plain court
    # asked about nothing at all says nothing at all, so a forms-only world, which
    # hands it no files, tripped a guard about a court nobody had asked.
    if spoke:
        return []
    said = " ".join(out.split())[:120] or "nothing at all"
    return [{"address": (os.path.basename(MANIFEST["manifest"]) if MANIFEST
                         else os.path.basename(JUDGE)),
             "claim": f"the court was asked `{verb}` and did not answer in its own canon: it "
                      f"said `{said}`. Every verdict here is read out of that answer, so an "
                      "answer this tool cannot read is not a green. It is a court that did not "
                      "sit, and a green over it would be this tool's own worst failure"}]


def where_refused(out):
    # AND THE WHERE VERDICT TOO: the refused lines, each with the certificate
    # its first quoted word names. Two callers spelled this walk themselves.
    for line in out.split("\n"):
        line = line.strip()
        if not line.startswith("✗"):
            continue
        claim = line[1:].strip()
        m = re.match(r"'(\w+)", claim)
        yield (m.group(1) if m else None), claim


def refine_addresses(text, refusals, fname):
    # the judge pins a refusal to the previous drain's line — refine the
    # address to the line holding the refusal's subject, in a window nearby
    file_lines = text.split("\n")
    for ref in refusals:
        n = int(ref["address"].split(":")[1])
        m = (re.search(r"requires (\w+)\.", ref["claim"])
             or re.search(r"(\w+)(?:\.\w+)? resolves to nothing", ref["claim"])
             or re.match(r"(\w+)\.", ref["claim"]))
        if not m:
            continue
        subject = m.group(1)
        for k in range(max(0, n - 4), min(len(file_lines), n + 8)):
            if re.search(rf"\b{subject}\b", file_lines[k]):
                ref["address"] = f"{fname}:{k + 1}"
                break
    return refusals


def locate_claim(text, claim):
    # the line where this text actually makes this claim, or None. An entry
    # spans lines — the form, then its parties — so read one entry at a time,
    # from the form to the line that closes it, and require every party the
    # claim names to be inside THAT entry: two entries about one person are
    # two different claims.
    names = re.findall(r"\b[A-Z]\w*", claim)
    if not names:
        return None
    form = names[0]
    parties = re.findall(r"\b([A-Z]\w*)\.\w+", claim)
    # ── AND THE ARGUMENT THE CLAIM TURNS ON, WHICH IS WHAT MAKES IT THIS CLAIM
    # AND NOT ITS NEIGHBOUR. The law above was written and only half kept: the
    # form and the parties were required and the argument was not, so an entry
    # about the same person with a DIFFERENT argument answered to the same claim.
    # A world where one file holds and another refuses then put an address on the
    # holding line, and whoever opened it read a right line accused of somebody
    # else's wrong. The side the claim requires is the one after `==`; a claim
    # with no `==` in it asks for nothing more than before.
    wanted = re.search(r"==\s*([A-Z]\w*)", claim)
    # kept apart from `parties`, because the line this refusal points AT is still
    # the accused name's, never the argument it was measured against
    inside = parties + ([wanted.group(1)] if wanted else [])
    lines = text.split("\n")
    for i, ln in enumerate(lines):
        if not re.search(rf"\b{re.escape(form)}\b", ln):
            continue
        end = i
        while end < min(len(lines), i + 10) and ">" not in lines[end]:
            end += 1
        entry = lines[i:end + 1]
        joined = "\n".join(entry)
        if not all(re.search(rf"\b{re.escape(p)}\b", joined) for p in inside):
            continue
        want = parties[0] if parties else form
        for k, line in enumerate(entry):
            if re.search(rf"\b{re.escape(want)}\b", line):
                return i + k + 1
        return i + 1
    return None


def attribute_refusals(refusals, sources):
    # Given several files, the judge repeats every refusal once per file, with
    # the line of whichever file it read the claim in — so a file that never
    # mentions the form still gets an address, at a line it may not even have.
    # A refusal belongs to the file that makes the claim: find that line, in
    # every file that makes it, and drop the broadcast copies.
    # sources: [(shown name, text)]
    first, order = {}, []
    for r in refusals:
        if r["claim"] not in first:
            first[r["claim"]] = r
            order.append(r["claim"])
    out = []
    for claim in order:
        orig = first[claim]["address"]
        ofile, _, oline = orig.partition(":")
        oline = int(oline) if oline.isdigit() else None
        # Only a GATE claim needs placing. The judge pins one to the line the
        # entry before it ended on, and repeats it once per file it was given.
        # Everything else — a name that resolves to nothing, an unknown gate —
        # it addresses exactly, in the one file that says it, and moving that
        # is how a refusal ends up pointing at somebody else's line.
        if " requires " not in claim:
            out.append(first[claim])
            continue
        placed = False
        for name, text in sources:
            line = locate_claim(text, claim)
            if not line:
                continue
            if name == ofile and oline:
                # the judge named THIS file, so its own line stands. An entry
                # spans several lines and the judge pins the refusal to the one
                # the entry before it ended on, so a match a few lines away is
                # a refinement; a match far away is our locator losing the
                # thread, and then the judge is the one to believe.
                line = line if abs(line - oline) <= 8 else oline
            out.append({"address": f"{name}:{line}", "claim": claim})
            placed = True
        if not placed:
            out.append(first[claim])   # unlocatable: keep the judge's own word
    return out


def judge(path):
    t0 = time.time()
    out = judge_call(["judge", path]).stdout
    wall_ms = round((time.time() - t0) * 1000, 1)
    refusals = judged_refusals(out)
    refusals = refine_addresses(open(path).read(), refusals, os.path.basename(path))
    holds = "THE JUDGE holds" in out
    times = re.findall(r"([\d.]+) ms", out)
    return {
        "verdict": "holds" if holds else "refused",
        "refusals": refusals,
        "judge_ms": float(times[-1]) if times else None,
        "wall_ms": wall_ms,
    }


def must_sub(text, pattern, repl, what, count=1):
    found = len(re.findall(pattern, text, re.S))
    if found != count:
        cannot(f"{what}: anchor x{found}, want {count}",
               "the world says this a different number of times than the change expects")
    return re.sub(pattern, repl, text, count=count, flags=re.S)


SCRATCH = []


def scratch(prefix):
    # ── AND WHAT THIS TOOL PUTS ON A MACHINE, IT TAKES OFF AGAIN. A probe needs
    # a directory to write a file into, and nine places made one; four of them
    # never removed it. On the machine this was found on: 6676 left by the panel,
    # one per keystroke, and 3586 by `verify`. A tool whose first promise is that
    # nothing of it stays behind may not grow without bound in somebody's temp.
    # Made here, and every maker is a caller of this, so the guard has one name
    # to watch.
    d = tempfile.mkdtemp(prefix=prefix)
    SCRATCH.append(d)
    return d


def sweep_scratch():
    while SCRATCH:
        shutil.rmtree(SCRATCH.pop(), ignore_errors=True)


def with_temp(text):
    d = scratch("gate-")
    # the probe carries the real world's filename: addresses read as native
    p = os.path.join(d, os.path.basename(FACTS))
    with open(p, "w") as f:
        f.write(text)
    return p


def last_entry_insert(text, head, args, indent):
    # insert a new entry after the LAST entry of the same form (and same axis arguments, when given)
    pat = head + r"<\s*(\w+),\s*(\w+)\s*>\.self;?"
    hits = [m for m in re.finditer(pat, text)]
    if args.get("second"):
        hits = [m for m in hits if m.group(2) == args["second"]]
    if not hits:
        cannot(f"no {head} entries to anchor on",
               "this change writes beside an existing entry, and the world has none")
    m = hits[-1]
    pad, inner = " " * indent, " " * (indent + 4)
    entry = (
        f"\n{pad}{head}<\n{inner}{args['first']},\n{inner}{args['args_second']}\n{pad}>.self"
    )
    return text[: m.end()] + entry + text[m.end() :]


def cmd_ask(a):
    # ask view WHO DOC — would this view entry stand? a probe entry + judgement, nothing changes
    #
    # ── AND ONE NAME OF TWO IS A MISTAKE, NOT A QUESTION. `gate check view`
    # bare is somebody learning what the verb takes, and the dispatcher answers
    # that with a usage line and a nought exit. `gate check view Emp0042` is
    # somebody who meant something and stopped halfway, and it read argv[1] of
    # a one-word argv: a stack trace on the verb the cover's own table sells.
    _asked = ("gate check view Emp0042 FinanceShare, with names your world declares "
              "(`gate library` lists that vocabulary)")
    if not a:
        return {"command": "check", "asks": True,
                "note": "check view WHO WHAT  ·  a question about one entry, and nothing changes",
                "next": _asked}
    if len(a) < 2:
        cannot(f"check view WHO WHAT: this names only {a[0]}", _asked)
    who, doc = a[0], a[1]
    # ── AND A QUESTION OF A WORLD FILE NEEDS ONE, said where the reading is.
    # This read FACTS unguarded, so in a world declared as a layout alone, which
    # is what `gate demo` and `gate import codeowners` build and what this
    # repository is, it raised: the terminal on a FileNotFoundError and the bench
    # by dropping the connection with no response at all. The first spelling of
    # this guard sat in the dispatcher, and the bench calls these verbs directly,
    # so the page kept dropping the line: a guard belongs at the reading, never
    # at one of its callers.
    if not (FACTS and os.path.exists(FACTS)):
        cannot("this asks its question of a world file, and there is none here",
               "run `gate init .` to start one, or `gate demo` for a repository to look "
               "at. A world declared as a layout alone is judged by `gate status`")
    text = open(FACTS).read()
    probe = last_entry_insert(
        text, "VerifiedView", {"first": who, "args_second": doc}, indent=12
    )
    r = judge(with_temp(probe))
    return {"command": "ask view", "who": who, "doc": doc, **r, "mutates": False}


def cmd_ask_build(kind, a):
    # check administer|delete WHO DOC — compiler gates (Granted/Authorized):
    # a probe entry in CertifiedAccesses + swift build; seconds, the full arbiter
    if not ROOT:
        cannot("check " + kind + " needs GATE_CORPUS (a checkout of the theory corpus with Team.swift)",
               "set GATE_CORPUS to that checkout, or ask `gate check view` instead, which needs none")
    _asked = (f"gate check {kind} Emp0042 FinanceVault, with names your world declares "
              "(`gate library` lists that vocabulary)")
    if not a:
        return {"command": "check", "asks": True,
                "note": f"check {kind} WHO WHAT  ·  the compiler is the arbiter, and it takes seconds",
                "next": _asked}
    if len(a) < 2:
        cannot(f"check {kind} WHO WHAT: this names only {a[0]}", _asked)
    who, doc = a[0], a[1]
    team = os.path.join(ROOT, "Sources", "Organization", "System", "Team.swift")
    text = open(team).read()
    anchor = "        Granted<Delete<Alice, FinanceVault>>.self         // only the owner, and only at manager rank, deletes"
    assert text.count(anchor) == 1
    gate_name = kind.capitalize()
    probe = text.replace(anchor, anchor + f"\n        Granted<{gate_name}<{who}, {doc}>>.self // gate probe")
    open(team, "w").write(probe)
    t0 = time.time()
    out = subprocess.run(["swift", "build"], cwd=ROOT, capture_output=True, text=True)
    secs = round(time.time() - t0, 2)
    subprocess.run(["git", "checkout", "--", team], cwd=ROOT, capture_output=True)
    reasons = sorted(set(re.findall(r"error: (.+)$", out.stdout + out.stderr, re.M)))
    return {
        "command": f"ask {kind}",
        "who": who,
        "doc": doc,
        "verdict": "holds" if out.returncode == 0 else "refused",
        "compiler_says": reasons[:3],
        "build_s": secs,
        "mutates": False,
    }


def transfer_text(text, who, dept):
    # the mechanics of a transfer: Home in the roster + the team entry (both
    # facts); view grants are NOT touched: re-pointing or revoking access is
    # a decision of intent, left to the human (the reply hints grant/revoke)
    text = must_sub(
        text,
        rf"(public enum {who}: Employee, Person \{{[^}}]*?public typealias Home = )\w+",
        rf"\g<1>{dept}",
        f"roster entry of {who}",
    )
    text = re.sub(
        rf"(VerifiedInDepartment<\s*{who},\s*)\w+",
        rf"\g<1>{dept}",
        text,
    )
    return text


def grant_text(text, who, doc):
    return last_entry_insert(text, "VerifiedView", {"first": who, "args_second": doc}, 12)


def revoke_text(text, who, doc):
    pat = rf"\n\s*VerifiedView<\s*{who},\s*{doc}\s*>\.self;?"
    found = len(re.findall(pat, text))
    if found != 1:
        cannot(f"revoke: grant {who}->{doc} found x{found}, want 1",
               "revoke removes one grant, and the world states that one a different number of times")
    return re.sub(pat, "", text, count=1)


def hire_text(text, f):
    block = (
        f"\n\npublic enum {f['id']}: Employee, Person {{\n"
        f"    public typealias Rank = {f['rank']}\n"
        f"    public typealias Home = {f['home']}\n"
        f"    public typealias Given = {f['given']}\n"
        f"    public typealias Family = {f['family']}\n"
        f"    public typealias Born = {f['born']}\n"
        f"    public typealias Site = {f['site']}\n"
        f"    public typealias Sex = Given.Sex\n}}"
    )
    rosters = [m for m in re.finditer(r"public enum \w+: Employee, Person \{.*?\n\}", text, re.S)]
    if not rosters:
        cannot("hire: no roster entries to anchor on",
               "hire writes beside an existing person, and the world has none")
    m = rosters[-1]
    text = text[: m.end()] + block + text[m.end() :]
    slices = [m for m in re.finditer(r"(Emp\w+\.self;?)(?=\s*\n\s*\})", text)]
    if slices:  # the corpus world carries a Company list; an imported one does not, and the judge needs none
        s = slices[0]
        text = text[: s.end()] + f" {f['id']}.self;" + text[s.end() :]
    text = last_entry_insert(text, "VerifiedView", {"first": f["id"], "args_second": f["home"] + "Share"}, 12)
    text = last_entry_insert(text, "VerifiedInDepartment", {"first": f["id"], "args_second": f["home"], "second": f["home"]}, 8)
    text = last_entry_insert(text, "VerifiedAtRank", {"first": f["id"], "args_second": f["rank"], "second": f["rank"]}, 8)
    text = last_entry_insert(text, "VerifiedAtWorkplace", {"first": f["id"], "args_second": f["site"], "second": f["site"]}, 8)
    return text


def cmd_change(a):
    # change transfer WHO DEPT [--apply] · change hire ID RANK HOME GIVEN FAMILY BORN SITE [--apply]
    # The SINGLE source — the world — is edited; the diff stays a Swift git diff.
    apply_it = "--apply" in a
    a = [x for x in a if x != "--apply"]
    # ── AND A QUESTION OF A WORLD FILE NEEDS ONE, said where the reading is.
    # This read FACTS unguarded, so in a world declared as a layout alone, which
    # is what `gate demo` and `gate import codeowners` build and what this
    # repository is, it raised: the terminal on a FileNotFoundError and the bench
    # by dropping the connection with no response at all. The first spelling of
    # this guard sat in the dispatcher, and the bench calls these verbs directly,
    # so the page kept dropping the line: a guard belongs at the reading, never
    # at one of its callers.
    if not (FACTS and os.path.exists(FACTS)):
        cannot("this asks its question of a world file, and there is none here",
               "run `gate init .` to start one, or `gate demo` for a repository to look "
               "at. A world declared as a layout alone is judged by `gate status`")
    # the two doors are `diff` and `apply`, and both reached `a[0]` on an argv
    # that may be empty: bare, either one met a person with an IndexError
    if not a:
        return {"command": "change", "asks": True,
                "note": "diff transfer WHO DEPT  ·  diff hire ID RANK HOME GIVEN FAMILY "
                        "BORN SITE  ·  the same words after `apply` write the change",
                "next": "gate diff transfer Emp0042 Sales shows what would move and what "
                        "would stop holding, and writes nothing"}
    text = open(FACTS).read()
    if a[0] == "transfer":
        who, dept = a[1], a[2]
        new = transfer_text(text, who, dept)
        label = {"command": "change transfer", "who": who, "to": dept,
                 "note": "roster and team entry moved. View grants are intent, so resolve leftovers with grant/revoke"}
    elif a[0] == "grant":
        who, doc = a[1], a[2]
        new = grant_text(text, who, doc)
        label = {"command": "change grant", "who": who, "doc": doc}
    elif a[0] == "revoke":
        who, doc = a[1], a[2]
        new = revoke_text(text, who, doc)
        label = {"command": "change revoke", "who": who, "doc": doc}
    elif a[0] == "hire":
        f = dict(zip(["id", "rank", "home", "given", "family", "born", "site"], a[1:8]))
        new = hire_text(text, f)
        label = {"command": "change hire", **f}
    else:
        cannot(f"unknown change {a[0]}",
               "the changes this verb makes are `transfer`, `hire`, `grant` and `revoke`")
    r = judge(with_temp(new))
    # ── AND `applied` MEANS SOMETHING CHANGED. A transfer to the department
    # somebody is already in rewrites the file with the bytes it already had, and
    # this said `applied` while `git status` stayed empty: the answer must be
    # what happened, and nothing happened. The verb still holds, and says so.
    applied, moved = False, open(FACTS, encoding="utf-8").read() != new
    if apply_it and r["verdict"] == "holds" and moved:
        open(FACTS, "w").write(new)
        applied = True
    return {**label, **r, "dry_run": not apply_it, "applied": applied,
            "changed": moved}


def cmd_import(a):
    # import people.csv grants.csv -o gate.swift — a mechanical translation
    # of the client's facts into the world's facts layer. CSV columns = the
    # world's axes; refusal addresses translate back to the client's CSV lines.
    import csv

    # two tables, and this line took them off an argv that may carry none: the
    # bare verb answered with an IndexError. It is also the head of a family, so
    # the sentence names the other doors rather than only its own.
    if len(a) < 2:
        return {"command": "import", "asks": True,
                "note": "import people.csv grants.csv [-o gate.swift]  ·  "
                        "import codeowners CODEOWNERS --tree . [--policy owners.csv]  ·  "
                        "import rbac rbac.json  ·  import refs FILE",
                "next": "gate import codeowners CODEOWNERS --tree . reads ownership you "
                        "already keep, and writes one small file you commit"}
    people_csv, grants_csv = a[0], a[1]
    out_path = a[a.index("-o") + 1] if "-o" in a else "gate.swift"
    lines = []  # (text, source|None)

    def emit(chunk, src=None):
        for ln in chunk.split("\n"):
            lines.append((ln, src))

    # THREE THOUGHTS, SAID APART. A blank comment line is where the writer
    # stopped, and a reader — a person or the Bare view — has no other way to
    # know. Run together they read as one long sentence that changes subject
    # twice, which is what they did until somebody looked at them set as prose.
    emit("// the facts world, yours: the source you read and edit, and the")
    emit("// one this tool answers for. Not a generated artifact. The tables")
    emit("// only seeded it once, below, and from here the world is what is")
    emit("// edited and judged. A gate.manifest.swift may split it across")
    emit("// several files, all judged together. git carries the history.")
    emit("//")
    emit(f"// seeded by gate import from: {os.path.basename(people_csv)}, {os.path.basename(grants_csv)}")
    emit("//")
    emit("// the language it is written in: `gate stdlib show forms-organization`.")
    emit("// Those words are carried by the judge, and `materialize` writes them out")
    emit("// beside this file to read: editing that copy adds no word to the language.")
    people = list(csv.DictReader(theirs_text(people_csv)))
    grants = list(csv.DictReader(theirs_text(grants_csv)))

    # the atom pools: distinct given/family/year values from the data, Next rings closed in a circle
    def ring(names, conf, extra=None):
        names = list(dict.fromkeys(names))
        for i, n in enumerate(names):
            nxt = names[(i + 1) % len(names)]
            body = f"    public typealias Next = {nxt}\n"
            if extra:
                body += f"    public typealias Sex = {extra[n]}\n"
            emit(f"\npublic enum {n}: {conf} {{\n{body}}}")

    sexes = {p["given"]: p.get("sex", "Male") for p in people}
    ring([p["given"] for p in people], "GivenNameCycle", sexes)
    ring([p["family"] for p in people], "FamilyNameCycle")
    ring([p["born"] for p in people], "BirthYearCycle")
    for i, p in enumerate(people):
        src = f"{os.path.basename(people_csv)}:{i + 2}"
        emit(
            f"\npublic enum {p['id']}: Employee, Person {{\n"
            f"    public typealias Rank = {p['rank']}\n"
            f"    public typealias Home = {p['home']}\n"
            f"    public typealias Given = {p['given']}\n"
            f"    public typealias Family = {p['family']}\n"
            f"    public typealias Born = {p['born']}\n"
            f"    public typealias Site = {p['site']}\n"
            f"    public typealias Sex = Given.Sex\n}}",
            src,
        )
    emit("\npublic enum ImportedTeam: Team {\n    @StructureBuilder\n    public static var body: some Structure {")
    for i, p in enumerate(people):
        src = f"{os.path.basename(people_csv)}:{i + 2}"
        emit(f"        VerifiedInDepartment<\n            {p['id']},\n            {p['home']}\n        >.self", src)
        emit(f"        VerifiedAtRank<\n            {p['id']},\n            {p['rank']}\n        >.self", src)
        emit(f"        VerifiedAtWorkplace<\n            {p['id']},\n            {p['site']}\n        >.self", src)
    emit("    }\n}")
    emit("\npublic enum ImportedAccesses: AccessLedger {\n    @StructureBuilder\n    public static var body: some Structure {")
    for i, g in enumerate(grants):
        src = f"{os.path.basename(grants_csv)}:{i + 2}"
        emit(f"            VerifiedView<\n                {g['who']},\n                {g['doc']}\n            >.self", src)
    emit("    }\n}")

    with open(out_path, "w") as f:
        f.write("\n".join(t for t, _ in lines) + "\n")
    r = judge(out_path)
    for ref in r["refusals"]:
        # the judge pins a refusal to the previous drain's line — refine to
        # the line holding the refusal's subject, in a window around the address
        n = int(ref["address"].split(":")[1])
        src = lines[n - 1][1] if n - 1 < len(lines) else None
        m = re.search(r"requires (\w+)\.", ref["claim"]) or re.match(r"(\w+)\.", ref["claim"])
        if m:
            subject = m.group(1)
            for k in range(max(0, n - 4), min(len(lines), n + 8)):
                if re.search(rf"\b{subject}\b", lines[k][0]) and lines[k][1]:
                    src = lines[k][1]
                    ref["address"] = f"{os.path.basename(out_path)}:{k + 1}"
                    break
        ref["source"] = src
    return {
        "command": "import",
        "world": out_path,
        "people": len(people),
        "grants": len(grants),
        **r,
    }


def cmd_export(a):
    # export gate.swift -o people.csv grants.csv — the world prints the
    # tables back. Round-trip: import → export → empty diff vs the originals
    # ⇒ the fact translation is proven mechanically, no trust in the translator.
    # A verb meets a person with a sentence, never a stack trace: asked for
    # nothing, this answered IndexError, the same voice verify once used.
    if not a or a[0].startswith("-") or "-o" not in a or a.index("-o") + 2 >= len(a):
        return {"command": "export", "asks": True,
                "note": "export prints the org tables back from a world, for the round-trip diff",
                "next": "gate export gate.swift -o people.csv grants.csv, then diff each "
                        "printed table against the original you imported"}
    world = a[0]
    # and a world that is not there is said, not raised: the vein carrying this
    # verb answered in words while this line raised FileNotFoundError
    if not os.path.exists(world):
        cannot(f"no such world: {world}",
               "name the file your world is written in, or `gate init .` to start one")
    people_out, grants_out = a[a.index("-o") + 1], a[a.index("-o") + 2]
    text = open(world).read()
    rows = []
    for m in re.finditer(
        r"public enum (\w+): Employee, Person \{(.*?)\n\}", text, re.S
    ):
        f = dict(re.findall(r"public typealias (\w+) = ([\w.]+)", m.group(2)))
        sex_pool = dict(
            re.findall(r"public enum (\w+): GivenNameCycle \{.*?Sex = (\w+)", text, re.S)
        )
        # ── AND A RECORD MISSING A COLUMN IS A REFUSAL, NOT A TRACEBACK. This
        # read the seven fields by key and raised KeyError on a world where one
        # of them is absent: the same defect this function's own head calls out,
        # a verb meeting a person with a stack trace. The world says which record
        # and which word, so the answer says it too.
        missing = [k for k in ("Rank", "Home", "Given", "Family", "Born", "Site") if k not in f]
        if missing:
            at = text[:m.start()].count("\n") + 1
            return {"command": "export", "verdict": "refused",
                    "refusals": [{"address": f"{world}:{at}",
                                  "claim": f"`{m.group(1)}` states no {' and no '.join(missing)}: "
                                           "the tables have a column for each, and a record that "
                                           "does not say one cannot be printed back"}],
                    "next": "add the line to the record, or drop the record from the world"}
        rows.append(
            [m.group(1), f["Rank"], f["Home"], f["Given"], f["Family"], f["Born"], f["Site"], sex_pool.get(f["Given"], "")]
        )
    with open(people_out, "w") as f:
        f.write("id,rank,home,given,family,born,site,sex\n")
        f.writelines(",".join(r) + "\n" for r in rows)
    grants = re.findall(r"VerifiedView<\s*(\w+),\s*(\w+)\s*>\.self;?", text)
    with open(grants_out, "w") as f:
        f.write("who,doc\n")
        f.writelines(f"{w},{d}\n" for w, d in grants)
    return {
        "command": "export",
        "people": len(rows),
        "grants": len(grants),
        "wrote": [people_out, grants_out],
    }


def seeds(people, grants):
    # the seed catalogue: one violation per rule form, drawn from the data itself
    # ── AND A TABLE WITH NO ROWS IS SAID, NOT INDEXED. `gate verify` handed two
    # files of the wrong kind straight to this, and `people[0]` raised: the
    # catalogue is drawn FROM the data, so with no data there is nothing to draw
    # and that is a sentence, not a stack trace.
    if not people or not grants:
        cannot("the tables this reads have no rows: a seed is drawn from the data itself",
               "point it at the two CSVs you imported, people and grants, with their "
               "header lines")
    p0 = people[0]
    other_home = next(p["home"] for p in people if p["home"] != p0["home"])
    yield "cross-view", people, grants + [{"who": p0["id"], "doc": other_home + "Share"}]
    yield "duplicate-grant", people, grants + [dict(grants[0])]
    yield "dangling-who", people, grants + [{"who": "Emp9999", "doc": p0["home"] + "Share"}]
    yield "dangling-doc", people, grants + [{"who": p0["id"], "doc": "NoSuchShare"}]
    moved = [dict(p) for p in people]
    moved[0]["home"] = other_home
    yield "stale-after-transfer", moved, grants


def cmd_verify(a):
    # verify people.csv grants.csv --against CMD — differential rule check:
    # catalogue seeds are judged by the world AND the client's old checker; a
    # verdict split = the address of an untranslated rule (or one the client lacks).
    import csv

    # ── AND A VERB MEETS A PERSON WITH A SENTENCE, NEVER A STACK TRACE. Typed in
    # a world that keeps no tables, this answered `IndexError: list index out of
    # range` — the one voice this tool never uses, in the one moment when
    # somebody is already unsure what they typed.
    if len(a) < 2 or a[0].startswith("-") or a[1].startswith("-"):
        return {"command": "verify", "asks": True,
                "misread": bool([x for x in a if not x.startswith("-")]),
                "note": "verify reads two catalogue files and judges their seeds",
                "next": "gate verify people.csv grants.csv [--against CMD]: the two tables, "
                        "and the checker you have today if you want the two answers compared "
                        "claim by claim"}
    people_csv, grants_csv = a[0], a[1]
    against = a[a.index("--against") + 1] if "--against" in a else None
    people = list(csv.DictReader(theirs_text(people_csv)))
    grants = list(csv.DictReader(theirs_text(grants_csv)))
    d = scratch("gate-verify-")

    # step 0: the base must be clean on BOTH sides — background violations
    # would mask the seeds and "covered" would mean nothing
    base_world = cmd_import([people_csv, grants_csv, "-o", os.path.join(d, "base.swift")])
    base_legacy = (
        subprocess.run(against.split() + [people_csv, grants_csv], capture_output=True, text=True)
        if against
        else None
    )
    if base_world["verdict"] != "holds" or (base_legacy and base_legacy.returncode != 0):
        return {
            "command": "verify",
            "base": "dirty: fix these before seeding",
            "world_says": [r["claim"] + " · " + str(r["source"]) for r in base_world["refusals"]],
            "legacy_says": base_legacy.stdout.strip().splitlines() if base_legacy else [],
        }
    rows = []
    for name, ps, gs in seeds(people, grants):
        pp, gp = os.path.join(d, "people.csv"), os.path.join(d, "grants.csv")
        with open(pp, "w") as f:
            f.write("id,rank,home,given,family,born,site,sex\n")
            f.writelines(",".join(p[k] for k in ["id", "rank", "home", "given", "family", "born", "site", "sex"]) + "\n" for p in ps)
        with open(gp, "w") as f:
            f.write("who,doc\n")
            f.writelines(f"{g['who']},{g['doc']}\n" for g in gs)
        world = cmd_import([pp, gp, "-o", os.path.join(d, "gate.swift")])
        w = world["verdict"]
        if against:
            legacy = subprocess.run(against.split() + [pp, gp], capture_output=True, text=True)
            l = "refused" if legacy.returncode else "holds"
            verdict = {
                ("refused", "refused"): "covered: both refuse",
                ("refused", "holds"): "WORLD STRICTER: the client's checker misses this",
                ("holds", "refused"): "NOT TRANSLATED: the legacy rule has no gate in the world",
                ("holds", "holds"): "weak seed: neither side refuses",
            }[(w, l)]
            legacy_says = legacy.stdout.strip().splitlines()[:2]
        else:
            # --self: seeds against the world alone — which rules hold at all
            l, legacy_says = "n/a", []
            verdict = "held by the world" if w == "refused" else "NO GATE HOLDS THIS SEED"
        rows.append({
            "seed": name,
            "world": w,
            "world_says": [r["claim"] for r in world["refusals"]][:2],
            "legacy": l,
            "legacy_says": legacy_says,
            "reading": verdict,
        })
    holes = [r for r in rows if r["reading"].startswith(("NOT TRANSLATED", "NO GATE"))]
    return {"command": "verify", "seeds": rows, "translation_holes": len(holes)}


