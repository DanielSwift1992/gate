def dispatch(cmd, rest):
    if cmd in ("check", "ask", "diff", "apply", "change", "status", "fsck", "report"):
        ensure_world()
    if cmd in ("check", "ask") and rest[0] == "view":
        return cmd_ask(rest[1:])
    if cmd in ("check", "ask") and rest[0] in ("administer", "delete"):
        return cmd_ask_build(rest[0], rest[1:])
    if cmd == "diff":
        return cmd_change([x for x in rest if x != "--apply"])
    if cmd == "apply":
        return cmd_change(rest + ["--apply"])
    if cmd == "change":
        return cmd_change(rest)
    if cmd == "import" and rest and rest[0] == "codeowners":
        return cmd_import_codeowners(rest[1:])
    if cmd == "drift":
        return cmd_drift(rest)
    if cmd == "declare":
        return cmd_declare(rest)
    if cmd == "seam":
        return cmd_seam(rest)
    if cmd == "aside":
        return cmd_aside(rest)
    if cmd == "attention":
        return cmd_attention(rest)
    if cmd == "badge":
        return cmd_badge(rest)
    if cmd == "import" and rest and rest[0] == "refs":
        return cmd_import_refs(rest[1:])
    if cmd == "import" and rest and rest[0] == "rbac":
        return cmd_import_rbac(rest[1:])
    if cmd == "import":
        return cmd_import(rest)
    if cmd == "export":
        return cmd_export(rest)
    if cmd == "verify":
        return cmd_verify(rest)
    if cmd == "init":
        return cmd_init(rest)
    if cmd in ("status", "fsck"):
        files = world_files()
        # A WORLD OF FORMS IS STILL A WORLD. `world_files` is the plain court's
        # list and rightly holds no forms row — but emptiness there was being
        # read as emptiness altogether, so a repository that declares its
        # grammar and nothing else was told it had nothing. That repository is
        # this one: gate's own facts about its surface are forms, judged by the
        # where court, and until now the tool could not see the shape it is.
        if not files and not (MANIFEST and MANIFEST.get("rows")):
            # no world here — but this IS a git repository, and the journal
            # reads one of those with no translation at all. Offer the rung
            # the reader is standing on, not the whole ladder.
            inside = subprocess.run(["git", "rev-parse", "--is-inside-work-tree"],
                                    capture_output=True, text=True).stdout.strip() == "true"
            # AND CHOSEN BY WHAT IS ACTUALLY HERE. A repository with no world and
            # no commits was sent to read its own history, which sent it back to
            # status: two rungs pointing at each other and nothing to stand on.
            # Where there is nothing at all, the one step that produces something
            # is a world to look at.
            commits = subprocess.run(["git", "rev-list", "--count", "HEAD"],
                                     capture_output=True, text=True).stdout.strip()
            has_past = commits.isdigit() and int(commits) > 0
            return {"command": "status", "verdict": "no world here", "refusals": [],
                    "next": ("run `gate log` to read this repository's own history: nothing to translate"
                             if inside and has_past else
                             "run `gate demo` for a world to look at: people, grants, and one refusal"
                             if inside else "run `gate init .` to start a world in this folder"),
                    "then": "drop your CSVs into tables/ and run gate status again, or gate demo to see one",
                    "mutates": False}
        # what disagrees right now: judgement over the declared file list +
        # layout guards + world metrics (counted, never remembered)
        t0 = time.time()
        raw = subprocess.run([JUDGE, "judge", *files], capture_output=True, text=True).stdout
        wall_ms = round((time.time() - t0) * 1000, 1)
        refusals = [{"address": m.group(1), "claim": m.group(2).strip()}
                    for m in re.finditer(r"^\s+(\S+\.swift:\d+)\s+(.+)$", raw, re.M)]
        if len(files) > 1:  # one claim, one file: the one that makes it
            refusals = attribute_refusals(refusals, [(os.path.basename(p), open(p).read()) for p in files])
        refusals += manifest_guards()
        refusals += forms_guards()
        refusals += policy_guards()
        refusals += stdlib_guards()
        refusals += vendored_guards()
        refusals += duplicate_guards()
        refusals += entry_guards()
        times = re.findall(r"([\d.]+) ms", raw)
        out = {"command": "status", "facts": files if len(files) > 1 else FACTS,
               "verdict": "holds" if not refusals else "refused", "refusals": refusals,
               "judge_ms": float(times[-1]) if times else None, "wall_ms": wall_ms, "mutates": False}
        m = re.search(r"(\d+) declarations · (\d+) lookups · (\d+) premises", raw)
        if m:
            out["world"] = {"declarations": int(m.group(1)), "lookups": int(m.group(2)), "premises": int(m.group(3))}
        out["next"] = next_rung(bool(refusals))
        return out
    if cmd == "guard" and rest and rest[0] == "deps":
        return cmd_guard_deps(rest[1:])
    if cmd == "guard":
        ensure_world()
        return cmd_guard(rest)
    if cmd == "library":
        ensure_world()
        return cmd_library(rest)
    if cmd == "survey":
        return cmd_survey(rest)
    if cmd == "demo" and rest and rest[0] == "seam":
        return cmd_demo_seam(rest[1:])
    if cmd == "demo":
        return cmd_demo(rest)
    if cmd == "my":
        # my — your personal world: where it is, and its verdict WITH the shared
        # world (the claims you keep, judged against facts other people own)
        p = personal_path()
        if not p:
            raise SystemExit(json.dumps({"error": "no world here: cd into a repo with gate.swift"}))
        if not os.path.exists(p):
            return {"command": "my", "personal": p, "repo_key": repo_key(), "empty": True,
                    "verdict": "holds", "refusals": [], "shared_repo_untouched": True,
                    "next": "nobody has written in your world, so it is not stored anywhere. "
                            "Open the bench and write a claim in my.swift: it is judged with the "
                            "shared world, stays out of it, and is kept on this machine alone. "
                            "Clear it again and it is gone."}
        named = [(n, q) for n, q in bench_files() if os.path.exists(q)]
        raw = subprocess.run([JUDGE, "judge", *[q for _, q in named]], capture_output=True, text=True).stdout
        refusals = [{"address": m.group(1), "claim": m.group(2).strip()}
                    for m in re.finditer(r"^\s+(\S+\.swift:\d+)\s+(.+)$", raw, re.M)]
        refusals = attribute_refusals(refusals, [(n, open(q).read()) for n, q in named])
        return {"command": "my", "personal": p, "repo_key": repo_key(),
                "shared_repo_untouched": True,
                "verdict": "holds" if not refusals else "refused", "refusals": refusals}
    if cmd == "findings":
        return cmd_findings(rest)
    if cmd == "log":
        # gate log [N] — the world's history; gate log all [N] — the repository's
        scope = "all" if rest and rest[0] in ("all", "--all") else "world"
        nums = [x for x in rest if x.isdigit()]
        return repo_journal(int(nums[0]) if nums else 200, scope)
    if cmd == "stdlib":
        return cmd_stdlib(rest)
    if cmd == "mine":
        return cmd_side(rest, "Mine")
    if cmd == "theirs":
        return cmd_side(rest, "Theirs")
    raise SystemExit(USAGE)


def is_red(out):
    # a threshold the operator declared is not a verdict, but it is theirs to act
    # on, so it reaches the exit code the same way a refusal does
    return out.get("over_threshold") or out.get("verdict") == "refused" or bool(out.get("translation_holes")) or out.get("base", "").startswith("dirty")


def humanize(out):
    # humans get lines, machines get --json (git's porcelain pattern)
    lines = []
    cmd = out.get("command", "")
    if cmd == "badge" and out.get("verdict") != "no world here":
        lines.append("badge: " + out["text"] + (f" · wrote {out['wrote']}" if out.get("wrote") else ""))
        lines.append(f"  note: {out['note']}")
        lines.append(f"  next: {out['next']}")
        return "\n".join(lines)
    if out.get("verdict") == "no world here":
        lines.append("status: no world here")
        lines.append(f"  next: {out['next']}")
        lines.append(f"  then: {out['then']}")
        return "\n".join(lines)
    if "verdict" in out:
        head = "holds" if out["verdict"] == "holds" else f"refused {len(out.get('refusals', []))}"
        tail = []
        if isinstance(out.get("world"), dict):
            w = out["world"]
            tail.append(f"{w['declarations']} declarations · {w['lookups']} lookups · {w['premises']} premises")
        if out.get("judge_ms") is not None:
            tail.append(f"{out['judge_ms']} ms")
        if out.get("build_s") is not None:
            tail.append(f"build {out['build_s']} s")
        if cmd.startswith("change") and not out.get("dry_run", True):
            tail.append("applied" if out.get("applied") else "NOT applied")
        elif cmd.startswith("change"):
            tail.append("dry-run")
        lines.append(f"{cmd or 'verdict'}: {head}" + (" · " + " · ".join(tail) if tail else ""))
        for r in out.get("refusals", []):
            src = f"  ({r['source']})" if r.get("source") else ""
            # an address, or the certificate that carries one: an importer names
            # the claim, the source line names where it came from
            where = r.get("address") or r.get("certificate") or "?"
            lines.append(f"  {where} · {r['claim']}{src}")
        for s in out.get("compiler_says", []):
            lines.append(f"  compiler: {s}")
        if out.get("note"):
            lines.append(f"  note: {out['note']}")
        if out.get("next"):
            lines.append(f"  next: {out['next']}")
    elif "seeds" in out:
        lines.append(f"verify: {out['translation_holes']} hole(s)")
        for s in out["seeds"]:
            lines.append(f"  {s['seed']:22} world={s['world']:8} legacy={s['legacy']:8} → {s['reading']}")
    elif out.get("base", "").startswith("dirty"):
        lines.append("verify: base dirty — fix these before seeding")
        for w in out.get("world_says", []):
            lines.append(f"  world:  {w}")
        for l in out.get("legacy_says", []):
            lines.append(f"  legacy: {l}")
    elif cmd == "demo seam":
        lines.append(f"demo seam: two sides in {out['root']} — the contract states "
                     f"{out['declared']['contract']}, the library claims {out['declared']['carrier']}")
        for x in out["waiting_on_you"]:
            lines.append(f"  waits on the library · {x}")
        for x in out["you_wait_on"]:
            lines.append(f"  waits on the contract · {x}")
        for x in out["parted"]:
            lines.append(f"  parted · {x}")
        lines.append(f"  next: {out['next']}")
        for x in out["try"]:
            lines.append(f"    {x}")
    elif cmd == "demo":
        lines.append(f"demo: a world in {out['root']}")
        for r in out.get("refused", []):
            lines.append(f"  asked `{out['asked']}` for you, and it answers:")
            lines.append(f"    {r}")
        lines.append(f"  next: {out['next']}")
        for t in out["try"]:
            lines.append(f"    {t}")
    elif cmd == "init":
        lines.append(f"init: {out['root']}" + (f" · created {len(out['created'])} files" if out["created"] else " · already there"))
        if out.get("next"):
            lines.append(f"  next: {out['next']}")
        if out.get("hooks"):
            lines.append(f"  {out['hooks']}")
        if out.get("undo_hooks"):
            lines.append(f"  to undo that one git setting: {out['undo_hooks']}")
        if out.get("vendored"):
            v = out["vendored"]
            lines.append(f"  gate now travels with this repository: .gate/ + {v['shim']}")
            lines.append("  commit it, and every clone has the tool — nothing to install")
            if v.get("judge_sha256"):
                lines.append(f"  judge sha256: {v['judge_sha256'][:16]}…")
    elif cmd in ("mine", "theirs"):
        # SAID IN ONE LINE, THE SAME LINE BOTH WAYS. The whole difference is the
        # verb: one I write, one I only read — and the operator should be able to
        # see which a file is without opening it.
        if out.get("asks"):
            lines.append("usage: " + out["note"])
        elif out.get("held") is not None:
            # THE ACCOUNT, in the shape somebody reads down a column: what, what
            # for, and how fresh. An owner who cannot see this cannot own it.
            lines.append(f"{cmd}: {len(out['held'])}")
            for h in out["held"]:
                at = f" · at {h['at']}" if h.get("at") else ""
                lines.append(f"  {h['file']:<28} {h['role'] or '—':<7}{at}")
            lines.append(f"  next: `gate {cmd} FILE --forget` takes one out of the list, "
                         "and leaves the file alone")
        elif out.get("forgot"):
            lines.append(f"{cmd}: {out['forgot']} · out of {out['declared_in']}")
            lines.append("  the file is still on disk — that is a separate act, and yours")
        else:
            # what was taken, and at what — the whole account in the line that
            # takes it, because a pin stated nowhere pins nothing
            took = f" · took it at {out['at']}" if out.get("at") else ""
            lines.append(f"{cmd}: {out['file']}{took} · written down in {out['declared_in']}")
            lines.append(f"  role `{out['role']}` — {out['role_means']}")
    elif cmd == "aside":
        if out.get("asks"):
            lines.append("usage: " + out["note"]); lines.append(f"  next: {out['next']}")
        else:
            lines.append(f"aside: {out['address']} · while {out['because']} is open "
                         f"· said by {out['declared_by']} · {out['standing']} standing")
            lines.append(f"  note: {out['note']}")
            lines.append(f"  next: {out['next']}")
    elif cmd == "attention":
        if out.get("asks"):
            lines.append("usage: " + out["note"]); lines.append(f"  next: {out['next']}")
        else:
            lines.append(f"attention: as {out['as']} · {len(out['waits_on_you'])} waiting on you · "
                         f"{len(out['you_wait_on'])} you are waiting for · {len(out['parted'])} parted"
                         + (f" · {len(out['expired'])} came back" if out["expired"] else ""))
            for x in out["expired"]:
                lines.append(f"  came back · {x['address']} · it was set aside for {x['because']}, "
                             f"and {x['because']} is closed")
            for x in out["waits_on_you"]:
                lines.append(f"  waits on you · {x['address']} · "
                             + (x.get("why") or "stated by the contract; you have not said whether you carry it"))
            for x in out["you_wait_on"]:
                lines.append(f"  you are waiting · {x['address']} · "
                             + (x.get("why") or "you carry it; the contract has not stated it"))
            for x in out["parted"]:
                lines.append(f"  parted · {x['address']} · {x['why']}")
            for x in out["known"]:
                lines.append(f"  known · {x['address']} · set aside by {x['declared_by']} "
                             f"for {x['because']} ({x['state'].lower()})")
            lines.append(f"  note: {out['note']}")
            lines.append(f"  next: {out['next']}")
    elif cmd.startswith("declare"):
        if out.get("asks"):
            lines.append("usage: " + out["note"])
            lines.append(f"  next: {out['next']}")
        else:
            lines.append(f"{cmd}: {out['declares']} declared"
                         + (f" · wrote {out['wrote']}" if out.get("wrote") else ""))
            lines.append(f"  note: {out['note']}")
            lines.append(f"  next: {out['next']}")
    elif cmd == "seam" and out.get("asks"):
        lines.append("usage: " + out["note"])
        lines.append(f"  next: {out['next']}")
    elif cmd == "drift" and out.get("asks"):
        lines.append("usage: " + out["note"])
        lines.append(f"  next: {out['next']}")
    elif cmd == "drift":
        # every line here names its CATEGORY, because the two kinds of fact
        # below are not equally certified: a date is an object, an absence is a
        # walk. The word `refused` appears nowhere — no world entered, so no
        # court sat.
        head = f"drift: observation of {out['carrier']} against {out['contract']}"
        if out.get("thin"):
            head += " · no history here, so nothing is dated"
        elif out["late"]:
            head += (f" · behind on {out['late']} names · median {out['median_days']} days"
                     f" · worst {out['worst_days']}")
        else:
            head += " · nothing arrived late"
        lines.append(head)
        for w in out.get("worst", []):
            lines.append(f"  in history · {w['field']} · the contract's earliest revision saying it is "
                         f"{w['contract']}, the library's earliest commit writing it {w['carrier']} "
                         f"— {w['days']} days")
        for n in out.get("unwritten", [])[:5]:
            lines.append(f"  in this walk · {n} · the contract declares it; no file walked writes it")
        if len(out.get("unwritten", [])) > 5:
            lines.append(f"  … and {len(out['unwritten']) - 5} more names no file walked writes")
        for r in out.get("silent_routes", [])[:3]:
            lines.append(f"  in this walk · {r} · the contract declares this route; no file walked "
                         "spells its segments")
        if out.get("over_threshold"):
            lines.append(f"  threshold: you set --fail-over {out['threshold']}, and the median is "
                         f"{out['median_days']} — this exits non-zero by your rule, not by a verdict")
        lines.append(f"  note: {out['note']}")
        lines.append(f"  next: {out['next']}")
    elif cmd == "stdlib" and out.get("modules"):
        # WHAT MAY BE SAID HERE, in a sentence rather than a blob. An operator
        # who cannot see the vocabulary cannot know it is theirs to read: the
        # shelf was reachable only by already knowing a name on it.
        #
        # AND IT IS NOT A SHELF OF FILES. Splitting it into speech and gate's
        # own furniture drew a line that does not matter to anybody using this,
        # and hid the line that does: none of it is yours. Every word here is
        # carried by the judge we ship — a world speaks `Department` with no file
        # of that name anywhere near it, and a copy declared as a world file is
        # refused outright. So a printout is exactly that, and the dependency is
        # the judge, named by revision.
        roles = out.get("roles") or {}
        speak = [k for k in out["modules"] if roles.get(k) == "forms"]
        lines.append(f"stdlib: {len(speak)} you can speak, "
                     f"{len(out['modules']) - len(speak)} gate's own — all of it theirs")
        for name, note in out["modules"].items():
            own = "" if roles.get(name) == "forms" else "   (gate's own furniture)"
            lines.append(f"  {name:<20} {note.split('—')[-1].strip()[:52]}{own}")
        lines.append("  these are THEIRS: read them, quote them, learn them — but they are not "
                     "files your world is made of, and editing one adds no word to the language. "
                     "`gate --version` names the revision they were compiled from")
        lines.append("  next: `gate stdlib show <name>` reads one as plain Swift · "
                     "`gate mine FILE` / `gate theirs FILE` is how a file joins your world")
    elif cmd == "library":
        f = out.get("forms") or out.get("crystal") or {}
        lines.append(f"library: {len(f)} forms" + (f" · wrote {out['wrote']}" if out.get("wrote") else ""))
    elif cmd == "export":
        lines.append(f"export: {out['people']} people, {out['grants']} grants → {', '.join(out['wrote'])}")
    elif cmd == "log":
        d = out.get("default_branch") or "?"
        what = ("the world's history" if out.get("scope") == "world" and out.get("world_files")
                else "the repository")
        lines.append(f"log: {len(out['commits'])} commits · {what} · observed, not judged · closed = reachable from {d}")
        for c in out["commits"]:
            st = "?" if c["closed"] is None else ("closed" if c["closed"] else "open")
            who = c["person"] or c["email"]
            star = " *" if c["touches_world"] else ""
            lines.append(f"  {c['short']} {st:6} {c['when'][:10]} {who:20} {c['subject']}{star}")
    elif cmd == "findings":
        f = out["findings"]
        if not f:
            lines.append("findings: nothing to report yet")
        else:
            lines.append(f"findings: {len(f)} · {out['judged']} checked by the judge, "
                         f"{out['observed']} read from git")
            for x in f:
                tag = "checked" if x["kind"] == "judged" else ("offer  " if x["kind"] == "offer" else "read   ")
                lines.append(f"  [{tag}] {x['sentence']}")
                lines.append(f"           {x['evidence']}")
        if out.get("markdown"):
            lines.append("")
            lines.append(out["markdown"])
    elif cmd == "survey":
        lines.append(f"survey: {out['commits']} commits, read-only")
        lines.append("  unwritten links (co-change from your own history):")
        for l in out["unwritten_links"]:
            lines.append(f"    {l['together']:3d}x {l['confidence']:4.0%}  {l['a']} <-> {l['b']}")
        i = out["identity"]
        lines.append(f"  identity: {i['authors']} author(s), {i['signed_commits']} signed commits")
        for t in i["top"]:
            lines.append(f"    {t}")
        if out["object_candidates"]:
            lines.append("  object candidates in commit messages: " + ", ".join(f"{k}({c})" for k, c in out["object_candidates"].items()))
        f = out["fabric"]
        lines.append(f"  fabric: {f.get('facts') or 'no world yet'} · " + (f"{f['verdict']}, {f['refusals']} refusal(s)" if f.get("verdict") else f.get("note", "")))
    else:
        return json.dumps(out, ensure_ascii=False, indent=2)
    # EVERY OUTPUT ENDS WITH THE STEP THAT COMES NEXT. It is the oldest rule
    # here and it was kept by hand, branch by branch, which meant five commands
    # quietly did not: `log`, `library`, `survey`, `findings`, and — worst —
    # `init`, where somebody has just set everything up and is looking for what
    # to do. A reader who has to plan their own next move is a reader carrying
    # the map, and carrying the map is exactly what this is supposed to take off
    # them. The rule lives in one place now, so a new verb cannot forget it.
    if out.get("next") and not any(l.startswith("  next:") for l in lines):
        lines.append(f"  next: {out['next']}")
    return "\n".join(lines)


VERSION = "0.1.0"


def judge_from():
    # WHICH REVISION OF THE CORPUS THIS JUDGE CAME FROM. Bytes say what a thing
    # is; they do not say what it was made from, and a dependency stated as an
    # opaque hash cannot be checked by anybody who does not already know the
    # answer. The build records the commit beside the binary. Where it is
    # missing, that is said rather than glossed.
    try:
        return open(JUDGE + ".from", encoding="utf-8").read().strip() or None
    except OSError:
        return None


def judge_version():
    # the judge has no version flag; its identity is its bytes, which is also
    # what the README asks a reviewer to reproduce from the public corpus
    import hashlib
    try:
        with open(JUDGE, "rb") as f:
            return "sha256:" + hashlib.sha256(f.read()).hexdigest()[:12]
    except OSError:
        return "missing"


def main():
    if len(sys.argv) < 2:
        raise SystemExit(USAGE)
    args = sys.argv[1:]
    if args[0] in ("--version", "-v", "version"):
        came = judge_from()
        print(json.dumps({"command": "version", "gate": VERSION, "judge": judge_version(),
                          "judge_from": came, "python": sys.version.split()[0]}) if "--json" in args
              else f"gate {VERSION} · judge {judge_version()} (canon v2) · python {sys.version.split()[0]}"
              + ("\n  judge built from verification-is-identification " + came[:12]
                 + " — `bin/build-judge.sh " + came[:12] + "` reproduces these bytes"
                 if came else
                 "\n  the revision this judge was built from is not recorded: "
                 "`bin/build-judge.sh` writes it down"))
        return
    as_json = "--json" in args
    args = [a for a in args if a != "--json"]
    cmd, rest = args[0], args[1:]
    if cmd == "serve":
        return cmd_serve(rest)
    if cmd == "report":
        ensure_world()
        out = cmd_report(rest)
    else:
        out = dispatch(cmd, rest)
    print(json.dumps(out, ensure_ascii=False, indent=2) if as_json else humanize(out))
    sys.exit(1 if is_red(out) else 0)


if __name__ == "__main__":
    main()
