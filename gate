            "signed_commits": signed,
        },
        "object_candidates": {k: c for k, c in keys.most_common(10)},
        "fabric": world or {"facts": None, "note": "no world yet: coverage 0%. The links above say where to start"},
    }


# ── the stdlib: definitions baked into the binary, fully extractable ──
# Hidden is not secret (the git model: packed away, but cat-file shows all).
# `gate stdlib` lists, `gate show <name>` prints, `gate materialize <name>`
# lands the file in the repo — from then on it is the client's, versioned by
# his git; editing it means removing the header (it becomes his file).

MATERIALIZED_MARK = "// gate stdlib"

def spell_number(n):
    # ── SAYING A NUMBER, which is reading one run backwards. These worlds spell
    # a value on their own ladder from Unit, so writing 760 means writing the
    # rungs it is made of — the same shape every line already in them has:
    # ascending, right-nested, `Unit` where the ladder has no name for one.
    # Without this the bench could show a value and never let anybody say one,
    # which is a table you may read and not answer.
    if n <= 0:
        return "Never"
    parts, bit = [], 1
    while bit <= n:
        if n & bit:
            parts.append("Unit" if bit == 1 else "W%d" % bit)
        bit <<= 1
    out = parts[-1]
    for piece in reversed(parts[:-1]):
        out = "Plus<%s, %s>" % (piece, out)
    return out


def my_forms_file():
    # WHERE A VALUE OF MINE GOES. A row of mine, read by the where court, that is
    # not one of the files this tool ships — writing into those would be editing
    # somebody else's world, which is the one thing the whole mine/theirs split
    # exists to prevent. One such file is an answer; none and several are not,
    # and both say so rather than picking.
    rows = (MANIFEST.get("rows") if MANIFEST else None) or []
    base = os.path.dirname(MANIFEST["manifest"]) if MANIFEST else "."
    shipped = {n + ".swift" for n in STDLIB}
    mine = [r["path"] for r in rows
            if r["role"] == "forms" and r.get("source") == "mine"
            and os.path.basename(r["path"]) not in shipped]
    return [os.path.join(base, m) for m in mine]


def _peano(text):
    # every number in these worlds is spelled on the file's own ladder from Unit,
    # so reading one is walking that spelling — never a table kept beside it
    vals = {}

    def ev(e):
        e = e.strip()
        if e == "Unit":
            return 1
        if e == "Never":
            return 0
        if e in vals:
            return vals[e]
        m = re.fullmatch(r"[WN](\d+)", e)
        if m:
            return int(m.group(1))
        if e.startswith("Twice<"):
            return 2 * ev(e[6:-1])
        if e.startswith("Plus<"):
            inner, d = e[5:-1], 0
            for i, c in enumerate(inner):
                if c == "<":
                    d += 1
                elif c == ">":
                    d -= 1
                elif c == "," and d == 0:
                    return ev(inner[:i]) + ev(inner[i + 1:])
        raise ValueError(e)
    for m in re.finditer(r"^public typealias (\w+) = (.+)$", text, re.M):
        name, expr = m.group(1), m.group(2).split("//")[0].strip()
        if name in vals:
            continue          # first said wins: what was presented outranks what shipped
        try:
            vals[name] = ev(expr)
        except ValueError:
            continue
    return vals


def presented_over(shelf_name, live=None):
    # ── PRIORITY IS A PROPERTY OF THE LAYER, NEVER OF POSITION. This read the
    # presented worlds in the order the manifest listed them and let the first
    # speaker win — which made reordering a list change what the page paints,
    # and order carrying truth is the thing this project spent a week burying.
    # Correctness is order-invariant (§5.25); only efficiency is order-set. So
    # what overrides what is decided by which LAYER a declaration is in — a world
    # you presented outranks the one this tool ships — and two declarations
    # inside ONE layer are two truths about one name, refused with both
    # addresses rather than settled by whoever was listed first.
    #
    # And the merge is a REPLACEMENT, not an appending: your line stands where
    # theirs stood, so the certificates that shipped with the shelf go on testing
    # the value you put there. Freedom to say any number, no freedom to escape
    # the law about it.
    shipped = STDLIB.get(shelf_name, "")
    rows = (MANIFEST.get("rows") if MANIFEST else None) or []
    if not rows:
        return shipped, {}, []
    base = os.path.dirname(MANIFEST["manifest"])
    mine, clash = {}, []
    for r in rows:
        if r["role"] != "forms":
            continue
        # a file that IS this world does not override it. gate presents its own
        # shelf files as its own forms — that is the point of being the first
        # inhabitant — and reading them as overrides of themselves made every
        # name in this repository a second truth about itself.
        #
        # BY THE FILE, NEVER BY THE NAME. This compared basenames, so anybody
        # whose copy of a shelf world kept its name was silently skipped: the
        # third verb hands you `bench-palette.swift`, declares it, judges it —
        # and the values you then changed painted nothing, because the merge
        # took your file for ours on the strength of what it was called. The
        # shipped file has a path; that is what identity means here.
        if os.path.abspath(os.path.join(base, r["path"])) in SHIPPED_PATHS:
            continue
        fp = os.path.join(base, r["path"])
        said = (live or {}).get(r["path"])
        if said is None and not os.path.exists(fp):
            continue
        # ── AND A TYPEALIAS INSIDE A DECLARATION IS AN AXIS, NOT A VALUE. The
        # duplicate guard learned this and this one never did: `public typealias
        # Post = Zone_docs` inside a record is what that record says about
        # itself, and every record of a kind states the same axes. Read at any
        # depth, two of an operator's own forms files declaring two owners
        # collided on the word `Post` — a hundred and eleven refusals about
        # names nobody had presented twice. It stayed invisible only because
        # until now nobody had written a second forms file with records in it.
        depth = 0
        for i, line in enumerate((said if said is not None
                                  else open(fp, encoding="utf-8", errors="replace").read())
                                 .split("\n"), 1):
            code = line.split("//")[0]
            at_top = depth == 0
            depth += code.count("{") - code.count("}")
            m = re.match(r"public typealias (\w+) = ", line.strip())
            if not m or not at_top:
                continue
            name = m.group(1)
            # ── A VALUE IS YOURS; THE LAW ABOUT IT IS NOT. Moving a number
            # means restating what still holds of it — the slack is written by
            # whoever states the value, as the corpus does it — so a presented
            # certificate is legitimate. Changing its FORM is not: rewriting
            # `TowardWarm` as `TowardBlue` does not satisfy the law, it deletes
            # it, and a verdict channel that may declare itself cold is a bench
            # free to show refusals in the colour of agreement. Same head, your
            # arguments.
            head = re.match(r"public typealias \w+ = (\w+)<", line.strip())
            was = re.search(r"^public typealias " + name + r" = (\w+)<", shipped, re.M)
            if was and (not head or head.group(1) != was.group(1)):
                clash.append({"address": f"{r['path']}:{i}",
                              "claim": f"`{name}` is a law of a world you did not write, and this "
                                       f"says it is `{head.group(1) if head else 'a value'}` where "
                                       f"it is `{was.group(1)}`. Restate what holds of your own "
                                       "numbers as much as you like. The form is not yours to "
                                       "replace, or the law could be rewritten to permit whatever "
                                       "broke it"})
                continue
            if name in mine and mine[name][0] != r["path"]:
                clash.append({"address": f"{r['path']}:{i}",
                              "claim": f"`{name}` is said here and at {mine[name][0]}:"
                                       f"{mine[name][1]} — two worlds you present, one name, "
                                       "and nothing but the order they are listed in to choose "
                                       "between them. One layer, one declaration"})
                continue
            mine[name] = (r["path"], i, line)
    if not mine:
        # a clash is a refusal even when nothing survived to override: the guard
        # ran, said its piece, and this used to throw it away on the way out —
        # the shape of every quiet green there has ever been
        return shipped, {}, clash
    # IN PLACE, AND ONLY WHAT THIS WORLD SAYS. Two things had to be right here
    # and only one was.
    #
    # In place, because "your line stands where theirs stood" has to mean it:
    # hoisting the replacements to the top left every comment standing over a
    # different number than it was written about, and moved every line in the
    # file, so a table row and the line it jumps to described different things.
    #
    # And only this world's names, which is what was wrong. Everything the
    # operator declares in a forms file was collected and appended to EVERY
    # shipped world — a length from the metrics world glued onto the end of the
    # grants forms, the git atoms, the contract forms. Two encodings must not
    # communicate (V=I §5.24), and this had them all talking at once. It also
    # made the merged text depend on the ORDER the operator declared their files
    # in, so two people with identical content got different line numbers for
    # the same refusal — order leaking into an address, which §5.25 forbids.
    #
    # A name this world never said is not an addition to this world. It stands
    # in the operator's own stream, which `forms_guards` already builds and
    # judges beside these — that is where a new name of theirs belongs.
    out, placed = [], {}
    for ln in shipped.split("\n"):
        m = re.match(r"public typealias (\w+) = ", ln.strip())
        if m and m.group(1) in mine:
            out.append(mine[m.group(1)][2])
            placed[m.group(1)] = mine[m.group(1)][0]
        else:
            out.append(ln)
    return ("\n".join(out), placed, clash)


def presented_world(shelf_name):
    return presented_over(shelf_name)[0]


def palette_tokens():
    # ── THE COLOURS, READ FROM THE WORLD THAT DECLARES THEM. The stylesheet had
    # been carrying every one of these numbers a second time — `color(xyz-d65
    # calc(307/1000) …)` beside a record that already said 307 — with a check
    # standing between the two copies to keep them equal. A check is what you
    # reach for when a single source is out of reach; here it was not. The page
    # holds no colour of its own now: what it paints with is what the judge holds.
    vals = _peano(presented_world("bench-palette"))
    names = sorted({m.group(1) for m in
                    re.finditer(r"^public typealias (\w+)(?:Lit|Dim)X = ", 
                                presented_world("bench-palette"), re.M)})

    def srgb(x, y, z):
        # a hex fallback for anything that cannot read color(); a rendering of
        # the declared fact, never a second statement of it
        lin = (3.2406 * x - 1.5372 * y - 0.4986 * z,
               -0.9689 * x + 1.8758 * y + 0.0415 * z,
               0.0557 * x - 0.2040 * y + 1.0570 * z)
        out = []
        for c in lin:
            c = 12.92 * c if c <= 0.0031308 else 1.055 * (max(c, 0) ** (1 / 2.4)) - 0.055
            out.append(max(0, min(255, round(c * 255))))
        return "#%02X%02X%02X" % tuple(out)

    def block(half):
        rows = []
        for n in names:
            try:
                x, y, z = (vals[f"{n}{half}X"], vals[f"{n}{half}Y"], vals[f"{n}{half}Z"])
            except KeyError:
                continue
            var = "--" + n[0].lower() + re.sub(r"([A-Z])", lambda m: m.group(1).lower(), n[1:])
            rows.append(f"  {var}: {srgb(x / 1000, y / 1000, z / 1000)};"
                        f" {var}: color(xyz-d65 calc({x}/1000) calc({y}/1000) calc({z}/1000));")
        return "\n".join(rows)
    return (":root {\n" + block("Lit") + "\n}\n"
            + ':root[data-theme="dark"] {\n' + block("Dim") + "\n}\n")


def register_tokens():
    # ── THE FACES, READ FROM THE WORLD THAT DECLARES THEM. The page had been
    # restating a register every time it used one — nineteen font declarations
    # where four registers stood declared, half of them the same register written
    # again with the leading a hair different. Sizes live in tenths of a pixel
    # and leadings in hundredths of their own size, because a world spells its
    # numbers on its own ladder and 12.5 is not a whole anything. What is served
    # is what the page rendered before, to the last tenth.
    vals = _peano(presented_world("bench-registers"))
    text = presented_world("bench-registers")
    faces = dict(re.findall(r"public enum (\w+): Register \{\s*\n\s*public typealias On = (\w+)",
                            text))
    # how hard a register is set, read off the same declaration. This was three
    # world names written into this function — a world's vocabulary living in a
    # mechanism, which is the one thing no layer here may do: present a register
    # of your own and it could never be firm, because the tool had never heard
    # of it. Now the declaration says, and a name this file never mentions is
    # treated exactly like the ones it ships.
    stresses = dict(re.findall(
        r"public enum (\w+): Register \{[^}]*?public typealias Set = (\w+)", text, re.S))
    rows = []
    for name, face in sorted(faces.items()):
        size = vals.get(name + "Size")
        if size is None:
            continue
        lead = vals.get(name + "Lead")
        stack = ("ui-monospace,Menlo,monospace" if face == "Mono"
                 else "-apple-system,sans-serif")
        weight = "600 " if stresses.get(name) == "Firm" else ""
        px = ("%g" % (size / 10))
        rows.append(f"  --{name.lower()}: {weight}{px}px"
                    + (f"/{'%g' % (lead / 100)}" if lead else "") + f" {stack};")
    # and the two faces on their own, for a rule that changes the face and keeps
    # whatever size it stands in — still a name, never a stack written by hand
    for face, stack in (("Mono", "ui-monospace,Menlo,monospace"),
                        ("Sans", "-apple-system,sans-serif")):
        if "public enum " + face + ": Face {}" in text:
            rows.append(f"  --{face.lower()}: {stack};")
    return ":root {\n" + "\n".join(rows) + "\n}\n"


