def dispatch(cmd, rest):
    if cmd in ("check", "ask", "diff", "apply", "change", "status", "fsck", "report"):
        ensure_world()
    # ── AND A VERB ASKED FOR NOTHING SAYS WHAT IT WANTS. `rest[0]` below read the
    # first argument of an argv that may have none, so `gate check`, which is the
    # verb the cover's own table sells, answered a person with an IndexError and
    # a stack trace. Found by walking every read-only verb through seven public
    # repositories: `check` and `import` did this in all seven, and in a world
    # that holds, because it was never about the repository at all. Typing a verb
    # bare is how anybody learns what it takes.
    if cmd in ("check", "ask") and not rest:
        return {"command": "check", "asks": True,
                "note": "check view WHO WHAT  ·  check administer WHO WHERE  ·  "
                        "check delete WHO WHAT",
                "next": "gate check view Emp0042 FinanceShare, with names your world "
                        "declares (`gate library` lists that vocabulary)"}
