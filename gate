def cmd_guard(a):
    # guard [merge] — the repository's OWN action policy by the same gates:
    # a git object (the HEAD author) → a world atom (identities.csv) → a probe
    # entry of an existing form (VerifiedAtRank) → judgement. Rules live in
    # the world's tables; CI and hooks only transport the verdict.
    import csv

    action = a[0] if a else "merge"
    if not TABLES:
        raise SystemExit(json.dumps({"error": "guard needs a tables world (identities.csv, guard.csv)"}))
    world_dir = os.path.dirname(TABLES) or "."
    email = subprocess.run(
        ["git", "log", "-1", "--format=%ae"], cwd=world_dir, capture_output=True, text=True
    ).stdout.strip()
    identities = {r["email"]: r["id"] for r in csv.DictReader(open(os.path.join(TABLES, "identities.csv")))}
    rules = {r["action"]: r["requires_rank"] for r in csv.DictReader(open(os.path.join(TABLES, "guard.csv")))}
    if action not in rules:
        raise SystemExit(json.dumps({"error": f"guard: no rule for action '{action}' in guard.csv"}))
    required = rules[action]
    who = identities.get(email)
    if not who:
        return {"command": f"guard {action}", "author": email, "verdict": "refused",
                "refusals": [{"address": "tables/identities.csv", "claim": f"author {email} is not mapped to any person: an unknown identity performs no guarded action"}]}
    text = open(FACTS).read()
    probe = last_entry_insert(text, "VerifiedAtRank", {"first": who, "args_second": required}, 8)
    r = judge(with_temp(probe))
    return {"command": f"guard {action}", "author": f"{email} = {who}", "requires": required, **r, "mutates": False}


def cmd_library(a):
