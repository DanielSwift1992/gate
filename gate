                    body = presented_world(mod).encode()
                    self.send_response(200)
                    self.send_header("Content-Type", "text/plain; charset=utf-8")
                    self.send_header("Cache-Control", "no-store")
                    self.end_headers()
                    self.wfile.write(body)
                    return
                if u.path == "/files":
                    named = bench_files()
                    names = [n for n, _ in named]
                    pf = personal_path()
                    lay = (os.path.relpath(MANIFEST["manifest"],
                                           os.path.dirname(os.path.abspath(FACTS)))
                           if MANIFEST and os.path.exists(MANIFEST["manifest"]) else None)
                    here_undeclared = undeclared_here()
                    forms_rows = [r["path"] for r in
                                  ((MANIFEST.get("rows") if MANIFEST else None) or [])
                                  if r["role"] == "forms" and r["path"] in names]
                    # AND WHICH OF YOUR FILES OVERRULES SOMETHING WE SHIPPED. An
                    # override that is judged but invisible is still a surprise:
