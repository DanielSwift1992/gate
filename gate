                    body = json.dumps({"gate": VERSION, "judge_from": judge_from()}).encode()
                    self.send_response(200)
                    self.send_header("Content-Type", "application/json")
                    self.send_header("Cache-Control", "no-store")
                    self.end_headers()
                    self.wfile.write(body)
                    return
                if u.path == "/judge.js":
                    return self.send_file(os.path.join(here, "bin", "judge.js"), "text/javascript")
                if u.path == "/codemirror.js":
                    return self.send_file(os.path.join(here, "web", "codemirror.js"), "text/javascript")
                if u.path == "/codemirror.css":
                    return self.send_file(os.path.join(here, "web", "codemirror.css"), "text/css")
                if u.path == "/shelf":
                    mod = q.get("m")
