#!/bin/sh
# refusals stop a commit; an addressed unsupported remainder is printed and kept
if [ -x ./gatew ]; then exec ./gatew status --hook; fi
# a clone carries the tool at ./gate, which is the way the cover says to run it
# ("no install step"), so the hook looks there before it looks for an install
if [ -x ./gate ]; then exec ./gate status --hook; fi
if command -v gate >/dev/null 2>&1; then exec gate status --hook; fi
echo "pre-commit: gate is not on PATH and there is no ./gatew here, so nothing"
echo "checked the claims in this repository. Put gate on PATH, run"
echo "gate init . --vendor to carry it here, or delete .githooks/pre-commit."
exit 1
